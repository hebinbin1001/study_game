.over-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(20, 34, 56, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.over-card {
  width: 600rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  box-sizing: border-box;
}
.o-stars { font-size: 72rpx; color: var(--pri); letter-spacing: 8rpx; }
.o-title { font-size: 48rpx; font-weight: 900; color: #2e8b57; margin-top: 10rpx; }
.o-title.fail { color: #e62e2e; }
.o-msg { font-size: 28rpx; color: var(--ink-weak); margin-top: 10rpx; line-height: 1.5; }
/* 「差一点」提示：浅黄底 + 深金文字，与「差一档」的情绪对上 */
.o-hint {
  margin: 14rpx 0 4rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #FFF6E0;
  color: #A96A00;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}
.ops { margin-top: 6rpx; }
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 900;
}
.btn-icon { width: 44rpx; height: 44rpx; flex: 0 0 auto; }
.btn.b1 { background: var(--pri); color: var(--white); box-shadow: var(--clay-3, inset 0 -10rpx 0 rgba(20, 50, 90, .15), inset 0 8rpx 0 rgba(255, 255, 255, .55), 0 14rpx 28rpx rgba(20, 50, 90, .16)); }
.btn.b2 { background: linear-gradient(135deg, #4285F4, #6AA6F5); color: var(--white); box-shadow: var(--clay-3, inset 0 -10rpx 0 rgba(20, 50, 90, .15), inset 0 8rpx 0 rgba(255, 255, 255, .55), 0 14rpx 28rpx rgba(20, 50, 90, .16)); }
.btn::after { border: none; }
