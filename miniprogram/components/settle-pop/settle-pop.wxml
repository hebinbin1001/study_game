<view wx:if="{{visible}}" class="over-mask" catchtap="onTapBubble">
  <view class="over-card">
    <view wx:if="{{starsText}}" class="o-stars">{{starsText}}</view>
    <view wx:else class="o-stars">💔</view>
    <view class="o-title {{win ? '' : 'fail'}}">{{title || (win ? '通关成功！' : '再接再厉！')}}</view>
    <view wx:if="{{msg}}" class="o-msg">{{msg}}</view>
    <!-- 「差一点」提示（2026-10-17）：星级是三档硬阈值，差 1 题就掉档，
         这里明确告诉玩家还差多少，比只显示结果更能推动重玩。 -->
    <view wx:if="{{hint}}" class="o-hint">{{hint}}</view>

    <!-- 页面自定义操作区 -->
    <view class="ops"><slot></slot></view>

    <!-- 通关后的「下一关」：只在还有下一关时由页面打开（showNext） -->
    <button wx:if="{{!customOps && showNext && win}}" class="btn b2" catchtap="onNext">
      <image wx:if="{{icons.next}}" class="btn-icon" src="{{icons.next}}" mode="aspectFit"></image>
      <text>{{nextText || '下一关 ▶'}}</text>
    </button>
    <button wx:if="{{!customOps && showRetry && !win}}" class="btn b1" catchtap="onRetry">
      <image wx:if="{{icons.retry}}" class="btn-icon" src="{{icons.retry}}" mode="aspectFit"></image>
      <text>再来一次</text>
    </button>
    <button wx:if="{{!customOps && win && !showNext}}" class="btn b1" catchtap="onRetry">
      <image wx:if="{{icons.retry}}" class="btn-icon" src="{{icons.retry}}" mode="aspectFit"></image>
      <text>再玩一次</text>
    </button>
  </view>
</view>
