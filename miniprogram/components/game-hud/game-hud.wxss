.gh-wrap {
  position: relative;
  flex: 0 0 auto;
}
/* 战士徽章贴在 HUD 行右端：不再 fixed 悬浮压住题目卡 */
.gh-badge {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}
.hud {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 18rpx;
  flex: 0 0 auto;
  margin: 12rpx 0;
}
.chip {
  background: rgba(255, 255, 255, 0.94);
  color: var(--ink);
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: var(--fs-body);
  font-weight: 800;
  box-shadow: var(--clay-2, inset 0 -6rpx 0 rgba(20, 50, 90, .12), inset 0 5rpx 0 rgba(255, 255, 255, .50), 0 6rpx 14rpx rgba(20, 50, 90, .12));
  line-height: 1.4;
}
.chip-lives { color: var(--pink); min-width: 120rpx; text-align: center; }
.chip-score { color: var(--link); }
.chip-extra { color: var(--pri); }
