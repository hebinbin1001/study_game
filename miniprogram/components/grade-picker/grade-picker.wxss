.gp-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(20, 40, 70, .45);
  display: flex;
  align-items: flex-end;
}

.gp-sheet {
  width: 100%;
  background: var(--white);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: gpUp .22s ease-out;
}
@keyframes gpUp {
  from { transform: translateY(40rpx); opacity: .6; }
  to { transform: translateY(0); opacity: 1; }
}

.gp-head { padding: 0 4rpx 18rpx; }
.gp-title { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); }
.gp-sub {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  line-height: 1.5;
  color: var(--ink-weak);
}

/* 14 项 = 7 行，按 7×84rpx + 6×14rpx 留足高度，一屏看全，不用再滚 */
.gp-scroll { max-height: 700rpx; }
.gp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 4rpx 0 8rpx;
}
.gp-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #f3f7fc;
  color: var(--ink-sub);
  font-size: var(--fs-body);
  font-weight: 800;
}
.gp-item.on {
  background: linear-gradient(135deg, var(--pri), var(--pri));
  color: var(--white);
  box-shadow: var(--clay-2, inset 0 -6rpx 0 rgba(20, 50, 90, .12), inset 0 5rpx 0 rgba(255, 255, 255, .50), 0 6rpx 14rpx rgba(20, 50, 90, .12));
}
.gp-item:active { transform: translateY(2rpx); }
.gp-check { font-size: var(--fs-cap); font-weight: 900; }

.gp-cancel {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  background: var(--surface);
  color: var(--ink-sub);
  font-size: var(--fs-strong);
  font-weight: 800;
}
.gp-cancel:active { opacity: .8; }
