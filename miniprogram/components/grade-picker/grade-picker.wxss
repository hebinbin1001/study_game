.gp-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(20, 40, 70, .45);
  display: flex;
  align-items: flex-end;
}

.gp-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: gpUp .22s ease-out;
}
@keyframes gpUp {
  from { transform: translateY(40rpx); opacity: .6; }
  to { transform: translateY(0); opacity: 1; }
}

.gp-head { padding: 0 4rpx 18rpx; }
.gp-title { font-size: 32rpx; font-weight: 900; color: #2f4a6b; }
.gp-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a9bb5;
}

/* 14 项 = 7 行，按 7×84rpx + 6×14rpx 留足高度，一屏看全，不用再滚 */
.gp-scroll { max-height: 700rpx; }
.gp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 4rpx 0 8rpx;
}
.gp-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #f3f7fc;
  color: #3a5a80;
  font-size: 26rpx;
  font-weight: 800;
}
.gp-item.on {
  background: linear-gradient(135deg, #ffb703, #ff9800);
  color: #fff;
  box-shadow: 0 6rpx 0 rgba(190, 110, 0, .28);
}
.gp-item:active { transform: translateY(2rpx); }
.gp-check { font-size: 24rpx; font-weight: 900; }

.gp-cancel {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #eef2f8;
  color: #5c7f9e;
  font-size: 30rpx;
  font-weight: 800;
}
.gp-cancel:active { opacity: .8; }
