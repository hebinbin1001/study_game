/* game-pause —— 统一暂停按钮与弹层 */

/* ============ 暂停按钮 ============ */
/* 2026-10-18 改版（用户反馈「右上角暂停键和战士图标难看」）：
   旧版是「半透明白圆 + 字符 Ⅱ」——白色圆片在浅蓝天空背景上只剩一团白，
   字符 Ⅱ 带 letter-spacing，远看像有人手写了两个「I」，不像按钮。
   现在：深色实心圆 + 两根 view 画的圆角竖条，图标是几何图形而不是文字，
   深浅背景上都清晰；白竖条对深底的对比度远高于浅灰字对白底。

   两种定位：
     · 默认（inline=false）—— fixed 右上角，兼容没有 HUD 行的页面；
     · inline=true —— position:static，作为 flex item 进 HUD 行，
       和战士徽章并排（2026-10-18「按 D 对齐」）。 */
.gp-fab {
  position: fixed;
  top: 12rpx;
  right: 12rpx;
  z-index: 90;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--ink);
  box-shadow: 0 4rpx 10rpx rgba(20, 40, 80, .22);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  box-sizing: border-box;
  /* 进 HUD 行时与两侧胶囊垂直居中（各页 .hud 多为 align-items:stretch） */
  align-self: center;
}

/* 进 HUD 行：不再悬浮，尺寸与 warrior-badge(sm) 对齐（都是 72rpx） */
.gp-fab--inline {
  position: static;
  z-index: auto;
  box-shadow: 0 4rpx 10rpx rgba(20, 40, 80, .18);
}

.gp-fab-bar {
  width: 6rpx;
  height: 24rpx;
  border-radius: 0rpx;
  background: var(--white);
}
.gp-fab-img { width: 48rpx; height: 48rpx; }

.gp-fab--tap { transform: scale(.94); opacity: .9; }

/* ============ 弹层 ============ */
.gp-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  z-index: 200;
  background: rgba(20, 24, 40, .55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.gp-card {
  width: 100%;
  max-width: 560rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 44rpx 40rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, .28);
}

.gp-ico { font-size: 56rpx; line-height: 1; }
.gp-ico-img { width: 64rpx; height: 64rpx; margin: 0 auto; }
.gp-title {
  margin-top: 12rpx;
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--ink);
}
.gp-sub {
  margin-top: 8rpx;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}

.gp-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: var(--link);
  color: var(--white);
  font-size: var(--fs-strong);
  font-weight: 800;
  border: none;
}
.gp-main::after { border: none; }
.gp-btn-icon { width: 38rpx; height: 38rpx; flex: 0 0 auto; }

.gp-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.gp-mini {
  flex: 1 1 0;
  min-width: 0;
  height: 88rpx;
  border-radius: 28rpx;
  background: #f2f5fb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.gp-mini-ico { font-size: var(--fs-strong); line-height: 1.1; }
.gp-mini-img { width: 34rpx; height: 34rpx; }
.gp-mini-txt { font-size: var(--fs-cap); color: #5c6b85; font-weight: 700; }

.gp-quit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  font-size: var(--fs-cap);
  color: #98a4b8;
  padding: 10rpx 0;
}
