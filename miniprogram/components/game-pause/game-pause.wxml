<!-- 统一暂停按钮 + 暂停弹层（见 game-pause.js 头部说明） -->

<!-- 暂停按钮：只在对局中显示（showFab）且未暂停时显示。
     2026-10-18 改版：图标不再用「Ⅱ」字符（看着像文字），改用两根 view 圆角竖条；
     inline=true 时参与 HUD 行内布局（不再 fixed 悬浮），见 wxss 注释。 -->
<view
  wx:if="{{showFab && !show}}"
  class="gp-fab {{inline ? 'gp-fab--inline' : ''}}"
  catchtap="onOpen"
  hover-class="gp-fab--tap"
  hover-stay-time="60">
  <image
    wx:if="{{icons.pause && !pauseIconErr}}"
    class="gp-fab-img"
    src="{{icons.pause}}"
    mode="aspectFit"
    binderror="onPauseIconError"></image>
  <block wx:else>
    <view class="gp-fab-bar"></view>
    <view class="gp-fab-bar"></view>
  </block>
</view>

<!-- 暂停弹层 -->
<view wx:if="{{show}}" class="gp-mask" catchtouchmove="noop" catchtap="noop">
  <view class="gp-card" catchtap="noop">
    <image
      wx:if="{{icons.pause && !pauseIconErr}}"
      class="gp-ico-img"
      src="{{icons.pause}}"
      mode="aspectFit"></image>
    <view wx:else class="gp-ico">⏸</view>
    <view class="gp-title">已暂停</view>
    <view wx:if="{{sub}}" class="gp-sub">{{sub}}</view>

    <button class="gp-main" catchtap="onResume">
      <image wx:if="{{icons.resume}}" class="gp-btn-icon" src="{{icons.resume}}" mode="aspectFit"></image>
      <text>继续游戏</text>
    </button>

    <view class="gp-row">
      <view class="gp-mini" catchtap="onToggleSound">
        <text class="gp-mini-ico">{{sound ? '🔊' : '🔇'}}</text>
        <text class="gp-mini-txt">{{sound ? '音效开' : '音效关'}}</text>
      </view>
      <view class="gp-mini" catchtap="onRestart">
        <image wx:if="{{icons.retry}}" class="gp-mini-img" src="{{icons.retry}}" mode="aspectFit"></image>
        <text wx:else class="gp-mini-ico">↻</text>
        <text class="gp-mini-txt">重新开始</text>
      </view>
    </view>

    <view class="gp-quit" catchtap="onQuit">
      <image wx:if="{{icons.back}}" class="gp-mini-img" src="{{icons.back}}" mode="aspectFit"></image>
      <text>退出本关</text>
    </view>
  </view>
</view>
