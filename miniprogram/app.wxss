/**
 * app.wxss —— 词力战士全局样式
 *
 * 设计说明：
 *   - 配色取自 HTML 试玩原型（prototype/index.html）的暖色天空卡通风格
 *   - 卡通扁平化：大圆角 + 底部硬阴影（box-shadow 0 Xpx 0）营造「按压感」
 *   - 提供通用按钮 / 卡片 / 背景基线样式，各页面可复用或覆盖
 */

/* ============ 全局基座 ============ */
/* 2026-10-28（批 5）：这里原本还有一整套 --sky1 / --sky2 / --pink / --orange 变量声明，
   但末尾的正式令牌块又定义了一遍同名变量（优先级相同 → 后者胜出），
   等于这套声明从来没生效过，还埋着「两处同名不同值」的雷（--sky1 一边 #7ec8ff、
   一边 var(--sky-2)；--orange 一边 var(--pri)、一边 --pri）。已整块删除，
   令牌只保留文件末尾那一处真相源。 */
page {
  /* 暖色天空渐变背景（三档全部来自 --sky-* 令牌，与四个 tab 页同一套）
     2026-10-18：去掉 background-attachment: fixed。
     微信 WebView（iOS 尤其明显）里固定背景只铺「首屏视口」，内容一旦超过一屏，
     滚动出来的下半部分就没有背景（用户反馈「文字超过一页，背景没跟上」）。
     改为跟随 page 高度拉伸，长列表页也能铺满。 */
  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 60%, var(--sky-3) 100%);
  /* 兜底底色：万一某个老版本 WebView 对长页面渐变的裁剪仍有偏差，
     露出来的也是浅蓝而不是刺眼的白 */
  background-color: var(--sky-3);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  color: var(--ink);
  font-size: var(--fs-body);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面容器（全屏纵向布局） */
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ============ 标题 ============ */
.page-title {
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  margin: 40rpx 0 0;
}

.page-sub {
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  letter-spacing: 8rpx;
  margin: 12rpx 0 40rpx;
}

/* ============ 通用按钮（卡通硬阴影风格） ============ */
/**
 * ============ 通用「游戏页外壳」（2026-09-12 需求⑥ 视觉统一） ============
 *
 * 老玩法页（数独/2048/24 点/连连看/贪吃蛇/消消乐）此前各写各的头部与 HUD，
 * 字号、圆角、留白、胶囊配色都不一致，看起来像不同游戏。这里把「头部 + HUD」抽成一套共享类：
 *   .g-head / .g-title / .g-chip      顶部栏（返回胶囊 + 标题 + 右侧信息胶囊）
 *   .g-hud / .g-hud-box / .g-hud-num / .g-hud-lab   两到四个指标盒
 * 各页只需在 wxml 上套这些类，删掉各自重复的样式即可保持一致。
 */
.g-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}

.g-title {
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--white);
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, .12);
}

.g-chip {
  margin-left: auto;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  font-weight: 800;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.g-hud {
  display: flex;
  gap: 14rpx;
  margin: 18rpx 0 12rpx;
  flex: 0 0 auto;
}

.g-hud-box {
  flex: 1;
  background: rgba(255, 255, 255, .94);
  border-radius: 28rpx;
  padding: 12rpx 8rpx;
  text-align: center;
}

.g-hud-num { font-size: var(--fs-strong); font-weight: 900; color: var(--ink); }
.g-hud-lab { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 4rpx; }

/* 胶囊型 HUD（数独/24 点/连连看/贪吃蛇/消消乐共用；原来 5 个页面各写一份，只有 padding 和字号差 1~2rpx） */
.hud {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin: 18rpx 0 14rpx;
  flex: 0 0 auto;
}

.hud-chip {
  background: rgba(255, 255, 255, .92);
  color: var(--ink);
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  box-shadow: var(--clay-1);
}

.btn {
  border: none;
  border-radius: 999rpx;
  font-weight: 900;
  color: var(--white);
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: var(--clay-3);
  transition: transform 0.12s, box-shadow 0.12s;
}

/**
 * 重置小程序原生 <button> —— 关键修复（2026-09-12 用户反馈「很多按钮里的字靠上」）：
 *
 * 原生 button 自带 `line-height: 2.55555556`（≈46px）；而这里原来写的是 `line-height: inherit`，
 * 父容器没设行高时它会退化成 `normal`。两种情况都会让「设了 height 但没写 line-height」的按钮
 * 里文字贴顶（各页的 .btn-back / .btn-use / .check-pill 等都是这一类）。
 *
 * 统一改成 flex 垂直居中：不论按钮多高、字号多大，文字都在正中。
 * 页面里已经写了 `line-height: <height>` 的按钮不受影响（两者效果一致）。
 */
button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}
button::after {
  border: none;
}

/* 自定义 .btn 风格（去掉原生内边距/外边距，颜色由 .btn-xxx 决定） */
button.btn {
  padding: 0;
  margin: 0;
  background: var(--pri);
}
.btn:active {
  /* 黏土按压（2026-10-28）：从「整体下沉 6rpx」改成「压扁 + 内厚变薄」。
     下沉会让按钮在按下瞬间与周围元素脱开，压扁更像软胶被按进去。 */
  transform: translateY(2rpx) scaleY(.97);
  box-shadow: var(--clay-press);
}

/* ============ 按钮四态补齐（2026-10-28 · 批 3） ============
   改版前实测：49 个页面里 `:disabled` 只出现过 1 次，`disabled=` 属性只用在 3 处。
   也就是说「按不了」这件事基本没有视觉表达 —— 用户点了没反应，会以为是卡住。

   三态定义：
     默认  黏土厚度（--clay-2 / --clay-3，由各按钮自己给）
     按下  压扁 + 内厚变薄（.btn:active，已在上方）
     禁用  去掉厚度 + 半透明（--clay-off：没有厚度就没有「可按」的隐喻）
     加载  旋转环 + 禁止点击（.btn--loading）

   注意 `button[disabled]` 必须显式杀掉 :active —— 小程序在 disabled 状态下
   仍会触发 :active 伪类（不是 bug，是 CSS 语义），不杀的话按下去还会压扁。 */
button[disabled],
button.btn[disabled],
.btn--off {
  opacity: .55;
  box-shadow: var(--clay-off);
}
button[disabled]:active,
button.btn[disabled]:active,
.btn--off:active {
  transform: none;
  box-shadow: var(--clay-off);
}

.btn--loading {
  pointer-events: none;
  opacity: .9;
}
.btn--loading::before {
  content: '';
  flex: 0 0 auto;
  width: 26rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, .45);
  border-top-color: var(--white);
  animation: btnSpin .7s linear infinite;
}
@keyframes btnSpin {
  to { transform: rotate(360deg); }
}

/* 结算弹层里的次要操作（返回关卡 / 关卡列表）
 * 2026-10-17：各页的 .b1/.b2 配色本来就不一致（有的 b1 橙、有的 b1 灰），
 * 放进统一弹层会花；这里给一个固定浅灰款，**不依赖各页局部样式**。 */
.btn-ghost {
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  border-radius: var(--r-pill);
  background: #eef2f8;
  color: var(--ink-sub);
  font-size: var(--fs-strong);
  font-weight: 900;
  box-shadow: var(--clay-card);
}

/* 主按钮（大号，常用于「开始游戏」） */
.btn-primary {
  width: 480rpx;
  height: 128rpx;
  font-size: var(--fs-display);
  background: var(--pri);
  line-height: 128rpx;
}

/* 次级按钮（颜色可分主题覆写） */
.btn-secondary {
  min-width: 240rpx;
  padding: 0 40rpx;
  height: 88rpx;
  font-size: var(--fs-strong);
  background: var(--blue);
  line-height: 88rpx;
}

/* 按钮配色变体（对应原型 .btn-xxx） */
.btn-blue { background: var(--blue); }
.btn-purple { background: var(--purple); }
.btn-green { background: var(--green); }
.btn-pink { background: var(--pink); }
.btn-orange { background: var(--pri); }

/* ============ 通用卡片 ============ */
.card {
  background: var(--white);
  border-radius: var(--r-md);
  box-shadow: var(--clay-card);
  padding: var(--sp-4);
}

/* ============ 布局辅助 ============ */
/* 页面内按钮/元素之间的垂直间距 */
.menu-gap { margin-top: 32rpx; }

/* 占位内容卡片（骨架期提示后续任务实现） */
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #8899aa;
  font-size: var(--fs-strong);
  text-align: center;
}

/* ==========================================================================
   统一按钮规范（2026-10-08）

   背景（用户反馈）：「返回按钮统一设计下，现在太普通了」+
   「下一关、返回、重玩等按钮统一下」。

   现状：app.wxss 里本来就有 .btn / .btn-primary 这套基础，
   但各页**没引用它**、各自又写了一遍（.ri-back / .lv-back / .wb-back …），
   同一类操作在不同页面长得不一样 —— 这才是"看着乱"的根源。

   这里把「关卡流程里会反复出现的操作」定成标准件，各页直接引用：
     尺寸  btn-lg（128rpx，主操作）/ btn-md（96rpx，常规）/ btn-sm（72rpx，次要内联）
     语义  btn-primary 主操作（橙）· btn-ghost 次要（白底描边）
           btn-next 下一关（绿）· btn-retry 重玩（蓝）· btn-back 返回（胶囊）

   ⚠️ 三句实现上的硬约束（都踩过坑）：
     1. 必须 flex 居中 —— 原生 button 的 line-height 会让文字贴顶（见上方那条注释）；
     2. 去掉原生 ::after 边框，否则会多一圈灰线；
     3. :active 用「下压 + 阴影变浅」而不是改背景色 —— 改背景色在深色按钮上看不出来。
   ========================================================================== */

/* ---- 尺寸档 ---- */
.btn-lg { height: 128rpx; font-size: var(--fs-title); padding: 0 56rpx; }
.btn-md { height: 96rpx; font-size: var(--fs-strong); padding: 0 40rpx; }
.btn-sm { height: 88rpx; font-size: var(--fs-cap); padding: 0 32rpx; border-radius: var(--r-pill); }

/* ---- 语义档 ---- */
/* 主操作：下一关 / 开始 / 保存 */
.btn-next {
  background: linear-gradient(135deg, var(--green), #4caf50);
  box-shadow: var(--clay-3);
}
/* 重玩：蓝 */
.btn-retry {
  background: linear-gradient(135deg, var(--sky-2), #3f8fe0);
  box-shadow: var(--clay-3);
}
/* 次要操作：白底描边，用在「回首页」「取消」这类不想抢注意力的位置 */
.btn-ghost {
  background: var(--white);
  color: var(--ink-sub);
  box-shadow: var(--clay-card);
}
.btn-ghost.btn { color: var(--ink-sub); }

/**
 * 返回：统一胶囊（白底 + 左箭头 + 轻微阴影）。
 * 用它替掉各页自写的圆形返回 —— 圆形那个在小屏上像颗纽扣，撑不起"返回"的语义。
 */
.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 2026-10-28：72 → 88rpx。72rpx 只有 36px，低于 44px 的触控下限；
     这个类被 16 个页面引用，改这一处等于一次性修完 16 个返回按钮的热区。 */
  height: 88rpx;
  min-width: 88rpx;
  padding: 0 30rpx 0 22rpx;
  border-radius: var(--r-pill);
  background: rgba(255, 255, 255, .92);
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: 800;
  letter-spacing: 1rpx;
  box-shadow: var(--clay-1);
  transition: transform .12s, box-shadow .12s;
}
.btn-back::before {
  content: '‹';
  margin-right: 10rpx;
  font-size: var(--fs-title);
  line-height: 1;
  font-weight: 900;
}
.btn-back:active { transform: translateY(3rpx); }

/* ============ 返回按钮 ============ */
.back-btn {
  align-self: flex-start;
  margin: 24rpx 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink);
  font-size: var(--fs-title);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* ============ 辅助组件（UI 重设计新增，各页复用） ============ */

/* 软卡片变体：浅底、更轻阴影（用于内嵌信息卡） */
.card--soft {
  background: rgba(255, 255, 255, 0.85);
  box-shadow: var(--clay-card);
}

/* 标签 / 徽章（稀有度、成就、签到天数等） */
.tag,
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 28rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  line-height: 1.4;
}
.tag {
  background: rgba(255, 255, 255, 0.85);
  color: var(--ink-sub);
}
.badge {
  background: var(--gold);
  color: #6b4e00;
}
.badge--green { background: var(--green); color: var(--white); }
.badge--blue { background: var(--blue); color: var(--white); }
.badge--pink { background: var(--pink); color: var(--white); }
.badge--purple { background: var(--purple); color: var(--white); }

/* 大 emoji 头像容器（皮肤/吉祥物展示） */
.emoji-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--white);
  box-shadow: var(--clay-card);
}
.emoji-avatar text {
  font-size: 96rpx;
  line-height: 1;
}

/* 空态占位（统一风格） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #8899aa;
  font-size: var(--fs-body);
  text-align: center;
}
.empty-state .empty-emoji {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

/* 进度条（错题本熟练度、成就进度等） */
.progress-bar {
  width: 100%;
  height: 20rpx;
  border-radius: var(--r-pill);
  background: rgba(0, 0, 0, 0.08);
  overflow: hidden;
}
.progress-bar__fill {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(90deg, var(--blue), var(--green));
  transition: width 0.3s ease;
}

/* ============ 棋盘 / 卡牌材质（需求⑥ 第二期，6 个棋盘类玩法共用） ============
   一期把头部与 HUD 统一了，二期统一「棋盘本身」的质感：原来各页的格子都是一块纯色方块
   加一层几乎看不见的阴影，整块棋盘像浮在页面背景上。这里定四个共用类：

     .b-tray  棋盘底槽 —— 让棋子「嵌」在板上
     .b-face  棋子/卡牌面 —— 白面渐变 + 底部硬阴影 + 顶部内高光（卡通塑料片质感）
     .b-press 按下反馈 —— 下沉并收起投影，与 app.wxss 的 .btn:active 同一套手感
     .b-sel   选中态 —— 金色环 + 上浮（用 box-shadow 画环，不依赖 border，
                        因为各页原来有的写了 outline、有的只写了 border-color 而没声明 border）

   注意：数字类玩法（2048 的 .cell.c8 等）用「两个类」的选择器设背景，特异性高于单类名
   的 .b-face，所以叠上去不会把颜色冲掉 —— 这正是把材质做成独立类而不是写进 .cell 的原因。 */
.b-tray {
  background: rgba(255, 255, 255, 0.17);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 28rpx;
  padding: 16rpx;
  box-sizing: border-box;
  box-shadow: inset 0 8rpx 18rpx rgba(16, 44, 78, 0.16);
}
.b-face {
  background: linear-gradient(180deg, var(--white) 0%, #eef4fb 100%);
  box-shadow: var(--clay-2);
}
.b-press:active {
  transform: translateY(3rpx);
  box-shadow: var(--clay-press);
}
.b-sel {
  transform: translateY(-4rpx);
  box-shadow: 0 0 0 6rpx var(--pri), var(--clay-2);
}
/* 入场：整块棋盘轻微铺开（一次性，不打扰对局节奏） */
@keyframes bBoardIn {
  from { opacity: 0; transform: translateY(-10rpx) scale(0.985); }
  to { opacity: 1; transform: none; }
}
.b-in { animation: bBoardIn 0.26s ease-out both; }

/* ============ 未登录门禁引导条（M5 T2.3 受限页直入守卫） ============
   受限页（排行榜 / 错题本 / 成就 / 签到 / 形象 / 结算页）在未登录时展示这一条，
   页内引导而不是弹窗拦截：不打断用户、也不影响无登录态的页面渲染回归。
   样式放全局，6 个页面共用一份（改文案/配色只改这里）。 */
.gate-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 20rpx 24rpx;
  background: #fff8e6;
  border: 2rpx solid #ffd8a8;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(200, 140, 0, 0.08);
}
.gate-bar .gate-emoji { flex: none; font-size: var(--fs-strong); margin-right: 14rpx; }
.gate-bar .gate-text {
  flex: 1;
  font-size: var(--fs-cap);
  color: #8a6338;
  line-height: 1.5;
}
.gate-bar .gate-btn {
  flex: none;
  margin: 0 0 0 16rpx;
  padding: 0 26rpx;
  height: 60rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--white);
  background: #ff9800;
  border-radius: var(--r-pill);
}
.gate-bar .gate-btn::after { border: none; }

/* ==========================================================================
   战士主题 · UI 重做一期（2026-10-17）

   产品目标（用户拍板）：用「主题 + 玩法」吸引玩家 —— 战士皮肤 / Boss 立绘
   这套资产以前只在皮肤页躺着，首页和对局页几乎不露脸。现在把它们放到台前：
     首页   = 战士舞台（当前皮肤立绘）+ 皮肤收集条 + Boss 预告卡 + 出战大按钮
     对局页 = 战士 VS Boss 双血条，答题即战斗
     结算页 = 击败演出 + 「下一款皮肤还差多少」的钩子

   口径（用户 2026-10-17 拍板）：
     ① 等级 = 段位阶梯的 cell（1~72），由星星数推导（utils/rank-ladder.js），不新增数值；
     ② 皮肤解锁按段位（rank）与成就（milestone）展示条件文案；
     ③ Boss 奖励体系不动；
     ④ 布局要求「整屏铺满」—— 页面 flex 纵向撑满，末屏模块 flex:1 吃掉剩余高度，
        不留大片空白（下方 .page-fill / .fill-1 就是干这个的）。
   ========================================================================== */

/* ---- 主题 token（与 demo/ui-redesign/style-h-theme.html 同一套） ---- */
page {
  --sky-top: #4a9fe8;      /* 天空顶 */
  --sky-mid: #8fcbf7;      /* 天空中 */
  --sky-bot: #d8efff;      /* 天空底 */
  --cta: #ff9a1f;          /* 主操作橙 */
  --cta-deep: #d97c00;     /* 橙色底影（按压感） */
  --win: #3fbf5f;          /* 成功/下一关绿 */
  --boss-bg1: #3b2a5e;     /* Boss 场景暗紫顶 */
  --boss-bg2: #c98ab8;     /* Boss 场景紫粉底 */
  --gold: #ffd166;         /* 星星/解锁金 */
  --ink: #3a3a5c;
  --ink-sub: #8a9bb5;
}

/* ---- 铺满布局基类：页面纵向撑满，末屏用 .fill-1 吃掉剩余高度 ---- */
.page-fill {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}
.fill-1 { flex: 1 1 auto; min-height: 0; }

/* ---- 战士舞台（首页视觉中心：当前装备的皮肤立绘） ---- */
.w-stage {
  position: relative;
  width: 100%;
  text-align: center;
  padding: 12rpx 0 0;
}
/* 舞台光晕：立绘脚下的一圈浅色，让战士「站」在页面上而不是浮着 */
.w-stage::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  width: 300rpx;
  height: 76rpx;
  margin-left: -150rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, .85), rgba(255, 255, 255, 0) 70%);
}
.w-img {
  position: relative;
  z-index: 1;
  width: 330rpx;
  height: 330rpx;
}
.w-emoji {
  position: relative;
  z-index: 1;
  font-size: 150rpx;
  line-height: 1;
}
.w-side {
  position: absolute;
  top: 44%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
/* 2026-10-28：这里原本是 .w-side--right + .w-lv/.w-lv-lab（战士舞台右上角的「Lv.X 等级」）。
   等级与左侧段位都由同一颗星推导，属于同一个数字讲两遍，已随「砍 Lv、只留段位」一并删除；
   DOM 与样式同时清掉，避免留下没人引用的死规则。 */
/* 左侧标签必须显式 left:0 —— 绝对定位不写 left/right 会退回到文档流位置，
   在小屏上会压到立绘身上（首页真机复查踩过）。 */
.w-side--left { left: 0; }
.w-name {
  max-width: 240rpx;
  background: var(--white);
  color: #3a5a80;
  font-size: var(--fs-cap);
  font-weight: 900;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  box-shadow: var(--clay-1);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.w-rank {
  margin-top: 8rpx;
  background: linear-gradient(160deg, #ffe9b8, var(--gold));
  color: #8a5a00;
  font-size: var(--fs-cap);
  font-weight: 900;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* ---- 皮肤收集条 ---- */
.skin-strip {
  width: 100%;
  background: rgba(255, 255, 255, .92);
  border-radius: 28rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
  box-shadow: var(--clay-card);
}
.skin-strip__head {
  display: flex;
  align-items: center;
  font-size: var(--fs-cap);
  font-weight: 900;
  color: #3a5a80;
}
.skin-strip__prog {
  margin-left: auto;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
  font-weight: 700;
}
.skin-strip__row { display: flex; gap: 12rpx; margin-top: 12rpx; }
.skin-cell {
  flex: 1 1 0;
  height: 88rpx;
  border-radius: 16rpx;
  background: #eaf3fc;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.skin-cell__img { width: 76rpx; height: 76rpx; }
.skin-cell--locked { background: #eef2f8; }
.skin-cell--locked .skin-cell__img { filter: grayscale(1) brightness(.55); }
.skin-cell--next { box-shadow: 0 0 0 4rpx var(--pri); }
.skin-cell__lock { font-size: var(--fs-strong); }

/* ---- Boss 预告卡 ---- */
.boss-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 28rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(120deg, #4a3060, #7a3a5e);
  box-shadow: var(--clay-2);
  color: var(--white);
}
.boss-card__img { width: 110rpx; height: 110rpx; flex: 0 0 auto; }
.boss-card__emoji { font-size: 72rpx; flex: 0 0 auto; }
.boss-card__t { flex: 1; min-width: 0; }
.boss-card__name {
  font-size: var(--fs-strong);
  font-weight: 900;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, .3);
  display: block;
}
.boss-card__sub {
  font-size: var(--fs-cap);
  color: #f0c8e0;
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.boss-card__go { font-size: var(--fs-display); font-weight: 900; opacity: .9; }

/* ---- 对局：战士 VS Boss 双血条 ---- */
.vs-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
}
.vs-side { flex: 1; text-align: center; min-width: 0; }
.vs-ava {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: rgba(255, 255, 255, .15);
  border: 4rpx solid rgba(255, 255, 255, .5);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.vs-ava--boss { border-color: #ffb0d0; }
.vs-ava__img { width: 104rpx; height: 104rpx; }
.vs-name {
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--white);
  margin-top: 6rpx;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, .25);
}
.vs-mid {
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--gold);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, .3);
}
.hp {
  margin-top: 8rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, .25);
  overflow: hidden;
}
.hp__fill { height: 100%; border-radius: 999rpx; }
.hp__fill--me { background: linear-gradient(90deg, var(--green), #4caf50); }
.hp__fill--boss { background: linear-gradient(90deg, #ff8a8a, #f23050); }

/* ---- 结算：下一款皮肤解锁钩子 ---- */
.unlock-bar {
  width: 100%;
  box-sizing: border-box;
  background: linear-gradient(120deg, #fff8e0, #ffedc2);
  border: 3rpx solid var(--gold);
  border-radius: 28rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: var(--clay-1);
}
.unlock-bar__img { width: 88rpx; height: 88rpx; flex: 0 0 auto; }
.unlock-bar__t { flex: 1; min-width: 0; font-size: var(--fs-cap); color: #8a5a00; line-height: 1.5; }
.unlock-bar__t b { font-size: var(--fs-cap); display: block; }

/* ============ 深色模式兜底：已移除（2026-09-12） ============
   背景：这里原先有一段 `@media (prefers-color-scheme: dark)`，只把 page 底色改成近黑 (#12171f)、
   文字改成浅色，但**页面内容（卡片、渐变、按钮、图例）全是按浅色主题设计的，没有任何一套深色适配**。
   后果（真机实测）：18 个「自己没有背景色、依赖 page 底」的页面在深色模式手机上**整片发黑、内容看不清**
   —— 我的 / 成就 / 关卡 / 拼词 / 结算 / 错题本等，而开发者工具默认浅色，本地完全复现不出来。
   结论：对这款卡通教育游戏，**统一浅色主题**才是正确做法（多数页面本身就写死了浅色渐变背景），
   故移除该兜底。将来真要支持深色模式，必须逐页做完整的深色配色（不能只改 page 底），
   并补一条「深色模式截图回归」的用例，否则会重现同样的问题。 */

/* ==========================================================================
   设计令牌 · 唯一真相源（2026-10-28 · D「黏土玩具」方向）
   ==========================================================================

   为什么要有这一块（不是「再加一层规范」，是补上从来没有过的那一层）：
     改版前实测 —— 2115 条色值 / 580 种不同颜色 / 45 档字号 / 24 档圆角 / 6 种页面边距，
     而 `var(--*)` 全站只用过 50 次，**且全部是 JS 注入的动画坐标**（--target-x 等），
     颜色 token 一次都没有被引用过。也就是说：上面那些 --sky1 / --orange 定义了等于没定义，
     每个页面都在自己发明数值。2026-10-09 那份设计文档定过「色值 330 → 24」，
     19 天后实测涨到 580 —— 没有护栏的规范等于不存在。

   本块放在文件末尾，是刻意的：CSS 自定义属性后定义覆盖先定义，
   这样能盖住上面两块 page{} 里遗留的旧值（--ink-sub 等），无需改动老代码。

   使用规则（由 e2e/check-tokens.js 强制，存量按基线豁免、只许降不许升）：
     1. 颜色只准 var(--*)，禁止裸写 #色值
     2. font-size 只准 48 / 38 / 32 / 28 / 24（最小 24rpx，不再有 22rpx 及以下）
     3. border-radius 只准 16 / 28 / 999rpx（另允许 0 与 50% 这两个非圆角语义值）
     4. 阴影只准用 --clay-* 四档，禁止再写「外部硬底边」0 Nrpx 0

   黏土化（D 方向）的核心就是把旧写法 `0 12rpx 0 rgba(...)`（外部硬边，塑料片）
   换成 `inset 0 -12rpx 0 ... + inset 高光 + 外柔影`（内侧厚度，软胶）。
   厚度值可以沿用原值，所以「批量替换」不会改变任何元素的尺寸与布局。
   ========================================================================== */
page {
  /* ---- 文字角色 ---- */
  --ink: #3a3a5c;        /* 主文字（白底/卡片内） */
  --ink-sub: #5c7f9e;    /* 次要文字 */
  --ink-weak: #8a9bb5;   /* 辅助/占位/未解锁 */
  --ink-deep: #2f4a6b;   /* 天空蓝底上的标题。和 --ink 是两个语义：
                            --ink 是紫调深灰（白卡片上），--ink-deep 是蓝调深色（浅蓝天空上）。
                            实测 var(--ink) 在 var(--sky-3) 上会显脏发紫，所以这一档必须单独存在。 */

  /* ---- 品牌 ---- */
  --pri: #ff9a1f;        /* 主操作橙。2026-10-28 由 #ffb703 调深：#ffb703 偏黄，
                            叠白色内高光后两者糊在一起，黏土按钮会失去立体 */
  --pri-deep: #d97c00;   /* 橙的内侧暗面（渐变端/描边，不做文字） */
  --pri-ink: #a26a00;    /* 橙系深色「文字」。星星数、金币数这类白底小字必须用它：
                            --pri-deep 在白底上对比度只有 3.4:1，用于 24rpx 以下会看不清 */
  --sky-1: #4a9fe8;
  --sky-2: #8fcbf7;
  --sky-3: #d8efff;
  --sky-deep: #3b8bd6;   /* 天空渐变深端（年级胶囊等蓝底元素的暗面） */

  /* ---- 功能色 ---- */
  --blue: #4cc9f0;
  --green: #3fbf5f;      /* 由 #7bd389 加深：白字对比度更足（旧值 2.1:1，新值 2.9:1） */
  --pink: #ff5d8f;
  --purple: #b388ff;
  --gold: #ffd166;
  --danger: #ff5a5a;
  --white: #ffffff;

  /* ---- 表面 / 浅底 ----
     2026-10-28 批 6：这一档是「按角色命名」而不是「按色值命名」。
     改之前实测：#eef2f8 / #eef3fa / #eef5fb / #f4f8fd / #e8edf4 … 在屏幕上根本分不出来，
     但它们在 15 个文件里各写各的，于是同一个「卡内浅底」有 13 种写法。
     归并时色值有 2~8/255 的位移，肉眼不可辨；代价换来的是「改一处全站生效」。 */
  --surface: #eef2f8;    /* 卡内浅底 / 幽灵按钮底 / 输入框凹槽 */
  --line: #cfe0ee;       /* 分隔线 / 浅描边（比 --surface 深一档） */

  /* ---- 语义浅底（tint）：状态背景。饱和度极低，只做底、不做文字 ---- */
  --soft-red: #fff0f0;   /* 错误 / 危险底 */
  --soft-green: #e9fbef; /* 正确 / 完成底 */
  --soft-gold: #fff3d6;  /* 高亮 / 奖励底 */

  /* ---- 亮色的「深色文字变体」----
     和 --pri-ink 是同一套思路：同一个色相要两个值 —— 亮色做面（按钮/进度），
     深色做字（白底小字）。只有亮色会导致 24rpx 文字看不清。 */
  --link: #4285f4;       /* 蓝操作色：链接、次级按钮面、进度条 */
  --link-soft: #6aa6f5;  /* 蓝的浅端（与 --link 组成按钮渐变） */
  --link-ink: #2e6fd6;   /* 蓝系文字（白底） */
  --green-ink: #2e8b57;  /* 绿系文字（白底） */
  --danger-ink: #d64545; /* 红系文字（白底） */

  /* ---- 渐变（整段命名，避免逐字重复）---- */
  --link-grad: linear-gradient(135deg, var(--link), var(--link-soft));
  --sky-grad: linear-gradient(180deg, var(--sky-1) 0%, #7dbdf2 32%, #b9e0ff 64%, var(--sky-3) 100%); /* 玩法页 */
  --sky-grad-soft: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);                  /* 内容页 */

  /* ---- 字号（5 档，相邻差 ≥4rpx）----
     2026-10-28：五档全部乘 --fs-scale，为了「三档字号」。
     改之前全站 1013 处 font-size 里有 867 处是写字面值的（且都正好是这五档之一），
     所以先做了收口（794 处换成 var(--fs-*)），再在这里挂倍数 —— 只改 5 行就能让
     全部正文跟着缩放，不用去动 940 处引用。

     倍数怎么生效：utils/font-scale.js 把 `--fs-scale: 1.14` 写进 page-meta 的
     page-style，落在 page 根节点的行内样式上，优先级高于这里的 page{} 规则。
     默认值必须是 1 —— 没有注入 page-meta 的页面（组件、还没接的页）表现完全不变。

     刻意没算进来的：剩下的 73 处 ≥50rpx 的字（200/150/110rpx 这类巨型数字、
     HUD 计量表），它们是版式里的「图形」而不是正文，跟着放大只会把卡片撑破。 */
  --fs-scale: 1;
  --fs-display: calc(48rpx * var(--fs-scale));   /* 结算大标题 / Boss 名 */
  --fs-title: calc(38rpx * var(--fs-scale));     /* 页面标题 / 区块标题 */
  --fs-strong: calc(32rpx * var(--fs-scale));    /* 按钮文字 / 数字 / 小标题 */
  --fs-body: calc(28rpx * var(--fs-scale));      /* 正文（全局默认） */
  --fs-cap: calc(24rpx * var(--fs-scale));       /* 说明 / 标签 / HUD label（最小档） */

  /* ---- 间距（4 档；4rpx 仅用于视觉微调，不入档）---- */
  --sp-1: 8rpx;
  --sp-2: 16rpx;
  --sp-3: 24rpx;
  --sp-4: 32rpx;

  /* ---- 圆角（3 档）---- */
  --r-sm: 16rpx;         /* 小件 / 格子 / 图标底 */
  --r-md: 28rpx;         /* 卡片 / 面板 */
  --r-pill: 999rpx;      /* 按钮 / chip / 标签 / 头像 */

  /* ---- 页面左右边距 ---- */
  --page-x: 32rpx;

  /* ---- 黏土阴影（D 方向核心，四档 + 按压 + 禁用）----
     每档都由三部分组成，缺一不可：
       inset 下暗   = 厚度（替代原来的外部硬底边，所以形状完全不变）
       inset 上亮   = 软胶的顶部高光（黏土质感的来源）
       外部柔影      = 让元素离开页面，而不是贴在上面
     注意：白底元素别用 --clay-1/2/3 —— 白叠白看不出高光，要用 --clay-card。 */
  --clay-1: inset 0 -4rpx 0 rgba(20, 50, 90, .10), inset 0 3rpx 0 rgba(255, 255, 255, .45), 0 3rpx 6rpx rgba(20, 50, 90, .10);
  --clay-2: inset 0 -6rpx 0 rgba(20, 50, 90, .12), inset 0 5rpx 0 rgba(255, 255, 255, .50), 0 6rpx 14rpx rgba(20, 50, 90, .12);
  --clay-3: inset 0 -10rpx 0 rgba(20, 50, 90, .15), inset 0 8rpx 0 rgba(255, 255, 255, .55), 0 14rpx 28rpx rgba(20, 50, 90, .16);
  --clay-card: inset 0 -8rpx 0 rgba(20, 50, 90, .07), 0 8rpx 18rpx rgba(20, 50, 90, .10);
  --clay-press: inset 0 -2rpx 0 rgba(20, 50, 90, .12), inset 0 2rpx 0 rgba(255, 255, 255, .50), 0 2rpx 4rpx rgba(20, 50, 90, .10);
  --clay-off: inset 0 -3rpx 0 rgba(20, 50, 90, .06), inset 0 3rpx 0 rgba(255, 255, 255, .30);

  /* ---- 迁移别名（2026-10-28 起保留，批 5 收口后删除）----
     现存代码引用这些旧名的次数为 0（实测），保留只是为了「万一」和可读性；
     新代码一律用上面的正式名。 */
  --sky1: var(--sky-2);
  --sky2: var(--sky-3);
  --sky-top: var(--sky-1);
  --sky-mid: var(--sky-2);
  --sky-bot: var(--sky-3);
  --orange: var(--pri);
  --cta: var(--pri);
  --cta-deep: var(--pri-deep);
  --win: var(--green);
  --text-sub: var(--ink-sub);
}
