/**
 * app.wxss —— 词力战士全局样式
 *
 * 设计说明：
 *   - 配色取自 HTML 试玩原型（prototype/index.html）的暖色天空卡通风格
 *   - 卡通扁平化：大圆角 + 底部硬阴影（box-shadow 0 Xpx 0）营造「按压感」
 *   - 提供通用按钮 / 卡片 / 背景基线样式，各页面可复用或覆盖
 */

/* ============ 全局基座 ============ */
page {
  /* 卡通配色变量（供各页面引用） */
  --sky1: #7ec8ff;      /* 天空浅蓝 */
  --sky2: #d8efff;      /* 天空更浅蓝 */
  --pink: #ff5d8f;      /* 卡通粉 */
  --orange: #ffb703;    /* 卡通橙 */
  --blue: #4cc9f0;      /* 卡通蓝 */
  --green: #7bd389;     /* 卡通绿 */
  --purple: #b388ff;    /* 卡通紫 */
  --ink: #3a3a5c;       /* 主文字墨色 */
  --text-sub: #5c7f9e;  /* 次要文字 */
  --gold: #ffd166;      /* 星星/成就金 */
  --danger: #ff5a5a;    /* 危险/错误红 */

  /* 暖色天空渐变背景 */
  background: linear-gradient(180deg, #5aa9e6 0%, #a3d5ff 60%, #d8efff 100%);
  background-attachment: fixed;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
  color: #3a3a5c;
  font-size: 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 页面容器（全屏纵向布局） */
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ============ 标题 ============ */
.page-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  margin: 40rpx 0 0;
}

.page-sub {
  color: #5c7f9e;
  font-size: 26rpx;
  letter-spacing: 8rpx;
  margin: 12rpx 0 40rpx;
}

/* ============ 通用按钮（卡通硬阴影风格） ============ */
.btn {
  border: none;
  border-radius: 44rpx;
  font-weight: 900;
  color: #ffffff;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.18), 0 20rpx 40rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}

/**
 * 重置小程序原生 <button> —— 关键修复（2026-09-12 用户反馈「很多按钮里的字靠上」）：
 *
 * 原生 button 自带 `line-height: 2.55555556`（≈46px）；而这里原来写的是 `line-height: inherit`，
 * 父容器没设行高时它会退化成 `normal`。两种情况都会让「设了 height 但没写 line-height」的按钮
 * 里文字贴顶（各页的 .btn-back / .btn-use / .check-pill 等都是这一类）。
 *
 * 统一改成 flex 垂直居中：不论按钮多高、字号多大，文字都在正中。
 * 页面里已经写了 `line-height: <height>` 的按钮不受影响（两者效果一致）。
 */
button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}
button::after {
  border: none;
}

/* 自定义 .btn 风格（去掉原生内边距/外边距，颜色由 .btn-xxx 决定） */
button.btn {
  padding: 0;
  margin: 0;
  background: #ffb703;
}
.btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.18);
}

/* 主按钮（大号，常用于「开始游戏」） */
.btn-primary {
  width: 480rpx;
  height: 128rpx;
  font-size: 44rpx;
  background: #ffb703;
  line-height: 128rpx;
}

/* 次级按钮（颜色可分主题覆写） */
.btn-secondary {
  min-width: 240rpx;
  padding: 0 40rpx;
  height: 88rpx;
  font-size: 32rpx;
  background: #4cc9f0;
  line-height: 88rpx;
}

/* 按钮配色变体（对应原型 .btn-xxx） */
.btn-blue { background: #4cc9f0; }
.btn-purple { background: #b388ff; }
.btn-green { background: #7bd389; }
.btn-pink { background: #ff5d8f; }
.btn-orange { background: #ffb703; }

/* ============ 通用卡片 ============ */
.card {
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.1), 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
  padding: 40rpx;
}

/* ============ 布局辅助 ============ */
/* 页面内按钮/元素之间的垂直间距 */
.menu-gap { margin-top: 32rpx; }

/* 占位内容卡片（骨架期提示后续任务实现） */
.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #8899aa;
  font-size: 30rpx;
  text-align: center;
}

/* ============ 返回按钮 ============ */
.back-btn {
  align-self: flex-start;
  margin: 24rpx 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #3a3a5c;
  font-size: 40rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
}

/* ============ 辅助组件（UI 重设计新增，各页复用） ============ */

/* 软卡片变体：浅底、更轻阴影（用于内嵌信息卡） */
.card--soft {
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06), 0 12rpx 24rpx rgba(0, 0, 0, 0.06);
}

/* 标签 / 徽章（稀有度、成就、签到天数等） */
.tag,
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}
.tag {
  background: rgba(255, 255, 255, 0.85);
  color: #5c7f9e;
}
.badge {
  background: #ffd166;
  color: #6b4e00;
}
.badge--green { background: #7bd389; color: #fff; }
.badge--blue { background: #4cc9f0; color: #fff; }
.badge--pink { background: #ff5d8f; color: #fff; }
.badge--purple { background: #b388ff; color: #fff; }

/* 大 emoji 头像容器（皮肤/吉祥物展示） */
.emoji-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 16rpx 32rpx rgba(0, 0, 0, 0.08);
}
.emoji-avatar text {
  font-size: 96rpx;
  line-height: 1;
}

/* 空态占位（统一风格） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #8899aa;
  font-size: 28rpx;
  text-align: center;
}
.empty-state .empty-emoji {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

/* 进度条（错题本熟练度、成就进度等） */
.progress-bar {
  width: 100%;
  height: 20rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.08);
  overflow: hidden;
}
.progress-bar__fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #4cc9f0, #7bd389);
  transition: width 0.3s ease;
}

/* ============ 深色模式（M6-O 基础） ============
   说明：多数页面在自身 wxss 定义了浅色渐变背景（会覆盖此处 page 背景），
   故此处只做全局文字/默认背景/通用组件的深色兜底；各页面按需自行追加深色覆盖。 */
@media (prefers-color-scheme: dark) {
  page {
    background: #12171f;
    color: #dce4f0;
  }
  .page-sub {
    color: #9fb0c8;
  }
  .placeholder {
    color: #8a9bb5;
  }
  .card--soft {
    background: rgba(31, 41, 51, 0.92);
  }
}
