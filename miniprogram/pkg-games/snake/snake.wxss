/* 单词贪吃蛇（B6-6） */
.page-snake {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--sky-grad);
}/* 目标条 */
.target-bar {
  flex: 0 0 auto;
  background: var(--white); border-radius: 28rpx;
  padding: 16rpx 22rpx; margin-bottom: 14rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: var(--clay-2);
}
.t-emoji { font-size: var(--fs-display); }
.t-main { flex: 1; min-width: 0; }
.t-tip { font-size: var(--fs-cap); color: var(--ink-weak); }
.t-word { font-size: var(--fs-strong); font-weight: 900; color: var(--green-ink); }

/* 目标词卡 + 拼写进度 */
.word-card {
  flex: 0 0 auto;
  background: var(--white); border-radius: 28rpx;
  padding: 18rpx 24rpx 20rpx; margin-bottom: 6rpx;
  box-shadow: var(--clay-2);
}
.wc-top { display: flex; align-items: baseline; gap: 18rpx; }
.wc-en { font-size: var(--fs-display); font-weight: 900; color: var(--green-ink); letter-spacing: 2rpx; }
.wc-zh { font-size: var(--fs-cap); color: var(--ink-weak); }
.wc-progress { display: flex; gap: 10rpx; margin-top: 14rpx; flex-wrap: wrap; }
.wc-ch {
  min-width: 52rpx; height: 56rpx; line-height: 56rpx;
  text-align: center;
  background: var(--surface); color: #b6c2d3;
  border-radius: 16rpx; font-size: var(--fs-strong); font-weight: 900;
}
.wc-ch.on { background: var(--green); color: var(--white); }

/* 触屏控制提示 */
.tap-hint { flex: 0 0 auto; text-align: center; font-size: var(--fs-cap); color: var(--white); opacity: .95; margin: 8rpx 0 6rpx; }

/* 触屏容器：占剩余高度，网格填满 */
.board-touch {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 两侧留出可点触摸带（2026-09-13 用户反馈「贴边时想往边上转点不到」）：
     蛇头在最右/最左列时，朝那一侧的半平面只剩 0 宽，手指没地方点；
     棋盘两侧各让出 36rpx，这块空白同样算「那一侧」。 */
  padding: 0 36rpx;
  box-sizing: border-box;
}
/* 网格 */
.grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 6rpx;
}
.cell {
  aspect-ratio: 1/1;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-cap); font-weight: 900;
  /* 空格子：凹进去的浅格，蛇身/食物才"浮"在板上 */
  background: rgba(255,255,255,.5);
  box-shadow: inset 0 2rpx 4rpx rgba(18,44,78,.10);
  color: var(--ink-sub);
  box-sizing: border-box;
}
.cell.head {
  background: linear-gradient(180deg, #6fd8ff 0%, #35b3e8 100%);
  color: var(--white);
  box-shadow: inset 0 0 0 2rpx var(--white), 0 3rpx 8rpx rgba(18,44,78,.22);
}
.cell.body {
  background: linear-gradient(180deg, #b3e9fb 0%, #86d6f2 100%);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.55);
}
.cell.food-ok {
  background: linear-gradient(180deg, #8fe0a0 0%, #57c374 100%);
  color: var(--white); font-size: var(--fs-body);
  box-shadow: 0 3rpx 8rpx rgba(30,120,60,.28);
}
.cell.food-bad {
  background: linear-gradient(180deg, #ff9cbc 0%, #ff6f9c 100%);
  color: var(--white); font-size: var(--fs-body);
  box-shadow: 0 3rpx 8rpx rgba(160,40,80,.28);
}

.foot-tip { flex: 0 0 auto; text-align: center; font-size: var(--fs-cap); color: var(--ink-sub); opacity: 1; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: var(--white); border-radius: 28rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: var(--pri); letter-spacing: 8rpx; }
.o-title { font-size: var(--fs-display); font-weight: 900; color: var(--ink); margin-top: 10rpx; }
.o-msg { font-size: var(--fs-body); color: var(--ink-weak); margin-top: 10rpx; }
.btn { margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: var(--r-pill); font-size: var(--fs-strong); font-weight: 900; }
.btn.b1 { background: var(--pri); color: var(--white); box-shadow: var(--clay-3); }
.btn.b2 { background: var(--surface); color: var(--ink-sub); }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
