/* 数独页（B6 闯关模式） */
.page-sudoku {
  /* 2026-10-18：删掉 height: 100vh —— 选关视图有 60 关，比一屏长，
     固定高度会让下半部分没有背景（用户反馈「文字超过一页，背景没跟上」）。
     保留 min-height，短内容仍铺满一屏，长内容自然长高、背景跟着走。 */
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--sky-grad);
}/* 关卡列表 */
.intro-card { margin: 20rpx 0; background: var(--white); border-radius: 28rpx; padding: 26rpx; text-align: center; flex: 0 0 auto; }
.intro-emoji { font-size: 64rpx; }
.intro-t { font-size: var(--fs-strong); font-weight: 900; color: var(--ink); margin-top: 8rpx; }
.intro-s { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 8rpx; line-height: 1.6; }

.level-grid {
  flex: 1 1 auto;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx;
  padding: 8rpx 0 24rpx;
}
.lv-node {
  position: relative;
  aspect-ratio: 1/1;
  background: var(--white);
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--clay-2);
}
.lv-node.lock { opacity: .6; background: var(--surface); }
.lv-node.next { outline: 6rpx solid var(--pri); }
.lv-no { font-size: var(--fs-display); font-weight: 900; color: var(--ink); }
.lv-size { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 4rpx; }
.lv-stars { position: absolute; top: 6rpx; right: 10rpx; font-size: var(--fs-cap); color: var(--pri); font-weight: 900; }
/* 锁标放右上角（2026-10-17）：绝对定位不写 top/right 会退回文档流位置，
   正好压在关卡号上（截图里 3/4/5… 全被 🔒 盖住）。 */
.lv-lock { position: absolute; top: 6rpx; right: 10rpx; font-size: var(--fs-cap); }
.lv-node.next .lv-size { color: var(--pri); }

.tip-note { flex: 0 0 auto; text-align: center; font-size: var(--fs-cap); color: var(--ink-sub); opacity: 1; margin: 0 0 8rpx; }

/* HUD 用 app.wxss 的 .hud / .hud-chip */
.hud-back {
  flex: 0 0 auto;
  align-self: center;
  background: rgba(255,255,255,.8);
  color: var(--ink-sub);
  border-radius: 999rpx;
  padding: 6rpx 26rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  margin-bottom: 4rpx;
}

/* 棋盘：占剩余空间，居中自适应 */
.board-wrap { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; min-height: 0; }
.board {
  display: grid;
  gap: 8rpx;
  width: 100%;
  max-height: 100%;
}
/* 用 aspect 方块由 item 尺寸控制——WXML grid-template 已按 n 列，这里只需单元样式。
   棋盘底槽 / 白面材质 / 选中金环来自 app.wxss 的 .b-tray/.b-face/.b-sel（二期统一） */
.cell {
  aspect-ratio: 1/1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 800;
  color: var(--ink);
}
/* 题面给定的数字：压成「印在板上」的凹面，与玩家填的区别开 */
.cell.given {
  background: linear-gradient(180deg, #dde8f4 0%, #cfdcec 100%);
  color: var(--ink-sub);
  box-shadow: inset 0 3rpx 6rpx rgba(18, 44, 78, 0.18);
}
/* 选中 / 填错由 .b-sel 与下面的 .err 负责 */
.cell.err {
  background: linear-gradient(180deg, #ff9cbc 0%, #ff7ba4 100%);
  color: var(--white);
  animation: shake .3s;
}
@keyframes shake { 25% { transform: translateX(-6rpx); } 75% { transform: translateX(6rpx); } }

/* 数字键盘 */
.num-pad {
  flex: 0 0 auto;
  display: grid;
  gap: 14rpx;
  margin: 18rpx 0 12rpx;
}
.num-btn {
  aspect-ratio: 1/1;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--blue);
}
.board-tip { flex: 0 0 auto; text-align: center; font-size: var(--fs-cap); color: var(--ink-sub); opacity: 1; }

/* 结算 */
.settle-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.settle-card { width: 600rpx; background: var(--white); border-radius: 28rpx; padding: 44rpx 36rpx; text-align: center; }
.stars { font-size: 72rpx; letter-spacing: 10rpx; color: var(--pri); }
.s-title { font-size: var(--fs-display); font-weight: 900; color: var(--green-ink); margin-top: 10rpx; }
.s-title.fail { color: var(--danger-ink); }
.s-msg { font-size: var(--fs-body); color: var(--ink-weak); margin-top: 10rpx; }
.s-btns { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.btn-main {
  height: 92rpx; line-height: 92rpx; border-radius: var(--r-pill);
  background: var(--pri); color: var(--white); font-size: var(--fs-strong); font-weight: 900;
  box-shadow: var(--clay-3);
}
.btn-ghost {
  height: 88rpx; line-height: 88rpx; border-radius: var(--r-pill);
  background: var(--surface); color: var(--ink-sub); font-size: var(--fs-strong); font-weight: 800;
}
.btn-main::after, .btn-ghost::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }

/* 2026-10-18：暂停键进 HUD 行，不再需要右侧让位 */
.hud-holder { display: flex; align-items: center; gap: 12rpx; }
.hud-holder > game-hud { flex: 1 1 auto; min-width: 0; }
