/* 华容道 —— 视觉走「词力战士」的卡片语言：深色棋盘底板 + 暖色棋子 + 硬阴影 */
.page-klotski {
  min-height: 100vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #2f3350 0%, #3f4470 60%, #4a4f86 100%);
  display: flex;
  flex-direction: column;
}

/* ============ 顶栏 ============ */
.k-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}
.k-title { font-size: var(--fs-title); font-weight: 900; color: var(--white); text-shadow: 0 4rpx 0 rgba(0, 0, 0, .12); }
.k-chip {
  margin-left: auto;
  background: rgba(255, 255, 255, .9);
  color: var(--ink-sub); font-size: var(--fs-cap); font-weight: 800;
  padding: 10rpx 22rpx; border-radius: 999rpx;
}

/* ============ 选关 ============ */
.k-intro {
  margin: 20rpx 0 12rpx;
  background: rgba(255, 255, 255, .94);
  border-radius: 28rpx;
  padding: 22rpx 26rpx;
}
.ki-t { font-size: var(--fs-strong); font-weight: 900; color: var(--ink); }
.ki-s { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 8rpx; line-height: 1.5; }

.k-group { margin-top: 18rpx; }
.kg-head { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 10rpx; }
.kg-title { font-size: var(--fs-body); font-weight: 900; color: var(--white); }
.kg-count { font-size: var(--fs-cap); font-weight: 800; color: rgba(255, 255, 255, .8); }
.kg-list { display: flex; flex-direction: column; gap: 12rpx; }

.kg-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, .95);
  border-radius: 28rpx;
  padding: 18rpx 22rpx;
  box-shadow: var(--clay-2);
}
.kg-item.locked { opacity: .55; }
.kg-item.classic { border: 3rpx solid var(--pri); }
.kg-no {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  background: var(--surface); color: var(--ink); border-radius: 16rpx;
  font-weight: 900; font-size: var(--fs-body);
}
.kg-name { font-size: var(--fs-body); font-weight: 800; color: var(--ink); }
.kg-meta { margin-left: auto; font-size: var(--fs-cap); color: var(--ink-weak); }
.kg-stars { display: flex; gap: 2rpx; }
.ks { font-size: var(--fs-cap); color: #d8e0ea; }
.ks.on { color: var(--pri); }

/* ============ HUD ============ */
/* 右侧留 84rpx：给右上角固定的暂停按钮让位（见 components/game-pause） */
/* 2026-10-18：暂停键进 HUD 行，右侧不再留 84rpx 让位 */
.k-hud { display: flex; gap: 14rpx; margin: 18rpx 0 12rpx; flex: 0 0 auto; align-items: stretch; }
.kh-box {
  flex: 1;
  background: rgba(255, 255, 255, .94);
  border-radius: 28rpx;
  padding: 12rpx 8rpx;
  text-align: center;
}
.kh-num { font-size: var(--fs-strong); font-weight: 900; color: var(--ink); }
.kh-lab { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 4rpx; }

/* ============ 棋盘 ============ */
.k-board {
  position: relative;
  width: 100%;
  /* 5 行：用屏幕宽度反推高度，保证 4:5 比例 */
  padding-top: 125%;
  flex: 0 0 auto;
  background: rgba(20, 22, 40, .55);
  border-radius: 28rpx;
  box-shadow: inset 0 0 0 6rpx rgba(255, 255, 255, .12);
  margin-top: 6rpx;
  overflow: hidden;
}
.k-cell { position: absolute; width: 25%; height: 20%; box-sizing: border-box; border: 2rpx solid rgba(255, 255, 255, .07); }
.k-cell.gate {
  background: rgba(255, 183, 3, .22);
  border: 4rpx dashed rgba(255, 183, 3, .95);
  border-radius: 16rpx;
  /* 出口要一眼能看见（2026-09-13 用户反馈「出口不明显」）：呼吸式金色发光 */
  animation: k-gate-pulse 1.6s ease-in-out infinite;
}
@keyframes k-gate-pulse {
  0%, 100% { box-shadow: 0 0 0 rgba(255, 183, 3, 0); }
  50% { box-shadow: 0 0 26rpx rgba(255, 183, 3, .8), inset 0 0 20rpx rgba(255, 183, 3, .35); }
}
.k-gate-text {
  position: absolute; left: 0; right: 0; top: 8rpx;
  text-align: center;
  font-size: var(--fs-body); font-weight: 900; color: var(--pri);
  letter-spacing: 2rpx;
  text-shadow: 0 0 12rpx rgba(255, 183, 3, .9);
}
/* 出口指示箭头：贴在出口格底部向下跳，视线一扫就能找到出口 */
.k-gate-arrow {
  position: absolute; left: 0; right: 0; bottom: -4rpx;
  text-align: center;
  font-size: var(--fs-strong); line-height: 1;
  color: var(--pri);
  text-shadow: 0 0 12rpx rgba(255, 183, 3, .95);
  animation: k-gate-arrow 1.2s ease-in-out infinite;
}
@keyframes k-gate-arrow {
  0%, 100% { transform: translateY(0); opacity: .85; }
  50% { transform: translateY(8rpx); opacity: 1; }
}

/* 棋子：外层负责定位（百分比），内层负责外观（留缝） */
.k-piece { position: absolute; box-sizing: border-box; padding: 6rpx; transition: left .12s, top .12s; }
.kp-face {
  width: 100%; height: 100%;
  border-radius: 16rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  font-weight: 900; color: var(--white);
  box-shadow: var(--clay-2);
}
.kp-glyph { font-size: var(--fs-title); line-height: 1; }
.kp-name { font-size: var(--fs-cap); opacity: .9; margin-top: 6rpx; }

/* 曹操：红金，最大最醒目 */
.k-piece.cao .kp-face { background: linear-gradient(160deg, #ff7b7b 0%, var(--pink) 60%, #e9457c 100%); box-shadow: var(--clay-3); }
.k-piece.cao .kp-glyph { font-size: 52rpx; }
/* 竖将：蓝紫系 */
.k-piece.v .kp-face { background: linear-gradient(160deg, #6d7bff 0%, #5b6bf0 100%); box-shadow: var(--clay-2); }
/* 横将：青蓝 */
.k-piece.h .kp-face { background: linear-gradient(160deg, var(--blue) 0%, #35a8d6 100%); box-shadow: var(--clay-2); }
/* 兵：绿 */
.k-piece.s .kp-face { background: linear-gradient(160deg, #8fe39a 0%, #6ac47c 100%); box-shadow: var(--clay-2); }

/* 选中 / 提示 */
.k-piece.on .kp-face { outline: 6rpx solid var(--pri); outline-offset: -4rpx; }
.k-piece.hint .kp-face { animation: kp-pulse 1s ease-in-out infinite; outline: 6rpx solid var(--gold); outline-offset: -4rpx; }
@keyframes kp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(.94); }
}

/* ============ 提示条 / 操作区 ============ */
.k-tip {
  margin-top: 14rpx;
  font-size: var(--fs-cap); color: var(--white); text-align: center;
  background: rgba(255, 255, 255, .14);
  border-radius: 999rpx; padding: 12rpx 20rpx;
}
.k-tip.dim { color: rgba(255, 255, 255, .75); font-size: var(--fs-cap); }

.k-ops { display: flex; gap: 14rpx; margin-top: 14rpx; }
.op {
  flex: 1;
  background: rgba(255, 255, 255, .95);
  border-radius: 28rpx;
  padding: 14rpx 0;
  text-align: center;
  box-shadow: var(--clay-2);
}
.op.off { opacity: .45; }
.op-i { display: block; font-size: var(--fs-strong); }
.op-t { display: block; font-size: var(--fs-cap); color: var(--ink-sub); font-weight: 800; margin-top: 4rpx; }


/* ============ 结算按钮（settle-pop 插槽） ============ */
.s-btns { display: flex; flex-direction: column; gap: 16rpx; width: 100%; }
.s-btn {
  width: 100%; height: 92rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong); font-weight: 900;
  color: var(--ink);
  background: var(--surface);
  box-shadow: var(--clay-2);
}
.s-btn.primary { background: var(--pri); color: var(--white); }
.s-btn.ghost { background: rgba(255, 255, 255, .9); }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 20rpx); }
