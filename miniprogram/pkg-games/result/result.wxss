/* 结算页样式（T16 · UI 重设计）：
   ⭐ 星级弹跳展示 + 白色结算面板 + 2×2 数据卡 + 按压感按钮
   硬阴影 + :active 按压位移（与 avatar 页样板一致） */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== ⭐ 大星级 ===== */
.big-stars {
  display: flex;
  align-items: flex-end;
  height: 110rpx;
  margin-bottom: 28rpx;
}

/* ===== 我的战士（2026-10-08） =====
   赢和输给两种不同的动作：赢了往上蹦一下（回弹曲线，有"爽"感），
   输了往下沉一点、缩一点（垂头丧气）。纯 CSS，不需要新素材。 */
.hero-mood {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}
.hero-mood--win {
  animation: heroWin 1.1s cubic-bezier(.34, 1.56, .64, 1) 1;
}
@keyframes heroWin {
  0%   { transform: translateY(0) scale(.55) rotate(0); }
  55%  { transform: translateY(-28rpx) scale(1.14) rotate(-7deg); }
  100% { transform: translateY(0) scale(1) rotate(0); }
}
.hero-mood--lose {
  animation: heroLose .85s ease-out 1 both;
}
@keyframes heroLose {
  0%   { transform: translateY(-18rpx) scale(1); opacity: 0; }
  100% { transform: translateY(12rpx) scale(.9); opacity: 1; }
}
.big-star {
  font-size: 84rpx;
  line-height: 1;
  margin: 0 8rpx;
  text-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.15);
}
.big-star.on {
  color: var(--gold);
  animation: starPop 0.5s ease both;
}
/* 弹跳登场：依次延迟，营造星星逐个点亮感 */
.big-star.on:nth-child(2) {
  animation-delay: 0.15s;
}
.big-star.on:nth-child(3) {
  animation-delay: 0.3s;
}
.big-star.off {
  color: rgba(255, 255, 255, 0.55);
}
@keyframes starPop {
  0% { transform: scale(0) rotate(-30deg); opacity: 0; }
  60% { transform: scale(1.3) rotate(8deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

/* ===== 结算面板 ===== */
.result-panel {
  width: 620rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 52rpx 40rpx;
  text-align: center;
  box-shadow: var(--clay-3);
  box-sizing: border-box;
}
.res-title {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--ink);
  letter-spacing: 4rpx;
}
.res-title-fail {
  color: var(--pink);
}
.res-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-sub);
}
/* 「差一点」提示：与 settle-pop 的 o-hint 同款，保持两处结算视觉一致 */
.res-hint {
  margin: 18rpx auto 0;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: #FFF6E0;
  color: #A96A00;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-block;
  max-width: 92%;
}

/* ===== 统计数据卡（2×2 网格） ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 36rpx 0 8rpx;
}
.stat-box {
  width: 260rpx;
  border-radius: 28rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--clay-2);
  box-sizing: border-box;
}
.stat-box--blue   { background: rgba(76, 201, 240, 0.14); }
.stat-box--green  { background: rgba(123, 211, 137, 0.18); }
.stat-box--purple { background: rgba(179, 136, 255, 0.16); }
.stat-box--orange { background: rgba(255, 209, 102, 0.25); }

.stat-emoji {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1.2;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
  font-weight: 700;
}

/* ===== 操作按钮 ===== */
/* 2026-10-28 布局修正：3 个 248rpx 按钮 + 24rpx 间距 = 768rpx，
   而结算面板内容区约 540rpx，flex 只能把每个压到 164rpx，
   「下一关 ▶」的文字几乎贴边。改成纵向两行：主操作通栏 + 次操作并排。 */
.res-btns {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 36rpx;
  width: 100%;
}
.res-btns__row {
  display: flex;
  gap: 18rpx;
}
.btn {
  border: none;
  color: var(--white);
  font-weight: 900;
  border-radius: 999rpx;
  box-shadow: var(--clay-3);
  letter-spacing: 4rpx;
  transition: transform 0.12s, box-shadow 0.12s;
}
/* 按压位移（卡通「按压感」） */
.btn:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}
.btn::after {
  border: none;
}
.btn-res {
  width: 100%;
  height: 104rpx;
  font-size: 32rpx;
  line-height: 104rpx;
}
/* 并排时各占一半；min-width:0 让它在长文案下也能收缩，而不是撑破容器 */
.res-btns__row .btn-res {
  flex: 1 1 0;
  min-width: 0;
  font-size: var(--fs-strong);
}
.btn-blue {
  background: var(--blue);
}
.btn-orange {
  background: var(--pri);
}
/* 「下一关」（2026-09-18）：通关后主推按钮 */
.btn-green {
  background: linear-gradient(135deg, #33c07f, #2fa96b);
}

/* ============ 本局错题回顾（R4） ============ */
.wrong-card {
  margin: 28rpx 0 8rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 28rpx;
  background: #fff6f8;
  text-align: left;
}
.wrong-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.wrong-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #c53862;
}
.wrong-count {
  font-size: 24rpx;
  color: #b58a9a;
}
.wrong-item {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--white);
}
.wrong-word {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
}
.wrong-hint {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7b8494;
}
.wrong-ex {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9aa4b4;
}
.wrong-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #a68b98;
  line-height: 1.5;
}

/* 生词本收藏按钮（2026-10-28）
   只加 flex 与右侧固定宽度的小按钮，卡片其余排版不动 ——
   .wrong-item 原本是块级、三个子元素各占一行，加 wrapper 后视觉完全一致。 */
.wrong-item {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
}
.wrong-item__main {
  flex: 1;
  min-width: 0;
}
.fav-btn {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong);
  color: var(--ink-weak);
}
.fav-btn.is-on {
  background: var(--sky-3);
  color: var(--pri);
}
