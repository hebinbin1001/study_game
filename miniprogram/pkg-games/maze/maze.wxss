/* 词义迷宫（数字智力第 11 款）—— 靛蓝石墙主题，与数独（亮蓝）/ 一笔画（青绿）/ 找规律（紫）/ 认钟表（橙）区分 */
page {
  background: linear-gradient(180deg, #3f5b8b 0%, #6d8ab8 30%, #d6e2f2 62%, var(--surface) 100%);
  min-height: 100vh;
}

.page-maze {
  min-height: 100vh;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hud { display: flex; gap: 16rpx; align-items: stretch; }
.chip {
  flex: 1;
  background: var(--white);
  border-radius: 28rpx;
  padding: 12rpx 6rpx;
  text-align: center;
  box-shadow: var(--clay-2);
}
.chip .k { font-size: var(--fs-cap); color: var(--ink-weak); }
.chip .v { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); margin-top: 2rpx; }
.chip .v.hearts { font-size: var(--fs-cap); letter-spacing: 2rpx; }

.bar { height: 12rpx; border-radius: var(--r-pill); background: #dbe6f6; overflow: hidden; flex: 0 0 auto; }
.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #4caf9a, #7bd6a8);
  transition: width 0.25s ease;
}

.banner {
  flex: 0 0 auto;
  background: var(--white);
  border-radius: 28rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  box-shadow: var(--clay-2);
}
.banner .main { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); }
/* 固定两行高：从提示换成"答对了 + 算式"时不跳动 */
.banner .sub {
  margin-top: 4rpx;
  font-size: var(--fs-cap);
  color: #6f83a6;
  line-height: 1.4;
  min-height: 32rpx;
}
.banner.good { background: var(--soft-green); }
.banner.good .main { color: var(--green-ink); }
.banner.good .sub { color: var(--green-ink); }
.banner.bad { background: var(--soft-red); }
.banner.bad .main { color: var(--danger-ink); }
.banner.bad .sub { color: #a85858; }

/* ---------- 棋盘 ---------- */
.board {
  flex: 0 0 auto;
  margin: 0 auto;
  display: grid;
  background: var(--surface);
  border-radius: 28rpx;
  padding: 8rpx;
  box-sizing: content-box;
  box-shadow: var(--clay-3);
}
/* 墙：四边都是 3rpx 实线，通道那条边透明 —— 相邻两格都透明时看起来就是通的 */
.cell {
  position: relative;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cell.wn { border-top-color: var(--ink-deep); }
.cell.we { border-right-color: var(--ink-deep); }
.cell.ws { border-bottom-color: var(--ink-deep); }
.cell.ww { border-left-color: var(--ink-deep); }

/* 走过的格子淡淡留痕：既提示"来过"，又不至于把墙盖住 */
.cell.seen { background: #eef3ff; }
.cell.cur {
  background: var(--soft-gold);
  box-shadow: inset 0 0 0 4rpx var(--pri);
  z-index: 2;
}
.cell.cur .ico { font-size: 54rpx; }
/* 未答的门轻轻呼吸，走到出口时能一眼看到还差哪几道 */
.cell.gate-lock { background: #fff8e8; }
.cell.gate-lock .ico { animation: gatePulse 1.4s ease-in-out infinite; }
@keyframes gatePulse {
  50% { transform: scale(1.12); filter: drop-shadow(0 0 6rpx var(--pri)); }
}

.ico { font-size: var(--fs-display); line-height: 1; }

/* ---------- 答题浮层 ---------- */
.ask-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 100;
  background: rgba(18, 30, 52, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.ask-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.28);
}
.ask-title { font-size: var(--fs-body); color: var(--ink-weak); font-weight: 700; }
.ask-prompt {
  margin-top: 12rpx;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
.ask-word {
  margin-top: 8rpx;
  font-size: 54rpx;
  font-weight: 900;
  color: var(--ink-deep);
  letter-spacing: 2rpx;
  line-height: 1.2;
  word-break: break-word;
}
.ask-opts {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.ask-opt {
  min-height: 96rpx;
  padding: 14rpx 10rpx;
  box-sizing: border-box;
  border: 4rpx solid #eef2fa;
  border-radius: 28rpx;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  font-weight: 900;
  color: var(--ink-deep);
  line-height: 1.35;
  text-align: center;
  word-break: break-word;
}
.ask-opt.ok {
  background: var(--soft-green);
  border-color: var(--green);
  color: var(--green-ink);
}
.ask-opt.bad {
  background: var(--soft-red);
  border-color: #f2635f;
  color: var(--danger-ink);
}
.ask-tip {
  margin-top: 18rpx;
  font-size: var(--fs-cap);
  color: #8ba0c0;
  min-height: 30rpx;
}
.ask-tip.good { color: var(--green-ink); font-weight: 700; }
.ask-tip.bad { color: var(--danger-ink); font-weight: 700; }

.foot {
  flex: 0 0 auto;
  text-align: center;
  font-size: var(--fs-cap);
  color: #43587c;
  opacity: 0.9;
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
