/* 字母拼词工坊样式：晴空蓝 + 字母格子（与成语拼字的暖橙区分开） */
page {
  background: linear-gradient(180deg, #5aa9e6 0%, #a8d8f5 38%, var(--sky-3) 70%, #eef8ff 100%);
  min-height: 100vh;
}
.page-word-build {
  min-height: 100vh;   /* 同上：根容器撑满，.slots 的 flex:1 才能吃到剩余空间 */
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prompt {
  background: var(--white);
  border-radius: 28rpx;
  padding: 30rpx 24rpx;
  text-align: center;
  box-shadow: var(--clay-3);
}
.prompt .label { font-size: var(--fs-cap); color: #7a8896; }
.prompt .cn {
  font-size: 54rpx;
  font-weight: 900;
  color: #1d3550;
  margin: 10rpx 0 6rpx;
  line-height: 1.3;
}
.prompt .meta { font-size: var(--fs-cap); color: #6b7a89; }

.slots {
  /* 字母槽区占据剩余空间并居中（原来内容顶在上半屏，下面一片空） */
  flex: 1 1 auto;
  align-content: center;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
.slot {
  width: 84rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: var(--white);
  border: 4rpx dashed #b8d6f0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-display);
  font-weight: 900;
  color: #2f6fd0;
  box-shadow: var(--clay-2);
}
.slot.filled { border-style: solid; border-color: #9fc9ee; background: #eef7ff; }
.slot.hinted { background: #fff6dd; border-color: var(--gold); color: var(--pri-ink); }
.slots.ok .slot { background: var(--soft-green); border-color: var(--green); color: var(--green-ink); }
.slots.bad { animation: shake 0.42s ease; }
.slots.bad .slot { background: #ffe2ea; border-color: #ff9fb8; color: #c53862; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.poolWrap {
  background: rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
}
.pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}
.tile {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: var(--white);
  color: #1d3550;
  font-size: var(--fs-title);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--clay-2);
  transition: transform 0.1s ease, opacity 0.2s ease;
}
.tile:active { transform: translateY(4rpx); }
.tile.used { opacity: 0.25; transform: scale(0.94); }

.foot { display: flex; gap: 16rpx; margin-top: 4rpx; }
.back { display: flex; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong);
  font-weight: 800;
  background: var(--link);
  color: var(--white);
  box-shadow: var(--clay-2);
}
.btn:active { transform: translateY(4rpx); }
.btn.ghost {
  background: var(--white);
  color: var(--link);
  box-shadow: var(--clay-2);
}
.btn.wide { width: 100%; }
