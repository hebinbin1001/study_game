/* 汉诺塔（数字智力第 12 款 · 6 关小品）—— 珊瑚粉主题，与其余数字玩法区分 */
page {
  background: linear-gradient(180deg, #d94f85 0%, #f28ab0 30%, #ffd9e6 62%, #fff5f8 100%);
  min-height: 100vh;
}

.page-hanoi {
  min-height: 100vh;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hud { display: flex; gap: 16rpx; align-items: stretch; }
.chip {
  flex: 1;
  background: var(--white);
  border-radius: 28rpx;
  padding: 12rpx 6rpx;
  text-align: center;
  box-shadow: var(--clay-2);
}
.chip .k { font-size: var(--fs-cap); color: #b57a92; }
.chip .v { font-size: var(--fs-strong); font-weight: 900; color: #b03a68; margin-top: 2rpx; }

.banner {
  flex: 0 0 auto;
  background: var(--white);
  border-radius: 28rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  box-shadow: var(--clay-2);
}
.banner .main { font-size: var(--fs-strong); font-weight: 900; color: #b03a68; }
.banner .sub {
  margin-top: 4rpx;
  font-size: var(--fs-cap);
  color: #a6788a;
  line-height: 1.4;
  min-height: 32rpx;
}
.banner.good { background: var(--soft-green); }
.banner.good .main { color: var(--green-ink); }
.banner.good .sub { color: var(--green-ink); }
.banner.bad { background: var(--soft-red); }
.banner.bad .main { color: var(--danger-ink); }
.banner.bad .sub { color: #a85858; }

/* ---------- 三根柱子 ---------- */
.tower {
  flex: 1 1 auto;
  min-height: 420rpx;
  display: flex;
  /* 2026-10-18：原来 align-items:flex-end + .peg height:100%，百分比高度在 flex 子项里
     算不出确定值 → 柱子 .rod 的 height:calc(100%-40rpx) 变成 0，整块题板看着是空白的。
     改为 stretch + .rod 用 top/bottom 定位，柱子在任何屏幕尺寸下都能画出来。 */
  align-items: stretch;
  gap: 6rpx;
  padding: 8rpx 6rpx 10rpx;
  background: var(--white);
  border-radius: 28rpx;
  box-shadow: var(--clay-3);
}
.peg {
  position: relative;
  flex: 1;
  /* 高度交给父级 stretch（见 .tower 注释），不再写 height:100% */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 14rpx;
}
/* 柱子本体：绝对定位在盘子后面，底部对齐底座 */
.rod {
  position: absolute;
  bottom: 14rpx;
  top: 40rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  /* 用 top/bottom 撑满（不再用百分比 height，flex 子项里不可靠） */
  border-radius: 16rpx 16rpx 0 0;
  background: linear-gradient(180deg, #d9a06a, #8a5a34);
}
.base {
  width: 100%;
  height: 18rpx;
  border-radius: var(--r-pill);
  background: #8a5a34;
  box-shadow: var(--clay-2);
  z-index: 2;
}
/* 盘子：column-reverse 让数组第一个（最大的盘）落在最底下 */
.disks {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  gap: 5rpx;
  width: 100%;
}
.disk {
  height: 36rpx;
  border-radius: var(--r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-cap);
  font-weight: 900;
  color: var(--white);
  box-shadow: var(--clay-1);
  transition: transform 0.12s ease;
}
.peg.sel .rod { background: linear-gradient(180deg, var(--gold), #e0a020); }
/* 选中的柱子把顶部盘抬起来：明确"拿在手上的是哪一个" */
.peg.sel .disk.top {
  transform: translateY(-18rpx);
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.22);
}
.peg-no {
  position: absolute;
  /* 放在柱子顶端：原来贴底（bottom:-6rpx）会被题板的 padding 裁掉一半 */
  top: 6rpx;
  font-size: var(--fs-cap);
  font-weight: 900;
  color: #d8a2b6;
}

/* ---------- 操作 ---------- */
.ops {
  flex: 0 0 auto;
  display: flex;
  gap: 20rpx;
}
.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 28rpx;
  background: var(--white);
  color: #b03a68;
  font-size: var(--fs-body);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--clay-2);
}

.foot {
  flex: 0 0 auto;
  text-align: center;
  font-size: var(--fs-cap);
  color: #8e4f68;
  opacity: 0.9;
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
