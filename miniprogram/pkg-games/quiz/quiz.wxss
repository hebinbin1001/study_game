/* 限时抢答（2026-09-19）—— 浅色卡通风，尺寸全用 rpx */

.page-quiz {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 22rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--sky-grad);
}

/* ============ 顶部 HUD ============ */
.qz-hud {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.qz-back {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-sub);
  font-size: var(--fs-title);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--clay-2);
}
.qz-timer {
  position: relative;
  flex: 1 1 auto;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, .06);
}
.qz-timer-fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, #6fcf97, var(--green));
  transition: width .9s linear, background .3s;
}
.qz-timer-fill.danger { background: linear-gradient(90deg, #ff9f6b, var(--danger)); }
.qz-timer-text {
  position: relative;
  z-index: 1;
  height: 56rpx;
  line-height: 56rpx;
  padding-left: 20rpx;
  font-size: var(--fs-cap);
  font-weight: 900;
  color: var(--ink-deep);
}
.qz-stats { flex: 0 0 auto; display: flex; align-items: center; gap: 8rpx; }
.qz-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--ink-sub);
}
.qz-combo { color: var(--pri-deep); }

.qz-label {
  flex: 0 0 auto;
  margin-top: 14rpx;
  align-self: center;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .85);
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--link-ink);
}

/* ============ 题干 ============ */
.qz-stem-card {
  flex: 0 0 auto;
  margin-top: 26rpx;
  padding: 40rpx 30rpx;
  border-radius: 28rpx;
  background: var(--white);
  text-align: center;
  box-shadow: var(--clay-3);
}
.qz-stem-label {
  font-size: var(--fs-cap);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--ink-weak);
}
.qz-stem {
  margin-top: 16rpx;
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--ink-deep);
  line-height: 1.4;
  word-break: break-all;
}

.qz-feedback {
  flex: 0 0 auto;
  margin-top: 18rpx;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 900;
  animation: qzPop .4s cubic-bezier(.34, 1.56, .64, 1);
}
.qz-feedback.ok { color: var(--green); }
.qz-feedback.bad { color: var(--danger); }
@keyframes qzPop {
  0% { transform: scale(.5); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ============ 选项 ============ */
.qz-options {
  flex: 1 1 auto;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
}
.qz-opt {
  min-height: 108rpx;
  padding: 18rpx 26rpx;
  border-radius: 28rpx;
  background: var(--white);
  border: 3rpx solid #dfeaf5;
  font-size: var(--fs-strong);
  font-weight: 800;
  color: var(--ink-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  word-break: break-all;
  box-shadow: var(--clay-2);
  transition: transform .12s, border-color .2s, background .2s;
}
.qz-opt:active { transform: translateY(4rpx); box-shadow: var(--clay-1); }
.qz-opt.ok {
  background: var(--soft-green);
  border-color: var(--green);
  color: #1f7a4d;
}
.qz-opt.bad {
  background: var(--soft-red);
  border-color: var(--danger);
  color: #c0394f;
}

.qz-tip {
  flex: 0 0 auto;
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
