.lb-page {
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 12rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
  color: #203d5b;
  background:
    radial-gradient(circle at 12% 9%, rgba(255,255,255,.58), transparent 21%),
    linear-gradient(180deg, #3f93df 0%, #80c9f1 44%, #dff4ff 100%);
}

.lb-hud {
  flex: none;
  min-height: 72rpx;
  padding: 8rpx 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid rgba(255,255,255,.32);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(20,75,116,.25), rgba(24,85,126,.1));
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.26);
}
.lb-chip {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  color: #31536f;
  background: rgba(255,255,255,.94);
  box-shadow: var(--clay-1);
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}
.lb-lives {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #ff5f69;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
}
.lb-combo {
  color: #b56b00;
  background: #fff4d0;
}

.lb-target {
  flex: none;
  position: relative;
  overflow: hidden;
  padding: 14rpx 18rpx 12rpx;
  border: 2rpx solid rgba(255,255,255,.8);
  border-radius: 28rpx;
  background: rgba(255,255,255,.95);
  box-shadow: var(--clay-2);
}
.lb-target::after {
  content: "";
  position: absolute;
  right: -34rpx;
  bottom: -54rpx;
  width: 180rpx;
  height: 140rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(91,192,239,.16), transparent 66%);
  pointer-events: none;
}
.lb-target-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #7c91a4;
  font-size: 24rpx;
  font-weight: 800;
}
.lb-stage {
  max-width: 72%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.lb-count {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #2f6898;
  background: #e6f5ff;
}
.lb-target-main {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 7rpx;
}
.lb-word {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
  color: #176276;
  font-family: "Trebuchet MS", "Arial Rounded MT Bold", sans-serif;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  line-height: 1.05;
}
.lb-word.word-long {
  font-size: 48rpx;
  letter-spacing: 1rpx;
}
.lb-word.word-xl {
  font-size: 38rpx;
  letter-spacing: 0;
}
.lb-letter {
  flex: none;
  text-shadow: 0 3rpx 0 #cdebf0;
}
.lb-letter.is-blank {
  min-width: 30rpx;
  color: #df9411;
  text-align: center;
  animation: lb-blank 1.1s ease-in-out infinite;
}
.lb-letter.is-solved {
  color: #1d8b68;
  animation: lb-solved .44s ease;
}
@keyframes lb-blank {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .55; transform: scale(.9); }
}
@keyframes lb-solved {
  0% { transform: scale(.55); opacity: .2; }
  70% { transform: scale(1.22); }
  100% { transform: scale(1); }
}
.lb-meaning {
  flex: none;
  max-width: 42%;
  text-align: right;
}
.lb-meaning-main {
  display: block;
  color: #294d68;
  font-size: 32rpx;
  font-weight: 900;
}
.lb-ipa {
  display: block;
  margin-top: 3rpx;
  color: #8ca1b2;
  font-size: 24rpx;
  white-space: nowrap;
}
.lb-clue {
  margin-top: 7rpx;
  color: #879aab;
  font-size: 24rpx;
  font-weight: 700;
}
.lb-clue--good { color: #16805e; }
.lb-clue--danger { color: #c44c58; }

.lb-arena {
  position: relative;
  flex: 1 1 auto;
  min-height: 570rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255,255,255,.66);
  border-radius: 28rpx;
  background:
    radial-gradient(ellipse at 50% 41%, rgba(255,236,157,.62), transparent 30%),
    radial-gradient(circle at 50% 87%, rgba(255,255,255,.5), transparent 19%),
    linear-gradient(180deg, rgba(42,128,194,.46), rgba(184,230,250,.72) 64%, rgba(238,252,255,.76));
  box-shadow: var(--clay-2);
  touch-action: none;
}
.lb-arena::before,
.lb-arena::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 55%;
  border: 2rpx solid rgba(255,255,255,.18);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.lb-arena::before {
  width: 620rpx;
  height: 340rpx;
}
.lb-arena::after {
  width: 430rpx;
  height: 240rpx;
}
.lb-orbit {
  position: absolute;
  left: 50%;
  top: 45%;
  z-index: 1;
  border: 2rpx dashed rgba(255,255,255,.24);
  border-radius: 50%;
  pointer-events: none;
  transform: translate(-50%, -50%);
}
.orbit-one {
  width: 520rpx;
  height: 290rpx;
}
.orbit-two {
  width: 370rpx;
  height: 205rpx;
  border-style: solid;
  border-color: rgba(255,255,255,.12);
}
.orbit-three {
  width: 650rpx;
  height: 390rpx;
  border-color: rgba(255,255,255,.1);
}

.lb-boss {
  position: absolute;
  left: 50%;
  top: 45%;
  z-index: 2;
  width: 340rpx;
  height: 285rpx;
  transform: translate(-50%, -52%);
  transition: transform .2s ease;
}
.lb-boss::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 54%;
  width: 300rpx;
  height: 210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,232,128,.32), transparent 68%);
  transform: translate(-50%, -50%);
}
.boss-phase-2 .lb-boss {
  transform: translate(-50%, -52%) scale(1.06);
}
.boss-phase-3 .lb-boss {
  transform: translate(-50%, -52%) scale(1.12);
}
.lb-boss.is-countering {
  z-index: 8;
  transition: none;
  animation: lb-boss-counter .5s cubic-bezier(.28,.82,.22,1) both;
}
.lb-boss.is-hit {
  animation: lb-boss-hit .34s ease-out;
}
.lb-boss-art,
.lb-boss-emoji {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 300rpx;
  height: 238rpx;
  transform: translateX(-50%);
  filter: drop-shadow(0 12rpx 10rpx rgba(30,65,91,.16));
}
.lb-boss-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 150rpx;
}
.boss-phase-2 .lb-boss-art,
.boss-phase-2 .lb-boss-emoji {
  filter: hue-rotate(22deg);
}
.boss-phase-3 .lb-boss-art,
.boss-phase-3 .lb-boss-emoji {
  filter: hue-rotate(310deg) saturate(1.2);
}
.lb-boss-core {
  position: absolute;
  left: 50%;
  top: 118rpx;
  width: 210rpx;
  height: 80rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(255,225,106,.34), transparent 70%);
  pointer-events: none;
}
.lb-boss-status {
  position: absolute;
  z-index: 5;
  left: 50%;
  top: 12rpx;
  width: 390rpx;
  padding: 8rpx 12rpx 9rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255,255,255,.26);
  border-radius: 16rpx;
  background: rgba(19,72,110,.34);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.2);
  backdrop-filter: blur(8rpx);
  transform: translateX(-50%);
}
.lb-boss-hp {
  position: relative;
  width: 100%;
  height: 16rpx;
  margin-top: 5rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255,255,255,.85);
  border-radius: 999rpx;
  background: rgba(30,63,88,.46);
}
.lb-boss-hp-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ffc34d, #ff6b67);
  transition: width .38s ease;
}
.lb-boss-title {
  display: flex;
  justify-content: space-between;
  color: var(--white);
  font-size: 24rpx;
  font-weight: 900;
  text-shadow: 0 2rpx 5rpx rgba(30,64,93,.6);
}

.lb-bubble {
  position: absolute;
  z-index: 4;
  width: 88rpx;
  height: 88rpx;
  margin: -44rpx 0 0 -44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255,255,255,.92);
  border-radius: 50%;
  color: var(--white);
  box-shadow: var(--clay-2);
  font-family: "Trebuchet MS", sans-serif;
  font-size: 38rpx;
  font-weight: 900;
  text-shadow: 0 2rpx 3rpx rgba(28,68,99,.2);
  transition: transform .12s ease, box-shadow .12s ease;
}
.lb-bubble::after {
  content: "";
  position: absolute;
  left: 19%;
  top: 13%;
  width: 27%;
  height: 17%;
  border-radius: 50%;
  background: rgba(255,255,255,.72);
  transform: rotate(-28deg);
  pointer-events: none;
}
.tone-0 { background: #ff8b68; }
.tone-1 { background: #4caee9; }
.tone-2 { background: #62c894; }
.tone-3 { background: #a888ee; }
.tone-4 { background: #eab436; }
.tone-5 { background: #ed789d; }
.tone-6 { background: #4bc5bf; }
.tone-7 { background: #d68ce7; }
.tone-8 { background: #ed9c55; }
.lb-bubble.is-aimed {
  transform: scale(1.17);
  box-shadow: 0 0 0 9rpx rgba(255,243,128,.55), inset -8rpx -9rpx 0 rgba(20,68,105,.1);
}
.lb-bubble.is-blast {
  animation: lb-blast .5s ease forwards;
}
.lb-bubble.is-reject {
  animation: lb-reject .5s ease;
}
@keyframes lb-blast {
  0% { transform: scale(1); }
  45% { transform: scale(1.48); opacity: 1; }
  100% { transform: scale(.1); opacity: 0; }
}
@keyframes lb-reject {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-13rpx) rotate(-8deg); }
  70% { transform: translateX(13rpx) rotate(8deg); }
}

.lb-aim-line {
  position: absolute;
  z-index: 3;
  left: 50%;
  bottom: 135rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(255,255,255,.22), rgba(255,244,139,.95));
  transform-origin: 0 50%;
  pointer-events: none;
}
.lb-impact {
  position: absolute;
  z-index: 6;
  width: 34rpx;
  height: 34rpx;
  margin: -17rpx 0 0 -17rpx;
  border-radius: 50%;
  background: #fff3a0;
  box-shadow: 0 0 26rpx 12rpx rgba(255,231,101,.55);
  animation: lb-impact .5s ease forwards;
  pointer-events: none;
}
.lb-impact.wrong {
  background: #ff6d72;
  box-shadow: 0 0 26rpx 12rpx rgba(255,75,84,.45);
}
@keyframes lb-impact {
  0% { transform: scale(.3); opacity: 0; }
  35% { transform: scale(1.7); opacity: 1; }
  100% { transform: scale(2.3); opacity: 0; }
}

.lb-warrior {
  position: absolute;
  left: 50%;
  bottom: 9rpx;
  z-index: 3;
  width: 170rpx;
  height: 205rpx;
  transform: translateX(-50%);
  pointer-events: none;
}
.lb-warrior.is-attacking {
  z-index: 9;
  animation: lb-warrior-strike .62s cubic-bezier(.2,.82,.2,1) both;
}
.lb-warrior.is-finishing {
  animation-duration: .86s;
}
.lb-warrior.is-hurt {
  animation: lb-warrior-hurt .34s .1s both;
}
.lb-warrior::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 3rpx;
  width: 146rpx;
  height: 36rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255,255,255,.82), transparent);
  transform: translateX(-50%);
}
.lb-warrior-art,
.lb-warrior-emoji {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 166rpx;
  height: 188rpx;
  transform: translateX(-50%);
}

@keyframes lb-warrior-strike {
  0% { transform: translate(-50%, 0) scale(1); }
  14% { transform: translate(-50%, 8rpx) scale(.94); }
  56% {
    transform: translate(
      calc(-50% + var(--strike-x)),
      var(--strike-y)
    ) scale(1.08);
  }
  70% {
    transform: translate(
      calc(-50% + var(--strike-x)),
      var(--strike-y)
    ) scale(1.12) rotate(-4deg);
  }
  100% { transform: translate(-50%, 0) scale(1); }
}
@keyframes lb-boss-counter {
  0% { transform: translate(-50%, -52%) scale(1); }
  18% { transform: translate(-50%, -58%) scale(1.08); }
  60% {
    transform: translate(
      calc(-50% + var(--counter-x)),
      calc(-52% + var(--counter-y))
    ) scale(.9) rotate(4deg);
  }
  74% {
    transform: translate(
      calc(-50% + var(--counter-x)),
      calc(-52% + var(--counter-y))
    ) scale(.94) rotate(-3deg);
  }
  100% { transform: translate(-50%, -52%) scale(1); }
}
@keyframes lb-warrior-hurt {
  0%, 100% { transform: translate(-50%, 0) rotate(0); filter: none; }
  35% { transform: translate(-50%, 13rpx) rotate(-9deg); filter: brightness(1.55) saturate(.7); }
  70% { transform: translate(-50%, -4rpx) rotate(5deg); }
}
@keyframes lb-boss-hit {
  0% { filter: brightness(1); }
  35% { filter: brightness(2.1) saturate(.45); }
  100% { filter: brightness(1); }
}
.lb-warrior-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  filter: drop-shadow(0 8rpx 6rpx rgba(25,67,98,.15));
}
.lb-launch-pad {
  position: absolute;
  left: 50%;
  bottom: 34rpx;
  z-index: 2;
  width: 205rpx;
  height: 54rpx;
  border: 3rpx solid rgba(255,255,255,.56);
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255,255,255,.56), rgba(87,185,229,.16) 57%, transparent 72%);
  box-shadow: 0 0 24rpx rgba(89,199,237,.24);
  transform: translateX(-50%);
  pointer-events: none;
}
.lb-toast {
  position: absolute;
  left: 50%;
  top: 27%;
  z-index: 9;
  max-width: 88%;
  padding: 10rpx 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  color: var(--white);
  background: rgba(22,55,82,.92);
  box-shadow: 0 7rpx 16rpx rgba(21,61,93,.2);
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
  text-overflow: ellipsis;
  transform: translateX(-50%);
}
.lb-toast.good { background: rgba(28,137,109,.95); }
.lb-toast.bad { background: rgba(202,66,75,.95); }

.lb-guide {
  flex: none;
  min-height: 66rpx;
  padding: 9rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,.9);
  box-shadow: var(--clay-1);
}
.lb-guide-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #486b87;
  font-size: 24rpx;
  font-weight: 800;
}
.lb-guide-ico {
  color: #327dc2;
  font-size: 28rpx;
  font-weight: 900;
}
.lb-guide-sep {
  width: 2rpx;
  height: 28rpx;
  background: #dceaf4;
}

.lb-loading {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17,47,71,.46);
}
.lb-loading-card {
  padding: 20rpx 34rpx;
  border-radius: 28rpx;
  color: #315571;
  background: var(--white);
  box-shadow: var(--clay-3);
  font-size: 28rpx;
  font-weight: 900;
}

@media (max-height: 660px) {
  .lb-page { gap: 7rpx; padding-top: 7rpx; }
  .lb-hud { min-height: 58rpx; }
  .lb-target { padding-top: 10rpx; padding-bottom: 8rpx; }
  .lb-word { font-size: 50rpx; }
  .lb-arena { min-height: 500rpx; }
  .lb-guide { min-height: 54rpx; }
}
