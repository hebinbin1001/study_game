<!-- 成语拼字（玩法落地：demo g3）：看释义把字块拼成四字成语，字块里有干扰字 -->
<page-meta page-style="{{fsStyle}}" />

<view class="page-idiom-build">

  <game-hud lives="{{lives}}" score="{{score}}" scoreText="{{scoreText}}" extra="{{hudText}}" />

  <view class="prompt">
    <view class="label">{{promptLabel}}</view>
    <view class="hint">{{prompt}}</view>
    <view class="meta">{{meta}}</view>
  </view>

  <view class="slots {{slotsCls}}">
    <view
      wx:for="{{slots}}"
      wx:key="index"
      class="slot {{item.filled ? 'filled' : ''}} {{item.cls}}"
      data-idx="{{index}}"
      catchtap="tapSlot">{{item.ch}}</view>
  </view>

  <view class="poolWrap">
    <view class="pool">
      <view
        wx:for="{{tiles}}"
        wx:key="index"
        class="tile {{item.used ? 'used' : ''}}"
        data-idx="{{index}}"
        catchtap="tapTile">{{item.ch}}</view>
    </view>
  </view>

  <view class="foot">
    <view class="btn ghost" bindtap="onHint">💡 提示首字</view>
  </view>

  <battle-fx trigger="{{fxSeq}}" mode="{{fxMode}}" text="{{fxText}}" />

  <settle-pop
    visible="{{settle}}" win="{{win}}" starsText="{{starsText}}"
    title="{{win ? '本局完成' : '生命用完了'}}" msg="{{overMsg}}"
    hint="{{hintText}}"
    showNext="{{showNext}}" bind:retry="onRetry" bind:next="onNext" />
</view>



<!-- 首次进入的操作引导（2026-10-28）：每款玩法只弹一次，文案在 utils/game-howto.js。
     放在页面最外层，组件自身 fixed 定位，不影响任何已有布局。 -->
<how-to-play game="idiombuild" />
