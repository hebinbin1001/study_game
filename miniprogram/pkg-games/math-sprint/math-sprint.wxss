/* 口算冲刺样式：暖橙渐变 + 大字号题目 + 2×2 大按钮（触屏友好） */
page {
  background: linear-gradient(180deg, #ff7a59 0%, #ffa07a 30%, #ffd3bf 64%, #fff2ea 100%);
  min-height: 100vh;
}
.page-sprint {
  /* 根容器必须撑满视口，子块的 flex:1 才有剩余空间可分（原来只有 page{} 带 min-height） */
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.track {
  height: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(120, 50, 20, 0.12);
}
.fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--pri), #ff7a59);
  transition: width 0.12s linear;
}
.fill.low { background: linear-gradient(90deg, #ff5252, #d32f2f); }

.timerow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
}
.time {
  font-size: 48rpx;
  font-weight: 900;
  color: #a33517;
  font-variant-numeric: tabular-nums;
}
.time.low { color: #e53935; }
.mult {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--white);
  background: rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.stage {
  /* 题目卡占据剩余空间并居中：原来内容全顶在上半屏、下半屏空着 */
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: var(--white);
  border-radius: 28rpx;
  padding: 46rpx 24rpx;
  text-align: center;
  box-shadow: var(--clay-3);
}
.expr {
  font-size: 76rpx;
  font-weight: 900;
  color: #a33517;
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.qm { color: #d9b3a6; }

.answers {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.ans {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 40rpx 0;
  text-align: center;
  border-radius: 28rpx;
  background: var(--white);
  color: #a33517;
  font-size: 52rpx;
  font-weight: 900;
  box-shadow: var(--clay-3);
  transition: transform 0.1s ease, background 0.16s ease;
}
.ans:active { transform: translateY(4rpx); }
.ans.ok { background: var(--green); color: var(--white); }
.ans.bad { background: var(--pink); color: var(--white); }

.foot { display: flex; margin-top: 6rpx; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: 32rpx;
  font-weight: 800;
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.86);
  color: #c2571f;
  box-shadow: var(--clay-2);
}

/* 2026-10-18：暂停键进 HUD 行，不再需要右侧让位 */
.hud-holder { display: flex; align-items: center; gap: 12rpx; }
.hud-holder > game-hud { flex: 1 1 auto; min-width: 0; }
