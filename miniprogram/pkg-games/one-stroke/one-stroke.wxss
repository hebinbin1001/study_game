/* 一笔画样式：青绿 + 绝对定位的线/圆点棋盘（不用 Canvas，坐标由引擎算） */
page {
  background: linear-gradient(180deg, #12a08c 0%, #7fd0c8 34%, #cdeadf 68%, #f2fbf8 100%);
  min-height: 100vh;
}
.page-one-stroke {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hud { display: flex; gap: 16rpx; }
.chip {
  flex: 1;
  background: var(--white);
  border-radius: 28rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  box-shadow: var(--clay-2);
}
.chip .k { font-size: var(--fs-cap); color: #7f9c97; }
.chip .v { font-size: var(--fs-strong); font-weight: 900; color: #16695e; margin-top: 4rpx; }

.banner {
  background: var(--white);
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  text-align: center;
  box-shadow: var(--clay-3);
}
.banner .main { font-size: var(--fs-strong); font-weight: 900; color: #16695e; }
.banner .sub { margin-top: 8rpx; font-size: var(--fs-cap); color: #6b8b86; min-height: 34rpx; }
.banner.warn .main { color: #d97706; }

/* 进度条（demo 顶部那条）：已走线 / 总边数 */
.bar {
  margin-top: 14rpx;
  height: 12rpx;
  border-radius: var(--r-pill);
  background: #e6f0ee;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #7fe0a8, #12a08c);
  transition: width 0.25s ease;
}

.board {
  background: var(--white);
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
  box-shadow: var(--clay-3);
}
.canvas { position: relative; width: 600rpx; height: 600rpx; }

.edge {
  position: absolute;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: var(--r-pill);
  background: #c3d6d3;
  transform-origin: 0 50%;
  transition: background 0.16s ease;
}
.edge.used {
  background: var(--green-ink);
  box-shadow: 0 0 12rpx rgba(52, 168, 83, 0.45);
}
/* 提示线：黄色呼吸，1.6 秒后自动消失（demo 的 hintEdge） */
.edge.hint {
  background: var(--gold);
  box-shadow: 0 0 20rpx rgba(251, 191, 36, 0.85);
  animation: hintPulse 0.7s ease-in-out infinite;
}
@keyframes hintPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.node {
  position: absolute;
  width: 84rpx;
  height: 84rpx;
  margin-left: -42rpx;
  margin-top: -42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.node .dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--white);
  border: 6rpx solid #12a08c;
  box-sizing: border-box;
  transition: all 0.14s ease;
}
.node.visited .dot { background: #12a08c; }
/* 起手提示：奇点镀金圈（连奇数条线的点只能当起点/终点） */
.node.odd .dot {
  border-color: var(--gold);
  box-shadow: 0 0 0 8rpx rgba(251, 191, 36, 0.25), 0 0 20rpx rgba(251, 191, 36, 0.7);
}
.node.cur .dot {
  width: 46rpx;
  height: 46rpx;
  background: var(--pri);
  border-color: #e08a00;
  box-shadow: 0 0 16rpx rgba(255, 159, 28, 0.6);
}

/* 提示文案（起手点 / 顺着闪光线走）：放横幅里，不压棋盘圆点 */
.hint-tip {
  margin: 14rpx auto 0;
  max-width: 540rpx;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #fff9e0;
  color: var(--pri-ink);
  font-size: var(--fs-cap);
  font-weight: 700;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(161, 98, 7, 0.14);
}

.foot { display: flex; gap: 16rpx; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong);
  font-weight: 800;
  background: #12a08c;
  color: var(--white);
  box-shadow: var(--clay-2);
}
.btn:active { transform: translateY(4rpx); }
.btn.ghost {
  background: var(--white);
  color: #12a08c;
  box-shadow: var(--clay-2);
}
/* 💡 提示（demo 的黄色主按钮）：用完就变成灰白，一眼看出没次数了 */
.btn.hint {
  background: linear-gradient(135deg, var(--gold), #f59e0b);
  color: var(--white);
  box-shadow: var(--clay-2);
  font-size: var(--fs-body);
}
.btn.hint.off {
  background: #f2f5f4;
  color: #b3c4c1;
  box-shadow: var(--clay-2);
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
