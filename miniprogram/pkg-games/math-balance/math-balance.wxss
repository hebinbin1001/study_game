/* 算式天平样式：青绿 + 会倾斜的天平（与其它数学玩法的暖色区分开） */
page {
  background: linear-gradient(180deg, #12a08c 0%, #7ed7c9 34%, #cdeee8 68%, #f0fbf9 100%);
  min-height: 100vh;
}
.page-balance {
  min-height: 100vh;   /* 同上：根容器撑满，.scaleBox 的 flex:1 才能吃到剩余空间 */
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tip {
  background: rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
  padding: 18rpx 24rpx;
  font-size: var(--fs-body);
  color: #2c6a62;
  line-height: 1.6;
}

.scaleBox {
  /* 天平区占据剩余空间并居中；同时给够高度，避免绝对定位的秤盘溢出压住下面的提示行
     （截图实测：左盘/右盘会探到 .scale 外面，和 .tip 文字重叠） */
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--white);
  border-radius: 28rpx;
  padding: 36rpx 24rpx 20rpx;
  box-shadow: var(--clay-3);
}
.scale { position: relative; padding-top: 44rpx; padding-bottom: 150rpx; }
.beam {
  position: relative;
  height: 20rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(90deg, #d8b24a, #f0cd72, #d8b24a);
  transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1);
}
.pillar {
  position: absolute;
  left: 50%;
  top: -30rpx;
  width: 8rpx;
  height: 52rpx;
  background: #c9a227;
  border-radius: 0rpx;
  transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1);
}
.pan {
  position: absolute;
  top: 20rpx;
  width: 44%;
  transform-origin: 50% 0;
  transition: transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1);
}
.pan.left { left: 0; }
.pan.right { right: 0; }
.pan .plate {
  border-radius: 0 0 28rpx 28rpx;
  border-top: none;
  background: #f0f7f6;
  border: 4rpx solid #cfe7e3;
  padding: 26rpx 12rpx 34rpx;
  text-align: center;
}
.pan .val {
  font-size: 50rpx;
  font-weight: 900;
  color: #16695e;
  letter-spacing: 2rpx;
}
.pan .val.empty { color: #b6ccc9; }
.pan .sub { font-size: var(--fs-cap); color: #7f9c97; margin-top: 8rpx; }
.pan .plate.ok { background: var(--soft-green); border-color: var(--green); }
.pan .plate.ok .val { color: var(--green-ink); }
.pan .plate.bad { background: #ffe2ea; border-color: #ff9fb8; }
.pan .plate.bad .val { color: #c53862; }

.trend {
  margin-top: 26rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: #3b7d74;
  min-height: 36rpx;
  line-height: 1.5;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.num {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 34rpx 0;
  text-align: center;
  border-radius: 28rpx;
  background: var(--white);
  font-size: 50rpx;
  font-weight: 900;
  color: #16695e;
  box-shadow: var(--clay-3);
  transition: transform 0.1s ease, background 0.16s ease;
}
.num:active { transform: translateY(4rpx); }
.num.ok { background: var(--green); color: var(--white); }
.num.bad { background: var(--pink); color: var(--white); }

.foot { display: flex; gap: 16rpx; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong);
  font-weight: 800;
  background: #12a08c;
  color: var(--white);
  box-shadow: var(--clay-2);
}
.btn:active { transform: translateY(4rpx); }
.btn.ghost {
  background: var(--white);
  color: #12a08c;
  box-shadow: var(--clay-2);
}
