/* 学习 Tab —— token 对齐 demo；O1 自适应 */
.page-study {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
  background: #F5F7FB;
}

.week-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 36rpx 32rpx;
  text-align: center;
}
.week-sub { font-size: 24rpx; color: #8A94A6; }
.week-big { font-size: 60rpx; font-weight: 900; margin: 8rpx 0 4rpx; color: #333A45; }

.link {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 26rpx 28rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}
.link:active { opacity: .8; }
.li {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #EEF3FD;
  flex: 0 0 auto;
}
.li-green { background: #E6F6EA; }
.li-purple { background: #F0ECFB; }
.li-orange { background: #FFF3E6; }
.lt { flex: 1; min-width: 0; }
.l-b { font-size: 30rpx; font-weight: 800; color: #333A45; }
.l-s { font-size: 22rpx; color: #8A94A6; margin-top: 4rpx; }
.ar { color: #C3CCDA; font-size: 36rpx; font-weight: 700; }

.state-chip {
  flex: 0 0 auto;
  background: #EEF3FD;
  color: #4285F4;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  font-weight: 800;
}
.state-chip.done { background: #E6F6EA; color: #34A853; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 48rpx); }
