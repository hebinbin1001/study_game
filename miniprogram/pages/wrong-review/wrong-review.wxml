<!-- 错题复习页 -->
<view class="page-wrong-review">
  <!-- 顶部进度条 -->
  <view class="progress-bar review-progress">
    <view class="progress-bar__fill" style="width: {{(currentIndex / totalCount) * 100}}%"></view>
  </view>
  <view class="progress-text">第 {{currentIndex + 1}} / {{totalCount}} 题</view>

  <!-- 复习形态切换（M6-G）：原题 / 听音选义 / 看中文选词 -->
  <view class="mode-bar" wx:if="{{currentItem && !completed}}">
    <view
      wx:for="{{modes}}"
      wx:key="key"
      class="mode-chip {{currentMode === item.key ? 'on' : ''}}"
      data-mode="{{item.key}}"
      catchtap="switchMode"
    >{{item.label}}</view>
  </view>

  <!-- 题目卡片 -->
  <view class="question-card" wx:if="{{currentItem && !completed}}">
    <view class="question-head">
      <text class="question-type tag">👾 {{currentItem.question.type}}</text>
    </view>

    <!-- 题干区：随复习形态变化（M6-G） -->
    <view class="question-text" wx:if="{{showQ}}">{{currentItem.question.q}}</view>
    <view wx:elif="{{showListen}}" class="question-text question-text--listen">🎧 听发音，选出听到的内容</view>
    <view wx:elif="{{showHint}}" class="question-text question-text--meaning">{{hintText}}</view>

    <!-- 听音播放按钮 -->
    <view class="listen-row" wx:if="{{showListen}}">
      <view class="listen-btn" catchtap="playAudio">🔊 再听一遍</view>
    </view>

    <!-- 释义提示（原题形态下作为辅助提示；hint 剧透时为空） -->
    <view class="question-hint" wx:if="{{showHint && currentMode === 'original'}}">💡 提示：{{hintText}}</view>

    <!-- 选项 -->
    <view class="options">
      <block wx:for="{{displayOptions}}" wx:key="value">
        <view class="option {{item.cls}}" data-option="{{item.value}}" bindtap="selectOption">
          {{item.value}}
        </view>
      </block>
    </view>
  </view>

  <!-- 完成页 -->
  <view class="completed" wx:if="{{completed}}">
    <view class="completed-card">
      <view class="completed-icon">🎉</view>
      <view class="completed-title">复习完成</view>
      <view class="completed-stats" wx:if="{{totalCount > 0}}">
        答对 {{correctCount}} / {{totalCount}} 题
      </view>
      <view class="completed-stats" wx:else>
        暂无待复习题目，休息一下吧～
      </view>
      <button class="btn-restart" bindtap="restart">🔄 继续复习</button>
      <button class="btn-back" bindtap="goBack">返回错题本</button>
    </view>
  </view>

  <!-- 反馈提示 -->
  <view class="feedback {{correct ? 'correct' : 'wrong'}}" wx:if="{{showFeedback}}">
    <text class="feedback-emoji">{{correct ? '🎉' : '💪'}}</text>
    <text wx:if="{{correct}}">回答正确</text>
    <text wx:else>回答错误</text>
  </view>
</view>
