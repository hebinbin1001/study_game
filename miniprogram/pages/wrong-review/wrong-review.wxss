/* 错题复习页（wrong-review）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-wrong-review {
  padding: 30rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  color: #3a3a5c;
}

/* ============ 顶部进度条（复用全局 .progress-bar / .progress-bar__fill） ============ */
.review-progress {
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.28);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  display: inline-block;
  margin-bottom: 28rpx;
}

/* ============ 题目卡片 ============ */
.question-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.1), 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
}

.question-head {
  margin-bottom: 24rpx;
}

.question-type {
  background: rgba(255, 183, 3, 0.16);
  color: #b07a00;
}

.question-text {
  font-size: 40rpx;
  font-weight: 900;
  color: #3b3b5f;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.question-hint {
  font-size: 24rpx;
  color: #5c7f9e;
  background: #eef3fa;
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 32rpx;
}

/* ============ 选项（卡通按压感） ============ */
.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  padding: 28rpx;
  background: #f4f8fd;
  border: 4rpx solid #e3edf7;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3b3b5f;
  text-align: center;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08), 0 12rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.12s, background 0.2s, border-color 0.2s;
  box-sizing: border-box;
}

.option:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
  background: #eaf4ff;
  border-color: #4cc9f0;
}

/* 选项反馈态（cls 由页面 js 预处理提供） */
.option.correct {
  background: #7bd389;
  border-color: #7bd389;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

.option.wrong {
  background: #ff5a5a;
  border-color: #ff5a5a;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

.option.answer {
  background: #7bd389;
  border-color: #7bd389;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

/* ============ 完成页 ============ */
.completed {
  padding: 60rpx 0;
}

.completed-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.1), 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
}

.completed-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.completed-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #3b3b5f;
  margin-bottom: 16rpx;
}

.completed-stats {
  font-size: 30rpx;
  font-weight: 700;
  color: #b07a00;
  background: rgba(255, 209, 102, 0.24);
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  margin-bottom: 48rpx;
}

.btn-restart {
  width: 400rpx;
  padding: 24rpx 0;
  background: #7bd389;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  border-radius: 44rpx;
  line-height: 1.4;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.14), 0 18rpx 36rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.12s;
}

.btn-restart:active {
  transform: translateY(6rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.14);
}

button.btn-restart::after {
  border: none;
}

.btn-back {
  width: 400rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  line-height: 1.4;
  border: 4rpx solid #e3edf7;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}

.btn-back:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08);
}

button.btn-back::after {
  border: none;
}

/* ============ 对/错反馈（居中弹出） ============ */
.feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 36rpx 72rpx;
  border-radius: 36rpx;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  z-index: 100;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.14), 0 20rpx 40rpx rgba(0, 0, 0, 0.16);
}

.feedback-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.feedback.correct {
  background: #7bd389;
  color: #ffffff;
}

.feedback.wrong {
  background: #ff5a5a;
  color: #ffffff;
}

/* ============ 复习形态切换（M6-G） ============ */
.mode-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: -8rpx 0 24rpx;
}
.mode-chip {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.35);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08);
  transition: background 0.15s;
}
.mode-chip.on {
  background: #4cc9f0;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.14);
}

/* 听音形态题干提示 */
.question-text--listen {
  font-size: 34rpx;
  color: #5c7f9e;
  text-align: center;
}
.question-text--meaning {
  font-size: 36rpx;
}
.listen-row {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.listen-btn {
  padding: 16rpx 44rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #ffffff;
  background: linear-gradient(90deg, #4cc9f0, #7bd389);
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.12), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}
.listen-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}
