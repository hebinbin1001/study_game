/* 错题复习页（wrong-review）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-wrong-review {
  padding: 30rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--ink);
}

/* ============ 顶部进度条（复用全局 .progress-bar / .progress-bar__fill） ============ */
.review-progress {
  margin-bottom: 16rpx;
}

/* 进度行：本关第几题 + 实时答对数（2026-10-25：进度按本关算，不再是整池的 0.9%） */
.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.progress-text {
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--white);
  background: rgba(255, 255, 255, 0.28);
  padding: 8rpx 24rpx;
  border-radius: 28rpx;
}
.progress-right {
  font-size: var(--fs-cap);
  font-weight: 900;
  color: var(--white);
  background: rgba(123, 211, 137, 0.92);
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
}

/* ============ 题目卡片 ============ */
.question-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow: var(--clay-3);
}

.question-head {
  margin-bottom: 24rpx;
}

.question-type {
  background: rgba(255, 183, 3, 0.16);
  color: var(--pri-ink);
}

.question-text {
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.question-hint {
  font-size: var(--fs-cap);
  color: var(--ink-sub);
  background: var(--surface);
  border-radius: 28rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 32rpx;
}

/* ============ 选项（卡通按压感） ============ */
.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option {
  padding: 28rpx;
  background: var(--surface);
  border: 4rpx solid #e3edf7;
  border-radius: 28rpx;
  font-size: var(--fs-strong);
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  box-shadow: var(--clay-2);
  transition: transform 0.12s, background 0.2s, border-color 0.2s;
  box-sizing: border-box;
}

.option:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
  background: #eaf4ff;
  border-color: var(--blue);
}

/* 选项反馈态（cls 由页面 js 预处理提供） */
.option.correct {
  background: var(--green);
  border-color: var(--green);
  color: var(--white);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

.option.wrong {
  background: var(--danger);
  border-color: var(--danger);
  color: var(--white);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

.option.answer {
  background: var(--green);
  border-color: var(--green);
  color: var(--white);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
}

/* ============ 完成页 ============ */
.completed {
  padding: 60rpx 0;
}

.completed-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--clay-3);
}

.completed-icon {
  font-size: 120rpx;
  line-height: 1;
  margin-bottom: 28rpx;
}

.completed-title {
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.completed-stats {
  font-size: var(--fs-strong);
  font-weight: 700;
  color: var(--pri-ink);
  background: rgba(255, 209, 102, 0.24);
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  margin-bottom: 48rpx;
}

.btn-restart {
  width: 440rpx;
  padding: 24rpx 0;
  background: var(--green);
  color: var(--white);
  font-size: var(--fs-strong);
  font-weight: 900;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  line-height: 1.4;
  margin-bottom: 24rpx;
  box-shadow: var(--clay-3);
  transition: transform 0.12s;
}

.btn-restart:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}

button.btn-restart::after {
  border: none;
}

/* 结算页「批量移出」：次要操作，不能抢「再来一关」的主视觉 */
.btn-bulk {
  width: 440rpx;
  padding: 20rpx 0;
  background: #fdeeea;
  color: #c9542f;
  font-size: var(--fs-body);
  font-weight: 800;
  border-radius: 28rpx;
  line-height: 1.4;
  margin-bottom: 24rpx;
  box-shadow: var(--clay-2);
  transition: transform 0.12s;
}

.btn-bulk:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}

button.btn-bulk::after {
  border: none;
}

/* 结算页提示（没有更多题 / 下次到期说明） */
.completed-tip {
  font-size: var(--fs-cap);
  color: var(--ink-sub);
  line-height: 1.5;
  text-align: center;
  margin: -24rpx 0 36rpx;
  padding: 0 20rpx;
}

/* ============ 对/错反馈（居中弹出） ============ */
.feedback {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 36rpx 72rpx;
  border-radius: 28rpx;
  font-size: var(--fs-title);
  font-weight: 900;
  letter-spacing: 4rpx;
  z-index: 100;
  box-shadow: var(--clay-3);
}

.feedback-emoji {
  font-size: 64rpx;
  line-height: 1;
}

.feedback.correct {
  background: var(--green);
  color: var(--white);
}

.feedback.wrong {
  background: var(--danger);
  color: var(--white);
}

/* ============ 复习形态切换（M6-G） ============ */
.mode-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: -8rpx 0 24rpx;
}
.mode-chip {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--white);
  background: rgba(255, 255, 255, 0.35);
  box-shadow: var(--clay-1);
  transition: background 0.15s;
}
.mode-chip.on {
  background: var(--blue);
  box-shadow: var(--clay-1);
}

/* 听音形态题干提示 */
.question-text--listen {
  font-size: var(--fs-strong);
  color: var(--ink-sub);
  text-align: center;
}
.question-text--meaning {
  font-size: var(--fs-title);
}
.listen-row {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.listen-btn {
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--white);
  background: linear-gradient(90deg, var(--blue), var(--green));
  box-shadow: var(--clay-2);
}
.listen-btn:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}

/* ============ 加载 / 失败占位（2026-10-28） ============
   补上「currentItem 为空且未完成」这个原本全空白的中间态。 */
.rv-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 480rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}
.rv-state__icon {
  font-size: var(--fs-display);
  line-height: 1;
}
.rv-state__text {
  margin-top: var(--sp-2);
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--ink);
}
.rv-state__sub {
  margin-top: var(--sp-1);
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
.rv-state__btn {
  margin-top: var(--sp-3);
  min-width: 280rpx;
}
