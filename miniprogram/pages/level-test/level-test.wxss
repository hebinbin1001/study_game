/* 字词定级测（2026-10-28）
   样式全部走 app.wxss 末尾的令牌（颜色 / 字号 5 档 / 圆角 3 档 / 黏土阴影），
   不新写裸色值与非档位字号 —— e2e/check-tokens.js 会拦。 */

.page-lt {
  padding: var(--sp-4) var(--page-x) 0;
  box-sizing: border-box;
}

/* ============ 说明页 ============ */
.lt-hero {
  text-align: center;
  padding: var(--sp-4) 0 var(--sp-3);
}
.lt-hero__ic {
  font-size: var(--fs-display);
  line-height: 1.2;
}
.lt-hero__t {
  margin-top: var(--sp-1);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--ink);
}
.lt-hero__s {
  margin-top: var(--sp-1);
  font-size: var(--fs-cap);
  color: var(--ink-sub);
}

.lt-card {
  background: var(--white);
  border-radius: var(--r-md);
  box-shadow: var(--clay-card);
  padding: var(--sp-3);
}

.lt-li {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-2);
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.6;
}
.lt-li + .lt-li {
  margin-top: var(--sp-2);
}
.lt-li__d {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--r-pill);
  background: var(--pri);
  color: var(--white);
  font-size: var(--fs-cap);
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
}

.lt-last {
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-sm);
  background: var(--white);
  box-shadow: var(--clay-card);
  font-size: var(--fs-body);
  color: var(--ink-sub);
  text-align: center;
}

.lt-btn {
  margin-top: var(--sp-4);
  height: 100rpx;
  border-radius: var(--r-pill);
  text-align: center;
  line-height: 100rpx;
  font-size: var(--fs-strong);
  font-weight: 900;
  letter-spacing: 2rpx;
  transition: transform 0.12s, box-shadow 0.12s;
}
.lt-btn--pri {
  background: var(--pri);
  color: var(--white);
  box-shadow: var(--clay-3);
}
.lt-btn--pri:active {
  transform: translateY(2rpx) scaleY(0.97);
  box-shadow: var(--clay-press);
}

.lt-tip {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}

/* ============ 作答页 ============ */
.lt-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lt-top__n {
  font-size: var(--fs-body);
  font-weight: 900;
  color: var(--ink);
}
.lt-top__lv {
  padding: 0 var(--sp-2);
  height: 44rpx;
  line-height: 44rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  box-shadow: var(--clay-1);
  font-size: var(--fs-cap);
  color: var(--ink-sub);
}

.lt-track {
  margin-top: var(--sp-2);
  height: 16rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  box-shadow: var(--clay-off);
  overflow: hidden;
}
.lt-fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--pri);
  transition: width 0.2s;
}

.lt-word {
  margin-top: 72rpx;
  text-align: center;
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--ink);
  line-height: 1.3;
  word-break: break-all;
}
.lt-sub {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}

.lt-opts {
  margin-top: var(--sp-4);
}
.lt-opt {
  min-height: 96rpx;
  padding: var(--sp-2) var(--sp-3);
  margin-bottom: var(--sp-2);
  border-radius: var(--r-md);
  background: var(--white);
  box-shadow: var(--clay-card);
  font-size: var(--fs-strong);
  font-weight: 800;
  color: var(--ink);
  display: flex;
  align-items: center;
  transition: transform 0.12s, box-shadow 0.12s;
}
.lt-opt--idle:active {
  transform: translateY(2rpx) scaleY(0.98);
  box-shadow: var(--clay-press);
}
.lt-opt--right {
  background: var(--green);
  color: var(--white);
  box-shadow: var(--clay-2);
}
.lt-opt--wrong {
  background: var(--danger);
  color: var(--white);
  box-shadow: var(--clay-2);
}
.lt-opt--dim {
  opacity: 0.45;
}

/* ============ 结果页 ============ */
.lt-res {
  text-align: center;
  padding: var(--sp-4) 0 var(--sp-3);
}
.lt-res__ic {
  font-size: var(--fs-display);
  line-height: 1.2;
}
.lt-res__t {
  margin-top: var(--sp-1);
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--ink);
}
.lt-res__big {
  margin-top: var(--sp-2);
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--pri);
}
.lt-res__s {
  margin-top: var(--sp-1);
  font-size: var(--fs-cap);
  color: var(--ink-sub);
}

.lt-rows {
  padding: var(--sp-1) 0;
}
.lt-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
.lt-row + .lt-row {
  margin-top: var(--sp-2);
}
.lt-row__k {
  flex: 0 0 120rpx;
  font-size: var(--fs-cap);
  color: var(--ink-sub);
}
.lt-row__track {
  flex: 1;
  height: 16rpx;
  border-radius: var(--r-pill);
  background: var(--sky-3);
  overflow: hidden;
}
.lt-row__fill {
  height: 100%;
  border-radius: var(--r-pill);
  background: var(--blue);
}
.lt-row__v {
  flex: 0 0 72rpx;
  text-align: right;
  font-size: var(--fs-cap);
  font-weight: 900;
  color: var(--ink-weak);
}
.lt-row__v.is-ok {
  color: var(--green);
}

.lt-actions {
  margin-top: var(--sp-3);
  display: flex;
  gap: var(--sp-2);
}
.lt-act {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  background: var(--white);
  box-shadow: var(--clay-card);
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--ink-sub);
}
/* 原生 <button> 要重置默认边框/内边距，否则和左边的 view 不是一个高度 */
.lt-act--btn {
  padding: 0;
  margin: 0;
  border: none;
}
.lt-act--btn::after {
  border: none;
}

.safe-gap {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
