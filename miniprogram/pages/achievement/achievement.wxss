/**
 * 成就列表页（achievement）—— 卡通勋章卡片风
 * 风格对齐 app.wxss 设计系统 + avatar 样板：
 *   白色卡片 + 大圆角 + 底部硬阴影 + :active 按压位移
 */

.page-achievement {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

/* 白色胶囊小按钮（返回 / 检查） */
.back-pill,
.check-pill {
  min-width: 140rpx;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08), 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}
.back-pill:active,
.check-pill:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
}
button.back-pill::after,
button.check-pill::after {
  border: none;
}

.check-pill {
  background: #ffd166;
  color: #6b4e00;
}

/* ============ 总进度卡 ============ */
.summary-card {
  margin-bottom: 32rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.summary-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff7e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06);
}

.summary-text {
  flex: 1;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3a3a5c;
  margin-bottom: 6rpx;
}

.summary-count {
  font-size: 24rpx;
  color: #5c7f9e;
}

.summary-percent {
  font-size: 40rpx;
  font-weight: 900;
  color: #ff9f43;
}

/* ============ 勋章卡片列表 ============ */
.achievement-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.medal-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid transparent;
  transition: transform 0.12s;
}

/* 按压感 */
.medal-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 已解锁：金色描边高亮 */
.medal-card.unlocked {
  border-color: #ffd166;
  background: #fffdf5;
}

/* 未解锁：整卡降饱和弱化 */
.medal-card.locked {
  background: rgba(255, 255, 255, 0.6);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.05), 0 10rpx 20rpx rgba(0, 0, 0, 0.05);
}
.medal-card.locked .medal-name {
  color: #9aa7bc;
}
.medal-card.locked .medal-desc {
  color: #aeb9cc;
}

/* 勋章圆容器 */
.medal {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
}

/* 已解锁勋章：金色渐变底 */
.medal--on {
  background: linear-gradient(160deg, #ffe29a 0%, #ffd166 100%);
}

/* 未解锁勋章：灰底 */
.medal--off {
  background: #e8edf4;
}

.medal-emoji {
  font-size: 60rpx;
  line-height: 1;
}

/* 解锁角标闪光 */
.medal-shine {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 32rpx;
  line-height: 1;
}

.medal-info {
  flex: 1;
  min-width: 0;
}

.medal-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #3a3a5c;
  margin-bottom: 8rpx;
}

.medal-desc {
  font-size: 24rpx;
  color: #5c7f9e;
  line-height: 1.5;
}

.medal-status {
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 未解锁徽章：灰底灰字（覆盖全局 badge 金底） */
.badge-locked {
  background: #e8edf4;
  color: #8a9bb5;
}

/* ============ 空态卡 ============ */
.empty-card {
  border-radius: 28rpx;
  padding: 40rpx;
  margin-top: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5c7f9e;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8a9bb5;
}
