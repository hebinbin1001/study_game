<!-- 形象选择页 -->
<view class="page-avatar">
  <!-- 段位信息栏 -->
  <view class="rank-bar">
    <view class="rank-info">
      <text class="rank-name">{{rankInfo.rankName || '青铜'}}</text>
      <text class="rank-wins">胜场: {{rankInfo.wins || 0}}</text>
      <text class="rank-stars">星数: {{rankInfo.stars || 0}}</text>
    </view>
  </view>

  <!-- 战士皮肤区 -->
  <view class="avatar-section">
    <view class="section-title">战士皮肤</view>
    <view class="avatar-list">
      <block wx:for="{{warriors}}" wx:key="avatarId">
        <view class="avatar-item {{item.currentUsed ? 'active' : ''}}" data-avatar-id="{{item.avatarId}}">
          <view class="avatar-rarity {{item.rarity}}">{{item.rarityLabel}}</view>
          <!-- 皮肤图优先（24 套战士美术已到货）；加载失败/缺图时回退 emoji，不出现白块 -->
          <image
            wx:if="{{item.image && !item.iconErr}}"
            class="avatar-img"
            src="{{item.image}}"
            mode="aspectFit"
            data-id="{{item.avatarId}}"
            binderror="onIconError" />
          <text wx:else class="avatar-emoji">{{item.emoji}}</text>
          <view class="avatar-name">{{item.name}}</view>
          <view class="avatar-status">
            <block wx:if="{{item.unlocked}}">
              <text class="status-unlocked">已解锁</text>
              <block wx:if="{{!item.currentUsed}}">
                <button class="btn-use" bindtap="useAvatar" data-avatar-id="{{item.avatarId}}">使用</button>
              </block>
              <block wx:else>
                <text class="status-using">使用中</text>
              </block>
            </block>
            <block wx:else>
              <text class="status-locked">{{item.canUnlock ? '可解锁' : '未解锁'}}</text>
              <text style="display:block;font-size:20rpx;line-height:1.35;color:{{item.canUnlock ? '#7bd389' : '#8a9bb5'}};font-weight:600;margin-top:4rpx;padding:0 8rpx;">{{item.unlockHint}}</text>
              <button wx:if="{{!item.milestone}}" class="btn-unlock" bindtap="unlockAvatar" data-avatar-id="{{item.avatarId}}">{{item.canUnlock ? '立即解锁' : '解锁'}}</button>
            </block>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 怪兽皮肤区 -->
  <view class="avatar-section">
    <view class="section-title">怪兽皮肤</view>
    <view class="avatar-list">
      <block wx:for="{{monsters}}" wx:key="avatarId">
        <view class="avatar-item {{item.currentUsed ? 'active' : ''}}" data-avatar-id="{{item.avatarId}}">
          <view class="avatar-rarity {{item.rarity}}">{{item.rarityLabel}}</view>
          <!-- 怪兽美术未交付，这里始终走 emoji 兜底分支；保留同样的图片分支便于后续直接接图 -->
          <image
            wx:if="{{item.image && !item.iconErr}}"
            class="avatar-img"
            src="{{item.image}}"
            mode="aspectFit"
            data-id="{{item.avatarId}}"
            binderror="onIconError" />
          <text wx:else class="avatar-emoji">{{item.emoji}}</text>
          <view class="avatar-name">{{item.name}}</view>
          <view class="avatar-status">
            <block wx:if="{{item.unlocked}}">
              <text class="status-unlocked">已解锁</text>
              <block wx:if="{{!item.currentUsed}}">
                <button class="btn-use" bindtap="useAvatar" data-avatar-id="{{item.avatarId}}">使用</button>
              </block>
              <block wx:else>
                <text class="status-using">使用中</text>
              </block>
            </block>
            <block wx:else>
              <text class="status-locked">{{item.canUnlock ? '可解锁' : '未解锁'}}</text>
              <text style="display:block;font-size:20rpx;line-height:1.35;color:{{item.canUnlock ? '#7bd389' : '#8a9bb5'}};font-weight:600;margin-top:4rpx;padding:0 8rpx;">{{item.unlockHint}}</text>
              <button wx:if="{{!item.milestone}}" class="btn-unlock" bindtap="unlockAvatar" data-avatar-id="{{item.avatarId}}">{{item.canUnlock ? '立即解锁' : '解锁'}}</button>
            </block>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 返回按钮 -->
  <button class="btn-back" bindtap="goBack">返回</button>
</view>
