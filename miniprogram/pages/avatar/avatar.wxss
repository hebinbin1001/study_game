/* 形象选择页（avatar）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-avatar {
  padding: 24rpx 30rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.safe-gap { height: calc(env(safe-area-inset-bottom) + 96rpx); }

.rank-bar {
  background: var(--white);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--clay-2);
}

.rank-info {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.rank-name {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--pri-ink);
}

.rank-wins, .rank-stars {
  font-size: 28rpx;
  color: var(--ink-sub);
}

/* 封顶说明（2026-10-28）：只在「考试没考过、段位被卡住」时出现，
   解释为什么段位名和累计星看起来对不上。 */
.rank-cap {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--pri-deep);
}

.skin-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 0 0 30rpx;
  padding: 10rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,.72);
  box-shadow: 0 8rpx 24rpx rgba(31, 66, 105, .1);
}
.skin-tab {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 28rpx;
  color: #53708d;
  transition: background .18s ease, transform .18s ease;
}
.skin-tab.on {
  color: #163f75;
  background: linear-gradient(135deg, var(--white) 0%, #e8f3ff 100%);
  box-shadow: inset 0 0 0 3rpx #8ec7ff, 0 6rpx 16rpx rgba(25, 98, 181, .12);
  transform: translateY(-2rpx);
}
.skin-tab__icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: var(--white);
  box-shadow: inset 0 3rpx 0 rgba(255,255,255,.35);
}
.skin-tab__icon.warrior { background: linear-gradient(145deg, #58a7ff, #3371d8); }
.skin-tab__icon.monster { background: linear-gradient(145deg, #a979ee, #6941b5); }
.skin-tab__copy { min-width: 0; display: flex; flex-direction: column; }
.skin-tab__title { font-size: 28rpx; font-weight: 900; line-height: 1.2; }
.skin-tab__meta {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #8395aa;
  white-space: normal;
}
.skin-tab.on .skin-tab__meta { color: #4276ad; }

.avatar-section {
  margin-bottom: 42rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--white);
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  margin-bottom: 20rpx;
}

.avatar-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  align-items: stretch;
}

.avatar-item {
  width: 335rpx;
  min-height: 500rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 22rpx;
  text-align: center;
  box-shadow: var(--clay-2);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.avatar-item.active {
  border-color: var(--pri);
  background: #fff7e0;
}

.avatar-rarity {
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius: 28rpx;
  margin-bottom: 12rpx;
  align-self: center;
  display: inline-block;
  font-weight: 700;
}

.avatar-rarity.common { background: #c9d6e8; color: var(--ink); }
.avatar-rarity.rare { background: var(--blue); color: #0b4a5e; }
.avatar-rarity.epic { background: var(--purple); color: #3b1a6b; }
.avatar-rarity.legend { background: var(--pri); color: #6b4e00; }

.avatar-emoji {
  display: block;
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 14rpx;
}

/* 立绘区（2026-10-09 重做）：带主色浅底的圆角容器，emoji 打底、图覆盖其上。
   原来直接放 <image>，CDN 图在弱网下要等一两秒 —— 那段时间卡片是一片白。 */
.avatar-art {
  position: relative;
  width: 100%;
  height: 230rpx;
  margin: 0 auto 14rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-emoji--ph {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
  opacity: .5;
}
/* 真实皮肤图（战士 24 套）：撑满立绘区，保持卡片版式一致 */
.avatar-img {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}

.avatar-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 800;
  margin-bottom: 10rpx;
  min-height: 70rpx;
  line-height: 1.35;
  white-space: normal;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.avatar-status {
  font-size: 24rpx;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.status-unlocked { color: var(--green); font-weight: 700; }
.status-using { color: var(--pri); font-weight: 700; }
.status-locked { color: #9aa7bc; }
.avatar-unlock-note {
  width: 100%;
  margin-top: 4rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
  color: var(--ink-weak);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.avatar-unlock-note.can-unlock { color: #2f8b4d; }

.avatar-action {
  min-height: 70rpx;
  margin-top: auto;
  padding-top: 10rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.btn-use, .btn-unlock {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
  border-radius: 28rpx;
  font-weight: 700;
}

.btn-use { background: var(--green); color: #14532d; }
.btn-unlock { background: var(--pri); color: #6b4e00; }
.action-current, .action-auto {
  display: block;
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 800;
}
.action-current { background: #fff4d6; color: #9a6700; }
.action-auto { background: #eef3fa; color: var(--ink-sub); }

button.btn-use::after,
button.btn-unlock::after {
  border: none;
}

