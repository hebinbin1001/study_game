/* 形象选择页（avatar）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-avatar {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.rank-bar {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 16rpx 32rpx rgba(0, 0, 0, 0.08);
}

.rank-info {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.rank-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #ffb703;
}

.rank-wins, .rank-stars {
  font-size: 28rpx;
  color: #5c7f9e;
}

.avatar-section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  margin-bottom: 20rpx;
}

.avatar-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.avatar-item {
  width: 210rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.avatar-item.active {
  border-color: #ffb703;
  background: #fff7e0;
}

.avatar-rarity {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  display: inline-block;
  font-weight: 700;
}

.avatar-rarity.common { background: #c9d6e8; color: #fff; }
.avatar-rarity.rare { background: #4cc9f0; color: #fff; }
.avatar-rarity.epic { background: #b388ff; color: #fff; }
.avatar-rarity.legend { background: #ffb703; color: #6b4e00; }

.avatar-emoji {
  display: block;
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: 14rpx;
}

.avatar-name {
  font-size: 26rpx;
  color: #3a3a5c;
  font-weight: 700;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.avatar-status {
  font-size: 22rpx;
}

.status-unlocked { color: #7bd389; font-weight: 700; }
.status-using { color: #ffb703; font-weight: 700; }
.status-locked { color: #9aa7bc; }

.btn-use, .btn-unlock {
  margin-top: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.btn-use { background: #7bd389; color: #fff; }
.btn-unlock { background: #ffb703; color: #fff; }

button.btn-use::after,
button.btn-unlock::after {
  border: none;
}

.btn-back {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  border-radius: 40rpx;
  font-weight: 700;
}
