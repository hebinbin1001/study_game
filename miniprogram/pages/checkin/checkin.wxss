/* 签到日历页（B2 只读）—— 暖色天空卡通风 */
.page-checkin {
  padding: 20rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--sky-grad-soft);
}

/* 头部 */
.header { display: flex; align-items: center; margin-bottom: 28rpx; }
/* 头部返回：这里刻意**不用**全局的 .btn-back 胶囊 ——
   签到页头部是「圆形返回 + 居中标题 + 右侧占位」的三段布局，
   换成胶囊会把标题挤偏。所以单留一个类名，和全局规范并存。 */
.hd-back {
  width: 88rpx; height: 88rpx; padding: 0;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  font-size: var(--fs-title); color: var(--ink); font-weight: 900;
  box-shadow: var(--clay-2);
}
.hd-back::after { border: none; }
.header-title { flex: 1; text-align: center; font-size: var(--fs-title); font-weight: 900; }
.header-side { width: 88rpx; }

/* 今日状态 */
.today-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: var(--clay-3);
}
.tc-left { flex: 1; }
.tc-label { font-size: var(--fs-cap); color: var(--ink-weak); }
.tc-state { font-size: var(--fs-display); font-weight: 900; color: var(--pri); margin: 4rpx 0; }
.tc-state.done { color: var(--green-ink); }
.tc-sub { font-size: var(--fs-cap); color: var(--ink-weak); }
.tc-btn {
  background: var(--pri); color: var(--white);
  border-radius: 999rpx; padding: 0 34rpx;
  height: 76rpx; line-height: 76rpx;
  font-size: var(--fs-body); font-weight: 900;
  box-shadow: var(--clay-2);
}
.tc-btn::after { border: none; }

/* 统计 */
.stat-card {
  margin-top: 26rpx;
  background: var(--white); border-radius: 28rpx;
  display: flex; align-items: center;
  padding: 24rpx 0;
  box-shadow: var(--clay-2);
}
.stat-box { flex: 1; text-align: center; }
.stat-divider { width: 2rpx; height: 64rpx; background: var(--surface); }
.s-num { font-size: var(--fs-display); font-weight: 900; color: var(--ink); }
.s-lab { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 4rpx; }

/* ===== 补签卡（2026-10-29）=====
   有卡才渲染。放在连续天数卡下面、日历上面：用户先是看到「连续 0 天」，
   紧接着就能看到「昨天断了，用一张接上」，两句连起来才讲得通。 */
.mk-card {
  margin-top: 26rpx;
  background: var(--white); border-radius: 28rpx;
  padding: 22rpx 26rpx;
  display: flex; align-items: center;
  gap: 20rpx;
  box-shadow: var(--clay-2);
}
.mk-left { flex: 1; min-width: 0; }
.mk-title { font-size: var(--fs-body); font-weight: 900; color: var(--ink); }
.mk-num { color: var(--pri-ink); }
.mk-sub {
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  line-height: 1.4;
  color: var(--ink-sub);
}
.mk-btn {
  flex: 0 0 auto;
  margin: 0; padding: 0 28rpx;
  height: 68rpx; line-height: 68rpx;
  border-radius: 999rpx;
  font-size: var(--fs-cap); font-weight: 900;
  color: var(--white); background: var(--pri);
  box-shadow: var(--clay-1);
}
.mk-btn::after { border: none; }
.mk-btn:active { transform: translateY(2rpx); }

/* 本月日历 */
.cal-card {
  margin-top: 26rpx;
  background: var(--white); border-radius: 28rpx;
  padding: 24rpx 26rpx 28rpx;
  box-shadow: var(--clay-2);
}
.cal-title { font-size: var(--fs-body); font-weight: 900; margin-bottom: 16rpx; }
.cal-week, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cal-w { text-align: center; font-size: var(--fs-cap); color: var(--ink-weak); padding: 8rpx 0; }
.cal-grid { margin-top: 6rpx; }
.cal-cell {
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink);
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 16rpx;
  background: var(--surface);
}
.cal-cell.on { background: var(--green); color: var(--white); font-weight: 800; }
.cal-cell.today { outline: 4rpx solid var(--pri); }
.cal-cell.future { opacity: .35; }

/* 送星阶梯 */
.ladder-card {
  margin-top: 26rpx;
  background: var(--white); border-radius: 28rpx;
  padding: 24rpx 26rpx 26rpx;
  box-shadow: var(--clay-2);
}
.ladder-title { font-size: var(--fs-body); font-weight: 900; margin-bottom: 18rpx; }
.ladder-row { display: flex; gap: 12rpx; }
.ladder-item {
  flex: 1; text-align: center;
  background: var(--surface); border-radius: 16rpx;
  padding: 16rpx 4rpx;
  opacity: .75;
}
.ladder-item.active { background: var(--soft-gold); opacity: 1; outline: 3rpx solid var(--pri); }
.l-day { font-size: var(--fs-cap); font-weight: 800; color: var(--ink); }
.l-stars { font-size: var(--fs-cap); color: var(--pri); font-weight: 800; margin-top: 4rpx; }
.ladder-tip { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 16rpx; }

/* 里程碑皮肤 */
.milestone-card {
  margin-top: 26rpx;
  background: var(--white); border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: var(--clay-2);
}
.ms-list { display: flex; flex-direction: column; gap: 14rpx; }
.ms-item {
  display: flex; align-items: center; gap: 18rpx;
  background: var(--surface); border-radius: 28rpx;
  padding: 18rpx 20rpx;
  opacity: .8;
}
.ms-item.reached { opacity: 1; outline: 3rpx solid var(--pri); }
.ms-item.claimed { outline: 3rpx solid var(--green); }
.ms-emoji { font-size: var(--fs-display); }
.ms-info { flex: 1; }
.ms-name { font-size: var(--fs-body); font-weight: 800; color: var(--ink); }
.ms-days { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 2rpx; }
.ms-state { font-size: var(--fs-cap); font-weight: 800; color: var(--ink-weak); }
.ms-item.claimed .ms-state { color: var(--green-ink); }
.ms-item.reached .ms-state { color: var(--pri); }

.tip { text-align: center; font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 28rpx; }

/* ============ 加载失败提示（2026-10-28） ============
   签到日历请求失败时明确告知并给重试入口。
   底色用 rgba 而不是新增一个 #色值 —— 令牌护栏只收紧 # 色值，
   这里没有引入新的颜色角色（仍是 danger 语义）。热区保持 ≥88rpx。 */
.load-err {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0;
  padding: 16rpx 20rpx 16rpx 24rpx;
  border-radius: var(--r-md);
  background: rgba(255, 90, 90, 0.10);
  box-shadow: 0 4rpx 12rpx rgba(180, 60, 60, 0.10);
}
.load-err__text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-cap);
  line-height: 1.5;
  font-weight: 700;
  color: var(--danger);
}
.load-err__btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  background: var(--danger);
  color: var(--white);
  font-size: var(--fs-cap);
  font-weight: 900;
}
.load-err__btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}
