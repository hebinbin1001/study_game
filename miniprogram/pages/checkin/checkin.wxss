/* 签到页面（checkin）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-checkin {
  padding: 20rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  color: #3a3a5c;
}

/* ============ 头部 ============ */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.btn-back {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  font-size: 40rpx;
  font-weight: 900;
  border-radius: 28rpx;
  line-height: 88rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}

.btn-back:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
}

button.btn-back::after {
  border: none;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

.header-side {
  width: 88rpx;
}

/* ============ 签到状态卡 ============ */
.checkin-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 44rpx 30rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.1), 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
}


.streak,
.total {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.card-divider {
  width: 4rpx;
  border-radius: 2rpx;
  background: #eef3fa;
  margin: 8rpx 24rpx;
}

/* 连续/累计徽章（复用全局 .badge） */
.streak-badge,
.total-badge {
  font-size: 22rpx;
}

.streak-number,
.total-number {
  font-size: 72rpx;
  font-weight: 900;
  color: #3b3b5f;
  line-height: 1.1;
}

.streak-number {
  color: #ff6b9d;
}

.total-number {
  color: #b388ff;
}

.streak-label,
.total-label {
  font-size: 22rpx;
  color: #5c7f9e;
  font-weight: 700;
}

/* ============ 今日日期卡 ============ */
.today-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 22rpx 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06), 0 12rpx 24rpx rgba(0, 0, 0, 0.06);
}

.today-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.today-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #3b3b5f;
}

.today-state {
  font-size: 22rpx;
  font-weight: 700;
  color: #ff6b9d;
  background: rgba(255, 107, 157, 0.14);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.today-state.done {
  color: #2e8b57;
  background: rgba(127, 211, 160, 0.2);
}

/* ============ 签到按钮（卡通按压感） ============ */
.btn-checkin {
  width: 100%;
  padding: 34rpx 0;
  background: #ffb703;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  border-radius: 44rpx;
  line-height: 1.4;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.14), 0 20rpx 40rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}

.btn-checkin:active {
  transform: translateY(6rpx);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.14);
}

.btn-checkin.checked {
  background: #c9d6e8;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.06);
}

button.btn-checkin::after {
  border: none;
}

/* ============ 奖励说明 ============ */
.rewards {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}

.reward-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3b3b5f;
  margin-bottom: 24rpx;
}

.reward-list {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.reward-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 8rpx;
  background: #f4f8fd;
  border-radius: 24rpx;
  border: 3rpx solid transparent;
  opacity: 0.55;
  box-sizing: border-box;
  transition: opacity 0.2s, border-color 0.2s;
}

.reward-item.active {
  opacity: 1;
  background: #fff7e0;
  border-color: #ffd166;
}

.reward-icon {
  font-size: 40rpx;
  line-height: 1;
}

.reward-day {
  font-size: 20rpx;
  color: #5c7f9e;
  font-weight: 700;
}

.reward-stars {
  font-size: 22rpx;
  color: #b07a00;
  font-weight: 900;
}

/* ============ 签到成功提示 ============ */
.tip {
  text-align: center;
  padding: 24rpx;
  background: #7bd389;
  border-radius: 28rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.1), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}
