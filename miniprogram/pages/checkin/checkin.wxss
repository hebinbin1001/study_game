/* 签到日历页（B2 只读）—— 暖色天空卡通风 */
.page-checkin {
  padding: 20rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  color: #3a3a5c;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}

/* 头部 */
.header { display: flex; align-items: center; margin-bottom: 28rpx; }
.btn-back {
  width: 88rpx; height: 88rpx; padding: 0;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06);
}
.btn-back::after { border: none; }
.header-title { flex: 1; text-align: center; font-size: 36rpx; font-weight: 900; }
.header-side { width: 88rpx; }

/* 今日状态 */
.today-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, .06), 0 18rpx 36rpx rgba(0, 0, 0, .08);
}
.tc-left { flex: 1; }
.tc-label { font-size: 22rpx; color: #8a9bb5; }
.tc-state { font-size: 44rpx; font-weight: 900; color: #ff8f00; margin: 4rpx 0; }
.tc-state.done { color: #2e8b57; }
.tc-sub { font-size: 22rpx; color: #8a9bb5; }
.tc-btn {
  background: #ffb703; color: #fff;
  border-radius: 999rpx; padding: 0 34rpx;
  height: 76rpx; line-height: 76rpx;
  font-size: 28rpx; font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .1);
}
.tc-btn::after { border: none; }

/* 统计 */
.stat-card {
  margin-top: 26rpx;
  background: #fff; border-radius: 28rpx;
  display: flex; align-items: center;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .05);
}
.stat-box { flex: 1; text-align: center; }
.stat-divider { width: 2rpx; height: 64rpx; background: #eef2f8; }
.s-num { font-size: 44rpx; font-weight: 900; color: #3a3a5c; }
.s-lab { font-size: 22rpx; color: #8a9bb5; margin-top: 4rpx; }

/* 本月日历 */
.cal-card {
  margin-top: 26rpx;
  background: #fff; border-radius: 28rpx;
  padding: 24rpx 26rpx 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .05);
}
.cal-title { font-size: 28rpx; font-weight: 900; margin-bottom: 16rpx; }
.cal-week, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10rpx; }
.cal-w { text-align: center; font-size: 22rpx; color: #8a9bb5; padding: 8rpx 0; }
.cal-grid { margin-top: 6rpx; }
.cal-cell {
  text-align: center;
  font-size: 24rpx;
  color: #3a3a5c;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 16rpx;
  background: #f4f8fd;
}
.cal-cell.on { background: #7bd389; color: #fff; font-weight: 800; }
.cal-cell.today { outline: 4rpx solid #ffb703; }
.cal-cell.future { opacity: .35; }

/* 送星阶梯 */
.ladder-card {
  margin-top: 26rpx;
  background: #fff; border-radius: 28rpx;
  padding: 24rpx 26rpx 26rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .05);
}
.ladder-title { font-size: 28rpx; font-weight: 900; margin-bottom: 18rpx; }
.ladder-row { display: flex; gap: 12rpx; }
.ladder-item {
  flex: 1; text-align: center;
  background: #f4f8fd; border-radius: 18rpx;
  padding: 16rpx 4rpx;
  opacity: .75;
}
.ladder-item.active { background: #fff3e0; opacity: 1; outline: 3rpx solid #ffb703; }
.l-day { font-size: 22rpx; font-weight: 800; color: #3a3a5c; }
.l-stars { font-size: 22rpx; color: #ff8f00; font-weight: 800; margin-top: 4rpx; }
.ladder-tip { font-size: 20rpx; color: #8a9bb5; margin-top: 16rpx; }

/* 里程碑皮肤 */
.milestone-card {
  margin-top: 26rpx;
  background: #fff; border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .05);
}
.ms-list { display: flex; flex-direction: column; gap: 14rpx; }
.ms-item {
  display: flex; align-items: center; gap: 18rpx;
  background: #f4f8fd; border-radius: 20rpx;
  padding: 18rpx 20rpx;
  opacity: .8;
}
.ms-item.reached { opacity: 1; outline: 3rpx solid #ffb703; }
.ms-item.claimed { outline: 3rpx solid #7bd389; }
.ms-emoji { font-size: 48rpx; }
.ms-info { flex: 1; }
.ms-name { font-size: 28rpx; font-weight: 800; color: #3a3a5c; }
.ms-days { font-size: 20rpx; color: #8a9bb5; margin-top: 2rpx; }
.ms-state { font-size: 22rpx; font-weight: 800; color: #8a9bb5; }
.ms-item.claimed .ms-state { color: #2e8b57; }
.ms-item.reached .ms-state { color: #ff8f00; }

.tip { text-align: center; font-size: 22rpx; color: #8a9bb5; margin-top: 28rpx; }
