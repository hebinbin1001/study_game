<!-- 签到页面 -->
<view class="page-checkin">
  <view class="header">
    <button class="btn-back" bindtap="goBack">‹ 返回</button>
    <view class="header-title">每日签到</view>
  </view>

  <!-- 签到状态 -->
  <view class="checkin-card">
    <view class="streak">
      <text class="streak-number">{{currentStreak}}</text>
      <text class="streak-label">连续签到天数</text>
    </view>
    <view class="total">
      <text class="total-number">{{totalCheckins}}</text>
      <text class="total-label">累计签到次数</text>
    </view>
  </view>

  <!-- 签到按钮 -->
  <button class="btn-checkin {{checkedIn ? 'checked' : ''}}" bindtap="doCheckin" loading="{{loading}}" disabled="{{checkedIn}}">
    {{checkedIn ? '今日已签到' : '立即签到'}}
  </button>

  <!-- 奖励说明 -->
  <view class="rewards">
    <view class="reward-title">签到奖励</view>
    <view class="reward-list">
      <view class="reward-item {{currentStreak >= 1 ? 'active' : ''}}">
        <text class="reward-day">第1天</text>
        <text class="reward-stars">+10 星</text>
      </view>
      <view class="reward-item {{currentStreak >= 3 ? 'active' : ''}}">
        <text class="reward-day">第3天</text>
        <text class="reward-stars">+30 星</text>
      </view>
      <view class="reward-item {{currentStreak >= 7 ? 'active' : ''}}">
        <text class="reward-day">第7天</text>
        <text class="reward-stars">+100 星</text>
      </view>
      <view class="reward-item {{currentStreak >= 14 ? 'active' : ''}}">
        <text class="reward-day">第14天</text>
        <text class="reward-stars">+200 星</text>
      </view>
      <view class="reward-item {{currentStreak >= 30 ? 'active' : ''}}">
        <text class="reward-day">第30天</text>
        <text class="reward-stars">+500 星</text>
      </view>
    </view>
  </view>

  <!-- 签到提示 -->
  <view class="tip" wx:if="{{rewardStars > 0}}">
    签到成功！获得 {{rewardStars}} 星奖励
  </view>
</view>