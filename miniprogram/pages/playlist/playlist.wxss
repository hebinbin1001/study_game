/* 玩法 Tab —— UI token 对齐 demo；O1 全机型自适应 */
.page-play {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
  background: #F5F7FB;
}

/* 顶部信息条 */
.pgbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #4285F4, #6AA6F5);
  border-radius: 32rpx;
  color: #fff;
  padding: 28rpx 32rpx;
  flex: 0 0 auto;
}
.pg-ic { font-size: 52rpx; }
.pg-t { flex: 1; min-width: 0; }
.pg-b { font-size: 32rpx; font-weight: 800; }
.pg-s { font-size: 22rpx; opacity: .92; margin-top: 4rpx; }
.pg-num {
  background: rgba(255, 255, 255, .25);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* 分类 chips */
.cat-scroll { flex: 0 0 auto; width: 100%; margin-top: 24rpx; white-space: nowrap; }
.cat-row { display: inline-flex; gap: 16rpx; padding: 4rpx 0 8rpx; }
.cat-chip {
  display: inline-flex;
  align-items: center;
  background: #fff;
  color: #8A94A6;
  border-radius: 999rpx;
  padding: 14rpx 30rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
}
.cat-chip.on { background: #4285F4; color: #fff; }

/* 玩法网格：占满剩余高度，内部滚动 */
.grid-scroll { flex: 1 1 auto; min-height: 0; width: 100%; }
.pgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 16rpx 0 8rpx;
}
.pcard {
  position: relative;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 28rpx 24rpx 22rpx;
  box-sizing: border-box;
}
.pcard.done { outline: 4rpx solid #34A853; }
.pcard.new { opacity: .78; }
.pic { font-size: 68rpx; line-height: 1.1; }
.pcard.new .pic { filter: grayscale(1); }
.pname { font-size: 32rpx; font-weight: 800; margin-top: 12rpx; color: #333A45; }
.pdesc { font-size: 22rpx; color: #8A94A6; line-height: 1.45; margin-top: 6rpx; min-height: 64rpx; }
.cat-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #FFF3E6;
  color: #FF9800;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 18rpx;
  font-weight: 800;
}
.pfoot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.tag {
  background: #EEF3FD;
  color: #4285F4;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 20rpx;
  font-weight: 800;
}
.tag.off { background: #F0F1F4; color: #A9B2C2; }
.arr { color: #C3CCDA; font-size: 34rpx; font-weight: 700; margin-left: auto; }

.foot-note { text-align: center; color: #A9B2C2; font-size: 22rpx; padding: 20rpx 0 8rpx; }
.safe-gap { height: calc(env(safe-area-inset-bottom) + 24rpx); }
