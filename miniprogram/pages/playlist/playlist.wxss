/* 玩法 Tab —— 布局收敛版（2026-10-17）
 * 变化：删掉顶部蓝色信息条（114rpx），已解锁计数并入年级行；
 *       头部从 ≈380rpx 降到 ≈236rpx，首屏多出一行卡片。
 * 配色（2026-10-28）：原来这里是 #F5F7FB 灰白底，注释写着「等主题收口批次统一换天空底」——
 * 这一批就是收口。四个 tab 页现在统一走 --sky-1/2/3，切 tab 不再有底色断层。 */
.page-play {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 36%, var(--sky-3) 100%);
}

/* 年级 + 已解锁计数（一行） */
.pg-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}
.pg-grades {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
}
.pg-grade-row { display: flex; gap: 12rpx; padding: 2rpx 2rpx 6rpx; }
.pg-grade {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  font-weight: 800;
  box-shadow: var(--clay-1);
}
.pg-grade:active { opacity: .85; }
.pg-grade.on { background: var(--pri); color: var(--white); }
/* 计数：原信息条的核心信息，压缩成一枚静态胶囊 */
.pg-count {
  flex: 0 0 auto;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--ink-weak);
  background: rgba(255, 255, 255, .9);
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

/* 二级分段：闯关线 / 数字智力 */
.seg-row {
  display: flex;
  gap: 16rpx;
  flex: 0 0 auto;
  margin-top: 16rpx;
}
.seg-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 84rpx;
  background: var(--white);
  border-radius: 28rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink-weak);
  box-shadow: 0 4rpx 12rpx rgba(28, 53, 92, .06);
}
.seg-tab.on {
  background: var(--surface);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 3rpx #93c5fd, 0 4rpx 12rpx rgba(28, 53, 92, .10);
}
.seg-ic { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.seg-label { line-height: 1; }

/* 分类 chips */
.cat-scroll { flex: 0 0 auto; width: 100%; margin-top: 16rpx; white-space: nowrap; }
.cat-row { display: inline-flex; gap: 16rpx; padding: 4rpx 0 8rpx; }
.cat-chip {
  display: inline-flex;
  align-items: center;
  background: var(--white);
  color: var(--ink-weak);
  border-radius: 999rpx;
  padding: 14rpx 30rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
}
.cat-chip.on {
  background: var(--surface);
  color: #1d4ed8;
  box-shadow: inset 0 0 0 3rpx #93c5fd, 0 6rpx 16rpx rgba(30, 60, 120, .10);
}
.cat-ic { width: 32rpx; height: 32rpx; margin-right: 8rpx; flex-shrink: 0; }

/* 玩法网格：占满剩余高度，内部滚动 */
.grid-scroll { flex: 1 1 auto; min-height: 0; width: 100%; }
.pgrid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 12rpx 0 8rpx;
}
.pcard {
  position: relative;
  background: var(--white);
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 26rpx 24rpx 20rpx;
  box-sizing: border-box;
}
/* 全通才描边（原 .done 挂在 unlocked 上，14 张卡全绿框 —— 2026-10-17 修） */
.pcard.full { outline: 4rpx solid var(--green-ink); }
.full-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  background: var(--soft-green);
  color: #1E8E3E;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: var(--fs-cap);
  font-weight: 900;
}
.pic { font-size: 68rpx; line-height: 1.1; }
.pic-img {
  display: block;
  width: 104rpx;
  height: 104rpx;
  margin: 2rpx 0 4rpx;
}
.pname { font-size: var(--fs-strong); font-weight: 800; margin-top: 10rpx; color: var(--ink); }
.pdesc { font-size: var(--fs-cap); color: var(--ink-weak); line-height: 1.45; margin-top: 6rpx; min-height: 64rpx; }
/* 预期时长标注：比描述再淡一档，不抢主信息 */
.pmin { color: #A9B7C7; }
.cat-tag {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  background: var(--soft-gold);
  color: var(--pri);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
}
/* 底部只有一枚「进度 · 去闯关」胶囊 + 箭头，不再两个标签并排 */
.pfoot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.tag {
  background: var(--surface);
  color: var(--link);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.arr { color: var(--line); font-size: var(--fs-strong); font-weight: 700; margin-left: auto; }

.foot-note { text-align: center; color: #A9B2C2; font-size: var(--fs-cap); padding: 20rpx 0 8rpx; }
.safe-gap { height: calc(env(safe-area-inset-bottom) + 24rpx); }

/* ============ 年级只读行（2026-10-18 全局年级设置） ============ */
.pg-grade-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 12rpx;
}
.pg-grade-line:active { opacity: .7; }
.pg-grade-ic { font-size: var(--fs-body); }
.pg-grade-tx { font-size: var(--fs-body); font-weight: 900; color: var(--ink-deep); }
.pg-grade-go { font-size: var(--fs-cap); font-weight: 800; color: var(--link); }
