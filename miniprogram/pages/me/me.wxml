<!-- 个人中心 Tab（B1 UI 对齐 demo 我的页；保留完整功能菜单） -->
<page-meta page-style="{{fsStyle}}" />

<view class="page-me">
  <!-- 资料卡：头像 + 昵称 + 段位行 + 编辑/登录 -->
  <view class="profile-card" bindtap="onProfileTap">
    <image wx:if="{{loggedIn && avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view wx:elif="{{loggedIn}}" class="avatar avatar--default">😎</view>
    <view wx:else class="avatar avatar--default">🕶️</view>
    <view class="info">
      <view class="name">{{loggedIn ? (nickname || '未设置昵称') : '游客'}}</view>
      <view class="meta">
        <block wx:if="{{loggedIn}}">
          <text class="meta-chip" bindtap="goRankInfo">🎖 {{rankName || '青铜'}} ›</text>
          <text class="meta-chip">⭐ {{rankStars}}</text>
        </block>
        <text wx:else class="meta-chip">游客模式 · 数据仅存本机</text>
        <!-- 年级是全局学习设置（2026-10-18）：资料卡里直接可见可点，避免藏在菜单里找不到 -->
        <text class="meta-chip" catchtap="openGradePicker">🏫 {{gradeLabel}} ›</text>
      </view>
    </view>
    <view class="edit-hint {{loggedIn ? '' : 'hint-login'}}">{{loggedIn ? '📝 编辑' : '🔑 登录'}}</view>
  </view>

  <!-- 游客说明卡（仅游客） -->
  <view wx:if="{{!loggedIn}}" class="guest-card">
    <view class="gc-ic">🕶️</view>
    <view class="gc-t">
      <view class="gc-b">你正在以游客身份使用</view>
      <view class="gc-s">进度只存在本机，退出/清缓存会丢失；排行榜不上榜。</view>
    </view>
  </view>

  <!-- 统计三格 -->
  <view class="stat-row">
    <view class="stat-box">
      <view class="stat-ic">⭐</view>
      <view class="stat-num">{{loggedIn ? rankStars : '-'}}</view>
      <view class="stat-lab">累计星星</view>
    </view>
    <view class="stat-box stat-box--rank" bindtap="goRankInfo">
      <image
        wx:if="{{loggedIn && rankIcon}}"
        class="rank-badge"
        src="{{rankIcon}}"
        mode="aspectFit"
        binderror="onRankIconError"></image>
      <view wx:else class="stat-ic">🎖</view>
      <view class="stat-num">{{loggedIn ? rankName || '-' : '-'}}</view>
      <view class="stat-lab">段位 ›</view>
    </view>
    <view class="stat-box">
      <view class="stat-ic">🏅</view>
      <view class="stat-num">{{loggedIn ? wins : '-'}}</view>
      <view class="stat-lab">胜场</view>
    </view>
  </view>

  <!-- 功能菜单（2026-10-17 分组：成长 / 对战 / 学习；重复入口保留不删，只归位） -->
  <view class="menu-group" wx:for="{{menuGroups}}" wx:for-item="grp" wx:key="title">
    <view class="menu-group-title">{{grp.title}}</view>
    <view class="menu-card">
      <view
        wx:for="{{grp.items}}"
        wx:for-item="item"
        wx:key="name"
        class="menu-row"
        data-url="{{item.url}}"
        data-action="{{item.action}}"
        bindtap="onMenuTap">
        <text class="menu-emoji">{{item.emoji}}</text>
        <text class="menu-name">{{item.name}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 账号区（仅已登录）：和上方菜单用同一套行样式，避免底部出现一块风格突兀的居中按钮 -->
  <view class="menu-group" wx:if="{{loggedIn}}">
    <view class="menu-group-title">账号</view>
    <view class="menu-card">
      <view class="menu-row" bindtap="goLogout">
        <text class="menu-emoji">🚪</text>
        <text class="menu-name">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="goDeleteAccount">
        <text class="menu-emoji">⚠️</text>
        <text class="menu-name menu-name--danger">注销账号</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部：协议（低频，从菜单移到这里）+ 版本号（连点 5 次进管理后台，普通用户看不到入口） -->
  <view class="version-row">
    <text class="version-link" bindtap="goAgreement">用户协议与隐私政策</text>
    <text class="version" bindtap="onVersionTap">词力战士 · Word Warrior v1.2.0</text>
  </view>

  <!-- 2026-10-28 删掉 <view class="safe-gap">：
       .page-me 的 padding-bottom 已经含 env(safe-area-inset-bottom)，
       再叠一个 .safe-gap 等于安全区算了两次，底部会多出一条看不见的空隙。 -->

  <!-- 全局年级选择器（2026-10-18）：年级是学习设置，只在这里和页面里的年级文字处修改 -->
  <grade-picker visible="{{gradePickerVisible}}" value="{{gradeKey}}"
    bind:pick="onGradePick" bind:close="onGradeClose" />
</view>
