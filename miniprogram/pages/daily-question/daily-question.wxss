/* 每日一题页（B2） */
.page-daily {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 40rpx);
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}

/* 顶部连续卡 */
.top-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, .06), 0 18rpx 36rpx rgba(0, 0, 0, .08);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.streak-big { font-size: 64rpx; font-weight: 900; color: #ff8f00; }
.streak-unit { font-size: 30rpx; }
.top-sub { flex: 1; display: flex; flex-wrap: wrap; gap: 14rpx; justify-content: flex-end; }
.badge { padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; }
.badge.fire { background: #fff3e0; color: #ff8f00; }
.badge { background: #f0f4fa; color: #5c7f9e; }
.badge.done { background: #e6f6ea; color: #2e8b57; }

/* 答题卡 */
.question-card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, .06), 0 20rpx 40rpx rgba(0, 0, 0, .1);
}
.q-label { font-size: 24rpx; color: #8a9bb5; font-weight: 700; }
.q-word {
  font-size: 76rpx;
  font-weight: 900;
  color: #3a3a5c;
  letter-spacing: 4rpx;
  margin: 24rpx 0 8rpx;
  word-break: break-all;
}
.q-sub { font-size: 24rpx; color: #8a9bb5; }

/* 选项 */
.opt-list { margin-top: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
.opt {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3a3a5c;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .05), 0 12rpx 24rpx rgba(0, 0, 0, .06);
}
.opt:active { opacity: .8; }
.opt.ok { background: #7bd389; color: #fff; }
.opt.no { background: #ff8fae; color: #fff; }

.tip-wrong { text-align: center; color: #e62e2e; font-size: 24rpx; margin-top: 20rpx; }
.btn-ghost {
  margin: 20rpx auto 0;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, .92);
  color: #3a3a5c;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .06);
}
.btn-ghost::after { border: none; }

/* 已签态 */
.done-card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, .06), 0 20rpx 40rpx rgba(0, 0, 0, .1);
}
.done-emoji { font-size: 120rpx; }
.done-title { font-size: 44rpx; font-weight: 900; color: #3a3a5c; margin: 16rpx 0 8rpx; }
.done-sub { font-size: 26rpx; color: #8a9bb5; line-height: 1.6; }
.btn-main {
  margin-top: 32rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #ffb703;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, .12);
}
.btn-main::after { border: none; }

/* 里程碑 */
.milestone-sec { margin-top: 32rpx; }
.ms-title { font-size: 26rpx; font-weight: 800; color: #3a3a5c; margin-bottom: 16rpx; }
.ms-row { display: flex; gap: 14rpx; }
.ms-item {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 18rpx 6rpx;
  text-align: center;
  opacity: .72;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .05);
}
.ms-item.reached { opacity: 1; outline: 4rpx solid #ffb703; }
.ms-item.claimed { outline: 4rpx solid #7bd389; }
.ms-emoji { font-size: 44rpx; }
.ms-day { font-size: 22rpx; font-weight: 800; color: #3a3a5c; margin-top: 6rpx; }
.ms-state { font-size: 18rpx; color: #8a9bb5; margin-top: 4rpx; }
.ms-item.claimed .ms-state { color: #2e8b57; }
.ms-item.reached .ms-state { color: #ff8f00; }

.foot-tip { text-align: center; font-size: 22rpx; color: #8a9bb5; margin-top: 28rpx; line-height: 1.6; }
