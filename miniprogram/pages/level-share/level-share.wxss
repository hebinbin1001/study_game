/**
 * 分享/导入页（level-share）—— 卡通卡片风
 * 风格对齐 app.wxss 设计系统 + avatar 样板：
 *   白色卡片 + 大圆角 + 底部硬阴影 + :active 按压位移
 */

.page-level-share {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}.header-title {
  flex: 1;
  text-align: center;
  font-size: 38rpx;
  font-weight: 900;
  color: var(--white);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  margin-right: 140rpx; /* 平衡返回按钮宽度，标题保持视觉居中 */
}

/* ============ 卡片标题 ============ */
.card-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 28rpx;
}

/* ============ 分享模式卡 ============ */
.share-card {
  text-align: center;
  padding: 60rpx 40rpx;
  margin-bottom: 32rpx;
}

.share-icon {
  font-size: 110rpx;
  line-height: 1.2;
  margin-bottom: 20rpx;
}

.share-tip {
  font-size: 28rpx;
  color: var(--ink-sub);
  margin-bottom: 32rpx;
}

/* 分享码大字：金橙渐变强调 */
.share-code {
  font-size: 80rpx;
  font-weight: 900;
  letter-spacing: 16rpx;
  color: #ff9f43;
  margin-bottom: 44rpx;
  padding: 24rpx 20rpx;
  background: #fff7e0;
  border-radius: 28rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.06);
}

/* 复制按钮：橙色主按钮按压感 */
.btn-copy {
  min-width: 320rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  background: var(--pri);
  color: var(--white);
  box-shadow: var(--clay-3);
  transition: transform 0.12s;
}
.btn-copy:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}
button.btn-copy::after {
  border: none;
}

/* ============ 导入模式卡 ============ */
.import-card {
  margin-bottom: 32rpx;
}

.input-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
}

/* 分享码输入框：大圆角 + 居中字距 */
.code-input {
  flex: 1;
  padding: 24rpx;
  background: #f2f7fc;
  border-radius: 28rpx;
  border: 4rpx solid #e1edf6;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
  letter-spacing: 12rpx;
  box-sizing: border-box;
}

.field-placeholder {
  color: #a8bacf;
  font-weight: 700;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

/* 导入按钮：蓝色次按钮按压感 */
.btn-import {
  min-width: 180rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  background: var(--blue);
  color: var(--white);
  box-shadow: var(--clay-2);
  transition: transform 0.12s;
}
.btn-import:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}
button.btn-import::after {
  border: none;
}

.input-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--ink-weak);
  text-align: center;
}

/* ============ 关卡信息卡 ============ */
.level-card {
  margin-bottom: 32rpx;
}

.level-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.level-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 标签复用全局 .tag（浅底灰字），仅调字号 */
.level-meta .tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
}

.level-description {
  font-size: 28rpx;
  color: var(--ink-sub);
  margin-bottom: 28rpx;
  line-height: 1.6;
  background: #f2f7fc;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
}

/* 开始游戏：绿色大按钮按压感 */
.btn-start {
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  border-radius: 999rpx;
  background: var(--green);
  color: var(--white);
  box-shadow: var(--clay-3);
  transition: transform 0.12s;
}
.btn-start:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}
button.btn-start::after {
  border: none;
}

/* ============ 空态说明卡 ============ */
.empty-card {
  border-radius: 28rpx;
  padding: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--ink-sub);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--ink-weak);
}
