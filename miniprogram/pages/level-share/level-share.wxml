<!-- 分享导入页 -->
<view class="page-level-share">
  <view class="header">
    <button class="btn-back" bindtap="goBack">‹ 返回</button>
    <view class="header-title">导入关卡</view>
  </view>

  <!-- 输入分享码 -->
  <view class="input-section">
    <text class="label">分享码</text>
    <view class="input-row">
      <input class="input" value="{{shareCode}}" bindinput="onInput" placeholder="输入 6 位分享码" maxlength="6" />
      <button class="btn-import" bindtap="importLevel" loading="{{loading}}">导入</button>
    </view>
  </view>

  <!-- 关卡信息 -->
  <view class="level-info" wx:if="{{levelInfo}}">
    <view class="level-title">{{levelInfo.title}}</view>
    <view class="level-meta">
      <text class="meta-item">作者：{{levelInfo.authorName || '匿名'}}</text>
      <text class="meta-item">学段：{{levelInfo.grade}}</text>
      <text class="meta-item">题目：{{levelInfo.totalQ}} 题</text>
    </view>
    <view class="level-description" wx:if="{{levelInfo.description}}">{{levelInfo.description}}</view>
    <button class="btn-start" bindtap="startGame">开始游戏</button>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!levelInfo}}">
    <view class="empty-icon">🔗</view>
    <view class="empty-text">输入好友分享的 6 位码</view>
    <view class="empty-text">即可导入自定义关卡</view>
  </view>
</view>