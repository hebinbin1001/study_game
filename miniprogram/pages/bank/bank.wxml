<!--
  题库页（2026-09-18）：各学段词汇一览 + 编辑/新增/删除 + 自建库 + 掌握状态
  说明：这里的词条（含自建库）就是闯关线的题源；自建库挂在学段下作为附加题源。
-->
<page-meta page-style="{{fsStyle}}" />

<view class="bk-page">

  <!-- 顶部：只在书架层显示。
       详情层隐藏它 —— 否则会出现三层头部（原生导航栏 + 这里 + 下面的 detail-head），
       标题和返回箭头都重复一遍。详情层用 detail-head 的「‹ 书架」返回。 -->
  <view class="bk-head" wx:if="{{viewMode === 'library'}}">
    <button class="bank-nav-back" bindtap="onHeaderBack">‹</button>
    <view class="bk-head-t">
      <view class="bk-title">{{viewMode === 'library' ? '词库书架' : '词库详情'}}</view>
      <view class="bk-sub">{{viewMode === 'library' ? '先选词库，再浏览和编辑词条' : activeLibraryLabel}} · {{syncing ? '同步中…' : curBookName}}</view>
    </view>
  </view>

  <!-- 门禁 -->
  <view class="gate-bar" wx:if="{{needLogin}}">
    <text class="gate-emoji">🔒</text>
    <text class="gate-text">{{gateText}}</text>
    <button class="gate-btn" bindtap="onGateLogin">去登录</button>
  </view>

  <block wx:else>
    <!-- 学段：跟随全局年级（2026-10-18），只读展示，点开可切换 -->
    <view class="bk-field">
    <text class="bk-field-label">学段</text>
    <view class="bk-grade-line" bindtap="openGradePicker">
      <text class="bk-grade-ic">🏫</text>
      <text class="bk-grade-tx">{{gradeLabel}}</text>
      <text class="bk-grade-go">切换 ›</text>
    </view>
    </view>

    <block wx:if="{{viewMode === 'library'}}">
      <view class="library-intro">
        <view class="library-intro-title">{{gradeLabel}} · 选择词库</view>
        <view class="library-intro-sub">先进入一个词库，再浏览、搜索或编辑词条</view>
      </view>
      <scroll-view class="library-scroll" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
        <view class="library-grid">
          <view wx:for="{{libraryCards}}" wx:key="key" class="library-card"
            data-key="{{item.key}}" bindtap="openLibrary">
            <view class="library-card-top">
              <text class="library-emoji">{{item.emoji}}</text>
              <text class="library-total">{{item.total}} 词</text>
            </view>
            <view class="library-name">{{item.label}}</view>
            <view class="library-desc">{{item.desc}}</view>
            <view class="library-bar"><view class="library-bar-in" style="width: {{item.progress}}%;"></view></view>
            <view class="library-meta">已掌握 {{item.learned}} · 薄弱 {{item.weak}}</view>
          </view>
          <view class="library-card library-add" bindtap="openCreateBank">
            <text class="library-add-icon">＋</text>
            <text class="library-add-title">新建题库</text>
            <text class="library-add-sub">整理自己的专题词表</text>
          </view>
        </view>
        <view class="safe-gap"></view>
      </scroll-view>
    </block>

    <block wx:else>
    <view class="detail-head">
      <text class="detail-back" bindtap="goLibraryShelf">‹ 书架</text>
      <view class="detail-title-wrap">
        <text class="detail-title">{{activeLibraryLabel}}</text>
        <text class="detail-sub">共 {{totalAll}} 条 · 薄弱 {{weakCount}} · 已掌握 {{learnedCount}}</text>
      </view>
      <view class="detail-icon {{searchOpen ? 'on' : ''}}" bindtap="toggleSearch">🔍</view>
      <view class="detail-icon" bindtap="openFilter">⋯</view>
    </view>

    <!-- 当前自建库的管理条 -->
    <view wx:if="{{curBankIsCustom}}" class="bk-bankbar">
      <text class="bk-bankbar-name">📗 {{curBankName}}</text>
      <view class="bk-bankbar-acts">
        <text class="bk-act" bindtap="openRenameBank">重命名</text>
        <text class="bk-act" bindtap="toggleBankEnabled">启用/暂停</text>
        <text class="bk-act danger" bindtap="deleteBank">删除</text>
      </view>
    </view>

    <!-- 题型筛选收进 ⋯ 弹层（原来常驻一行 chips，把列表挤到首屏以下）
         2026-10-25：与错题本统一 —— 首屏只留一行「掌握状态」，其余进筛选面板 -->

    <!-- 掌握状态筛选（⚠️ 这一行是 E2E 断言 .bk-mf 恰 3 个的地方，别往里加第 4 个 .bk-mf） -->
    <view class="bk-mfilters">
      <view class="bk-mf {{mFilter === 'all' ? 'on' : ''}}" data-key="all" bindtap="pickMFilter">
        全部 <text class="bk-mf-n">{{totalAll}}</text>
      </view>
      <view class="bk-mf weak {{mFilter === 'weak' ? 'on' : ''}}" data-key="weak" bindtap="pickMFilter">
        薄弱 <text class="bk-mf-n">{{weakCount}}</text>
      </view>
      <view class="bk-mf learned {{mFilter === 'learned' ? 'on' : ''}}" data-key="learned" bindtap="pickMFilter">
        已掌握 <text class="bk-mf-n">{{learnedCount}}</text>
      </view>
      <!-- 题型 / 排序的入口（刻意不叫 .bk-mf，避免把 E2E 的「3 档」断言撑成 4） -->
      <view class="bk-mf-filter {{curType !== 'all' ? 'on' : ''}}" bindtap="openFilter">⚙ 筛选</view>
    </view>

    <!-- 搜索（点顶栏 🔍 才展开；原来常驻占一整行） -->
    <view class="bk-search" wx:if="{{searchOpen}}">
      <text class="bk-search-ic">🔍</text>
      <input
        class="bk-search-input"
        value="{{keyword}}"
        placeholder="搜题目 / 答案 / 释义"
        confirm-type="search"
        focus="{{searchOpen}}"
        bindinput="onSearch" />
      <text wx:if="{{keyword}}" class="bk-search-clr" bindtap="clearSearch">✕</text>
    </view>

    <!-- 列表：排序与题型在 ⋯ 筛选弹层里；统计并入标题副行 -->
    <scroll-view class="bk-list" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
      <view
        wx:for="{{shown}}"
        wx:key="k"
        class="bk-item {{item.disabled ? 'off' : ''}}">
        <view class="bk-dot {{item.status}}"></view>
        <view class="bk-item-main">
          <view class="bk-item-top">
            <text class="bk-q">{{item.q}}</text>
            <!-- 音标（2026-10-09）：英语词条构建期已补，汉字词条没有 -->
            <text wx:if="{{item.ipa}}" class="bk-ipa">/{{item.ipa}}/</text>
          </view>
          <!-- 词面与答案相同时（英文单词题 q === a）只显示一次，避免「apple apple」 -->
          <view class="bk-sub" wx:if="{{item.a !== item.q || item.hint}}">
            <text wx:if="{{item.a !== item.q}}" class="bk-a">{{item.a}}</text>
            <text wx:if="{{item.a !== item.q && item.hint}}" class="bk-sep"> · </text>
            <text>{{item.hint}}</text>
          </view>
          <view class="bk-meta">
            <text class="bk-tag">{{item.typeLabel}}</text>
            <text wx:if="{{item.bookLabel}}" class="bk-pill book">{{item.bookLabel}}</text>
            <text class="bk-src {{item.srcCls}}">{{item.srcLabel}}</text>
            <text wx:if="{{item.r}}" class="bk-pill ok">✓ {{item.r}}</text>
            <text wx:if="{{item.w}}" class="bk-pill bad">✗ {{item.w}}</text>
          </view>
        </view>
        <view class="bk-item-act">
          <view class="bk-btn-more" data-k="{{item.k}}" bindtap="openItemMore">···</view>
        </view>
      </view>

      <!-- 翻页（2026-10-08）：原来是「加载更多」追加式，改成页码替换式。
           追加式想回头看第 3 页得从头再加载，也看不出自己翻到哪了。 -->
      <view wx:if="{{totalPages > 1}}" class="bk-pager">
        <view class="bk-pager-btn {{pageNum <= 1 ? 'dis' : ''}}" data-dir="-1" bindtap="goPage">上一页</view>
        <view class="bk-pager-info">第 {{pageNum}} / {{totalPages}} 页 · 共 {{filteredTotal}} 条</view>
        <view class="bk-pager-btn {{pageNum >= totalPages ? 'dis' : ''}}" data-dir="1" bindtap="goPage">下一页</view>
      </view>
      <view wx:if="{{!shown.length}}" class="bk-empty">
        <view class="bk-empty-emoji">📭</view>
        <view class="bk-empty-text">这个筛选下还没有词条</view>
      </view>
      <view class="safe-gap"></view>
    </scroll-view>

    <!-- 新增 -->
    <view class="bk-fab" bindtap="openCreate">＋ 新增词条</view>

    <!-- 筛选弹层（题型 + 排序）：从常驻两行收进来，把首屏让给词条列表 -->
    <view wx:if="{{filterShow}}" class="filter-mask" bindtap="closeFilter">
      <view class="filter-sheet" catchtap="noop">
        <view class="filter-head">
          <text class="filter-title">筛选词条</text>
          <text class="filter-close" bindtap="closeFilter">完成</text>
        </view>

        <view class="filter-label">题型</view>
        <view class="filter-chips">
          <view wx:for="{{types}}" wx:key="key"
            class="filter-chip {{curType === item.key ? 'on' : ''}}"
            data-key="{{item.key}}" bindtap="pickType">{{item.label}}</view>
        </view>

        <view class="filter-label">排序（英文按字母、汉字按拼音，构建期已补 py 字段）</view>
        <view class="filter-chips">
          <view class="filter-chip {{sortDesc ? '' : 'on'}}" data-dir="1" bindtap="pickSort">A→Z · 正序</view>
          <view class="filter-chip {{sortDesc ? 'on' : ''}}" data-dir="-1" bindtap="pickSort">Z→A · 倒序</view>
        </view>
      </view>
    </view>
    </block>
  </block>

  <!-- ============ 词条编辑弹层 ============ -->
  <view wx:if="{{sheetShow}}" class="bk-mask" bindtap="closeSheet">
    <view class="bk-sheet" catchtap="noop">
      <view class="bk-sheet-title">{{sheetTitle}}</view>

      <view class="bk-fl">题型</view>
      <scroll-view class="bk-type-scroll" scroll-x="true" enable-flex="true">
        <view class="bk-row">
          <view
            wx:for="{{sheetTypeOptions}}"
            wx:key="code"
            class="bk-chip bk-chip--t {{fType === item.code ? 'on' : ''}}"
            data-code="{{item.code}}"
            bindtap="pickSheetType">{{item.name}}</view>
        </view>
      </scroll-view>

      <view class="bk-fl">题目</view>
      <input class="bk-input" value="{{fQ}}" data-f="fQ" bindinput="onField"
             placeholder="如 cat / *l*ph*nt / 守*待兔" />

      <view class="bk-fl">答案</view>
      <input class="bk-input" value="{{fA}}" data-f="fA" bindinput="onField"
             placeholder="如 a / elephant / 株" />

      <view class="bk-fl">释义 / 提示</view>
      <input class="bk-input" value="{{fHint}}" data-f="fHint" bindinput="onField"
             placeholder="如 猫 / 大象 / 比喻不主动努力" />

      <view class="bk-fl">干扰项（逗号分隔，可空）</view>
      <input class="bk-input" value="{{fD}}" data-f="fD" bindinput="onField" placeholder="如 e,o,i" />

      <view class="bk-fl">例句（可选）</view>
      <input class="bk-input" value="{{fEx}}" data-f="fEx" bindinput="onField"
             placeholder="如 An apple a day keeps the doctor away." />

      <view class="bk-sheet-btns">
        <view class="bk-btn ghost" bindtap="closeSheet">取消</view>
        <view class="bk-btn" bindtap="saveSheet">保存</view>
      </view>
      <view class="bk-sheet-tip">保存后立刻用于闯关出题；内置词条的题目不可改（改了会变成新词条）</view>
    </view>
  </view>

  <!-- ============ 新建 / 重命名题库弹层 ============ -->
  <view wx:if="{{bankSheetShow}}" class="bk-mask" bindtap="closeBankSheet">
    <view class="bk-sheet" catchtap="noop">
      <view class="bk-sheet-title">{{bankSheetMode === 'rename' ? '重命名题库' : '新建题库'}}</view>
      <view class="bk-fl">题库名</view>
      <input class="bk-input" value="{{bName}}" bindinput="onBankName" placeholder="如 我家错词本 / 三年级上册" />
      <view class="bk-fl">挂在哪个学段（作为该学段的附加题源）</view>
      <scroll-view class="bk-type-scroll" scroll-x="true" enable-flex="true">
        <view class="bk-row">
          <view
            wx:for="{{grades}}"
            wx:key="key"
            class="bk-chip {{bGradeIndex === index ? 'on' : ''}}"
            data-index="{{index}}"
            bindtap="pickBankGrade">{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="bk-sheet-btns">
        <view class="bk-btn ghost" bindtap="closeBankSheet">取消</view>
        <view class="bk-btn" bindtap="saveBankSheet">{{bankSheetMode === 'rename' ? '保存' : '创建'}}</view>
      </view>
      <view class="bk-sheet-tip">闯关时会和该学段的内置词库一起出题；暂停后不再参与出题，词条仍保留</view>
    </view>
  </view>

  <!-- 全局年级选择器：与「我的 → 当前年级」同一个组件 -->
  <grade-picker visible="{{gradePickerVisible}}" value="{{gradeKey}}"
    bind:pick="onGradePick" bind:close="onGradeClose" />
</view>
