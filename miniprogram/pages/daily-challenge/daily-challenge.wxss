/* 每日挑战赛 */
.dc-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: var(--sky-grad-soft);
}

.dc-head { display: flex; align-items: center; gap: 20rpx; }
.dc-head-t { flex: 1; }
.dc-title { font-size: var(--fs-title); font-weight: 900; color: var(--ink-deep); letter-spacing: 2rpx; }
.dc-sub { font-size: var(--fs-cap); color: var(--ink-sub); margin-top: 6rpx; }

.dc-card {
  background: var(--white);
  border-radius: 28rpx;
  box-shadow: var(--clay-3);
  padding: 36rpx 32rpx;
  margin-top: 28rpx;
}
.dc-loading { text-align: center; color: var(--ink-sub); font-size: var(--fs-body); }
.dc-empty { text-align: center; }
.dc-empty-emoji { font-size: 90rpx; }
.dc-empty-t { margin: 16rpx 0 28rpx; color: var(--ink-sub); font-size: var(--fs-body); }
.dc-retry { margin: 0 auto; }

/* 准备态 */
.dc-hero { text-align: center; }
.dc-hero-emoji { font-size: 110rpx; }
.dc-hero-t { font-size: var(--fs-title); font-weight: 900; color: var(--ink-deep); margin-top: 8rpx; }
.dc-hero-s { font-size: var(--fs-cap); color: var(--ink-sub); line-height: 1.7; margin-top: 14rpx; }
.dc-start { margin-top: 32rpx; }
.dc-best {
  margin-top: 22rpx;
  font-size: var(--fs-cap);
  font-weight: 800;
  color: var(--pri);
}

/* 答题态 */
.dc-progress { margin-top: 28rpx; }
.dc-progress-text { font-size: var(--fs-cap); font-weight: 800; color: var(--ink-deep); }
.dc-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, .7);
  border-radius: 999rpx;
  margin-top: 10rpx;
  overflow: hidden;
}
.dc-bar-in { height: 100%; background: linear-gradient(90deg, var(--blue), var(--pri)); border-radius: 999rpx; transition: width .2s; }

.dc-question { text-align: center; }
.dc-word {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--ink-deep);
  letter-spacing: 4rpx;
  word-break: break-all;
}
.dc-qsub { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 10rpx; }

.dc-opts { margin-top: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.dc-opt {
  background: var(--white);
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  font-size: var(--fs-strong);
  font-weight: 700;
  color: var(--ink-deep);
  box-shadow: var(--clay-2);
}
.dc-opt:active { transform: translateY(2rpx); }
.dc-opt.ok { background: var(--green); color: var(--white); }
.dc-opt.no { background: #ff8fae; color: var(--white); }

/* 结算态 */
.dc-result { text-align: center; }
.dc-result-emoji { font-size: 110rpx; }
.dc-result-t { font-size: var(--fs-display); font-weight: 900; color: var(--ink-deep); margin-top: 8rpx; }
.dc-result-s { font-size: var(--fs-body); color: var(--ink-sub); margin-top: 10rpx; }
.dc-result-rank { font-size: var(--fs-body); font-weight: 900; color: var(--pri); margin-top: 14rpx; }
.dc-again { margin-top: 30rpx; }
.dc-login-tip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
.dc-login-btn { margin: 0; }

/* 榜单 */
.dc-rank { margin-top: 32rpx; }
.dc-rank-head { display: flex; align-items: baseline; justify-content: space-between; }
.dc-rank-title { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); }
.dc-rank-sub { font-size: var(--fs-cap); color: var(--ink-weak); }
.dc-rank-empty {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, .8);
  border-radius: 28rpx;
  padding: 36rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink-weak);
}
.dc-rank-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-top: 14rpx;
  box-shadow: var(--clay-2);
}
.dc-rank-row.me { outline: 4rpx solid var(--pri); }
.dc-rank-no { width: 56rpx; text-align: center; font-size: var(--fs-body); font-weight: 900; color: var(--ink-sub); }
.dc-rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sky-3);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-avatar-img { width: 100%; height: 100%; }
.dc-avatar-txt { font-size: var(--fs-body); font-weight: 900; color: var(--blue); }
.dc-rank-name {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--ink-deep);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dc-me {
  margin-left: 10rpx;
  font-size: var(--fs-cap);
  color: var(--white);
  background: var(--pri);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.dc-rank-score { text-align: right; }
.dc-rank-correct { display: block; font-size: var(--fs-body); font-weight: 900; color: var(--green-ink); }
.dc-rank-time { display: block; font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 2rpx; }

.dc-foot { text-align: center; font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 28rpx; }
