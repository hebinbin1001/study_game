/* 每日挑战赛 */
.dc-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}

.dc-head { display: flex; align-items: center; gap: 20rpx; }
.dc-head-t { flex: 1; }
.dc-title { font-size: 38rpx; font-weight: 900; color: #2c4a6b; letter-spacing: 2rpx; }
.dc-sub { font-size: 22rpx; color: #5c7f9e; margin-top: 6rpx; }

.dc-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, .06), 0 18rpx 36rpx rgba(0, 0, 0, .08);
  padding: 36rpx 32rpx;
  margin-top: 28rpx;
}
.dc-loading { text-align: center; color: #5c7f9e; font-size: 28rpx; }
.dc-empty { text-align: center; }
.dc-empty-emoji { font-size: 90rpx; }
.dc-empty-t { margin: 16rpx 0 28rpx; color: #5c7f9e; font-size: 28rpx; }
.dc-retry { margin: 0 auto; }

/* 准备态 */
.dc-hero { text-align: center; }
.dc-hero-emoji { font-size: 110rpx; }
.dc-hero-t { font-size: 38rpx; font-weight: 900; color: #2c4a6b; margin-top: 8rpx; }
.dc-hero-s { font-size: 24rpx; color: #5c7f9e; line-height: 1.7; margin-top: 14rpx; }
.dc-start { margin-top: 32rpx; }
.dc-best {
  margin-top: 22rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #ff8f00;
}

/* 答题态 */
.dc-progress { margin-top: 28rpx; }
.dc-progress-text { font-size: 24rpx; font-weight: 800; color: #2c4a6b; }
.dc-bar {
  height: 16rpx;
  background: rgba(255, 255, 255, .7);
  border-radius: 999rpx;
  margin-top: 10rpx;
  overflow: hidden;
}
.dc-bar-in { height: 100%; background: linear-gradient(90deg, #4cc9f0, #ffb703); border-radius: 999rpx; transition: width .2s; }

.dc-question { text-align: center; }
.dc-word {
  font-size: 72rpx;
  font-weight: 900;
  color: #2c4a6b;
  letter-spacing: 4rpx;
  word-break: break-all;
}
.dc-qsub { font-size: 24rpx; color: #8a9bb5; margin-top: 10rpx; }

.dc-opts { margin-top: 26rpx; display: flex; flex-direction: column; gap: 18rpx; }
.dc-opt {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #2c4a6b;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .05), 0 12rpx 24rpx rgba(0, 0, 0, .06);
}
.dc-opt:active { transform: translateY(2rpx); }
.dc-opt.ok { background: #7bd389; color: #fff; }
.dc-opt.no { background: #ff8fae; color: #fff; }

/* 结算态 */
.dc-result { text-align: center; }
.dc-result-emoji { font-size: 110rpx; }
.dc-result-t { font-size: 44rpx; font-weight: 900; color: #2c4a6b; margin-top: 8rpx; }
.dc-result-s { font-size: 26rpx; color: #5c7f9e; margin-top: 10rpx; }
.dc-result-rank { font-size: 28rpx; font-weight: 900; color: #ff8f00; margin-top: 14rpx; }
.dc-again { margin-top: 30rpx; }
.dc-login-tip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #8a9bb5;
}
.dc-login-btn { margin: 0; }

/* 榜单 */
.dc-rank { margin-top: 32rpx; }
.dc-rank-head { display: flex; align-items: baseline; justify-content: space-between; }
.dc-rank-title { font-size: 30rpx; font-weight: 900; color: #2c4a6b; }
.dc-rank-sub { font-size: 22rpx; color: #8a9bb5; }
.dc-rank-empty {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, .8);
  border-radius: 24rpx;
  padding: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a9bb5;
}
.dc-rank-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-top: 14rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .04);
}
.dc-rank-row.me { outline: 4rpx solid #ffb703; }
.dc-rank-no { width: 56rpx; text-align: center; font-size: 28rpx; font-weight: 900; color: #5c7f9e; }
.dc-rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d8efff;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-avatar-img { width: 100%; height: 100%; }
.dc-avatar-txt { font-size: 26rpx; font-weight: 900; color: #4cc9f0; }
.dc-rank-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #2c4a6b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dc-me {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #fff;
  background: #ffb703;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}
.dc-rank-score { text-align: right; }
.dc-rank-correct { display: block; font-size: 28rpx; font-weight: 900; color: #2e8b57; }
.dc-rank-time { display: block; font-size: 20rpx; color: #8a9bb5; margin-top: 2rpx; }

.dc-foot { text-align: center; font-size: 22rpx; color: #8a9bb5; margin-top: 28rpx; }
