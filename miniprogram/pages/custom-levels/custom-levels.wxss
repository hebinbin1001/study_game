/* 自定义题库中心（B4） */
.page-custom {
  height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: var(--sky-grad-soft);
}
.hub-head { display: flex; align-items: center; gap: 20rpx; flex: 0 0 auto; }
.hub-title { flex: 1; font-size: var(--fs-title); font-weight: 900; color: var(--white); text-shadow: 0 4rpx 0 rgba(0,0,0,.1); }
.hub-new {
  background: var(--pri); color: var(--white);
  border-radius: 999rpx; padding: 12rpx 28rpx;
  font-size: var(--fs-body); font-weight: 900;
  box-shadow: var(--clay-2);
}

.tabs { display: flex; gap: 20rpx; margin: 24rpx 0 16rpx; flex: 0 0 auto; }
.tab {
  flex: 1; text-align: center;
  background: rgba(255,255,255,.85); color: var(--ink-sub);
  border-radius: 999rpx; padding: 18rpx 0;
  font-size: var(--fs-body); font-weight: 800;
}
.tab.active { background: var(--pri); color: var(--white); }

.hub-scroll { flex: 1 1 auto; min-height: 0; }
.lv-card {
  background: var(--white); border-radius: 28rpx;
  padding: 24rpx 26rpx; margin-bottom: 20rpx;
  box-shadow: var(--clay-2);
}
.lv-head { display: flex; align-items: center; gap: 14rpx; }
.lv-title { flex: 1; font-size: var(--fs-strong); font-weight: 900; color: var(--ink); }
.lv-status { font-size: var(--fs-cap); font-weight: 800; padding: 6rpx 18rpx; border-radius: 999rpx; background: var(--surface); color: var(--ink-weak); }
.lv-status.ok { background: var(--soft-green); color: var(--green-ink); }
.lv-status.pending { background: var(--soft-gold); color: var(--pri); }
.lv-status.no { background: #fde8e8; color: var(--danger-ink); }
.lv-meta { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 8rpx; }
.lv-actions { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.act {
  background: var(--surface); color: var(--ink-sub);
  border-radius: 999rpx; padding: 10rpx 22rpx;
  font-size: var(--fs-cap); font-weight: 800;
}
.act-ok { background: var(--soft-green); color: var(--green-ink); }
.act:active { opacity: .8; }

.public-hint { font-size: var(--fs-cap); color: var(--white); opacity: .92; margin: 0 0 16rpx; }
.lv-author { font-size: var(--fs-cap); color: var(--ink-weak); }
.import-btn {
  text-align: center; color: var(--ink); font-size: var(--fs-body); font-weight: 800;
  background: rgba(255,255,255,.9); border-radius: 999rpx;
  padding: 22rpx 0; margin-top: 8rpx;
}
.empty { text-align: center; padding: 80rpx 30rpx; color: var(--ink); }
.e-emoji { font-size: 90rpx; }
.e-t { font-size: var(--fs-strong); font-weight: 900; margin-top: 16rpx; }
.e-s { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 8rpx; line-height: 1.6; }
.safe-gap { height: calc(env(safe-area-inset-bottom) + 24rpx); }
