<!--
  游戏页：Canvas 2D + HUD + 选项按钮，对接 game/engine.js 主循环
  关联 REQ：REQ-GAME-2（Canvas+HUD 分层）、REQ-GAME-3（命数/题号）、
           REQ-GAME-6/7/8/9/10（答对/答错/下沉/连击/反馈）、
           REQ-NFR-1（HUD 仅变化时 setData）、REQ-NFR-3（dpr 适配）
  平移来源：prototype/index.html 第 156-168 行游戏页 UI 结构
-->
<view class="game-page">

  <!-- HUD 层：命数 / 得分 / 题号 / 声音（REQ-GAME-3，白色卡通胶囊卡） -->
  <view class="hud">
    <view class="hud-chip hud-lives">{{livesText}}</view>
    <view class="hud-chip hud-score">得分 {{score}}</view>
    <view class="hud-chip hud-qnum">第 {{qIndex}}/{{totalQ}} 题</view>
    <view class="hud-chip hud-icon" catchtap="onToggleSound">{{soundOn ? '🔊' : '🔇'}}</view>
    <view class="hud-chip hud-icon hud-pause" catchtap="onPause">⏸</view>
  </view>

  <!-- 形态表现行（M7：boss 血条 / rush 倒计时；classic 不显示） -->
  <view wx:if="{{mode !== 'classic'}}" class="mode-deco">
    <block wx:if="{{mode === 'boss'}}">
      <view class="mode-label">{{bossFury ? '🐲 BOSS 暴怒！' : '🐲 BOSS'}}</view>
      <view class="hp-row {{bossFury ? 'fury' : ''}}">
        <view wx:for="{{hpCells}}" wx:key="*this" class="hp-cell {{index < bossRemain ? 'on' : ''}}"></view>
      </view>
    </block>
    <block wx:else>
      <view class="rush-head">
        <text class="rush-title">⚡ 极速</text>
        <text class="rush-seconds {{rushLow ? 'low' : ''}}">{{rushShow}}</text>
        <text class="rush-combo" wx:if="{{comboShow > 1}}">×{{comboShow}}</text>
      </view>
      <view class="rush-track">
        <view class="rush-fill {{rushLow ? 'low' : ''}}" style="width: {{rushPct}}%;"></view>
      </view>
    </block>
    <view wx:if="{{modeFxText}}" class="mode-fx">{{modeFxText}}</view>
  </view>

  <!--
    游戏画布：Canvas 2D 新接口，逻辑尺寸 390×500（与 config.js W/H 一致）
    onReady 中经 createSelectorQuery 获取 node + ctx，dpr 适配后注入 engine
    关联 REQ-GAME-2、REQ-NFR-3
  -->
  <canvas type="2d" id="game-canvas" class="game-canvas {{bossHit ? 'hit' : ''}}"></canvas>

  <!-- 底部面板：提示文字 + 选项按钮（REQ-GAME-2 分层） -->
  <view class="bottom-panel">
    <!-- 提示文字：答对/答错/逼近时由 engine.onTip 回调驱动 -->
    <view class="tip">{{tip}}</view>

    <!--
      选项按钮区：wx:for 渲染选项
      - 字符级题：4 个字符按钮（item.letter）
      - 词级题（H2-B）：按钮文本为整词 item.display（英文大写），
        item.wide=true 走宽版样式（自动宽度/换行）
      catchtap 阻止冒泡并转发给 onOptionTap → engine.fire(opt)
      关联 REQ-GAME-6/7（点选项触发答对/答错流程）
    -->
    <view class="options">
      <view
        wx:for="{{options}}"
        wx:key="letter"
        class="option {{item.colorClass}} {{item.used ? 'used' : ''}} {{item.wide ? 'wide' : ''}} {{penLock ? 'pen' : ''}} {{showAnswer && item.correct ? 'ok' : ''}} {{showAnswer && item.used ? 'bad' : ''}}"
        catchtap="onOptionTap"
        data-index="{{index}}"
      >{{item.display || item.letter}}</view>
    </view>
  </view>

  <!-- 连击提示浮层（REQ-GAME-9，连对 2/3/5 题时由 engine.onCombo 触发） -->
  <view wx:if="{{comboText}}" class="combo-toast">{{comboText}}</view>

  <!-- 暂停遮罩（R5）：不透明底盖住画面，暂停期间看不到题目与计时 -->
  <view wx:if="{{paused}}" class="pause-mask">
    <view class="pause-card">
      <view class="pause-emoji">⏸</view>
      <view class="pause-title">已暂停</view>
      <view class="pause-tip">题目与计时已隐藏</view>
      <view class="pause-btns">
        <view class="pause-btn pause-btn--ghost" catchtap="onQuit">返回</view>
        <view class="pause-btn" catchtap="onResume">继续</view>
      </view>
    </view>
  </view>

  <!-- 新手引导蒙层（M6-L：首次进入 3 步，点击任意处下一步/开始） -->
  <view wx:if="{{tutorialStep > 0}}" class="tutorial-mask" catchtap="onTutorialTap">
    <view class="tutorial-card">
      <view class="tutorial-emoji">{{tutorialStep === 1 ? '🐱' : (tutorialStep === 2 ? '💥' : '❤️')}}</view>
      <view class="tutorial-title">{{tutorialTitle}}</view>
      <view class="tutorial-desc">{{tutorialDesc}}</view>
      <view class="tutorial-dots">
        <view class="tutorial-dot {{tutorialStep === 1 ? 'on' : ''}}"></view>
        <view class="tutorial-dot {{tutorialStep === 2 ? 'on' : ''}}"></view>
        <view class="tutorial-dot {{tutorialStep === 3 ? 'on' : ''}}"></view>
      </view>
      <view class="tutorial-btn">{{tutorialStep < 3 ? '下一步' : '开始闯关！'}}</view>
    </view>
  </view>

  <!-- BOSS 击破大闪层（M7，结算跳转前短暂展示） -->
  <view wx:if="{{bossDefeat}}" class="defeat-flash">💥 BOSS 击破！</view>

</view>
