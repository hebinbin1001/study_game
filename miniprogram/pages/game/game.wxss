/**
 * 游戏页样式：Canvas 2D + HUD + 选项按钮
 * 关联 REQ：REQ-GAME-2（分层布局）、REQ-GAME-3（命数/题号）、REQ-NFR-3（画布几何）
 * 平移来源：prototype/index.html 第 74-94 行游戏页样式
 */

/* ============ 页面容器 ============ */
/* 暖色天空渐变背景，纵向布局；内容超出时允许滚动兜底（小屏机型） */
.game-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 24rpx;
  /* 底部安全区适配：全面屏底部选项按钮不被 Home 指示条遮挡 */
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 70%, #eaf8ff 100%);
}

/* ============ HUD 层 ============ */
/* 命数 / 得分 / 题号：白色卡通胶囊卡横排（配色统一引用 app.wxss 设计 token） */
.hud {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* HUD 胶囊卡：白色半透明底 + 小号硬阴影（卡通按压风格） */
.hud-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08), 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 命数：粉色 ❤ 字符（token --pink） */
.hud-lives {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--pink, #ff5d8f);
  letter-spacing: 4rpx;
  min-width: 120rpx;
}

/* 得分：墨色粗体（token --ink，白底上用深色保证对比度） */
.hud-score {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--ink, #3a3a5c);
}

/* 题号：次级灰蓝粗体（token --text-sub） */
.hud-qnum {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-sub, #5c7f9e);
  min-width: 160rpx;
}

/* 声音开关：窄胶囊（喇叭切换，catchtap） */
.hud-sound {
  width: 76rpx;
  padding: 0;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* ============ 游戏画布 ============ */
/* 逻辑尺寸 390×500（与 config.js W/H 一致），dpr 适配在 onReady 中处理 */
.game-canvas {
  /* 响应式：宽占满内容区（702rpx），高按 390:500 比例（702 × 500/390 ≈ 900rpx），
     渲染坐标系仍为 390×500，由 game.js onReady 中 ctx.scale 等比缩放适配。
     宽高比必须严格保持 390:500，否则与 ctx.scale 等比缩放不一致会导致画面变形 */
  width: 100%;
  height: 900rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 70%, #eaf8ff 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* ============ 底部面板 ============ */
/* 提示文字 + 选项按钮垂直堆叠 */
.bottom-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  gap: 16rpx;
}

/* 提示文字：答对/答错/逼近时由 engine.onTip 回调驱动（token --text-sub，M6-4 放大） */
.tip {
  font-size: 30rpx;
  color: var(--text-sub, #5c7f9e);
  font-weight: 700;
  text-align: center;
  min-height: 36rpx;
  line-height: 1.4;
  padding: 0 16rpx;
}

/* ============ 选项按钮 ============ */
/* 字符级：4 个字符选项横排居中；词级整词较长，允许换行成两行（H2-B） */
.options {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx 20rpx;
  width: 100%;
}

/* 单个选项按钮：卡通硬阴影风格（平移原型 .char-btn） */
.option {
  width: 132rpx;
  height: 132rpx;
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.18), 0 24rpx 44rpx rgba(0, 0, 0, 0.14);
  transition: transform 0.06s, box-shadow 0.06s, opacity 0.15s;
}

/* 词级整词按钮（H2-B）：胶囊形、自动宽度，容纳长整词（如 COMPETITION） */
.option.wide {
  width: auto;
  min-width: 120rpx;
  height: 96rpx;
  padding: 0 30rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
  max-width: 46%;
  word-break: keep-all;
}

/* 按下效果：下沉 + 阴影收缩 */
.option:active {
  transform: translateY(6rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.18);
}

/* 已用（选错）的选项置灰禁用 */
.option.used {
  opacity: 0.25;
}

/* 5 种配色循环（对应原型 .char-btn.c0~c4，统一引用设计系统 token） */
.option.c0 { background: var(--pink, #ff5d8f); }    /* 粉 */
.option.c1 { background: var(--blue, #4cc9f0); }    /* 蓝 */
.option.c2 { background: var(--orange, #ffb703); }  /* 橙 */
.option.c3 { background: var(--green, #7bd389); }   /* 绿 */
.option.c4 { background: var(--purple, #b388ff); }  /* 紫 */

/* ============ 连击提示浮层 ============ */
/* 连对 2/3/5 题时由 engine.onCombo 触发，800ms 自动消失（墨底金字，token --ink/--gold） */
.combo-toast {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(58, 58, 92, 0.9);
  color: var(--gold, #ffd166);
  padding: 16rpx 36rpx;
  border-radius: 44rpx;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  z-index: 99;
  white-space: nowrap;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.25);
  animation: comboPop 0.8s ease-out forwards;
}

/* 连击提示弹出动画：从下方淡入 → 放大回弹 → 上浮淡出 */
@keyframes comboPop {
  0%   { opacity: 0; transform: translateX(-50%) translateY(20rpx) scale(0.8); }
  20%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.1); }
  40%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-40rpx) scale(1); }
}

/* ============ 新手引导蒙层（M6-L） ============ */
.tutorial-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(30, 40, 60, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.tutorial-card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 44rpx;
  padding: 56rpx 44rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 0 rgba(0, 0, 0, 0.1), 0 30rpx 60rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}
.tutorial-emoji {
  font-size: 100rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.tutorial-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3a3a5c;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}
.tutorial-desc {
  font-size: 28rpx;
  color: #5c7f9e;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.tutorial-dots {
  display: flex;
  gap: 14rpx;
  margin-bottom: 36rpx;
}
.tutorial-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d5dde8;
}
.tutorial-dot.on {
  background: #4cc9f0;
}
.tutorial-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #ffb703;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.12);
}

/* ============ 对局形态表现行（M7：boss 血条 / rush 倒计时） ============ */
.mode-deco {
  width: 100%;
  box-sizing: border-box;
  margin: 10rpx 0 0;
  padding: 12rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.05), 0 12rpx 24rpx rgba(0, 0, 0, 0.07);
  position: relative;
}
.mode-label {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ink, #3a3a5c);
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* boss 血条 */
.hp-row {
  display: flex;
  gap: 6rpx;
  margin-top: 10rpx;
}
.hp-cell {
  flex: 1;
  height: 18rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.1);
  transition: background 0.2s;
}
.hp-cell.on {
  background: linear-gradient(180deg, #ff8fae, #ff5d8f);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.15);
}
.hp-row.fury .hp-cell.on {
  background: linear-gradient(180deg, #ff5a5a, #e62e2e);
  animation: hpPulse 0.5s ease-in-out infinite alternate;
}
@keyframes hpPulse {
  from { transform: scaleY(1); }
  to { transform: scaleY(1.35); }
}
/* 受击顿帧：canvas 容器水平抖动（表现层） */
.game-canvas.hit {
  animation: bossHitShake 0.14s linear;
}
@keyframes bossHitShake {
  0% { transform: translateX(0); }
  25% { transform: translateX(-6rpx); }
  50% { transform: translateX(4rpx); }
  75% { transform: translateX(-3rpx); }
  100% { transform: translateX(0); }
}

/* rush 倒计时条 */
.rush-track {
  height: 20rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin-top: 10rpx;
}
.rush-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #4cc9f0, #7bd389);
  transition: width 0.18s linear;
}
.rush-fill.low {
  background: linear-gradient(90deg, #ffb703, #ff5a5a);
  animation: hpPulse 0.4s ease-in-out infinite alternate;
}
.rush-combo {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #ffb703;
}

/* 极速形态大秒表（与经典拉开差异：醒目倒计时 + 低秒红闪） */
.rush-head {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-top: 4rpx;
}
.rush-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #5c7f9e;
  letter-spacing: 2rpx;
}
.rush-seconds {
  font-size: 92rpx;
  font-weight: 900;
  line-height: 1;
  color: #4cc9f0;
  font-variant-numeric: tabular-nums;
  min-width: 110rpx;
  text-align: center;
}
.rush-seconds.low {
  color: #ff5a5a;
  animation: hpPulse 0.5s ease-in-out infinite alternate;
}
.rush-head .rush-combo {
  font-size: 32rpx;
  margin-left: 0;
}

/* 形态飘字（命中/挥击/击破文案） */
.mode-fx {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  font-weight: 900;
  color: #ff5d8f;
  animation: fxIn 0.35s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  text-shadow: 0 2rpx 0 #ffffff;
}
@keyframes fxIn {
  0% { opacity: 0; transform: translateY(8rpx) scale(0.7); }
  60% { opacity: 1; transform: translateY(0) scale(1.15); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 竞速惩罚锁：选项禁点视觉 */
.option.pen {
  opacity: 0.45;
  pointer-events: none;
}

/* ============ 形态选择层（M7） ============ */
.pick-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 400;
  background: rgba(20, 34, 56, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-card {
  width: 640rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 36rpx 30rpx 30rpx;
  box-shadow: 0 18rpx 0 rgba(0, 0, 0, 0.12), 0 34rpx 70rpx rgba(0, 0, 0, 0.25);
}
.pick-title {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--ink, #3a3a5c);
  text-align: center;
}
.pick-sub {
  font-size: 22rpx;
  color: #8a9bb5;
  text-align: center;
  margin: 8rpx 0 22rpx;
  font-weight: 600;
}
.pick-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.pick-item {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  border: 4rpx solid #eef2f8;
  background: #fafcff;
  transition: border-color 0.15s, transform 0.12s;
}
.pick-item.on {
  border-color: #ffb703;
  background: #fff8e6;
  transform: translateY(-2rpx);
}
.pick-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}
.pick-body {
  flex: 1;
}
.pick-name {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--ink, #3a3a5c);
}
.pick-desc {
  font-size: 22rpx;
  color: #8a9bb5;
  margin-top: 4rpx;
}
.pick-check {
  font-size: 34rpx;
  color: #7bd389;
  font-weight: 900;
}
.pick-start {
  margin-top: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #ffb703;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.12);
}
.pick-start:active {
  transform: translateY(4rpx);
  box-shadow: 0 5rpx 0 rgba(0, 0, 0, 0.12);
}

/* BOSS 击破大闪层 */
.defeat-flash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
  color: #ff5a5a;
  letter-spacing: 4rpx;
  animation: defeatIn 0.4s cubic-bezier(0.2, 1.4, 0.4, 1) both;
}
@keyframes defeatIn {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}
