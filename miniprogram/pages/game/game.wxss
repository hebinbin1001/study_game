/**
 * 游戏页 · 字母射击（2026-09-18 改版）
 *
 * 全部尺寸用 rpx + flex，不写死像素（真机不同宽度都能自适应）。
 * 动画只用 transform / opacity，交给合成层，避免真机掉帧。
 * 视觉沿用项目浅色卡通风。
 */

.gs-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 55%, #eaf8ff 100%);
}

/* ============ HUD ============ */
.gs-hud {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .88);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .06);
}
.gs-icon {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  color: #5c7f9e;
  background: #eaf3fb;
}
.gs-dots {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  overflow: hidden;
}
.gs-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cfe0ee;
}
.gs-dot.done { background: #6fcf97; }
.gs-dot.cur { background: #ffb703; transform: scale(1.35); }
.gs-stats {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.gs-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f2f8fd;
  font-size: 22rpx;
  font-weight: 800;
  color: #5c7f9e;
}
.gs-chip-combo { color: #e8722c; }
.gs-chip-shield { color: #e8556d; letter-spacing: -2rpx; }

/* ============ 战场 ============ */
.gs-stage {
  position: relative;
  flex: 1 1 auto;
  margin-top: 16rpx;
  padding: 20rpx 20rpx 24rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 20% 18%, rgba(255, 255, 255, .85), transparent 45%),
    linear-gradient(180deg, #ffffff 0%, #eef7ff 100%);
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, .06), inset 0 0 0 2rpx rgba(143, 208, 255, .5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.gs-shake { animation: gsShake .3s cubic-bezier(.36, .07, .19, .97); }
@keyframes gsShake {
  0%, 100% { transform: translate(0, 0); }
  20% { transform: translate(-10rpx, 5rpx); }
  40% { transform: translate(10rpx, -6rpx); }
  60% { transform: translate(-7rpx, -4rpx); }
  80% { transform: translate(7rpx, 4rpx); }
}

/* 题面横幅 */
.gs-quest {
  flex: 0 0 auto;
  text-align: center;
}
.gs-quest-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.gs-quest-label {
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #7b93ad;
}
.gs-quest-stage {
  font-size: 20rpx;
  font-weight: 700;
  color: #4a90d9;
  background: #e6f3ff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.gs-quest-answer {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 900;
  color: #2f5470;
  line-height: 1.35;
  word-break: break-all;
}

/* Boss 血条 */
.gs-hp {
  flex: 0 0 auto;
  margin: 18rpx auto 0;
  width: 70%;
  height: 20rpx;
  border-radius: 999rpx;
  background: #dfeaf5;
  overflow: hidden;
}
.gs-hp-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff8f6b, #ff5f6d 60%, #ffc94d);
  transition: width .3s cubic-bezier(.34, 1.56, .64, 1);
}

/* 对阵区 */
.gs-field {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 10rpx 0;
  min-height: 260rpx;
}
.gs-hero, .gs-boss {
  position: relative;
  width: 200rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gs-art {
  width: 100%;
  height: 100%;
}
.gs-art-emoji {
  font-size: 120rpx;
  line-height: 1;
}
.gs-hero { animation: gsIdle 2.6s ease-in-out infinite; }
@keyframes gsIdle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.gs-hero-hurt { animation: gsHeroHurt .55s cubic-bezier(.36, .07, .19, .97); }
@keyframes gsHeroHurt {
  0% { transform: translateY(0) rotate(0); }
  25% { transform: translateY(10rpx) rotate(-12deg); filter: brightness(1.5) hue-rotate(-30deg); }
  55% { transform: translateY(-10rpx) rotate(10deg); }
  100% { transform: translateY(0) rotate(0); }
}
.gs-boss { animation: gsFloat 3.2s ease-in-out infinite; }
@keyframes gsFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-16rpx) scale(1.03); }
}
.gs-boss-hit { animation: gsBossHit .34s cubic-bezier(.36, .07, .19, .97); }
@keyframes gsBossHit {
  0% { transform: scale(1); filter: brightness(2.6) saturate(.3); }
  40% { transform: scale(1.18) rotate(-6deg); filter: brightness(2.2); }
  100% { transform: scale(1); filter: brightness(1); }
}
.gs-boss-charging { animation: gsCharge .32s ease-in-out; }
@keyframes gsCharge {
  0% { transform: scale(1); }
  50% { transform: scale(1.2) rotate(-4deg); filter: brightness(1.5) hue-rotate(-30deg); }
  100% { transform: scale(1); }
}
.gs-clash {
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #c3d4e3;
  transition: color .2s, transform .2s;
}
.gs-clash.danger {
  color: #ff4d6a;
  transform: scale(1.25);
}

/* 词槽 */
.gs-slots {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  min-height: 96rpx;
}
.gs-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 84rpx;
  padding: 0 8rpx;
  border-bottom: 6rpx solid #cfe0ee;
  font-size: 52rpx;
  font-weight: 900;
  color: #b7c9d9;
}
.gs-slot.on {
  color: #2f5470;
  border-bottom-color: #4a90d9;
}
.gs-slot--word {
  min-width: 160rpx;
  font-size: 46rpx;
  color: #2f5470;
  border-bottom-color: #4a90d9;
}
.gs-head, .gs-tail {
  font-size: 34rpx;
  font-weight: 800;
  color: #40617c;
  padding-bottom: 18rpx;
}

/* 浮层反馈 */
.gs-float {
  position: absolute;
  left: 50%;
  top: 46%;
  font-weight: 900;
  pointer-events: none;
  animation: gsFloatUp .9s cubic-bezier(.2, .85, .4, 1) forwards;
}
.gs-float--hit { font-size: 44rpx; color: #2fa96b; }
.gs-float--miss {
  font-size: 52rpx;
  color: #ff5f6d;
  letter-spacing: 4rpx;
}
.gs-float--dmg { font-size: 42rpx; color: #ff4d6a; margin-top: 70rpx; }
@keyframes gsFloatUp {
  0% { transform: translate(-50%, 0) scale(.4); opacity: 0; }
  25% { transform: translate(-50%, -30rpx) scale(1.15); opacity: 1; }
  100% { transform: translate(-50%, -140rpx) scale(.9); opacity: 0; }
}

/* ============ 字母 / 词卡面板 ============ */
.gs-pad-wrap {
  flex: 0 0 auto;
  margin-top: 16rpx;
  padding: 14rpx 18rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .9);
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .06);
}
.gs-pad-label {
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #93a9bd;
  margin-bottom: 12rpx;
}
.gs-pad {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
.gs-bullet {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #3f5a72;
  background: linear-gradient(180deg, #ffffff, #e8f3fc);
  border: 2rpx solid #cfe0ee;
  box-shadow: 0 8rpx 0 #cfe0ee;
  transition: transform .14s, opacity .2s, box-shadow .14s;
}
.gs-bullet:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 0 #cfe0ee;
}
.gs-bullet.used {
  opacity: .18;
  transform: none;
  box-shadow: none;
  pointer-events: none;
}
.gs-bullet--word {
  width: auto;
  min-width: 150rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
}
.gs-tip {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7b93ad;
  line-height: 1.5;
}

/* 连击浮层 */
.gs-combo-toast {
  position: fixed;
  left: 50%;
  top: 34%;
  transform: translateX(-50%);
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: rgba(255, 183, 3, .95);
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 183, 3, .5);
  animation: gsPop .5s cubic-bezier(.34, 1.56, .64, 1);
  z-index: 40;
}
@keyframes gsPop {
  0% { transform: translateX(-50%) scale(.4); opacity: 0; }
  60% { transform: translateX(-50%) scale(1.15); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}

/* ============ 遮罩（暂停 / 引导） ============ */
.gs-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(23, 46, 66, .55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}
.gs-card {
  width: 560rpx;
  padding: 44rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, .2);
}
.gs-card-emoji { font-size: 96rpx; line-height: 1; }
.gs-card-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: #2f5470;
}
.gs-card-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #7b93ad;
  line-height: 1.6;
}
.gs-card-dots {
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}
.gs-card-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #dce8f2;
}
.gs-card-dot.on { background: #ffb703; }
.gs-card-btns {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}
.gs-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #ffb703;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .1);
}
.gs-btn--ghost {
  background: #eef5fb;
  color: #7b93ad;
}
.gs-card .gs-btn { margin-top: 30rpx; }
.gs-card-btns .gs-btn { margin-top: 0; }
