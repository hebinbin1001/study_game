/**
 * 游戏页样式：Canvas 2D + HUD + 选项按钮
 * 关联 REQ：REQ-GAME-2（分层布局）、REQ-GAME-3（命数/题号）、REQ-NFR-3（画布几何）
 * 平移来源：prototype/index.html 第 74-94 行游戏页样式
 */

/* ============ 页面容器 ============ */
/* 暖色天空渐变背景，纵向布局；内容超出时允许滚动兜底（小屏机型） */
.game-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 16rpx 24rpx;
  /* 底部安全区适配：全面屏底部选项按钮不被 Home 指示条遮挡 */
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 70%, #eaf8ff 100%);
}

/* ============ HUD 层 ============ */
/* 命数 / 得分 / 题号：白色卡通胶囊卡横排（配色统一引用 app.wxss 设计 token） */
.hud {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;              /* 收紧：HUD 新增暂停按钮后仍需单行放下 */
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* HUD 胶囊卡：白色半透明底 + 小号硬阴影（卡通按压风格） */
.hud-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 18rpx;   /* 一期：HUD 新增暂停按钮后需收紧，否则 5 颗心时整行放不下会换行 */
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08), 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}

/* 命数：粉色 ❤ 字符（token --pink） */
.hud-lives {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--pink, #ff5d8f);
  letter-spacing: 2rpx;
  min-width: 100rpx;
}

/* 得分：墨色粗体（token --ink，白底上用深色保证对比度） */
.hud-score {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--ink, #3a3a5c);
}

/* 题号：次级灰蓝粗体（token --text-sub） */
.hud-qnum {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-sub, #5c7f9e);
  min-width: 150rpx;
}

/* 声音开关：窄胶囊（喇叭切换，catchtap） */
/* 图标型胶囊（声音 / 暂停）：定宽紧凑，排在 HUD 右侧 */
.hud-icon {
  width: 64rpx;
  padding: 0;
  font-size: 32rpx;
  flex-shrink: 0;
}

/* ============ 暂停遮罩（R5） ============
   用不透明底遮住画布与选项：暂停时不能看到题目与计时（防止「暂停偷看」）。
   暂停即 engine.stop() 停主循环，怪兽不再下沉。 */
.pause-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #5aa9e6 0%, #a8d8f5 42%, #d8efff 100%);
}
.pause-card {
  width: 560rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: 0 16rpx 0 rgba(0, 0, 0, 0.12), 0 30rpx 60rpx rgba(0, 0, 0, 0.2);
}
.pause-emoji { font-size: 64rpx; line-height: 1; }
.pause-title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 900;
  color: #3a3a5c;
}
.pause-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a9bb5;
}
.pause-btns {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}
.pause-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #ffffff;
  background: #ffb703;
  box-shadow: 0 8rpx 0 rgba(180, 120, 0, 0.3);
}
.pause-btn--ghost {
  background: #eef2f8;
  color: #5c7f9e;
  box-shadow: 0 8rpx 0 rgba(35, 70, 110, 0.12);
}
.pause-btn:active { transform: translateY(3rpx); opacity: .92; }

/* ============ 游戏画布 ============ */
/* O1 自适应：画布占「视口 - HUD - 形态行 - 底部面板」剩余高度（flex:1），
   不再固定 900rpx → 矮屏机型也能一屏放下不滚动。
   逻辑尺寸 390×500（config.W/H）由 onReady 取实际 CSS 尺寸后
   等比缩放并居中（scale=min(宽比,高比)），画面不变形不裁切。 */
.game-canvas {
  width: 100%;
  flex: 1 1 auto;
  min-height: 0;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 70%, #eaf8ff 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* ============ 底部面板 ============ */
/* 提示文字 + 选项按钮垂直堆叠 */
.bottom-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  gap: 16rpx;
}

/* 提示文字：答对/答错/逼近时由 engine.onTip 回调驱动（token --text-sub，M6-4 放大） */
.tip {
  font-size: 30rpx;
  color: var(--text-sub, #5c7f9e);
  font-weight: 700;
  text-align: center;
  min-height: 36rpx;
  line-height: 1.4;
  padding: 0 16rpx;
}

/* ============ 选项按钮 ============ */
/* 字符级：4 个字符选项横排居中；词级整词较长，允许换行成两行（H2-B） */
.options {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 20rpx 20rpx;
  width: 100%;
}

/* 单个选项按钮：卡通硬阴影风格（平移原型 .char-btn） */
.option {
  width: 132rpx;
  height: 132rpx;
  border-radius: 40rpx;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.18), 0 24rpx 44rpx rgba(0, 0, 0, 0.14);
  transition: transform 0.06s, box-shadow 0.06s, opacity 0.15s;
}

/* 词级整词按钮（H2-B）：胶囊形、自动宽度，容纳长整词（如 COMPETITION） */
.option.wide {
  width: auto;
  min-width: 120rpx;
  height: 96rpx;
  padding: 0 30rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
  max-width: 46%;
  word-break: keep-all;
}

/* 按下效果：下沉 + 阴影收缩 */
.option:active {
  transform: translateY(6rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.18);
}

/* 已用（选错）的选项置灰禁用 */
.option.used {
  opacity: 0.25;
}

/* ============ 答错反馈高亮（R3） ============
   答错后有 1.2s 的反馈窗口（GAME_CONFIG.approachTime），在此期间：
   正确项标绿、误选项标红 —— 低龄玩家往往先看按钮而不是看怪兽身上的空槽，
   把答案同时标在按钮上，纠错才真正发生。 */
.option.ok {
  background: #2fbf71;
  opacity: 1;
  box-shadow: 0 12rpx 0 #1f8f53, 0 24rpx 44rpx rgba(0, 0, 0, 0.18);
}
.option.bad {
  background: #e5484d;
  opacity: 1;
  box-shadow: 0 12rpx 0 #a52f33, 0 24rpx 44rpx rgba(0, 0, 0, 0.18);
}

/* 5 种配色循环（对应原型 .char-btn.c0~c4，统一引用设计系统 token） */
.option.c0 { background: var(--pink, #ff5d8f); }    /* 粉 */
.option.c1 { background: var(--blue, #4cc9f0); }    /* 蓝 */
.option.c2 { background: var(--orange, #ffb703); }  /* 橙 */
.option.c3 { background: var(--green, #7bd389); }   /* 绿 */
.option.c4 { background: var(--purple, #b388ff); }  /* 紫 */

/* ============ 连击提示浮层 ============ */
/* 连对 2/3/5 题时由 engine.onCombo 触发，800ms 自动消失（墨底金字，token --ink/--gold） */
.combo-toast {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(58, 58, 92, 0.9);
  color: var(--gold, #ffd166);
  padding: 16rpx 36rpx;
  border-radius: 44rpx;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  z-index: 99;
  white-space: nowrap;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.25);
  animation: comboPop 0.8s ease-out forwards;
}

/* 连击提示弹出动画：从下方淡入 → 放大回弹 → 上浮淡出 */
@keyframes comboPop {
  0%   { opacity: 0; transform: translateX(-50%) translateY(20rpx) scale(0.8); }
  20%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.1); }
  40%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-40rpx) scale(1); }
}

/* ============ 新手引导蒙层（M6-L） ============ */
.tutorial-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(30, 40, 60, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.tutorial-card {
  width: 560rpx;
  background: #ffffff;
  border-radius: 44rpx;
  padding: 56rpx 44rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 0 rgba(0, 0, 0, 0.1), 0 30rpx 60rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}
.tutorial-emoji {
  font-size: 100rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.tutorial-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3a3a5c;
  letter-spacing: 4rpx;
  margin-bottom: 18rpx;
}
.tutorial-desc {
  font-size: 28rpx;
  color: #5c7f9e;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.tutorial-dots {
  display: flex;
  gap: 14rpx;
  margin-bottom: 36rpx;
}
.tutorial-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d5dde8;
}
.tutorial-dot.on {
  background: #4cc9f0;
}
.tutorial-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #ffb703;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.12);
}

/* 说明：原「对局形态表现行」样式（Boss 血条 / 极速倒计时 / 形态飘字 / 击破闪层 /
   竞速惩罚锁）已随三种形态一并删除（一期）。 */
