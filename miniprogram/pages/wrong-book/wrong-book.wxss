.page-wrong-book {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
}

.stat-label {
  font-size: 24rpx;
  color: #ccc;
}

.stat-item.pending .stat-number {
  color: #ff9800;
}

.stat-item.mastered .stat-number {
  color: #4caf50;
}

.tabs {
  display: flex;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ccc;
}

.tab.active {
  background: #ffd700;
  color: #333;
  font-weight: bold;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 20rpx;
}

.item-card.mastered {
  border-left: 6rpx solid #4caf50;
}

.item-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.item-type {
  font-size: 24rpx;
  color: #ffd700;
  background: rgba(255, 215, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.item-mastery {
  font-size: 22rpx;
  color: #4caf50;
}

.item-question {
  margin-bottom: 15rpx;
}

.question-text {
  display: block;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.question-answer {
  display: block;
  font-size: 24rpx;
  color: #4caf50;
}

.item-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 15rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #888;
}

.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress {
  height: 100%;
  background: linear-gradient(90deg, #4caf50, #ffd700);
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #888;
  font-size: 28rpx;
}

.btn-review {
  margin-top: 30rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #4caf50, #8bc34a);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 20rpx;
}

.btn-back {
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border-radius: 20rpx;
}