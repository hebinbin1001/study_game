/* 错题本列表页样式
   2026-10-25 信息架构重排：顶栏 + 一行分段（统计与 tab 二合一）+ 瘦卡片 + 固定底部主操作。
   颜色取值与 app.wxss 的全局 token 一一对应（页面 wxss 沿用字面值，与既有约定一致）：
     var(--ink)=--ink  var(--ink-sub)=--text-sub  var(--ink-weak)=--text-mute
     var(--pri)=--orange  var(--green)=--green  var(--blue)=--blue  #eef2f8=--bg-soft
*/

.page-wrong-book {
  padding: 16rpx 24rpx calc(220rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  color: var(--ink);
}

/* ============ 顶栏：返回 / 标题 / 搜索 / 筛选 ============ */
.wb-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
}
.wb-back {
  flex: none;
  width: 88rpx; height: 88rpx;
  line-height: 84rpx; text-align: center;
  border-radius: 50%;
  background: var(--white);
  color: var(--ink-sub);
  font-size: var(--fs-strong);
  box-shadow: var(--clay-1);
}
.wb-back:active { transform: translateY(3rpx); }
.wb-head-t { flex: 1; min-width: 0; }
.wb-title {
  font-size: var(--fs-strong); font-weight: 900; color: var(--white); letter-spacing: 2rpx;
  text-shadow: 0 3rpx 0 rgba(0, 0, 0, .14);
}
.wb-head-sub { margin-top: 2rpx; font-size: var(--fs-cap); color: rgba(255, 255, 255, .92); }
.wb-icon {
  flex: none;
  width: 60rpx; height: 60rpx;
  line-height: 60rpx; text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-sub);
  font-size: var(--fs-body); font-weight: 900;
  box-shadow: var(--clay-1);
}
.wb-icon:active { transform: translateY(3rpx); }
.wb-icon.on { background: var(--pri); color: var(--white); box-shadow: var(--clay-1); }

/* ============ 搜索（默认收起，点 🔍 展开）============ */
.wb-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 16rpx;
}
.wb-search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 78rpx 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  font-size: var(--fs-body);
  color: var(--ink);
  box-shadow: 0 4rpx 12rpx rgba(28, 53, 92, .06);
}
/* 清空按钮压在输入框里（负 margin 让它在 flex 布局里不额外占位） */
.wb-search-clear {
  flex: 0 0 auto;
  position: relative;
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 50%;
  background: var(--surface);
  color: var(--ink-weak);
  font-size: var(--fs-body);
  margin-left: -74rpx;
  margin-right: 8rpx;
}
/* 视觉仍是 52rpx 的小圆点，命中区放大到 88rpx（约 44px），不占布局空间 */
.wb-search-clear::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
}
.wb-search-btn {
  flex: 0 0 auto;
  height: 72rpx; line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(135deg, #6fc3ff, var(--sky-deep));
  color: var(--white); font-size: var(--fs-body); font-weight: 800;
  box-shadow: var(--clay-1);
}
.wb-search-btn:active { transform: translateY(3rpx); }

/* ============ 一行分段：统计与 tab 二合一 ============ */
.wb-chips {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.wb-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-deep);
  font-size: var(--fs-cap); font-weight: 800;
  box-shadow: var(--clay-1);
  white-space: nowrap;
  overflow: hidden;
}
.wb-chip.on {
  background: linear-gradient(180deg, #ffd45c, var(--pri));
  color: var(--white);
  box-shadow: var(--clay-1);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, .1);
}
.wb-chip-n { font-weight: 900; }

/* 筛选生效提示条 */
.wb-filter-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .88);
  color: #42637f;
  font-size: var(--fs-cap); font-weight: 700;
}
.wb-filter-reset { color: var(--link-ink); font-weight: 900; }

/* ============ 列表 ============ */
.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.wb-group {
  padding: 12rpx 4rpx 2rpx;
  font-size: var(--fs-cap); font-weight: 800;
  color: var(--white);
  opacity: .95;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, .12);
}

/* 错题卡片：一列信息（题型/熟练度 → 题干 → 答案/查看 → meta → 熟练度条），右侧一个箭头 */
.item-card {
  display: flex;
  gap: 12rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 20rpx 22rpx;
  box-shadow: var(--clay-2);
}
.item-card:active { transform: translateY(3rpx); box-shadow: var(--clay-1); }
.item-card.mastered { background: #fbfffc; }

.q-main { flex: 1; min-width: 0; }
.q-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.item-type {
  background: rgba(255, 183, 3, .16);
  color: var(--pri-ink);
  font-size: var(--fs-cap);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  overflow: hidden;
}
.tag--green { background: rgba(123, 211, 137, .2); color: var(--green-ink); }
.q-mastery { flex: none; font-size: var(--fs-cap); font-weight: 800; color: var(--blue); }
.q-mastery.ok { color: var(--green-ink); }

.q-text {
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--ink);
  line-height: 1.35;
  word-break: break-all;
}
.question-answer {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-cap);
  color: #5cc07a;
  font-weight: 700;
}
.answer-peek {
  display: inline-block;
  margin-top: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  font-weight: 700;
}
/* meta 一行纯文字（原来是 3 个灰胶囊 + 2 个按钮，太挤） */
.q-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
.q-sep { opacity: .6; }
.q-bar {
  margin-top: 10rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--surface);
  overflow: hidden;
}
.q-bar-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8ed49a, var(--green));
}
.q-side {
  flex: none;
  width: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--line);
  font-size: var(--fs-strong);
}

/* 长按提示 */
.wb-hint {
  text-align: center;
  font-size: var(--fs-cap);
  color: rgba(255, 255, 255, .92);
  padding: 14rpx 0 4rpx;
}

/* ============ 翻页（替换式，不是「加载更多」）============ */
.wb-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 22rpx 0 8rpx;
}
.wb-pager-btn {
  height: 68rpx; line-height: 68rpx;
  padding: 0 32rpx;
  border-radius: var(--r-pill);
  background: var(--white);
  color: var(--link-ink);
  font-size: var(--fs-body); font-weight: 800;
  box-shadow: var(--clay-1);
}
.wb-pager-btn:active { transform: translateY(3rpx); }
.wb-pager-btn.dis {
  color: var(--line);
  background: #f2f5f9;
  box-shadow: none;
}
.wb-pager-info { font-size: var(--fs-cap); color: var(--ink-deep); font-weight: 700; }

/* 列表顶部的口径说明 */
.list-tip {
  padding: 14rpx 18rpx;
  margin: 6rpx 0 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, .85);
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  line-height: 1.5;
}

/* ============ 空态 ============ */
.empty-state {
  background: rgba(255, 255, 255, .85);
  border-radius: 28rpx;
  padding: 50rpx 30rpx;
  box-shadow: var(--clay-2);
}
.empty-text {
  color: var(--ink-weak);
  font-size: var(--fs-body);
}

/* ============ 底部固定主操作（本页唯一主 CTA）============ */
.wb-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(216, 239, 255, 0), rgba(216, 239, 255, .96) 45%);
}
.btn-review {
  width: 100%;
  margin: 0;
  padding: 26rpx 0;
  background: linear-gradient(180deg, #a4e8b4, var(--green) 55%, #5cc07a);
  color: var(--white);
  font-size: var(--fs-strong);
  font-weight: 900;
  letter-spacing: 3rpx;
  border-radius: 999rpx;
  line-height: 1.3;
  box-shadow: var(--clay-2);
  transition: transform .12s;
}
.btn-review:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}
button.btn-review::after { border: none; }

/* ============ 筛选弹层 ============ */
.filter-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 38, 55, .48);
}
.filter-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--white);
}
.filter-head { display: flex; align-items: center; justify-content: space-between; }
.filter-title { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); }
.filter-close { font-size: var(--fs-body); font-weight: 800; color: var(--link); padding: 8rpx 4rpx; }
.filter-label { margin: 24rpx 0 12rpx; font-size: var(--fs-cap); font-weight: 800; color: var(--ink-weak); }
.filter-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.filter-chip {
  padding: 13rpx 22rpx;
  border-radius: 999rpx;
  background: #f0f5fa;
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  font-weight: 800;
}
.filter-chip.on { background: var(--link); color: var(--white); }
