<!-- 错题本列表页 -->
<view class="page-wrong-book">
  <!-- M5 T2.3 门禁：直接 URL / 分享链接进来且未登录时，先引导登录（不请求数据） -->
  <view class="gate-bar" wx:if="{{needLogin}}">
    <text class="gate-emoji">🔒</text>
    <text class="gate-text">{{gateText}}</text>
    <button class="gate-btn" bindtap="onGateLogin">去登录</button>
  </view>

  <!-- 页面标题 -->
  <view class="book-title-bar">
    <view class="book-title-emoji">📖</view>
    <view class="book-title">错题本</view>
    <view class="book-title-sub">打败小怪兽，错题变星星</view>
  </view>

  <!-- 统计卡 -->
  <!-- 搜索（2026-10-08）：错题攒多了以后要能按关键字找。
       ⚠️ 搜索是**服务端**做的（见 wrong-book-view.listUrl 的 q 参数）——
       端上只加载了一页，在端上筛等于「只在已加载的 20 条里找」，用户会以为搜不到。 -->
  <view class="wb-search">
    <input
      class="wb-search-input"
      placeholder="搜题目 / 答案"
      value="{{q}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
      confirm-type="search" />
    <view wx:if="{{q}}" class="wb-search-clear" bindtap="onClearSearch">✕</view>
    <view class="wb-search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-emoji">📚</text>
      <text class="stat-number">{{stats.total}}</text>
      <text class="stat-label">总错题</text>
    </view>
    <view class="stat-item pending">
      <text class="stat-emoji">⏰</text>
      <text class="stat-number">{{stats.pending}}</text>
      <text class="stat-label">待复习</text>
    </view>
    <view class="stat-item mastered">
      <text class="stat-emoji">🏆</text>
      <text class="stat-number">{{stats.mastered}}</text>
      <text class="stat-label">已掌握</text>
    </view>
  </view>

  <!-- 标签切换 -->
  <view class="tabs">
    <view class="tab {{activeTab === 'pending' ? 'active' : ''}}" data-tab="pending" bindtap="switchTab">
      待复习 ({{stats.pending}})
    </view>
    <view class="tab {{activeTab === 'reviewed' ? 'active' : ''}}" data-tab="reviewed" bindtap="switchTab">
      已复习 ({{stats.reviewed}})
    </view>
    <view class="tab {{activeTab === 'mastered' ? 'active' : ''}}" data-tab="mastered" bindtap="switchTab">
      已掌握 ({{stats.mastered}})
    </view>
  </view>

  <!-- 加载失败提示（点击重试） -->
  <view wx:if="{{loadError}}" class="empty-state" bindtap="loadWrongBook" data-reset="1" style="margin-top:16rpx;">
    <view class="empty-emoji">📡</view>
    <view class="empty-text">加载失败（{{loadError}}）</view>
    <view class="empty-text">点这里重试</view>
  </view>

  <!-- 待复习列表（按到期分组 + 分批加载，错题多时更友好） -->
  <view class="list" wx:if="{{activeTab === 'pending'}}">
    <block wx:for="{{visible}}" wx:key="index">
      <!-- 分组标题行（已到期 / 明天 / N天后） -->
      <view wx:if="{{item.t === 'g'}}" style="padding:18rpx 12rpx 4rpx;font-size:24rpx;font-weight:800;color:#8a9bb5;">⏰ {{item.text}}</view>
      <!-- 错题卡片 -->
      <view wx:elif="{{item.t === 'c'}}" class="item-card" bindtap="practiceItem" data-id="{{item.it.recordId}}">
        <view class="item-header">
          <text class="item-type tag">{{item.it.question.type}}</text>
          <text class="item-mastery">熟练度 {{item.it.mastery}}%</text>
        </view>
        <view class="item-question">
          <text class="question-text">{{item.it.question.q}}</text>
          <text class="question-answer">答案：{{item.it.question.a}}</text>
        </view>
        <view class="item-meta">
          <text class="meta-text">错误 {{item.it.wrongCount}} 次</text>
          <text class="meta-text">{{item.it.reviewStageText}}</text>
          <text class="meta-text">{{item.it.nextReviewText}}</text>
          <text class="meta-go">练这道题 ›</text>
          <text class="meta-del" catchtap="removeItem" data-id="{{item.it.recordId}}">移除</text>
        </view>
        <view class="progress-bar">
          <view class="progress-bar__fill" style="width: {{item.it.reviewProgress * 20}}%"></view>
        </view>
      </view>
    </block>

    <!-- 翻页（2026-10-08）：原来是「加载更多」追加式，改成翻页替换式 ——
         追加式想回头看第 3 页得从头再加载，也看不出自己翻到哪了。 -->
    <view wx:if="{{totalPages > 1}}" class="wb-pager">
      <view class="wb-pager-btn {{page <= 1 || loading ? 'dis' : ''}}" data-dir="-1" bindtap="goPage">上一页</view>
      <view class="wb-pager-info">第 {{page}} / {{totalPages}} 页</view>
      <view class="wb-pager-btn {{page >= totalPages || loading ? 'dis' : ''}}" data-dir="1" bindtap="goPage">下一页</view>
    </view>

    <view class="empty-state" wx:if="{{pending.length === 0 && !loadError}}">
      <view class="empty-emoji">📝</view>
      <view class="empty-text">暂无待复习题目，太棒啦！</view>
    </view>
    <!-- 原来这里还要求 !hasMore（「加载完才能开始复习」）——
         改成翻页后 hasMore 的语义变成「还有下一页」，这个条件会把按钮永久藏起来。 -->
    <button class="btn-review" wx:if="{{pending.length > 0}}" bindtap="startReview">✏️ 开始复习</button>
  </view>

  <!-- 已掌握列表 -->
  <!-- 已复习列表：复习过（答对过）但熟练度还没满 100 的题（用户 2026-09-13 新增口径） -->
  <view class="list" wx:if="{{activeTab === 'reviewed'}}">
    <view class="list-tip">这些题你已经复习过、但熟练度还没满 100%；继续复习满 100% 就会进「已掌握」</view>
    <block wx:for="{{reviewed}}" wx:key="recordId">
      <view class="item-card" bindtap="practiceItem" data-id="{{item.recordId}}">
        <view class="item-header">
          <text class="item-type tag">{{item.question.type}}</text>
          <text class="item-mastery">熟练度 {{item.mastery}}% · 复习过 {{item.reviewCount}} 次</text>
        </view>
        <view class="item-question">
          <text class="question-text">{{item.question.q}}</text>
          <text class="question-answer">答案：{{item.question.a}}</text>
        </view>
        <view class="item-meta">
          <text class="meta-text">错误 {{item.wrongCount}} 次</text>
          <text class="meta-go">练这道题 ›</text>
          <text class="meta-del" catchtap="removeItem" data-id="{{item.recordId}}">移除</text>
        </view>
        <view class="progress-bar">
          <view class="progress-bar__fill" style="width: {{item.mastery}}%"></view>
        </view>
      </view>
    </block>
    <view class="empty-state" wx:if="{{reviewed.length === 0}}">
      <view class="empty-text">还没有复习过的题</view>
      <view class="empty-text">答对过的错题会出现在这里</view>
    </view>
  </view>

  <view class="list" wx:if="{{activeTab === 'mastered'}}">
    <view class="list-tip">熟练度满 100%（连续答对 5 次）才进入「已掌握」；答对但还没满的题会顺延复习时间，仍留在「待复习」</view>
    <block wx:for="{{mastered}}" wx:key="recordId">
      <view class="item-card mastered">
        <view class="item-header">
          <text class="item-type tag tag--green">{{item.question.type}}</text>
          <text class="item-mastery">🏅 已掌握</text>
        </view>
        <view class="item-question">
          <text class="question-text">{{item.question.q}}</text>
          <text class="question-answer">答案：{{item.question.a}}</text>
        </view>
        <view class="item-meta">
          <text class="meta-text">错误 {{item.wrongCount}} 次</text>
          <text class="meta-del" catchtap="removeItem" data-id="{{item.recordId}}">移除</text>
        </view>
      </view>
    </block>
    <!-- 翻页（同待复习 tab） -->
    <view wx:if="{{totalPages > 1}}" class="wb-pager">
      <view class="wb-pager-btn {{page <= 1 || loading ? 'dis' : ''}}" data-dir="-1" bindtap="goPage">上一页</view>
      <view class="wb-pager-info">第 {{page}} / {{totalPages}} 页</view>
      <view class="wb-pager-btn {{page >= totalPages || loading ? 'dis' : ''}}" data-dir="1" bindtap="goPage">下一页</view>
    </view>
    <view class="empty-state" wx:if="{{mastered.length === 0}}">
      <view class="empty-text">连续答对 5 次、熟练度满 100% 才会进这里</view>
      <view class="empty-emoji">🌱</view>
      <view class="empty-text">暂无已掌握题目，继续加油！</view>
    </view>
  </view>

  <!-- 返回按钮 -->
  <button class="btn-back" bindtap="goBack">返回</button>
</view>
