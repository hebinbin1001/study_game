<!-- 2048（B6-3 固定关卡） -->
<view class="page-2048">
  <view class="g-head">
    <button class="back-pill" bindtap="goBack">‹</button>
    <view class="g-title">2048</view>
    <view class="g-chip" bindtap="goLevels">{{playing ? ('第 ' + curLevel + '/' + levelInfo.length + ' 关') : '选关'}}</view>
  </view>

  <!-- 选关 -->
  <block wx:if="{{!playing}}">
    <view class="intro">
      <view class="i-t">滑动合成目标数字</view>
      <view class="i-s">关卡目标逐步提升：32 → 64 → … → 2048，步数限定</view>
    </view>
    <view class="levels">
      <view
        wx:for="{{levelInfo}}"
        wx:key="no"
        class="lv {{curLevel === item.no ? 'on' : ''}}"
        data-no="{{item.no}}"
        bindtap="pickLevel">
        <view class="lv-target">{{item.target}}</view>
        <view class="lv-steps">{{item.steps}} 步</view>
      </view>
    </view>

    <!-- 挑战模式（不限步数冲到 2048，只比最少步数） -->
    <view class="challenge-card" bindtap="startChallenge">
      <view class="cc-left">
        <view class="cc-title">🏆 挑战模式</view>
        <view class="cc-sub">不限步数冲到 2048 · 只比谁用得更少</view>
      </view>
      <view class="cc-best">{{challengeBest > 0 ? ('最佳 ' + challengeBest + ' 步') : '来试试'}}</view>
    </view>
  </block>

  <!-- 对局 -->
  <block wx:else>
    <view class="hud">
      <view class="hud-box"><view class="h-num">{{target}}</view><view class="h-lab">目标</view></view>
      <view class="hud-box"><view class="h-num">{{maxTile}}</view><view class="h-lab">最大块</view></view>
      <view class="hud-box"><view class="h-num">{{score}}</view><view class="h-lab">得分</view></view>
      <view class="hud-box"><view class="h-num">{{stepsLimit - usedSteps}}</view><view class="h-lab">剩余步</view></view>
    </view>

    <!-- 滑动操作：catchtouchmove 阻止页面跟着滚，否则竖滑可能被页面滚动吃掉手感 -->
    <view class="board b-tray b-in"
      bindtouchstart="onTouchStart"
      catchtouchmove="onTouchMove"
      bindtouchend="onTouchEnd">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="cell c{{item.v}} b-face">{{item.v || ''}}</view>
    </view>

    <view class="tip">👆 朝上下左右滑动棋盘 · 相同数字合体</view>
  </block>

  <!-- 结算 -->
  <view wx:if="{{over}}" class="over-mask">
    <view class="over-card">
      <view class="o-stars">{{win ? starsText : '💔'}}</view>
      <view class="o-title {{win ? '' : 'fail'}}">{{win ? '过关！' : '未达成'}}</view>
      <view class="o-msg">{{overMsg}}</view>
      <button wx:if="{{win}}" class="btn b1" bindtap="goNext">下一关 ▶</button>
      <button class="btn b2" bindtap="again">再试一次</button>
      <button class="btn b2" bindtap="goLevels">关卡列表</button>
    </view>
  </view>

  <view class="safe-gap"></view>
</view>
