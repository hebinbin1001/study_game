/* 2048（B6-3） */
.page-2048 {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
/* 头部/HUD 统一到 app.wxss 的 .g-head/.g-title/.g-chip/.hud（2026-09-12 视觉统一） */
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }

/* 选关 */
.intro { background: #fff; border-radius: 28rpx; padding: 26rpx; text-align: center; margin: 20rpx 0; }
.i-t { font-size: 32rpx; font-weight: 900; color: #3a3a5c; }
.i-s { font-size: 22rpx; color: #8a9bb5; margin-top: 8rpx; line-height: 1.5; }
.levels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx; }
.lv {
  background: #fff; border-radius: 24rpx; padding: 26rpx 8rpx;
  text-align: center; box-shadow: 0 8rpx 0 rgba(0,0,0,.05);
}
.lv.on { outline: 6rpx solid #ffb703; }
.lv-target { font-size: 40rpx; font-weight: 900; color: #b57900; }
.lv-steps { font-size: 22rpx; color: #8a9bb5; margin-top: 6rpx; }

/* HUD */
.hud-box { flex: 1; background: #fff; border-radius: 20rpx; padding: 16rpx 4rpx; text-align: center; box-shadow: 0 6rpx 0 rgba(0,0,0,.05); }
.h-num { font-size: 34rpx; font-weight: 900; color: #b57900; }
.h-lab { font-size: 20rpx; color: #8a9bb5; margin-top: 2rpx; }

/* 棋盘 */
.board {
  flex: 1 1 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  align-content: center;
  align-self: center;
  width: 100%;
}
.cell {
  aspect-ratio: 1/1;
  border-radius: 16rpx;
  background: #f2ead9;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 900; color: #776e65;
}
.cell.c2 { background: #eee4da; }
.cell.c4 { background: #ede0c8; }
.cell.c8 { background: #f2b179; color: #fff; }
.cell.c16 { background: #f59563; color: #fff; }
.cell.c32 { background: #f67c5f; color: #fff; }
.cell.c64 { background: #f65e3b; color: #fff; }
.cell.c128 { background: #edcf72; color: #fff; font-size: 30rpx; }
.cell.c256 { background: #edcc61; color: #fff; font-size: 30rpx; }
.cell.c512 { background: #edc850; color: #fff; font-size: 30rpx; }
.cell.c1024 { background: #edc53f; color: #fff; font-size: 26rpx; }
.cell.c2048 { background: #edc22e; color: #fff; font-size: 26rpx; }

/* 方向键 */
.pad { flex: 0 0 auto; margin: 14rpx 0 6rpx; }
.pad-row { display: flex; justify-content: center; gap: 16rpx; margin: 8rpx 0; }
.key {
  width: 132rpx; height: 88rpx;
  background: rgba(255,255,255,.92); color: #5c7f9e;
  border-radius: 20rpx; display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.08);
}
.pad-gap { width: 132rpx; }
.key:active { transform: translateY(3rpx); }
.tip { flex: 0 0 auto; text-align: center; font-size: 22rpx; color: #fff; opacity: .9; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #2e8b57; margin-top: 10rpx; }
.o-title.fail { color: #e62e2e; }
.o-msg { font-size: 26rpx; color: #8a9bb5; margin-top: 10rpx; }
.btn {
  margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx;
  border-radius: 46rpx; font-size: 32rpx; font-weight: 900;
}
.btn.b1 { background: #ffb703; color: #fff; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn.b2 { background: #eef2f8; color: #5c7f9e; }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
