<!-- 汉诺塔（数字智力第 12 款 · 6 关小品）：三根柱子，把所有盘移到最右柱 -->
<view class="page-hanoi">

  <view class="hud">
    <view class="chip"><view class="k">关卡</view><view class="v">{{levelText}}</view></view>
    <view class="chip"><view class="k">步数</view><view class="v">{{stepText}}</view></view>
    <view class="chip"><view class="k">最少</view><view class="v">{{minText}}</view></view>
    <warrior-badge size="sm" />
  </view>

  <view class="banner {{fb}}">
    <view class="main">{{bannerMain}}</view>
    <view class="sub">{{bannerSub}}</view>
  </view>

  <!-- 三根柱子：盘子在 disks 里用 column-reverse 从底往上堆，宽度按本关最大盘数归一 -->
  <view class="tower">
    <view
      class="peg {{item.sel ? 'sel' : ''}}"
      wx:for="{{pegs}}"
      wx:key="index"
      data-i="{{index}}"
      bindtap="tapPeg">
      <view class="rod"></view>
      <view class="disks">
        <view
          class="disk {{d.top ? 'top' : ''}}"
          wx:for="{{item.disks}}"
          wx:for-item="d"
          wx:key="size"
          style="width: {{d.w}}rpx; background: {{d.color}};">{{d.label}}</view>
      </view>
      <view class="base"></view>
      <view class="peg-no">{{item.no}}</view>
    </view>
  </view>

  <view class="ops">
    <view class="btn" bindtap="onUndo">↩ 撤销</view>
    <view class="btn" bindtap="onReset">🔄 重开</view>
  </view>

  <view class="foot">点一根柱子拿起顶部盘 · 再点另一根放下</view>

  <settle-pop
    visible="{{settle}}" win="{{win}}" starsText="{{starsText}}"
    title="{{overTitle}}" msg="{{overMsg}}" hint="{{overHint}}"
    show-next="{{showNext}}" next-text="下一关 ▶"
    bind:retry="onRetry" bind:next="onNext" />

  <!-- 暂停 / 音效（统一组件 game-pause）：固定右上角，只在对局中出现 -->
  <game-pause
    open="{{paused}}"
    showFab="{{!settle}}"
    sub="第 {{levelText}} 关 · {{stepText}} 步"
    bind:pause="onGamePause"
    bind:resume="onGameResume"
    bind:restart="onGameRestart"
    bind:quit="onGameQuit" />
</view>
