/* 汉诺塔（数字智力第 12 款 · 6 关小品）—— 珊瑚粉主题，与其余数字玩法区分 */
page {
  background: linear-gradient(180deg, #d94f85 0%, #f28ab0 30%, #ffd9e6 62%, #fff5f8 100%);
  min-height: 100vh;
}

.page-hanoi {
  min-height: 100vh;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hud { display: flex; gap: 16rpx; align-items: stretch; }
.chip {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 6rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(160, 40, 90, 0.16);
}
.chip .k { font-size: 22rpx; color: #b57a92; }
.chip .v { font-size: 30rpx; font-weight: 900; color: #b03a68; margin-top: 2rpx; }

.banner {
  flex: 0 0 auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(160, 40, 90, 0.13), 0 16rpx 28rpx rgba(160, 40, 90, 0.1);
}
.banner .main { font-size: 30rpx; font-weight: 900; color: #b03a68; }
.banner .sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #a6788a;
  line-height: 1.4;
  min-height: 32rpx;
}
.banner.good { background: #e9fbef; }
.banner.good .main { color: #1b8f4b; }
.banner.good .sub { color: #3f8f63; }
.banner.bad { background: #fff0f0; }
.banner.bad .main { color: #d64545; }
.banner.bad .sub { color: #a85858; }

/* ---------- 三根柱子 ---------- */
.tower {
  flex: 1 1 auto;
  min-height: 420rpx;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  padding: 8rpx 6rpx 10rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 0 rgba(160, 40, 90, 0.10), 0 20rpx 36rpx rgba(160, 40, 90, 0.10);
}
.peg {
  position: relative;
  flex: 1;
  /* 撑满题板高度：原来写死 400rpx，在大屏上柱子只占卡片下半截，上面一大片白 */
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 14rpx;
}
/* 柱子本体：绝对定位在盘子后面，底部对齐底座 */
.rod {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  margin-left: -7rpx;
  width: 14rpx;
  /* 柱子跟着题板长：8 盘堆高 323rpx，留 40rpx 余量即可 */
  height: calc(100% - 40rpx);
  border-radius: 8rpx 8rpx 0 0;
  background: linear-gradient(180deg, #d9a06a, #8a5a34);
}
.base {
  width: 100%;
  height: 18rpx;
  border-radius: 10rpx;
  background: #8a5a34;
  box-shadow: 0 6rpx 0 rgba(90, 50, 20, 0.22);
  z-index: 2;
}
/* 盘子：column-reverse 让数组第一个（最大的盘）落在最底下 */
.disks {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column-reverse;
  align-items: center;
  gap: 5rpx;
  width: 100%;
}
.disk {
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #fff;
  box-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.16);
  transition: transform 0.12s ease;
}
.peg.sel .rod { background: linear-gradient(180deg, #ffd166, #e0a020); }
/* 选中的柱子把顶部盘抬起来：明确"拿在手上的是哪一个" */
.peg.sel .disk.top {
  transform: translateY(-18rpx);
  box-shadow: 0 10rpx 18rpx rgba(0, 0, 0, 0.22);
}
.peg-no {
  position: absolute;
  /* 放在柱子顶端：原来贴底（bottom:-6rpx）会被题板的 padding 裁掉一半 */
  top: 6rpx;
  font-size: 20rpx;
  font-weight: 900;
  color: #d8a2b6;
}

/* ---------- 操作 ---------- */
.ops {
  flex: 0 0 auto;
  display: flex;
  gap: 20rpx;
}
.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #b03a68;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 0 rgba(160, 40, 90, 0.16);
}

.foot {
  flex: 0 0 auto;
  text-align: center;
  font-size: 21rpx;
  color: #8e4f68;
  opacity: 0.9;
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
.hud { padding-right: 84rpx; }
