<!-- 口算冲刺（玩法落地：demo g6）：限时口算 + 连击倍率 -->
<view class="page-sprint">

  <view class="hud-holder">
    <game-hud lives="{{lives}}" score="{{score}}" scoreText="{{scoreText}}" extra="{{hudText}}" />
    <!-- 暂停键进 HUD 行（2026-10-18）：不再 fixed 悬浮 -->
    <game-pause
      inline
      open="{{paused}}"
      showFab="{{!settle}}"
      bind:pause="onGamePause"
      bind:resume="onGameResume"
      bind:restart="onGameRestart"
      bind:quit="onGameQuit" />
  </view>

  <!-- 倒计时条（≤10s 变红） -->
  <view class="track">
    <view class="fill {{low ? 'low' : ''}}" style="width: {{remainPct}}%;"></view>
  </view>
  <view class="timerow">
    <text class="time {{low ? 'low' : ''}}">{{remainText}}s</text>
    <text class="mult" wx:if="{{combo >= 3}}">连击 {{combo}} · ×{{mult}}</text>
  </view>

  <!-- 题目 -->
  <view class="stage">
    <view class="expr">{{expr}} <text class="qm">= {{q}}</text></view>
  </view>

  <!-- 四个答案 -->
  <view class="answers">
    <view
      wx:for="{{options}}"
      wx:key="*this"
      class="ans {{picked === index ? (index === rightIdx ? 'ok' : 'bad') : ''}} {{picked >= 0 && index === rightIdx && picked !== index ? 'ok' : ''}}"
      data-idx="{{index}}"
      catchtap="tapOption">{{item}}</view>
  </view>

<settle-pop
    visible="{{settle}}" win="{{win}}" starsText="{{starsText}}"
    title="{{win ? '时间到！' : '再冲一次'}}" msg="{{overMsg}}"
    hint="{{hintText}}"
    showNext="{{showNext}}" nextText="下一关（更高年级）▶"
    bind:retry="onRetry" bind:next="onNext" />
</view>


