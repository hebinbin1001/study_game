/* 口算冲刺样式：暖橙渐变 + 大字号题目 + 2×2 大按钮（触屏友好） */
page {
  background: linear-gradient(180deg, #ff7a59 0%, #ffa07a 30%, #ffd3bf 64%, #fff2ea 100%);
  min-height: 100vh;
}
.page-sprint {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.track {
  height: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(120, 50, 20, 0.12);
}
.fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffb703, #ff7a59);
  transition: width 0.12s linear;
}
.fill.low { background: linear-gradient(90deg, #ff5252, #d32f2f); }

.timerow {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
}
.time {
  font-size: 44rpx;
  font-weight: 900;
  color: #a33517;
  font-variant-numeric: tabular-nums;
}
.time.low { color: #e53935; }
.mult {
  font-size: 26rpx;
  font-weight: 900;
  color: #fff;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.stage {
  background: #fff;
  border-radius: 36rpx;
  padding: 46rpx 24rpx;
  text-align: center;
  box-shadow: 0 12rpx 0 rgba(150, 60, 30, 0.14), 0 20rpx 40rpx rgba(150, 60, 30, 0.12);
}
.expr {
  font-size: 76rpx;
  font-weight: 900;
  color: #a33517;
  letter-spacing: 2rpx;
  line-height: 1.2;
}
.qm { color: #d9b3a6; }

.answers {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.ans {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  padding: 40rpx 0;
  text-align: center;
  border-radius: 32rpx;
  background: #fff;
  color: #a33517;
  font-size: 52rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 0 rgba(150, 60, 30, 0.18), 0 20rpx 36rpx rgba(150, 60, 30, 0.12);
  transition: transform 0.1s ease, background 0.16s ease;
}
.ans:active { transform: translateY(4rpx); }
.ans.ok { background: #7bd389; color: #fff; }
.ans.bad { background: #ff5d8f; color: #fff; }

.foot { display: flex; margin-top: 6rpx; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 800;
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.86);
  color: #c2571f;
  box-shadow: 0 8rpx 0 rgba(150, 60, 30, 0.14);
}
