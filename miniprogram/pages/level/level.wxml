<!-- 关卡选择页（2026-10-17 头部瘦身 + 二级分段）
     结构：学段 tabs / 游客横幅 / 进度+宝箱卡 / 继续当前关 / 自由玩入口 / 关卡列表 / 自定义关卡
     变化：
       ① 去掉标题两行（导航栏已有页面名），宝箱从独立一行并进进度卡 → 头部 540rpx → 约 320rpx；
       ② 2026-10-18 入口收敛：删掉「挑战主线 / 自由练」二级分段 ——
          首页进来 = 主线，玩法页带 ?mode= 进来 = 自由玩，视图只由入口决定，不在这里横跳；
       ③ 新增「⚔️ 继续第 N 关」置顶条，点一下直接开打；
       ④ 每 5 关一个段落标题，首次进入自动滚到当前关；
       ⑤ 第 30 关 Boss 换成暗紫卡 + 立绘（映射见 utils/boss-ladder.js，与首页同源）。
     2026-10-18：顶部「玩法线 + 题型」切换条已删除 —— 玩法在玩法 tab 已选过，
       本页不再二次提供其它玩法入口（pickType / freeGroups 一并移除）。 -->
<view class="page-level">
  <!-- 年级是全局学习设置（2026-10-18）：这里只显示当前年级，点一下弹选择器。
       不再放 14 个横向 tab —— 那一条比屏幕还长，且和玩法页/词库页各存了一套状态。 -->
  <view class="grade-line" bindtap="openGradePicker">
    <text class="grade-line__ic">🏫</text>
    <text class="grade-line__t">{{currentGradeLabel}}</text>
    <text class="grade-line__s">{{viewLabel}}</text>
    <text class="grade-line__go">切换 ›</text>
  </view>

  <!-- 游客横幅（未登录仅前 3 关可玩） -->
  <view wx:if="{{!loggedIn}}" class="guest-banner" bindtap="guestLogin">
    <text class="guest-banner-icon">🔒</text>
    <text class="guest-banner-text">游客模式 · 登录解锁全部关卡</text>
    <text class="guest-banner-btn">去登录</text>
  </view>

  <!-- 进度 + 里程碑宝箱（合并成一张卡） -->
  <view class="progress-card">
    <view class="progress-head">
      <view class="progress-label">
        <text class="progress-emoji">⭐</text>
        <text class="progress-text">{{isChallengeView ? '本学段主线星星' : '本视图星星'}}</text>
      </view>
      <view class="progress-value">{{gradeEarnedStars}}/{{gradeTotalStars}}</view>
    </view>
    <view class="progress-bar">
      <view class="progress-bar__fill progress-bar__fill--gold" style="width: {{gradeStarPercent}}%;"></view>
    </view>
    <view wx:if="{{isChallengeView && chests.length > 0}}" class="chest-strip">
      <view
        wx:for="{{chests}}"
        wx:key="at"
        class="chest-chip {{item.claimed ? 'done' : (item.claimable ? 'ready' : 'lock')}}"
        data-at="{{item.at}}"
        bindtap="claimChest">
        <text class="chest-chip__ic">{{item.claimed ? '📦' : (item.claimable ? '🎁' : '🔒')}}</text>
        <text class="chest-chip__tx">{{item.claimed ? item.label + ' · 已领' : (item.claimable ? item.label + ' · 领取' : item.label)}}</text>
      </view>
    </view>
  </view>

  <!-- 本页不再有「挑战主线 / 自由练」分段：首页进来 = 主线；玩法页带 ?mode= 进来 = 自由玩。 -->

  <!-- 2026-10-18：删掉「自由玩：玩法线 + 题型」chips 行 ——
       玩法在上一屏（玩法 tab）已经选过了，这里再列一遍 7 条玩法线属于重复入口；
       带 ?mode= 进来时，本页只负责「这个玩法自己的关卡」。 -->

  <!-- 继续当前关：省掉在 30 关列表里找关 -->
  <view wx:if="{{continueIndex >= 0}}" class="continue-bar" bindtap="tapContinue">
    <view class="cb-t">
      <text class="cb-b">{{continueLabel}}</text>
      <text class="cb-s">{{continueSub}}</text>
    </view>
    <view class="cb-go">开打 ›</view>
  </view>

  <!-- 关卡列表（每 5 关一段；当前关带 id 供自动滚动定位） -->
  <view class="level-list">
    <block wx:for="{{levels}}" wx:key="level">
      <view wx:if="{{item.groupLabel}}" class="lv-group">{{item.groupLabel}}</view>
      <view
        id="{{item.state === 'cur' ? 'lv-cur' : ''}}"
        class="lvrow {{item.state}} {{item.shaking ? 'shake' : ''}} {{item.isBoss ? 'boss' : ''}}"
        data-index="{{index}}"
        bindtap="onLevelTap">

        <!-- 左：Boss 关用立绘，普通关用关卡号 -->
        <view wx:if="{{item.isBoss}}" class="lv-boss-ava">
          <image wx:if="{{item.bossImg}}" class="lv-boss-img" src="{{item.bossImg}}" mode="aspectFit"></image>
          <text wx:else class="lv-boss-emoji">{{item.bossEmoji}}</text>
        </view>
        <view wx:else class="lv-no">{{item.state === 'lock' ? '🔒' : item.level}}</view>

        <!-- 中：题型 + 第 N 关 / Boss 名 -->
        <view class="lv-mid">
          <view class="lv-t1">
            <text wx:if="{{item.kindLabel}}" class="lv-kind">{{item.kindLabel}}</text>
            <text class="lv-name">{{item.isBoss ? item.bossName : '第 ' + item.level + ' 关'}}</text>
            <text wx:if="{{item.isBoss}}" class="lv-boss">BOSS</text>
          </view>
          <view class="lv-t2">{{item.sub}}</view>
        </view>

        <!-- 右：星级 / 继续挑战 / 解锁条件 -->
        <view class="lv-rt">
          <block wx:if="{{item.state === 'done'}}">
            <view class="lv-stars">
              <text class="lv-star {{item.starArr[0] ? 'on' : ''}}">★</text>
              <text class="lv-star {{item.starArr[1] ? 'on' : ''}}">★</text>
              <text class="lv-star {{item.starArr[2] ? 'on' : ''}}">★</text>
            </view>
            <view class="lv-go">重玩 ›</view>
          </block>
          <block wx:elif="{{item.state === 'cur'}}">
            <view class="lv-go lv-go--cur">继续挑战 ›</view>
          </block>
          <block wx:elif="{{item.state === 'open'}}">
            <view class="lv-go lv-go--open">开始挑战 ›</view>
          </block>
          <block wx:else>
            <view class="lv-locktip">{{item.lockTip}}</view>
          </block>
        </view>
      </view>
    </block>
  </view>

  <!-- 自定义关卡入口（M3） -->
  <view class="custom-level-entry" bindtap="goCustomLevel">
    <view class="entry-plus-circle">+</view>
    <text class="entry-text">自定义关卡</text>
    <text class="entry-arrow">→</text>
  </view>

  <!-- 全局年级选择器：本页只读展示年级，点它可切换（与「我的 → 当前年级」同一个组件） -->
  <grade-picker visible="{{gradePickerVisible}}" value="{{gradeKey}}"
    bind:pick="onGradePick" bind:close="onGradeClose" />
</view>
