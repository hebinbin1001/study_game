<!-- 关卡选择页（一期重做：蛇形地图 → 竖排关卡列表）
     结构：标题 / 游客横幅 / 学段 tab / 题型 chips / 星星进度卡 / 关卡列表 / 自定义关卡入口
     关卡行状态：done(已通关·绿色+星·可重玩) / cur(当前·橙色+继续挑战) / lock(灰锁+解锁条件)
     一期同时删除了「闯关形态」模式栏（三种形态判定与计分一致，属换皮）。
     关联需求：REQ-DICT-1、REQ-GAME-13/14、REQ-GUEST-1 -->
<view class="page-level">
  <!-- 标题 -->
  <view class="level-title">选择关卡</view>
  <view class="level-sub">收集星星 · 解锁新关卡</view>

  <!-- 游客横幅（M5 REQ-GUEST-1：未登录仅前 3 关可玩） -->
  <view wx:if="{{!loggedIn}}" class="guest-banner" bindtap="guestLogin">
    <text class="guest-banner-icon">🔒</text>
    <text class="guest-banner-text">游客模式 · 登录解锁全部关卡</text>
    <text class="guest-banner-btn">去登录</text>
  </view>

  <!-- 学段 tab（7 个学段，REQ-DICT-1） -->
  <scroll-view class="grade-tabs" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{grades}}"
      wx:key="key"
      class="grade-tab {{currentGradeIndex === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="pickGrade">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 题型分类 chips（综合/单词/填空/词语/成语/歇后语，横滑；不足一关的分类点击提示） -->
  <scroll-view wx:if="{{typeGroups.length > 0}}" class="type-tabs" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{typeGroups}}"
      wx:key="key"
      class="type-tab {{currentType === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickType">
      {{item.label}}<text wx:if="{{item.key !== 'all'}}" class="type-count">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 本学段星星进度卡（js 预处理：gradeEarnedStars / gradeTotalStars / gradeStarPercent） -->
  <view class="progress-card">
    <view class="progress-head">
      <view class="progress-label">
        <text class="progress-emoji">⭐</text>
        <text class="progress-text">本学段星星</text>
      </view>
      <view class="progress-value">{{gradeEarnedStars}}/{{gradeTotalStars}}</view>
    </view>
    <view class="progress-bar">
      <view class="progress-bar__fill progress-bar__fill--gold" style="width: {{gradeStarPercent}}%;"></view>
    </view>
  </view>

  <!-- 关卡列表（一期：竖排，一行一关）
       布局天然自适应：纵向滚动列表，不需要按可用高度估算节点尺寸 -->
  <view class="level-list">
    <view
      wx:for="{{levels}}"
      wx:key="level"
      class="lvrow {{item.state}} {{item.shaking ? 'shake' : ''}}"
      data-index="{{index}}"
      bindtap="onLevelTap">

      <!-- 左：关卡号（锁定显示锁） -->
      <view class="lv-no">{{item.state === 'lock' ? '🔒' : item.level}}</view>

      <!-- 中：题型标签 + 第 N 关 / 副说明 -->
      <view class="lv-mid">
        <view class="lv-t1">
          <text class="lv-kind">{{item.kindLabel}}</text>
          <text class="lv-name">第 {{item.level}} 关</text>
        </view>
        <view class="lv-t2">{{item.sub}}</view>
      </view>

      <!-- 右：星级 / 继续挑战 / 解锁条件 -->
      <view class="lv-rt">
        <block wx:if="{{item.state === 'done'}}">
          <view class="lv-stars">
            <text class="lv-star {{item.starArr[0] ? 'on' : ''}}">★</text>
            <text class="lv-star {{item.starArr[1] ? 'on' : ''}}">★</text>
            <text class="lv-star {{item.starArr[2] ? 'on' : ''}}">★</text>
          </view>
          <view class="lv-go">重玩 ›</view>
        </block>
        <block wx:elif="{{item.state === 'cur'}}">
          <view class="lv-go lv-go--cur">继续挑战 ›</view>
        </block>
        <block wx:elif="{{item.state === 'open'}}">
          <view class="lv-go lv-go--open">开始挑战 ›</view>
        </block>
        <block wx:else>
          <view class="lv-locktip">{{item.lockTip}}</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 自定义关卡入口（M3） -->
  <view class="custom-level-entry" bindtap="goCustomLevel">
    <view class="entry-plus-circle">+</view>
    <text class="entry-text">自定义关卡</text>
    <text class="entry-arrow">→</text>
  </view>
</view>
