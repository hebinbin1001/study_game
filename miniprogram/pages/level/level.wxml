<!-- 关卡选择页（T14 · M7 Phase B 蛇形路径地图）：
     学段 tab + 题型分类 chips + 游客横幅 + 星星进度卡 + 蛇形路径关卡地图
     节点状态：已通关(金色✔+星,可重玩) / 当前(呼吸光圈+继续) / 锁定(灰🔒+条件小字)
     连线按已通关逐段点亮；点击/解锁/登录引导复用 onLevelTap
     关联需求：REQ-DICT-1、REQ-GAME-13/14、REQ-GUEST-1 -->
<view class="page-level">
  <!-- 标题 -->
  <view class="level-title">选择关卡</view>
  <view class="level-sub">收集星星 · 解锁新关卡</view>

  <!-- 游客横幅（M5 REQ-GUEST-1：未登录仅第 1 关可玩） -->
  <view wx:if="{{!loggedIn}}" class="guest-banner" bindtap="guestLogin">
    <text class="guest-banner-icon">🔒</text>
    <text class="guest-banner-text">游客模式 · 登录解锁全部关卡</text>
    <text class="guest-banner-btn">去登录</text>
  </view>

  <!-- 学段 tab（7 个学段，REQ-DICT-1，交互保留） -->
  <scroll-view class="grade-tabs" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{grades}}"
      wx:key="key"
      class="grade-tab {{currentGradeIndex === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="pickGrade">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 题型分类 chips（综合/单词/填空/词语/成语/歇后语，横滑；不足一关的分类点击提示） -->
  <scroll-view wx:if="{{typeGroups.length > 0}}" class="type-tabs" scroll-x="true" enable-flex="true">
    <view
      wx:for="{{typeGroups}}"
      wx:key="key"
      class="type-tab {{currentType === item.key ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="pickType">
      {{item.label}}<text wx:if="{{item.key !== 'all'}}" class="type-count">{{item.count}}</text>
    </view>
  </scroll-view>

  <!-- 本学段星星进度卡（js 预处理：gradeEarnedStars / gradeTotalStars / gradeStarPercent） -->
  <view class="progress-card">
    <view class="progress-head">
      <view class="progress-label">
        <text class="progress-emoji">⭐</text>
        <text class="progress-text">本学段星星</text>
      </view>
      <view class="progress-value">{{gradeEarnedStars}}/{{gradeTotalStars}}</view>
    </view>
    <view class="progress-bar">
      <view class="progress-bar__fill progress-bar__fill--gold" style="width: {{gradeStarPercent}}%;"></view>
    </view>
  </view>

  <!-- 关卡蛇形路径地图（M7 Phase B）：连线点亮 + 节点（已通关✔/继续/锁定🔒） -->
  <view class="level-map" style="height: {{mapHeight}}rpx;">
    <!-- 连线层（z 低于节点；点亮段金色、未点亮灰色） -->
    <view class="map-paths">
      <view
        wx:for="{{mapSegs}}"
        wx:key="index"
        class="map-seg {{item.on ? 'on' : ''}}"
        style="left: {{item.x1}}rpx; top: {{item.y1}}rpx; width: {{item.len}}rpx; transform: rotate({{item.rot}}deg);"></view>
    </view>

    <!-- 节点层 -->
    <view
      wx:for="{{mapNodes}}"
      wx:key="level"
      class="map-node {{item.state}} {{item.shaking ? 'shake' : ''}}"
      style="left: {{item.left}}rpx; top: {{item.top}}rpx; width: {{item.size}}rpx; height: {{item.size}}rpx;"
      data-index="{{item.index}}"
      bindtap="onLevelTap">

      <!-- 分类徽标（非「综合」时，节点右上角） -->
      <view wx:if="{{item.badge}}" class="node-badge">{{item.badge}}</view>

      <!-- 已通关：✔ + 星数（可重玩） -->
      <block wx:if="{{item.state === 'done'}}">
        <view class="node-ok">✔</view>
        <view class="node-stars">★ {{item.stars}}</view>
      </block>

      <!-- 锁定：🔒 + 条件小字 -->
      <block wx:elif="{{item.state === 'lock'}}">
        <view class="node-lock">🔒</view>
        <view class="node-lock-tip">{{item.lockTip}}</view>
      </block>

      <!-- 当前可挑战：关卡号 + 继续 -->
      <block wx:else>
        <view class="node-num">{{item.level}}</view>
        <view class="node-go">继续 ▶</view>
      </block>
    </view>
  </view>

  <!-- 自定义关卡入口（M3） -->
  <view class="custom-level-entry" bindtap="goCustomLevel">
    <view class="entry-plus-circle">+</view>
    <text class="entry-text">自定义关卡</text>
    <text class="entry-arrow">→</text>
  </view>
</view>
