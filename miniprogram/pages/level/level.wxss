/* 关卡选择页样式（一期重做：蛇形地图 → 竖排关卡列表）
   结构：标题 / 游客横幅 / 学段胶囊 tab / 题型 chips / 星星进度卡 / 关卡列表 / 自定义关卡入口
   硬阴影 + :active 按压位移（与 avatar 页样板一致）
   一期同时删除了「闯关形态」模式栏与蛇形地图（节点定位/连线）两段样式。 */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-level {
  /* 2026-10-17：标题两行已删（导航栏已有页面名），顶部留白从 40rpx 收到 16rpx */
  padding: 16rpx 0;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 学段 tab（卡通胶囊） ===== */
.grade-tabs {
  white-space: nowrap;
  padding: 0 24rpx 20rpx;
  box-sizing: border-box;
}
.grade-tab {
  display: inline-block;
  width: 172rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-weight: 800;
  font-size: 30rpx;
  color: #5c7f9e;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
  margin-right: 20rpx;
  transition: all 0.12s;
}
.grade-tab:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
}
.grade-tab.on {
  color: #ffffff;
  background: #ffb703;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12), 0 12rpx 24rpx rgba(255, 183, 3, 0.35);
}

/* ===== 本学段星星进度卡（宝箱已并进来，省掉独立一行） ===== */
.progress-card {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}
.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-label {
  display: flex;
  align-items: center;
}
.progress-emoji {
  font-size: 32rpx;
  line-height: 1;
  margin-right: 10rpx;
}
.progress-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #3a3a5c;
}
.progress-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #ffb703;
}
/* 星星进度填充：金色渐变（容器 .progress-bar 为全局样式） */
.progress-bar__fill--gold {
  background: linear-gradient(90deg, #ffd166, #ffb703);
}

/* ===== 关卡列表（一期：一行一关） =====
   纵向列表天然自适应：不依赖可用高度估算，关卡数变化也只是多几行。 */
.level-list {
  margin: 0 32rpx;
}
.lvrow {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s, box-shadow 0.12s;
}
.lvrow:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
/* 已通关：淡绿底（星级由右侧展示） */
.lvrow.done {
  background: #f4fbf6;
}
/* 当前可挑战：金色描边 + 呼吸引导 */
.lvrow.cur {
  background: #fff8e6;
  box-shadow: 0 8rpx 0 rgba(255, 183, 3, 0.32), 0 0 0 4rpx #ffd166;
}
/* 锁定：灰底降饱和 */
.lvrow.lock {
  background: #f2f5f9;
  opacity: 0.82;
}
.lvrow.shake {
  animation: cardShake 0.4s;
}
@keyframes cardShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-12rpx); }
  75% { transform: translateX(12rpx); }
}

/* 左：关卡号方块 */
.lv-no {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #ffffff;
  background: #cfe0f2;
}
.lvrow.done .lv-no { background: #34A853; }
.lvrow.cur .lv-no { background: #ff9800; }
.lvrow.lock .lv-no { background: #cfd8e3; font-size: 32rpx; }

/* 中：题型标签 + 第 N 关 / 副说明 */
.lv-mid {
  flex: 1;
  min-width: 0;
}
.lv-t1 {
  display: flex;
  align-items: center;
}
.lv-kind {
  flex: 0 0 auto;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #2f6fd0;
  background: #e8f2ff;
}
.lv-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #3a3a5c;
}
/* 终关 Boss 徽标（第 30 关）：金色小牌，和普通关一眼区分开 */
.lv-boss {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  color: #6b3d00;
  background: linear-gradient(180deg, #ffe08a, #ffb703);
  box-shadow: 0 2rpx 0 rgba(139, 87, 0, 0.35);
}
/* Boss 行（2026-10-17）：暗紫底 + 立绘，和首页「Boss 预告」同一套视觉。
   以前只是金色描边 + 一枚 BOSS 小牌，和首页的 Boss 叙事完全脱节。 */
.lvrow.boss {
  background: linear-gradient(120deg, #4a3060, #7a3a5e);
  box-shadow: 0 8rpx 0 rgba(50, 20, 70, 0.35);
}
.lvrow.boss .lv-name { color: #ffffff; }
.lvrow.boss .lv-t2 { color: #f0c8e0; }
.lvrow.boss .lv-kind { background: rgba(255, 255, 255, 0.18); color: #ffe9f5; }
.lvrow.boss .lv-star { color: rgba(255, 255, 255, 0.32); }
.lvrow.boss .lv-star.on { color: #ffd166; }
.lvrow.boss .lv-go,
.lvrow.boss .lv-go--cur { color: #ffd166; }
.lvrow.boss .lv-locktip { color: #e6cfe0; }
.lvrow.boss .lv-no {
  background: linear-gradient(180deg, #ffb703, #e08b00);
}
/* 未解锁的 Boss 关不要用金色方块（会误以为已开放） */
.lvrow.lock.boss .lv-no {
  background: #cfd8e3;
}
.lvrow.lock.boss { opacity: 0.78; }

/* Boss 立绘位（普通关这里是关卡号方块） */
.lv-boss-ava {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.lv-boss-img { width: 72rpx; height: 72rpx; }
.lv-boss-emoji { font-size: 44rpx; line-height: 1; }
.lv-t2 {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a9bb5;
}

/* 右：星级 / 继续挑战 / 解锁条件 */
.lv-rt {
  flex: 0 0 auto;
  margin-left: 16rpx;
  text-align: right;
}
.lv-stars {
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.lv-star {
  color: #d5dde8;
}
.lv-star.on {
  color: #ffb703;
}
.lv-go {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 900;
  color: #8a9bb5;
}
.lv-go--cur {
  font-size: 24rpx;
  color: #ff8f00;
}
/* 已解锁但还没轮到：可直接开打（与「锁定」明确区分） */
.lv-go--open {
  font-size: 24rpx;
  color: #4cc9f0;
}
.lv-locktip {
  max-width: 190rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #9aa7bc;
  line-height: 1.35;
}

/* ===== 自定义关卡入口（M3） ===== */
.custom-level-entry {
  margin: 8rpx 32rpx 0;
  height: 120rpx;
  border-radius: 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s, box-shadow 0.12s;
}
.custom-level-entry:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
.entry-plus-circle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
  background: #ffb703;
  border-radius: 50%;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}
.entry-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #3a3a5c;
}
.entry-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: #c9d6e8;
}

/* ===== 游客横幅（M5 REQ-GUEST-1） ===== */
.guest-banner {
  margin: 8rpx 32rpx 24rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.05), 0 10rpx 20rpx rgba(0, 0, 0, 0.06);
}
.guest-banner-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}
.guest-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #5c7f9e;
  font-weight: 700;
}
.guest-banner-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: #4cc9f0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

/* ===== 题型分类 chips（题型分类关卡，2026-09-08） ===== */
.type-tabs {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}
.type-tab {
  display: inline-block;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5c7f9e;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 0.12s;
}
.type-tab:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}
.type-tab.on {
  color: #ffffff;
  background: #7bd389;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(123, 211, 137, 0.35);
}
.type-count {
  font-size: 20rpx;
  opacity: 0.85;
  margin-left: 6rpx;
}

/* ============ 自由玩入口（替代原「主线 / 自由练」分段，2026-10-18） ============ */
.free-entry {
  margin: 0 32rpx 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 5rpx 0 rgba(20, 70, 140, 0.08);
}
.free-entry:active { transform: translateY(2rpx); }
.free-entry__ic { font-size: 34rpx; flex: 0 0 auto; }
.free-entry__t { flex: 1; min-width: 0; }
.free-entry__b { font-size: 25rpx; font-weight: 900; color: #2f4a6b; }
.free-entry__s {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #7d93ad;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.free-entry__go { font-size: 32rpx; color: #9aaec4; flex: 0 0 auto; }

/* ============ 继续当前关（置顶条） ============ */
.continue-bar {
  margin: 0 32rpx 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #fff;
  background: linear-gradient(160deg, #ffb03a, #ff9a1f);
  box-shadow: 0 8rpx 0 #d97c00, 0 12rpx 20rpx rgba(200, 110, 0, 0.22);
}
.continue-bar:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 #d97c00;
}
.cb-t { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cb-b {
  font-size: 32rpx;
  font-weight: 900;
  text-shadow: 0 2rpx 0 rgba(160, 90, 0, 0.35);
}
.cb-s {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #fff6e4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cb-go {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 900;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
}

/* ============ 关卡分段标题（每 5 关一段） ============ */
.lv-group {
  margin: 6rpx 4rpx 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #5c7f9e;
  letter-spacing: 2rpx;
}

/* ============ 挑战主线里程碑宝箱（并进进度卡） ============ */
.chest-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.chest-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 6rpx;
  border-radius: 18rpx;
  background: #f4f7fc;
  font-size: 20rpx;
  font-weight: 800;
  color: #6b7f99;
}
.chest-chip__ic { font-size: 26rpx; line-height: 1; }
.chest-chip__tx {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.chest-chip.lock { opacity: 0.6; }
.chest-chip.ready {
  background: linear-gradient(135deg, #fff3d6, #ffe4a8);
  color: #b57900;
  box-shadow: 0 0 0 3rpx #ffb703;
}
.chest-chip.done { background: #eef7ef; color: #1E8E3E; }

/* ============ 年级只读行（2026-10-18 全局年级设置） ============ */
.grade-line {
  margin: 0 32rpx 16rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 5rpx 0 rgba(20, 70, 140, 0.08);
}
.grade-line:active { transform: translateY(2rpx); }
.grade-line__ic { font-size: 30rpx; flex: 0 0 auto; }
.grade-line__t { font-size: 27rpx; font-weight: 900; color: #2f4a6b; }
.grade-line__s { font-size: 21rpx; color: #8a9bb5; font-weight: 700; }
.grade-line__go { margin-left: auto; font-size: 21rpx; font-weight: 800; color: #4285F4; }
