/* 关卡选择页样式（T14 · UI 重设计）：
   学段卡通胶囊 tab + 星星进度卡 + 白色大圆角关卡卡片网格 + 自定义关卡入口
   硬阴影 + :active 按压位移（与 avatar 页样板一致） */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-level {
  padding: 40rpx 0;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 页面标题 ===== */
.level-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  text-align: center;
}
.level-sub {
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.85;
  letter-spacing: 4rpx;
  text-align: center;
}

/* ===== 学段 tab（卡通胶囊） ===== */
.grade-tabs {
  white-space: nowrap;
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}
.grade-tab {
  display: inline-block;
  width: 172rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-weight: 800;
  font-size: 30rpx;
  color: #5c7f9e;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08);
  margin-right: 20rpx;
  transition: all 0.12s;
}
.grade-tab:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
}
.grade-tab.on {
  color: #ffffff;
  background: #ffb703;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12), 0 12rpx 24rpx rgba(255, 183, 3, 0.35);
}

/* ===== 本学段星星进度卡 ===== */
.progress-card {
  margin: 0 32rpx 32rpx;
  padding: 26rpx 32rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}
.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.progress-label {
  display: flex;
  align-items: center;
}
.progress-emoji {
  font-size: 32rpx;
  line-height: 1;
  margin-right: 10rpx;
}
.progress-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #3a3a5c;
}
.progress-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #ffb703;
}
/* 星星进度填充：金色渐变 */
.progress-bar__fill--gold {
  background: linear-gradient(90deg, #ffd166, #ffb703);
}

/* ===== 关卡卡片网格 ===== */
.level-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 32rpx;
}
.level-card {
  width: 208rpx;
  height: 260rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid transparent;
  transition: transform 0.12s, box-shadow 0.12s;
  position: relative;
  margin-right: 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
/* 已解锁卡片按压位移 */
.level-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
/* 已得 1 星及以上：金色描边强化进度感 */
.level-card.has-star {
  border-color: #ffd166;
  background: #fffdf4;
}
.level-card.locked {
  filter: grayscale(0.9);
  opacity: 0.65;
  background: #f0f3f8;
}
.level-card.shake {
  animation: cardShake 0.4s;
}
@keyframes cardShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-12rpx); }
  75% { transform: translateX(12rpx); }
}

/* 星级（⭐ emoji / 灰 ☆） */
.stars {
  font-size: 34rpx;
  letter-spacing: 2rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin-bottom: 4rpx;
}
.star-on {
  color: #ffb703;
}
.star-off {
  color: #d5dde8;
  font-size: 28rpx;
}

/* 关卡编号 */
.num {
  font-size: 72rpx;
  font-weight: 900;
  color: #4cc9f0;
  line-height: 1.2;
  text-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.06);
}
.level-card.locked .num {
  color: #9aa7bc;
}

/* 锁定标识 */
.lock {
  font-size: 48rpx;
  margin-top: 4rpx;
}

/* ===== 自定义关卡入口（M3） ===== */
.custom-level-entry {
  margin: 16rpx 32rpx 0;
  height: 120rpx;
  border-radius: 32rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s, box-shadow 0.12s;
}
.custom-level-entry:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
.entry-plus-circle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1;
  background: #ffb703;
  border-radius: 50%;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}
.entry-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #3a3a5c;
}
.entry-arrow {
  font-size: 32rpx;
  font-weight: 900;
  color: #c9d6e8;
}

/* ===== 游客横幅（M5 REQ-GUEST-1） ===== */
.guest-banner {
  margin: 8rpx 32rpx 0;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.05), 0 10rpx 20rpx rgba(0, 0, 0, 0.06);
}
.guest-banner-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}
.guest-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #5c7f9e;
  font-weight: 700;
}
.guest-banner-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 26rpx;
  background: #4cc9f0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

/* ===== 题型分类 chips（题型分类关卡，2026-09-08） ===== */
.type-tabs {
  white-space: nowrap;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}
.type-tab {
  display: inline-block;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #5c7f9e;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.06);
  transition: all 0.12s;
}
.type-tab:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.06);
}
.type-tab.on {
  color: #ffffff;
  background: #7bd389;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08), 0 8rpx 16rpx rgba(123, 211, 137, 0.35);
}
.type-count {
  font-size: 20rpx;
  opacity: 0.85;
  margin-left: 6rpx;
}

/* 关卡卡分类徽标（非综合时显示） */
.type-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
  background: rgba(76, 201, 240, 0.92);
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  line-height: 1.6;
}
