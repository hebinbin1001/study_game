/* 战绩分享卡页（M6-K）
   2026-10-28：底色由深色（#1b2735→#12171f）改为与全站一致的天空浅色。
   原因：AGENTS.md §5 定的硬约定是「统一浅色主题」，而深色模式在这个项目里
   已经踩过一次坑（只改底色的半成品深色适配让 18 个页面整片发黑）。
   这张卡片本身就是浅色配色（导出图是浅底），页面深色反而和卡片撞。 */
page {
  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 58%, var(--sky-3) 100%);
  background-color: var(--sky-3);
  min-height: 100vh;
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-share {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pg-title {
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}
.pg-sub {
  font-size: var(--fs-cap);
  color: var(--ink-sub);
  margin-top: 12rpx;
  margin-bottom: 28rpx;
}

/* 画布/图片（宽 600rpx ≈ 逻辑 600×900 等比，2:3） */
.card-wrap {
  position: relative;
  width: 600rpx;
  height: 900rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--clay-3);
}
.share-canvas {
  width: 600rpx;
  height: 900rpx;
}
.share-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 600rpx;
}

/* 操作按钮 */
.btns {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}
.btn-act {
  width: 270rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--white);
  text-align: center;
  padding: 0;
  margin: 0;
}
.btn-act::after {
  border: none;
}
.btn-act--save {
  background: var(--blue);
  box-shadow: var(--clay-2);
}
.btn-act--share {
  background: var(--pri);
  box-shadow: var(--clay-2);
}
.btn-act[disabled] {
  opacity: 0.5;
}

/* 2026-10-28：原 .back-link 是死代码 —— wxml 里写的是 class="btn-back"（全局胶囊返回），
   页面又单独定义了 .back-link 却没人引用。删掉，返回统一走 app.wxss 的 .btn-back；
   这里只补一条本页需要的间距（全局件不加页级 margin）。 */
.page-share .btn-back {
  margin-top: 40rpx;
}
