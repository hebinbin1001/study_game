/* 单词贪吃蛇（B6-6） */
.page-snake {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
.sn-head { display: flex; align-items: center; gap: 20rpx; flex: 0 0 auto; }
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }
.sn-title { font-size: 40rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 0 rgba(0,0,0,.1); }
.sn-grade { margin-left: auto; background: rgba(255,255,255,.85); color: #5c7f9e; font-weight: 800; font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx; }

.hud { display: flex; justify-content: center; gap: 18rpx; margin: 16rpx 0; flex: 0 0 auto; }
.hud-chip {
  background: rgba(255,255,255,.92); color: #3a3a5c;
  border-radius: 999rpx; padding: 10rpx 26rpx;
  font-size: 24rpx; font-weight: 800;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.05);
}

/* 目标条 */
.target-bar {
  flex: 0 0 auto;
  background: #fff; border-radius: 24rpx;
  padding: 16rpx 22rpx; margin-bottom: 14rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.05);
}
.t-emoji { font-size: 44rpx; }
.t-main { flex: 1; min-width: 0; }
.t-tip { font-size: 20rpx; color: #8a9bb5; }
.t-word { font-size: 34rpx; font-weight: 900; color: #2e8b57; }

/* 网格 */
.grid {
  flex: 1 1 auto;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 6rpx;
  align-content: center;
  background: rgba(255,255,255,.35);
  border-radius: 20rpx;
  padding: 10rpx;
  min-height: 0;
}
.cell {
  aspect-ratio: 1/1;
  border-radius: 8rpx;
  background: rgba(255,255,255,.4);
}
.cell.head { background: #4cc9f0; box-shadow: inset 0 0 0 2rpx #fff; }
.cell.body { background: #9ae0f7; }
.cell.food-ok { background: #7bd389; }
.cell.food-bad { background: #ff8fae; }

/* 方向键 */
.pad { flex: 0 0 auto; margin: 12rpx 0 6rpx; }
.pad-row { display: flex; justify-content: center; gap: 16rpx; margin: 6rpx 0; }
.dir {
  width: 120rpx; height: 84rpx;
  background: rgba(255,255,255,.92); color: #5c7f9e;
  border-radius: 18rpx; display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.08);
}
.pad-gap { width: 120rpx; }
.dir:active { transform: translateY(3rpx); }
.foot-tip { flex: 0 0 auto; text-align: center; font-size: 20rpx; color: #fff; opacity: .9; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #3a3a5c; margin-top: 10rpx; }
.o-msg { font-size: 26rpx; color: #8a9bb5; margin-top: 10rpx; }
.btn { margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; font-size: 32rpx; font-weight: 900; }
.btn.b1 { background: #ffb703; color: #fff; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn.b2 { background: #eef2f8; color: #5c7f9e; }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
