/* 单词贪吃蛇（B6-6） */
.page-snake {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
/* 头部/HUD 统一到 app.wxss 的 .g-head/.g-title/.g-chip/.hud/.hud-chip（2026-09-12 视觉统一） */
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }
/* 目标条 */
.target-bar {
  flex: 0 0 auto;
  background: #fff; border-radius: 24rpx;
  padding: 16rpx 22rpx; margin-bottom: 14rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.05);
}
.t-emoji { font-size: 44rpx; }
.t-main { flex: 1; min-width: 0; }
.t-tip { font-size: 20rpx; color: #8a9bb5; }
.t-word { font-size: 34rpx; font-weight: 900; color: #2e8b57; }

/* 目标词卡 + 拼写进度 */
.word-card {
  flex: 0 0 auto;
  background: #fff; border-radius: 26rpx;
  padding: 18rpx 24rpx 20rpx; margin-bottom: 6rpx;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.05);
}
.wc-top { display: flex; align-items: baseline; gap: 18rpx; }
.wc-en { font-size: 44rpx; font-weight: 900; color: #2e8b57; letter-spacing: 2rpx; }
.wc-zh { font-size: 24rpx; color: #8a9bb5; }
.wc-progress { display: flex; gap: 10rpx; margin-top: 14rpx; flex-wrap: wrap; }
.wc-ch {
  min-width: 52rpx; height: 56rpx; line-height: 56rpx;
  text-align: center;
  background: #f0f4fa; color: #b6c2d3;
  border-radius: 12rpx; font-size: 30rpx; font-weight: 900;
}
.wc-ch.on { background: #7bd389; color: #fff; }

/* 触屏控制提示 */
.tap-hint { flex: 0 0 auto; text-align: center; font-size: 22rpx; color: #fff; opacity: .95; margin: 8rpx 0 6rpx; }

/* 触屏容器：占剩余高度，网格填满 */
.board-touch {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 网格 */
.grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 6rpx;
}
.cell {
  aspect-ratio: 1/1;
  border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 900;
  /* 空格子：凹进去的浅格，蛇身/食物才"浮"在板上 */
  background: rgba(255,255,255,.5);
  box-shadow: inset 0 2rpx 4rpx rgba(18,44,78,.10);
  color: #5c7f9e;
  box-sizing: border-box;
}
.cell.head {
  background: linear-gradient(180deg, #6fd8ff 0%, #35b3e8 100%);
  color: #fff;
  box-shadow: inset 0 0 0 2rpx #fff, 0 3rpx 8rpx rgba(18,44,78,.22);
}
.cell.body {
  background: linear-gradient(180deg, #b3e9fb 0%, #86d6f2 100%);
  box-shadow: inset 0 2rpx 4rpx rgba(255,255,255,.55);
}
.cell.food-ok {
  background: linear-gradient(180deg, #8fe0a0 0%, #57c374 100%);
  color: #fff; font-size: 28rpx;
  box-shadow: 0 3rpx 8rpx rgba(30,120,60,.28);
}
.cell.food-bad {
  background: linear-gradient(180deg, #ff9cbc 0%, #ff6f9c 100%);
  color: #fff; font-size: 28rpx;
  box-shadow: 0 3rpx 8rpx rgba(160,40,80,.28);
}

.foot-tip { flex: 0 0 auto; text-align: center; font-size: 20rpx; color: #fff; opacity: .9; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #3a3a5c; margin-top: 10rpx; }
.o-msg { font-size: 26rpx; color: #8a9bb5; margin-top: 10rpx; }
.btn { margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; font-size: 32rpx; font-weight: 900; }
.btn.b1 { background: #ffb703; color: #fff; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn.b2 { background: #eef2f8; color: #5c7f9e; }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
