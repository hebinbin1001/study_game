<!-- 单词贪吃蛇（B6-6 成熟玩法：按序吃字母拼词） -->
<view class="page-snake">
  <!-- 2026-10-17：删掉页内「返回 + 标题」——原生导航栏已有；目标词卡里本来就有当前目标，重复。 -->

  <!-- HUD -->
  <view class="hud">
    <view class="hud-chip">❤️ {{lives}}</view>
    <view class="hud-chip">分 {{score}}</view>
    <view class="hud-chip">{{targetLabel}}</view>
    <warrior-badge size="sm" />
    <game-pause
      inline
      open="{{paused}}"
      showFab="{{!over}}"
      sub="已拼 {{round}} 个词"
      bind:pause="onGamePause"
      bind:resume="onGameResume"
      bind:restart="onGameRestart"
      bind:quit="onGameQuit" />
  </view>

  <!-- 目标词卡：英文 + 释义 + 拼写进度 -->
  <view class="word-card">
    <view class="wc-top">
      <view class="wc-en">{{word}}</view>
      <view class="wc-zh">{{meaning}}</view>
    </view>
    <view class="wc-progress">
      <view
        wx:for="{{progress}}"
        wx:key="index"
        class="wc-ch {{item.done ? 'on' : ''}}">{{item.ch}}</view>
    </view>
  </view>

  <!-- 触屏提示 -->
  <view class="tap-hint">👆 点蛇头轴线哪一侧，就朝那一侧拐 90° · 吃掉「绿色字母」按顺序拼出上方单词</view>

  <!-- 网格（承载触屏） -->
  <view class="board-touch" bindtap="onBoardTap">
    <view class="grid b-tray b-in">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="cell {{item.cls}}"
        data-i="{{index}}"
        catchtap="onCellTap">{{item.ch || ''}}</view>
    </view>
  </view>

  <view class="foot-tip">👆 以蛇头为中心线：点左侧往左拐、点右侧往右拐（各 90°）· 点正前方直行 · 🟢 应拼字母 · 🔴 干扰字母</view>

  <battle-fx trigger="{{fxSeq}}" mode="{{fxMode}}" text="{{fxText}}" />

  <!-- 结算 -->
  <!-- 结算统一走公共组件（2026-10-17），原自绘遮罩样式与其它玩法不一致 -->
  <settle-pop
    visible="{{over}}"
    win="{{win}}"
    stars-text="{{starText}}"
    title="{{win ? '单词全拼完！' : '游戏结束'}}"
    msg="{{tip}}"
    hint="{{hintText}}"
    show-next="{{showNext && win}}"
    next-text="下一关 ▶"
    bind:retry="again"
    bind:next="onNext">
    <button class="btn btn-ghost" bindtap="goBack">返回关卡</button>
  </settle-pop>

  <view class="safe-gap"></view>

</view>


