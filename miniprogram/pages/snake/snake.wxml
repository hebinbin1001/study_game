<!-- 单词贪吃蛇（B6-6 成熟玩法：按序吃字母拼词） -->
<view class="page-snake">
  <view class="g-head">
    <button class="back-pill" bindtap="goBack">‹</button>
    <view class="g-title">单词贪吃蛇</view>
    <view class="g-chip">{{targetLabel}}</view>
  </view>

  <!-- HUD -->
  <view class="hud">
    <view class="hud-chip">❤{{lives}}</view>
    <view class="hud-chip">分 {{score}}</view>
    <view class="hud-chip">最高 {{best}}</view>
  </view>

  <!-- 目标词卡：英文 + 释义 + 拼写进度 -->
  <view class="word-card">
    <view class="wc-top">
      <view class="wc-en">{{word}}</view>
      <view class="wc-zh">{{meaning}}</view>
    </view>
    <view class="wc-progress">
      <view
        wx:for="{{progress}}"
        wx:key="index"
        class="wc-ch {{item.done ? 'on' : ''}}">{{item.ch}}</view>
    </view>
  </view>

  <!-- 触屏提示 -->
  <view class="tap-hint">👆 点蛇头轴线哪一侧，就朝那一侧拐 90° · 吃掉「绿色字母」按顺序拼出上方单词</view>

  <!-- 网格（承载触屏） -->
  <view class="board-touch">
    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="cell {{item.cls}}"
        data-i="{{index}}"
        catchtap="onCellTap">{{item.ch || ''}}</view>
    </view>
  </view>

  <view class="foot-tip">👆 以蛇头为中心线：点左侧往左拐、点右侧往右拐（各 90°）· 点正前方直行 · 🟢 应拼字母 · 🔴 干扰字母</view>

  <!-- 结算 -->
  <view wx:if="{{over}}" class="over-mask">
    <view class="over-card">
      <view class="o-stars">{{starText}}</view>
      <view class="o-title {{win ? '' : 'fail'}}">{{win ? '单词全拼完！' : '游戏结束'}}</view>
      <view class="o-msg">{{tip}}</view>
      <button class="btn b1" bindtap="again">再来一局</button>
      <button class="btn b2" bindtap="goBack">返回</button>
    </view>
  </view>

  <view class="safe-gap"></view>
</view>
