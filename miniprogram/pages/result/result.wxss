/* 结算页样式（T16）：
   星级 + 结算面板 + 操作按钮
   配色参考 prototype/index.html */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

/* ===== 大星级 ===== */
.big-stars {
  font-size: 88rpx;
  letter-spacing: 16rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}
.big-star.on {
  color: #ffb703;
}
.big-star.off {
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 结算面板 ===== */
.result-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 56rpx;
  padding: 52rpx 44rpx;
  text-align: center;
  box-shadow: 0 20rpx 0 rgba(0, 0, 0, 0.1), 0 36rpx 72rpx rgba(0, 0, 0, 0.16);
  box-sizing: border-box;
}
.res-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #3a3a5c;
}
.res-title-fail {
  color: #ff5d8f;
}

/* ===== 统计数据 ===== */
.stats {
  margin: 28rpx 0;
}
.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 16rpx;
  font-size: 30rpx;
  border-bottom: 1rpx dashed #e6eef5;
}
.row:last-child {
  border-bottom: none;
}
.row-label {
  color: #8899aa;
}
.row-value {
  font-weight: 700;
  color: #3a3a5c;
}

/* ===== 操作按钮 ===== */
.res-btns {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}
.btn {
  border: none;
  color: #fff;
  font-weight: 900;
  border-radius: 44rpx;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.18);
  letter-spacing: 4rpx;
}
.btn::after {
  border: none;
}
.btn-res {
  width: 240rpx;
  height: 104rpx;
  font-size: 34rpx;
  line-height: 104rpx;
}
.btn-blue {
  background: #4cc9f0;
  margin-right: 28rpx;
}
.btn-orange {
  background: #ffb703;
}
