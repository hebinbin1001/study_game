/* 结算页样式（T16 · UI 重设计）：
   ⭐ 星级弹跳展示 + 白色结算面板 + 2×2 数据卡 + 按压感按钮
   硬阴影 + :active 按压位移（与 avatar 页样板一致） */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== ⭐ 大星级 ===== */
.big-stars {
  display: flex;
  align-items: flex-end;
  height: 110rpx;
  margin-bottom: 28rpx;
}
.big-star {
  font-size: 84rpx;
  line-height: 1;
  margin: 0 8rpx;
  text-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.15);
}
.big-star.on {
  color: #ffb703;
  animation: starPop 0.5s ease both;
}
/* 弹跳登场：依次延迟，营造星星逐个点亮感 */
.big-star.on:nth-child(2) {
  animation-delay: 0.15s;
}
.big-star.on:nth-child(3) {
  animation-delay: 0.3s;
}
.big-star.off {
  color: rgba(255, 255, 255, 0.55);
}
@keyframes starPop {
  0% { transform: scale(0) rotate(-30deg); opacity: 0; }
  60% { transform: scale(1.3) rotate(8deg); opacity: 1; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

/* ===== 结算面板 ===== */
.result-panel {
  width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 52rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 0 rgba(0, 0, 0, 0.1), 0 24rpx 48rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}
.res-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #3a3a5c;
  letter-spacing: 4rpx;
}
.res-title-fail {
  color: #ff5d8f;
}
.res-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5c7f9e;
}

/* ===== 统计数据卡（2×2 网格） ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 36rpx 0 8rpx;
}
.stat-box {
  width: 260rpx;
  border-radius: 28rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06), 0 10rpx 20rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}
.stat-box--blue   { background: rgba(76, 201, 240, 0.14); }
.stat-box--green  { background: rgba(123, 211, 137, 0.18); }
.stat-box--purple { background: rgba(179, 136, 255, 0.16); }
.stat-box--orange { background: rgba(255, 209, 102, 0.25); }

.stat-emoji {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}
.stat-value {
  font-size: 40rpx;
  font-weight: 900;
  color: #3a3a5c;
  line-height: 1.2;
}
.stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5c7f9e;
  font-weight: 700;
}

/* ===== 操作按钮 ===== */
.res-btns {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
}
.btn {
  border: none;
  color: #fff;
  font-weight: 900;
  border-radius: 44rpx;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.15), 0 18rpx 32rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 4rpx;
  transition: transform 0.12s, box-shadow 0.12s;
}
/* 按压位移（卡通「按压感」） */
.btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.15);
}
.btn::after {
  border: none;
}
.btn-res {
  width: 248rpx;
  height: 104rpx;
  font-size: 34rpx;
  line-height: 104rpx;
}
.btn-blue {
  background: #4cc9f0;
  margin-right: 24rpx;
}
.btn-orange {
  background: #ffb703;
}
