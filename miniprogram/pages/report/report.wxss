/* 学习报告页（M6-D） */
page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-report {
  padding: 32rpx 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rep-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  text-align: center;
}
.rep-sub {
  text-align: center;
  font-size: 24rpx;
  color: #5c7f9e;
  margin: 12rpx 0 28rpx;
}

/* 概览 2×2 网格 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.stat-card {
  width: 320rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.06), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}
.stat-num {
  font-size: 52rpx;
  font-weight: 900;
  color: #4cc9f0;
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  color: #8a9bb5;
  margin-top: 6rpx;
}

/* 通用报告卡 */
.rep-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.06), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}
.rep-card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3a3a5c;
  margin-bottom: 20rpx;
}

/* 错题掌握 */
.wrong-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}
.ws-item { text-align: center; }
.ws-num { font-size: 44rpx; font-weight: 900; color: #5c7f9e; }
.ws-num--orange { color: #ffb703; }
.ws-num--green { color: #7bd389; }
.ws-label { font-size: 22rpx; color: #8a9bb5; margin-top: 4rpx; }
.rep-link {
  text-align: center;
  font-size: 26rpx;
  color: #4cc9f0;
  font-weight: 800;
  padding-top: 12rpx;
}

/* 日趋势柱状 */
.trend {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
}
.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  height: 100%;
}
.trend-bar-wrap {
  width: 32rpx;
  height: 140rpx;
  background: #eef2f8;
  border-radius: 16rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.trend-bar {
  width: 100%;
  min-height: 4rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #7bd389, #4cc9f0);
}
.trend-val {
  font-size: 20rpx;
  color: #5c7f9e;
  font-weight: 800;
  margin-top: 6rpx;
}
.trend-date {
  font-size: 18rpx;
  color: #aab7c8;
  margin-top: 2rpx;
}

/* 薄弱题型 */
.type-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.type-name {
  width: 120rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #3a3a5c;
  flex-shrink: 0;
}
.type-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: #eef2f8;
  border-radius: 12rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.type-bar {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #ffd166, #ffb703);
}
.type-count {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffb703;
  flex-shrink: 0;
}
