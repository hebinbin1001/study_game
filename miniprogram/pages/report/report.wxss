/* 学习报告页（M6-D） */
page {
  background: linear-gradient(180deg, var(--sky-2) 0%, var(--sky-3) 55%, var(--sky-3) 100%);
  min-height: 100vh;
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-report {
  padding: 32rpx 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rep-title {
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  text-align: center;
}
.rep-sub {
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-sub);
  margin: 12rpx 0 28rpx;
}

/* 概览 2×2 网格 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.stat-card {
  width: 320rpx;
  background: var(--white);
  border-radius: 28rpx;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--clay-2);
}
.stat-num {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--blue);
  line-height: 1.2;
}
.stat-label {
  font-size: var(--fs-cap);
  color: var(--ink-weak);
  margin-top: 6rpx;
}

/* 通用报告卡 */
.rep-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 28rpx 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--clay-2);
}
.rep-card-title {
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 20rpx;
}

/* 错题掌握 */
.wrong-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}
.ws-item { text-align: center; }
.ws-num { font-size: var(--fs-display); font-weight: 900; color: var(--ink-sub); }
.ws-num--orange { color: var(--pri); }
.ws-num--green { color: var(--green); }
.ws-label { font-size: var(--fs-cap); color: var(--ink-weak); margin-top: 4rpx; }
.rep-link {
  text-align: center;
  font-size: var(--fs-body);
  color: var(--blue);
  font-weight: 800;
  padding-top: 12rpx;
}

/* 日趋势柱状 */
.trend {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
}
.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  height: 100%;
}
.trend-bar-wrap {
  width: 32rpx;
  height: 140rpx;
  background: var(--surface);
  border-radius: 16rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.trend-bar {
  width: 100%;
  min-height: 4rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, var(--green), var(--blue));
}
.trend-val {
  font-size: var(--fs-cap);
  color: var(--ink-sub);
  font-weight: 800;
  margin-top: 6rpx;
}
.trend-date {
  font-size: var(--fs-cap);
  color: #aab7c8;
  margin-top: 2rpx;
}

/* 薄弱题型 */
.type-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.type-name {
  /* 2026-10-18：类型名改成中文后（如「汉字/成语挖1字」）120rpx 会折成两行，
     名称列加宽并略收字号，保证一行放下、条形图仍然完整。 */
  width: 200rpx;
  font-size: var(--fs-cap);
  line-height: 1.25;
  font-weight: 800;
  color: var(--ink);
  flex-shrink: 0;
}
.type-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: var(--surface);
  border-radius: var(--r-pill);
  margin: 0 16rpx;
  overflow: hidden;
}
.type-bar {
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(90deg, var(--gold), var(--pri));
}
.type-count {
  width: 60rpx;
  text-align: right;
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--pri-ink);
  flex-shrink: 0;
}
