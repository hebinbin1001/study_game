<!-- 词义消消乐（B6-2）：词↔义配对消除 -->
<view class="page-match">
  <view class="g-head">
    <button class="back-pill" bindtap="goBack">‹</button>
    <view class="g-title">词义消消乐</view>
    <view class="g-chip">{{gradeLabel}}</view>
  </view>

  <!-- HUD（公共组件） -->
  <game-hud lives="{{lives}}" extra="{{gradeLabel}} · 剩 {{left}} 卡" score="{{0}}" score-text="" />

  <!-- 棋盘 4×4 -->
  <view class="board b-tray b-in">
    <view
      wx:for="{{cards}}"
      wx:key="index"
      class="tile b-face b-press {{item.t === 'w' ? 'word' : ''}} {{item.sel ? 'b-sel' : ''}} {{item.hit ? 'hit' : ''}} {{item.gone ? 'gone' : ''}} {{item.miss ? 'miss' : ''}}"
      data-idx="{{index}}"
      bindtap="tapCard">{{item.lab}}</view>
  </view>

  <view class="tip">{{tip}}</view>

  <!-- 结算（公共组件 + 自定义操作） -->
  <settle-pop visible="{{over}}" win="{{win}}" stars-text="{{starsText}}"
    title="{{win ? '全部消除！' : '生命耗尽'}}" msg="{{win ? '获得 ' + stars + ' 星 · 错 ' + mistakes + ' 次' : '再试一次一定能行！'}}"
    show-retry="{{!win}}">
    <view class="s-btns">
      <button class="btn-main" bindtap="again">再来一局</button>
      <button class="btn-ghost" bindtap="changeGrade">换学段</button>
    </view>
  </settle-pop>

  <view class="safe-gap"></view>
</view>
