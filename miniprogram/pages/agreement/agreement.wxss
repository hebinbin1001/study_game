.page-agree {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(env(safe-area-inset-bottom) + 60rpx);
  background: var(--white);
}
.doc-title { font-size: var(--fs-title); font-weight: 900; color: #2c3e72; text-align: center; }
.doc-meta { text-align: center; font-size: var(--fs-cap); color: var(--ink-weak); margin: 10rpx 0 30rpx; }
.sec-title { font-size: var(--fs-strong); font-weight: 900; color: var(--link); margin: 30rpx 0 12rpx; }
.p { font-size: var(--fs-body); line-height: 1.75; color: var(--ink); margin-bottom: 16rpx; text-align: justify; }
.foot { text-align: center; color: #a9b2c2; font-size: var(--fs-cap); margin-top: 40rpx; }
.safe-gap { height: 24rpx; }
