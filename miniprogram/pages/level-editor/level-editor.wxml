<!-- 关卡编辑器页（表单卡片化重设计） -->
<view class="page-editor">
  <view class="editor-header">
    <button class="back-pill" bindtap="goBack">‹ 返回</button>
    <view class="header-title">{{editing ? '✏️ 编辑关卡' : '✨ 创建关卡'}}</view>
  </view>

  <!-- 关卡信息卡 -->
  <view class="card form-card">
    <view class="card-title">📋 关卡信息</view>

    <view class="form-item">
      <text class="label">标题</text>
      <input class="field-input" value="{{title}}" bindinput="onTitleInput" placeholder="请输入关卡标题" placeholder-class="field-placeholder" />
    </view>

    <view class="form-item">
      <text class="label">描述</text>
      <textarea class="field-textarea" value="{{description}}" bindinput="onDescriptionInput" placeholder="请输入关卡描述" placeholder-class="field-placeholder" />
    </view>

    <view class="form-item">
      <text class="label">学段</text>
      <picker value="{{grade}}" range="{{gradeOptions}}" range-key="label" bindchange="onGradeChange">
        <view class="field-picker">
          <text class="picker-text">{{gradeLabel}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 题目列表 -->
  <view class="items-section">
    <view class="section-header">
      <text class="section-title">📝 题目列表（{{items.length}}/10 · 提交需凑满 10 题一组）</text>
      <view class="section-actions">
        <button class="btn-pick" bindtap="openPicker">📚 从题库选</button>
        <button class="btn-add" bindtap="addItem">＋ 添加</button>
      </view>
    </view>

    <view class="item-list">
      <block wx:for="{{items}}" wx:key="index">
        <view class="item-card">
          <view class="item-header">
            <text class="item-index">第 {{index + 1}} 题</text>
            <button class="btn-remove" data-idx="{{index}}" bindtap="removeItem">删除</button>
          </view>

          <view class="item-form">
            <view class="form-item">
              <text class="label">类型</text>
              <picker value="{{item.type}}" range="{{['w1', 'w2', 'c1', 'c2', 'xhy', 'zc', 'fill', 'trans']}}" data-idx="{{index}}" data-field="type" bindchange="onItemInput">
                <view class="field-picker">
                  <text class="picker-text">{{item.type}}</text>
                  <text class="picker-arrow">▾</text>
                </view>
              </picker>
            </view>

            <view class="form-item">
              <text class="label">题目</text>
              <input class="field-input" value="{{item.q}}" data-idx="{{index}}" data-field="q" bindinput="onItemInput" placeholder="如：c*t" placeholder-class="field-placeholder" />
            </view>

            <view class="form-item">
              <text class="label">答案</text>
              <input class="field-input" value="{{item.a}}" data-idx="{{index}}" data-field="a" bindinput="onItemInput" placeholder="如：a" placeholder-class="field-placeholder" />
            </view>

            <view class="form-item">
              <text class="label">提示</text>
              <input class="field-input" value="{{item.hint}}" data-idx="{{index}}" data-field="hint" bindinput="onItemInput" placeholder="如：猫" placeholder-class="field-placeholder" />
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 题目空态 -->
    <view class="card--soft empty-card" wx:if="{{items.length === 0}}">
      <view class="empty-state">
        <text class="empty-emoji">🗂️</text>
        <view class="empty-text">还没有题目</view>
        <view class="empty-sub">点「📚 从题库选」批量挑题，或「＋ 添加」手打一道</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="btn-save" bindtap="saveDraft" disabled="{{saving}}">💾 保存草稿</button>
    <button class="btn-submit" bindtap="submitReview" disabled="{{saving}}">🚀 提交审核</button>
  </view>

  <!--
    从题库选题弹层（2026-09-18 方案 A）
    题库 = 我维护的词条（自建库挂在学段下），这里按学段挑 10 题组一关。
    自建关卡的题不进闯关题源 —— 只做单向搬运。
  -->
  <view wx:if="{{pickerShow}}" class="pk-mask" bindtap="closePicker">
    <view class="pk-sheet" catchtap="noop">
      <view class="pk-head">
        <text class="pk-title">📚 从题库选题</text>
        <text class="pk-close" bindtap="closePicker">✕</text>
      </view>
      <view class="pk-sub">已选 {{pickerCount}}/10 · 本学段共 {{pickerTotal}} 条（我的词条排在最前）</view>

      <scroll-view class="pk-scroll" scroll-x="true" enable-flex="true">
        <view class="pk-row">
          <view
            wx:for="{{pickerGrades}}"
            wx:key="key"
            class="pk-chip {{pickerGradeIndex === index ? 'on' : ''}}"
            data-index="{{index}}"
            bindtap="pickerPickGrade">{{item.label}}</view>
        </view>
      </scroll-view>

      <view class="pk-search">
        <text class="pk-search-ic">🔍</text>
        <input class="pk-search-input" value="{{pickerKeyword}}" placeholder="搜题目 / 答案 / 释义"
               bindinput="pickerSearch" confirm-type="search" />
        <text wx:if="{{pickerKeyword}}" class="pk-search-clr" bindtap="pickerClearSearch">✕</text>
      </view>

      <scroll-view class="pk-list" scroll-y="true" enhanced="true" show-scrollbar="{{false}}">
        <view
          wx:for="{{pickerOptions}}"
          wx:key="key"
          class="pk-item {{item.picked ? 'on' : ''}}"
          data-key="{{item.key}}"
          bindtap="pickerToggle">
          <view class="pk-check">{{item.picked ? '✓' : ''}}</view>
          <view class="pk-main">
            <view class="pk-qa">
              <text class="pk-q">{{item.q}}</text>
              <text class="pk-a">{{item.a}}</text>
            </view>
            <view wx:if="{{item.hint}}" class="pk-hint">{{item.hint}}</view>
          </view>
          <text class="pk-src {{item.srcRank === 0 ? 'mine' : (item.srcRank === 1 ? 'edit' : '')}}">{{item.src}}</text>
        </view>
        <view wx:if="{{!pickerOptions.length}}" class="pk-empty">没有匹配的词条</view>
        <view class="safe-gap"></view>
      </scroll-view>

      <view class="pk-btns">
        <view class="pk-btn ghost" bindtap="closePicker">取消</view>
        <view class="pk-btn" bindtap="pickerApply">加入题单（{{pickerCount}}）</view>
      </view>
      <view class="pk-tip">加入的是副本：改这里不会动题库；重复题会自动跳过，一关固定 10 题</view>
    </view>
  </view>
</view>
