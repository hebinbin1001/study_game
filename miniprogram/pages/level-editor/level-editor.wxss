/**
 * 关卡编辑器页（level-editor）—— 卡通表单卡片风
 * 风格对齐 app.wxss 设计系统 + avatar 样板：
 *   白色卡片 + 大圆角 + 底部硬阴影 + :active 按压位移
 * 注意：页面 js 使用 gradeLabel 预处理字段（上周修复成果），本文件仅做视觉呈现
 */

.page-editor {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.editor-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.back-pill {
  min-width: 140rpx;
  padding: 0 24rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.08), 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}
.back-pill:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.08);
}
button.back-pill::after {
  border: none;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  margin-right: 140rpx; /* 平衡返回按钮宽度，标题保持视觉居中 */
}

/* ============ 卡片标题 ============ */
.card-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #3a3a5c;
  margin-bottom: 28rpx;
}

/* ============ 表单卡（关卡信息） ============ */
.form-card {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #5c7f9e;
  margin-bottom: 12rpx;
}

/* 输入框：浅蓝灰底 + 大圆角 */
.field-input,
.field-textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  background: #f2f7fc;
  border-radius: 20rpx;
  color: #3a3a5c;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 4rpx solid #e1edf6;
}

.field-textarea {
  min-height: 140rpx;
  line-height: 1.5;
}

.field-placeholder {
  color: #a8bacf;
}

/* 学段选择器：输入框同款外观 + 箭头 */
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #f2f7fc;
  border-radius: 20rpx;
  border: 4rpx solid #e1edf6;
}

.picker-text {
  color: #3a3a5c;
  font-size: 28rpx;
  font-weight: 700;
}

.picker-arrow {
  color: #8a9bb5;
  font-size: 28rpx;
  font-weight: 900;
}

/* ============ 题目列表 ============ */
.items-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

/* 添加按钮：绿色小胶囊 + 按压感 */
.btn-add {
  min-width: 150rpx;
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 34rpx;
  background: #7bd389;
  color: #ffffff;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}
.btn-add:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.12);
}
button.btn-add::after {
  border: none;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 单题卡片：白卡 + 大圆角 + 硬阴影 */
.item-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 题号：彩色小徽章 */
.item-index {
  font-size: 24rpx;
  font-weight: 900;
  color: #ffffff;
  background: #4cc9f0;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

/* 删除按钮：浅红底红字小胶囊 */
.btn-remove {
  min-width: 110rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 28rpx;
  background: #ffe3e3;
  color: #ff5a5a;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}
.btn-remove:active {
  transform: translateY(4rpx);
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.08);
}
button.btn-remove::after {
  border: none;
}

/* ============ 底部操作按钮 ============ */
.action-section {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-save,
.btn-submit {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #ffffff;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.15), 0 18rpx 36rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}

.btn-save {
  background: #ffb703;
}

.btn-submit {
  background: #7bd389;
}

.btn-save:active,
.btn-submit:active {
  transform: translateY(6rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.15);
}

button.btn-save::after,
button.btn-submit::after {
  border: none;
}

/* 禁用态：半透明 + 取消按压位移 */
.btn-save[disabled],
.btn-submit[disabled] {
  opacity: 0.5;
  transform: none;
}

/* ============ 题目空态卡 ============ */
.empty-card {
  border-radius: 28rpx;
  padding: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #5c7f9e;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8a9bb5;
}
