/**
 * 关卡编辑器页（level-editor）—— 卡通表单卡片风
 * 风格对齐 app.wxss 设计系统 + avatar 样板：
 *   白色卡片 + 大圆角 + 底部硬阴影 + :active 按压位移
 * 注意：页面 js 使用 gradeLabel 预处理字段（上周修复成果），本文件仅做视觉呈现
 */

.page-editor {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.editor-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}.header-title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
  margin-right: 140rpx; /* 平衡返回按钮宽度，标题保持视觉居中 */
}

/* ============ 卡片标题 ============ */
.card-title {
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 28rpx;
}

/* ============ 表单卡（关卡信息） ============ */
.form-card {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: var(--ink-sub);
  margin-bottom: 12rpx;
}

/* 输入框：浅蓝灰底 + 大圆角 */
.field-input,
.field-textarea {
  width: 100%;
  padding: 22rpx 24rpx;
  background: var(--surface);
  border-radius: 28rpx;
  color: var(--ink);
  font-size: var(--fs-body);
  box-sizing: border-box;
  border: 4rpx solid #e1edf6;
}

.field-textarea {
  min-height: 140rpx;
  line-height: 1.5;
}

.field-placeholder {
  color: #a8bacf;
}

/* 学段选择器：输入框同款外观 + 箭头 */
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--surface);
  border-radius: 28rpx;
  border: 4rpx solid #e1edf6;
}

.picker-text {
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: 700;
}

.picker-arrow {
  color: var(--ink-weak);
  font-size: var(--fs-body);
  font-weight: 900;
}

/* ============ 题目列表 ============ */
.items-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--fs-strong);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}

/* 头部两个按钮（从题库选 + 添加） */
.section-actions { display: flex; gap: 12rpx; flex: 0 0 auto; }
.btn-pick {
  min-width: 176rpx;
  padding: 0 22rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  border-radius: var(--r-pill);
  background: #6AA6F5;
  color: var(--white);
  box-shadow: var(--clay-2);
}
.btn-pick::after { border: none; }

/* ============ 从题库选题弹层（2026-09-18） ============ */
.pk-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(23, 46, 66, .5);
  display: flex;
  align-items: flex-end;
  z-index: 60;
}
.pk-sheet {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 26rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--white);
}
.pk-head { display: flex; align-items: center; justify-content: space-between; }
.pk-title { font-size: var(--fs-strong); font-weight: 900; color: var(--ink-deep); }
.pk-close { font-size: var(--fs-strong); color: var(--ink-weak); padding: 0 8rpx; }
.pk-sub { margin-top: 6rpx; font-size: var(--fs-cap); color: var(--ink-weak); }

.pk-scroll { flex: 0 0 auto; width: 100%; white-space: nowrap; margin-top: 14rpx; }
.pk-row { display: flex; gap: 12rpx; padding: 2rpx 0; }
.pk-chip {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-sub);
  font-size: var(--fs-cap);
  font-weight: 800;
}
.pk-chip.on { background: var(--link); color: var(--white); }

.pk-search {
  flex: 0 0 auto;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: var(--surface);
}
.pk-search-ic { font-size: var(--fs-cap); }
.pk-search-input { flex: 1; font-size: var(--fs-body); color: var(--ink-deep); }
.pk-search-clr { font-size: var(--fs-body); color: var(--ink-weak); padding: 0 6rpx; }

.pk-list { flex: 1 1 auto; min-height: 420rpx; max-height: 620rpx; margin-top: 12rpx; }
.pk-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 28rpx;
  background: #f7fbff;
  border: 2rpx solid #e4eef8;
}
.pk-item.on { background: #eaf4ff; border-color: #9cc6f5; }
.pk-check {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--line);
  background: var(--white);
  color: var(--link);
  font-size: var(--fs-body);
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pk-item.on .pk-check { background: var(--link); border-color: var(--link); color: var(--white); }
.pk-main { flex: 1 1 auto; min-width: 0; }
.pk-qa { display: flex; align-items: baseline; gap: 12rpx; flex-wrap: wrap; }
.pk-q { font-size: var(--fs-body); font-weight: 900; color: var(--ink-deep); word-break: break-all; }
.pk-a { font-size: var(--fs-cap); font-weight: 800; color: var(--green); word-break: break-all; }
.pk-hint { margin-top: 4rpx; font-size: var(--fs-cap); color: var(--ink-weak); }
.pk-src {
  flex: 0 0 auto;
  font-size: var(--fs-cap);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--ink-weak);
}
.pk-src.mine { background: var(--soft-green); color: var(--green); }
.pk-src.edit { background: #fff4dd; color: #d18b00; }
.pk-empty { padding: 60rpx 0; text-align: center; font-size: var(--fs-body); color: var(--ink-weak); }

.pk-btns { flex: 0 0 auto; margin-top: 16rpx; display: flex; gap: 18rpx; }
.pk-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-pill);
  background: var(--pri);
  color: var(--white);
  font-size: var(--fs-strong);
  font-weight: 900;
  box-shadow: var(--clay-2);
}
.pk-btn.ghost { flex: 0 0 200rpx; background: var(--surface); color: var(--ink-weak); }
.pk-tip { margin-top: 14rpx; text-align: center; font-size: var(--fs-cap); color: var(--ink-weak); line-height: 1.5; }

/* 添加按钮：绿色小胶囊 + 按压感 */
.btn-add {
  min-width: 150rpx;
  padding: 0 24rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  border-radius: var(--r-pill);
  background: var(--green);
  color: var(--white);
  box-shadow: var(--clay-2);
  transition: transform 0.12s;
}
.btn-add:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}
button.btn-add::after {
  border: none;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 单题卡片：白卡 + 大圆角 + 硬阴影 */
.item-card {
  background: var(--white);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: var(--clay-2);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 题号：彩色小徽章 */
.item-index {
  font-size: var(--fs-cap);
  font-weight: 900;
  color: var(--white);
  background: var(--blue);
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  box-shadow: var(--clay-1);
}

/* 删除按钮：浅红底红字小胶囊 */
.btn-remove {
  min-width: 110rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: var(--fs-cap);
  font-weight: 700;
  border-radius: 28rpx;
  background: #ffe3e3;
  color: var(--danger);
  box-shadow: var(--clay-1);
  transition: transform 0.12s;
}
.btn-remove:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}
button.btn-remove::after {
  border: none;
}

/* ============ 底部操作按钮 ============ */
.action-section {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.btn-save,
.btn-submit {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 999rpx;
  font-size: var(--fs-strong);
  font-weight: 900;
  letter-spacing: 2rpx;
  color: var(--white);
  box-shadow: var(--clay-3);
  transition: transform 0.12s;
}

.btn-save {
  background: var(--pri);
}

.btn-submit {
  background: var(--green);
}

.btn-save:active,
.btn-submit:active {
  transform: translateY(6rpx);
  box-shadow: var(--clay-1);
}

button.btn-save::after,
button.btn-submit::after {
  border: none;
}

/* 禁用态：半透明 + 取消按压位移 */
.btn-save[disabled],
.btn-submit[disabled] {
  opacity: 0.5;
  transform: none;
}

/* ============ 题目空态卡 ============ */
.empty-card {
  border-radius: 28rpx;
  padding: 40rpx;
}

.empty-text {
  font-size: var(--fs-body);
  color: var(--ink-sub);
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
