.page-editor {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  color: #fff;
}

.editor-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.btn-back {
  background: transparent;
  color: #fff;
  font-size: 32rpx;
  padding: 0 20rpx;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.form-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 10rpx;
}

.input, .textarea {
  width: 100%;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
}

.picker {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
}

.picker-value {
  color: #fff;
  font-size: 28rpx;
}

.items-section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
}

.btn-add {
  padding: 10rpx 20rpx;
  background: #4caf50;
  color: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.item-index {
  font-size: 24rpx;
  color: #ffd700;
}

.btn-remove {
  padding: 8rpx 16rpx;
  background: #f44336;
  color: #fff;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.action-section {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-save, .btn-submit {
  flex: 1;
  padding: 30rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.btn-save {
  background: #ff9800;
  color: #fff;
}

.btn-submit {
  background: #4caf50;
  color: #fff;
}

.btn-save[disabled], .btn-submit[disabled] {
  opacity: 0.5;
}