/* 设置页（2026-10-28）
   字号只用 var(--fs-*)，圆角只用 var(--r-*)，颜色全部走变量。
   分隔线刻意不用 border：check-tokens 对硬编码边框色有基线，且卡片内两条目
   靠上下留白已经足够区分。 */

.page-set {
  min-height: 100vh;
  padding: var(--sp-3);
  box-sizing: border-box;
}

/* ---------- 顶栏 ---------- */
.st-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding-bottom: var(--sp-2);
}
.st-back {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: var(--fs-display);
  color: var(--ink);
}
.st-title {
  font-size: var(--fs-title);
  font-weight: 900;
  color: var(--ink);
}

/* ---------- 分组卡片 ---------- */
.st-group {
  margin-bottom: var(--sp-3);
  border-radius: var(--r-md);
  background: var(--white);
  box-shadow: var(--clay-card);
  overflow: hidden;
}
.st-row {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-3);
}
.st-row--tap:active {
  background: var(--sky-3);
}
.st-row-main {
  flex: 1;
  min-width: 0;
}
.st-row-t {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink);
}
.st-row-s {
  margin-top: 2rpx;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
  line-height: 1.6;
}
.st-row-arrow {
  flex: 0 0 auto;
  font-size: var(--fs-title);
  line-height: 1;
  color: var(--ink-weak);
}
.st-row-val {
  flex: 0 0 auto;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}

/* ---------- 页脚 ---------- */
.st-foot {
  margin-top: var(--sp-4);
  text-align: center;
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}

/* ---------- 字号三档（2026-10-28） ----------
   用「分段控件」而不是 switch：三档是互斥多选，switch 只能表达开/关；
   用 picker 又多一次跳转。分段控件点一下到位，还能顺带显示当前档。
   例文放在下面而不是塞进每一格：字号变化要看整句的换行与行距，
   单看「小/标准/大」三个字反而看不出差别。 */
.st-row--stack {
  flex-direction: column;
  align-items: stretch;
}
.fs-seg {
  display: flex;
  margin-top: var(--sp-2);
  padding: 4rpx;
  border-radius: var(--r-pill);
  background: var(--sky-3);
}
.fs-seg-i {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink-sub);
}
.fs-seg-i.is-on {
  background: var(--white);
  color: var(--pri-ink);
  box-shadow: var(--clay-1);
}
.fs-demo {
  padding: 0 var(--sp-3) var(--sp-3);
}
.fs-demo-t {
  font-size: var(--fs-cap);
  color: var(--ink-weak);
}
.fs-demo-b {
  margin-top: 4rpx;
  font-size: var(--fs-body);
  color: var(--ink);
  line-height: 1.7;
}
