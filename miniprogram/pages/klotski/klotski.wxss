/* 华容道 —— 视觉走「词力战士」的卡片语言：深色棋盘底板 + 暖色棋子 + 硬阴影 */
.page-klotski {
  min-height: 100vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #2f3350 0%, #3f4470 60%, #4a4f86 100%);
  display: flex;
  flex-direction: column;
}

/* ============ 顶栏 ============ */
.k-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}
.back-pill {
  width: 72rpx; height: 72rpx; padding: 0;
  background: rgba(255, 255, 255, .92);
  border-radius: 50%;
  font-size: 36rpx; font-weight: 900; color: #3a3a5c;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .12);
}
.k-title { font-size: 38rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 0 rgba(0, 0, 0, .12); }
.k-chip {
  margin-left: auto;
  background: rgba(255, 255, 255, .9);
  color: #5c7f9e; font-size: 24rpx; font-weight: 800;
  padding: 10rpx 22rpx; border-radius: 999rpx;
}

/* ============ 选关 ============ */
.k-intro {
  margin: 20rpx 0 12rpx;
  background: rgba(255, 255, 255, .94);
  border-radius: 24rpx;
  padding: 22rpx 26rpx;
}
.ki-t { font-size: 30rpx; font-weight: 900; color: #3a3a5c; }
.ki-s { font-size: 22rpx; color: #8a9bb5; margin-top: 8rpx; line-height: 1.5; }

.k-group { margin-top: 18rpx; }
.kg-head { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 10rpx; }
.kg-title { font-size: 26rpx; font-weight: 900; color: #fff; }
.kg-count { font-size: 22rpx; font-weight: 800; color: rgba(255, 255, 255, .8); }
.kg-list { display: flex; flex-direction: column; gap: 12rpx; }

.kg-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, .95);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .1);
}
.kg-item.locked { opacity: .55; }
.kg-item.classic { border: 3rpx solid #ffb703; }
.kg-no {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  background: #eef2f8; color: #3a3a5c; border-radius: 16rpx;
  font-weight: 900; font-size: 26rpx;
}
.kg-name { font-size: 28rpx; font-weight: 800; color: #3a3a5c; }
.kg-meta { margin-left: auto; font-size: 22rpx; color: #8a9bb5; }
.kg-stars { display: flex; gap: 2rpx; }
.ks { font-size: 24rpx; color: #d8e0ea; }
.ks.on { color: #ffb703; }

/* ============ HUD ============ */
.k-hud { display: flex; gap: 14rpx; margin: 18rpx 0 12rpx; flex: 0 0 auto; }
.kh-box {
  flex: 1;
  background: rgba(255, 255, 255, .94);
  border-radius: 20rpx;
  padding: 12rpx 8rpx;
  text-align: center;
}
.kh-num { font-size: 32rpx; font-weight: 900; color: #3a3a5c; }
.kh-lab { font-size: 20rpx; color: #8a9bb5; margin-top: 4rpx; }

/* ============ 棋盘 ============ */
.k-board {
  position: relative;
  width: 100%;
  /* 5 行：用屏幕宽度反推高度，保证 4:5 比例 */
  padding-top: 125%;
  flex: 0 0 auto;
  background: rgba(20, 22, 40, .55);
  border-radius: 28rpx;
  box-shadow: inset 0 0 0 6rpx rgba(255, 255, 255, .12);
  margin-top: 6rpx;
  overflow: hidden;
}
.k-cell { position: absolute; width: 25%; height: 20%; box-sizing: border-box; border: 2rpx solid rgba(255, 255, 255, .07); }
.k-cell.gate {
  background: rgba(255, 183, 3, .18);
  border: 4rpx dashed rgba(255, 183, 3, .85);
  border-radius: 12rpx;
}
.k-gate-text {
  position: absolute; right: 8rpx; bottom: 4rpx;
  font-size: 22rpx; font-weight: 900; color: rgba(255, 183, 3, .9);
}

/* 棋子：外层负责定位（百分比），内层负责外观（留缝） */
.k-piece { position: absolute; box-sizing: border-box; padding: 6rpx; transition: left .12s, top .12s; }
.kp-face {
  width: 100%; height: 100%;
  border-radius: 16rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  font-weight: 900; color: #fff;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .18), inset 0 -6rpx 0 rgba(0, 0, 0, .12);
}
.kp-glyph { font-size: 40rpx; line-height: 1; }
.kp-name { font-size: 18rpx; opacity: .9; margin-top: 6rpx; }

/* 曹操：红金，最大最醒目 */
.k-piece.cao .kp-face { background: linear-gradient(160deg, #ff7b7b 0%, #ff5d8f 60%, #e9457c 100%); box-shadow: 0 10rpx 0 #b8234f, inset 0 -6rpx 0 rgba(0, 0, 0, .15); }
.k-piece.cao .kp-glyph { font-size: 52rpx; }
/* 竖将：蓝紫系 */
.k-piece.v .kp-face { background: linear-gradient(160deg, #6d7bff 0%, #5b6bf0 100%); box-shadow: 0 8rpx 0 #3b45b8, inset 0 -6rpx 0 rgba(0, 0, 0, .12); }
/* 横将：青蓝 */
.k-piece.h .kp-face { background: linear-gradient(160deg, #4cc9f0 0%, #35a8d6 100%); box-shadow: 0 8rpx 0 #1f7fa8, inset 0 -6rpx 0 rgba(0, 0, 0, .12); }
/* 兵：绿 */
.k-piece.s .kp-face { background: linear-gradient(160deg, #8fe39a 0%, #6ac47c 100%); box-shadow: 0 6rpx 0 #3f8f52, inset 0 -4rpx 0 rgba(0, 0, 0, .1); }

/* 选中 / 提示 */
.k-piece.on .kp-face { outline: 6rpx solid #ffb703; outline-offset: -4rpx; }
.k-piece.hint .kp-face { animation: kp-pulse 1s ease-in-out infinite; outline: 6rpx solid #ffd166; outline-offset: -4rpx; }
@keyframes kp-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(.94); }
}

/* ============ 提示条 / 操作区 ============ */
.k-tip {
  margin-top: 14rpx;
  font-size: 22rpx; color: #fff; text-align: center;
  background: rgba(255, 255, 255, .14);
  border-radius: 999rpx; padding: 12rpx 20rpx;
}
.k-tip.dim { color: rgba(255, 255, 255, .75); font-size: 21rpx; }

.k-ops { display: flex; gap: 14rpx; margin-top: 14rpx; }
.op {
  flex: 1;
  background: rgba(255, 255, 255, .95);
  border-radius: 20rpx;
  padding: 14rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .12);
}
.op.off { opacity: .45; }
.op-i { display: block; font-size: 32rpx; }
.op-t { display: block; font-size: 20rpx; color: #5c7f9e; font-weight: 800; margin-top: 4rpx; }

/* 方向键：十字布局 */
.k-pad {
  position: relative;
  width: 260rpx; height: 200rpx;
  margin: 18rpx auto 0;
}
.pad-btn {
  position: absolute;
  width: 78rpx; height: 78rpx; line-height: 78rpx; text-align: center;
  background: rgba(255, 255, 255, .95);
  border-radius: 20rpx;
  font-size: 28rpx; font-weight: 900; color: #3a3a5c;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .12);
}
.pad-btn.up { left: 91rpx; top: 0; }
.pad-btn.left { left: 4rpx; top: 108rpx; }
.pad-btn.down { left: 91rpx; top: 108rpx; }
.pad-btn.right { left: 178rpx; top: 108rpx; }

/* ============ 结算按钮（settle-pop 插槽） ============ */
.s-btns { display: flex; flex-direction: column; gap: 16rpx; width: 100%; }
.s-btn {
  width: 100%; height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx; font-weight: 900;
  color: #3a3a5c;
  background: #eef2f8;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, .1);
}
.s-btn.primary { background: #ffb703; color: #fff; }
.s-btn.ghost { background: rgba(255, 255, 255, .9); }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 20rpx); }
