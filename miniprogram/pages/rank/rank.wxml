<!-- 排行榜页 -->
<view class="page-rank">
  <!-- 页面标题 -->
  <view class="rank-title-bar">
    <view class="rank-title-emoji">🏆</view>
    <view class="rank-title">全服排行榜</view>
    <view class="rank-title-sub">看看谁是词力小达人</view>
  </view>

  <!-- 全服榜标签（好友榜已下线，仅保留全服榜） -->
  <view class="tabs">
    <view class="tab active">🏅 全服榜</view>
  </view>

  <!-- 我的排名 -->
  <view class="my-rank" wx:if="{{myRank}}">
    <view class="my-rank-crown">👑</view>
    <view class="my-rank-main">
      <view class="my-rank-label">我的排名</view>
      <view class="my-rank-value">第 {{myRank.rank || '-'}} 名</view>
    </view>
    <view class="my-info">
      <image class="my-avatar" src="{{myRank.avatarUrl}}" mode="aspectFill"></image>
      <view class="my-meta">
        <view class="my-nickname">{{myRank.nickname || '未命名'}}</view>
        <view class="my-stars">⭐ {{myRank.stars || 0}}</view>
      </view>
    </view>
  </view>

  <!-- 排行榜列表 -->
  <view class="rank-list" wx:if="{{hasList}}">
    <view class="rank-item {{item.openid === myRank.openid ? 'me' : ''}}" wx:for="{{list}}" wx:key="openid">
      <view class="rank-number {{item.rankClass}}">
        {{item.rank <= 3 ? item.rankEmoji : item.rank}}
      </view>
      <image class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view class="rank-info">
        <view class="rank-nickname">{{item.nickname || '未命名'}}</view>
        <view class="rank-stars">⭐ 星数: {{item.stars || 0}}</view>
      </view>
      <view class="rank-detail">
        <view class="rank-rankName">{{item.rankName || '青铜'}}</view>
        <view class="rank-score">{{item.score || 0}} 分</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:if="{{!hasList}}">
    <view class="empty-emoji">📭</view>
    <view class="empty-text">榜单还空空的，快去闯关上榜吧！</view>
  </view>

  <!-- 分页 -->
  <view class="pagination" wx:if="{{total > pageSize}}">
    <button class="btn-page" bindtap="prevPage" disabled="{{page <= 1}}">‹ 上一页</button>
    <text class="page-info">第 {{page}} / {{totalPages}} 页</text>
    <button class="btn-page" bindtap="nextPage" disabled="{{page >= totalPages}}">下一页 ›</button>
  </view>

  <!-- 返回按钮 -->
  <button class="btn-back" bindtap="goBack">返回</button>
</view>
