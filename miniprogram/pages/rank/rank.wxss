/* 排行榜页（rank）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-rank {
  padding: 16rpx 30rpx calc(env(safe-area-inset-bottom) + 20rpx);
  height: 100vh;
  box-sizing: border-box;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}

/* ============ 页面标题 ============ */
.rank-title-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 6rpx 0 20rpx;
  flex: 0 0 auto;
}
.rank-title-area { flex: 1; }
.rank-title-emoji {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.rank-title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--white);
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
}

.rank-title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* ============ 榜单标签 ============ */
.tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--white);
  background: rgba(255, 255, 255, 0.28);
  border-radius: 28rpx;
  transition: transform 0.12s;
}

.tab.active {
  background: var(--pri);
  color: var(--white);
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
  box-shadow: var(--clay-2);
}

/* ============ 我的排名卡（金色高亮） ============ */
.my-rank {
  background: linear-gradient(135deg, var(--gold) 0%, var(--pri) 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--clay-2);
}

.my-rank-crown {
  font-size: 56rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.my-rank-main {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
}

.my-rank-label {
  font-size: 24rpx;
  color: #6b4e00;
  font-weight: 700;
}

.my-rank-value {
  font-size: 48rpx;
  font-weight: 900;
  color: #3b3b5f;
  line-height: 1.2;
}

.my-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-width: 0;
}

.my-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid var(--white);
  box-sizing: border-box;
  flex-shrink: 0;
}

.my-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.my-nickname {
  font-size: 24rpx;
  color: #3b3b5f;
  font-weight: 700;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-stars {
  font-size: 24rpx;
  color: #6b4e00;
  font-weight: 700;
}

/* ============ 排行榜列表（条目卡片化） ============ */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rank-number.top1 {
  background: var(--gold);
  color: #6b4e00;
  box-shadow: var(--clay-1);
}

.rank-number.top2 {
  background: #c9d6e8;
  color: #4a5568;
  box-shadow: var(--clay-1);
}

.rank-number.top3 {
  background: #eab68c;
  color: #7a4a1d;
  box-shadow: var(--clay-1);
}

/* 头像兜底：没有头像时用昵称首字占位（2026-09-13 用户反馈「名称前留了两个空」） */
.rank-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e8f0fa;
  color: var(--ink-sub);
  font-size: 32rpx;
  font-weight: 900;
}
/* 段位徽章（大段 8 枚，走云托管） */
.rank-badge {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  margin-right: 12rpx;
}

.rank-stars {
  font-size: 24rpx;
  color: var(--ink-sub);
}

.rank-detail {
  text-align: right;
  flex-shrink: 0;
}

.rank-rankName {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--purple);
  background: rgba(179, 136, 255, 0.14);
  padding: 4rpx 14rpx;
  border-radius: 28rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.rank-score {
  font-size: 32rpx;
  font-weight: 900;
  color: #3b3b5f;
}

/* ============ 空态 ============ */
.empty-state {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 60rpx 30rpx;
  box-shadow: var(--clay-2);
}

.empty-text {
  color: #8899aa;
  font-size: 28rpx;
}

/* ============ 分页 ============ */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 36rpx 0 24rpx;
}

.btn-page {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: var(--blue);
  color: var(--white);
  border-radius: 28rpx;
  line-height: 1.4;
  box-shadow: var(--clay-2);
  transition: transform 0.12s;
}

.btn-page:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}

.btn-page[disabled] {
  opacity: 0.5;
  background: #c9d6e8;
  color: var(--white);
}

button.btn-page::after {
  border: none;
}

.page-info {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--white);
  background: rgba(255, 255, 255, 0.85);
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}

/* ============ 返回按钮 ============ */
.btn-back {
  margin-top: 20rpx;
  width: 320rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.9);
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 28rpx;
  line-height: 1.4;
  box-shadow: var(--clay-2);
  transition: transform 0.12s;
}

.btn-back:active {
  transform: translateY(4rpx);
  box-shadow: var(--clay-1);
}

button.btn-back::after {
  border: none;
}

/* ============ B3 双榜新增 ============ */
/* 模式切换 tab 撑满 */
.rank-mode-tabs { flex: 0 0 auto; margin-bottom: 16rpx; }
.rank-mode-tabs .tab { flex: 1; text-align: center; }

/* 玩法/学段/题型 chips */
/* 2026-09-18：.game-chips（14 个玩法平铺、把页面顶宽的元凶）已随改版删除，
   玩法选择改为「卡片总览 → 详情」两层；筛选行统一用 .row-inner（套在 scroll-view 里）。 */
.row-inner { display: flex; gap: 14rpx; padding: 4rpx 0 8rpx; }
.row-scroll { flex: 0 0 auto; width: 100%; white-space: nowrap; }
.chip {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, .92);
  color: var(--ink-sub);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  margin-right: 14rpx;
  flex: 0 0 auto;
}
.chip.on { background: var(--pri); color: var(--white); }

/* ============ 玩法榜总览卡片（2026-09-18） ============ */
.game-cards { display: flex; flex-direction: column; gap: 16rpx; padding: 4rpx 0 8rpx; }
.gcard {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .96);
  box-shadow: var(--clay-2);
}
.gcard-icon {
  flex: 0 0 auto;
  width: 78rpx;
  height: 78rpx;
  border-radius: 28rpx;
  background: #eef5fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}
.gcard-main { flex: 1 1 auto; min-width: 0; }
.gcard-name { font-size: 32rpx; font-weight: 900; color: #2f5470; }
.gcard-meta { margin-top: 4rpx; }
.gcard-me { font-size: 24rpx; font-weight: 800; color: #4a90d9; }
.gcard-me.none { color: #93a9bd; font-weight: 700; }
.gcard-champ {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  font-size: 24rpx;
  color: #7b93ad;
}
.gcard-players { flex: 0 0 auto; color: #b0c1d1; }
.gcard-arrow { flex: 0 0 auto; font-size: 32rpx; color: #c3ccda; font-weight: 700; }

/* 详情头部 */
.no-nick {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .95);
  box-shadow: var(--clay-2);
}
.no-nick-ic { font-size: 32rpx; flex: 0 0 auto; }
.no-nick-t { flex: 1 1 auto; font-size: 24rpx; font-weight: 800; color: #2f5470; }
.no-nick-arrow { flex: 0 0 auto; font-size: 32rpx; color: #c3ccda; font-weight: 700; }

.detail-head {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 6rpx 4rpx 10rpx;
}
.detail-icon { font-size: 32rpx; }
.detail-name { font-size: 32rpx; font-weight: 900; color: var(--white); }
.detail-count { font-size: 24rpx; color: rgba(255, 255, 255, .85); }

/* 榜题 */
.board-label {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--white);
  font-weight: 700;
  margin: 8rpx 0 12rpx;
  opacity: .95;
}

/* 榜单滚动区（占满剩余高度） */
.board-scroll { flex: 1 1 auto; min-height: 0; width: 100%; }

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
  background: var(--white);
  border-radius: var(--r-md);
  /* border 常驻透明：将来做选中态时加 border-color 不会让行高跳一下 */
  border: 4rpx solid transparent;
  box-sizing: border-box;
  box-shadow: var(--clay-2);
}
.rank-item.me { outline: 4rpx solid var(--pri); }
.rank-number {
  width: 56rpx; height: 56rpx;
  flex: 0 0 56rpx;
  margin-right: 16rpx;
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 900;
  color: var(--ink-weak);
}
.rank-number.top1 { background: #ffe9c4; color: #d88a00; }
.rank-number.top2 { background: #e8edf4; color: #8a94a6; }
.rank-number.top3 { background: #f6ddc8; color: #c07a3a; }
.rank-avatar {
  width: 76rpx; height: 76rpx; flex: 0 0 76rpx;
  border-radius: var(--r-pill);
  /* 2026-10-28 合并重复定义：原来是「前一套 margin-right:20 + 后一套 margin-left:14」
     同时生效，头像左右间距 20/14 不对称。统一成右侧 16。 */
  margin: 0 16rpx 0 0;
  background: #e8f0fa;
  border: 4rpx solid #eef3fa;
  box-sizing: border-box;
}
.rank-info { flex: 1; min-width: 0; }
.rank-nickname {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-rankname { font-size: 24rpx; color: var(--ink-weak); margin-top: 4rpx; }
.rank-val {
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--ink);
  margin-left: 12rpx;
}
.rank-val--p { color: #d88a00; }

.safe-gap { height: 24rpx; }
