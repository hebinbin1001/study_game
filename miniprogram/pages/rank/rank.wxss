/* 排行榜页（rank）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-rank {
  padding: 16rpx 30rpx calc(env(safe-area-inset-bottom) + 20rpx);
  height: 100vh;
  box-sizing: border-box;
  color: #3a3a5c;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}

/* ============ 页面标题 ============ */
.rank-title-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 6rpx 0 20rpx;
  flex: 0 0 auto;
}
.back-pill {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  font-size: 40rpx;
  color: #3a3a5c;
  font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06);
  line-height: 88rpx;
}
.back-pill::after { border: none; }
.rank-title-area { flex: 1; }
.rank-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.12);
}
.rank-title-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-top: 4rpx;
}

.rank-title-emoji {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.rank-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
}

.rank-title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* ============ 榜单标签 ============ */
.tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 28rpx;
  transition: transform 0.12s;
}

.tab.active {
  background: #ffb703;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.1);
}

/* ============ 我的排名卡（金色高亮） ============ */
.my-rank {
  background: linear-gradient(135deg, #ffd166 0%, #ffb703 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}

.my-rank-crown {
  font-size: 56rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.my-rank-main {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
}

.my-rank-label {
  font-size: 22rpx;
  color: #6b4e00;
  font-weight: 700;
}

.my-rank-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #3b3b5f;
  line-height: 1.2;
}

.my-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-width: 0;
}

.my-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.my-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.my-nickname {
  font-size: 24rpx;
  color: #3b3b5f;
  font-weight: 700;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-stars {
  font-size: 22rpx;
  color: #6b4e00;
  font-weight: 700;
}

/* ============ 排行榜列表（条目卡片化） ============ */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: transform 0.12s;
}

.rank-item.me {
  background: #fff7e0;
  border-color: #ffb703;
}

.rank-number {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #8a9bb5;
  background: #eef3fa;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-number.top1 {
  background: #ffd166;
  color: #6b4e00;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-number.top2 {
  background: #c9d6e8;
  color: #4a5568;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-number.top3 {
  background: #eab68c;
  color: #7a4a1d;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid #eef3fa;
  box-sizing: border-box;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: #3b3b5f;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-stars {
  font-size: 22rpx;
  color: #5c7f9e;
}

.rank-detail {
  text-align: right;
  flex-shrink: 0;
}

.rank-rankName {
  font-size: 22rpx;
  font-weight: 700;
  color: #b388ff;
  background: rgba(179, 136, 255, 0.14);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.rank-score {
  font-size: 30rpx;
  font-weight: 900;
  color: #3b3b5f;
}

/* ============ 空态 ============ */
.empty-state {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 60rpx 30rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.06), 0 14rpx 28rpx rgba(0, 0, 0, 0.06);
}

.empty-text {
  color: #8899aa;
  font-size: 28rpx;
}

/* ============ 分页 ============ */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 36rpx 0 24rpx;
}

.btn-page {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #4cc9f0;
  color: #ffffff;
  border-radius: 28rpx;
  line-height: 1.4;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}

.btn-page:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.12);
}

.btn-page[disabled] {
  opacity: 0.5;
  background: #c9d6e8;
  color: #ffffff;
}

button.btn-page::after {
  border: none;
}

.page-info {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.85);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

/* ============ 返回按钮 ============ */
.btn-back {
  margin-top: 20rpx;
  width: 320rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  line-height: 1.4;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}

.btn-back:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08);
}

button.btn-back::after {
  border: none;
}

/* ============ B3 双榜新增 ============ */
/* 模式切换 tab 撑满 */
.rank-mode-tabs { flex: 0 0 auto; margin-bottom: 16rpx; }
.rank-mode-tabs .tab { flex: 1; text-align: center; }

/* 玩法/学段/题型 chips */
.game-chips, .row-inner { display: flex; gap: 14rpx; padding: 4rpx 0 8rpx; }
.row-scroll { flex: 0 0 auto; width: 100%; white-space: nowrap; }
.gchip, .chip {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, .92);
  color: #5c7f9e;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  margin-right: 14rpx;
  flex: 0 0 auto;
}
.gchip.on, .chip.on { background: #ffb703; color: #fff; }

/* 榜题 */
.board-label {
  flex: 0 0 auto;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
  margin: 8rpx 0 12rpx;
  opacity: .95;
}

/* 榜单滚动区（占满剩余高度） */
.board-scroll { flex: 1 1 auto; min-height: 0; width: 100%; }

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, .05);
}
.rank-item.me { outline: 4rpx solid #ffb703; }
.rank-number {
  width: 56rpx; height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 900;
  color: #8a9bb5;
}
.rank-number.top1 { background: #ffe9c4; color: #d88a00; }
.rank-number.top2 { background: #e8edf4; color: #8a94a6; }
.rank-number.top3 { background: #f6ddc8; color: #c07a3a; }
.rank-avatar {
  width: 76rpx; height: 76rpx; flex: 0 0 76rpx;
  border-radius: 50%; margin-left: 14rpx;
  background: #e8f0fa;
}
.rank-info { flex: 1; min-width: 0; margin-left: 18rpx; }
.rank-nickname { font-size: 28rpx; font-weight: 800; color: #3a3a5c; }
.rank-rankname { font-size: 20rpx; color: #8a9bb5; margin-top: 4rpx; }
.rank-val {
  flex: 0 0 auto;
  font-size: 26rpx;
  font-weight: 900;
  color: #3a3a5c;
  margin-left: 12rpx;
}
.rank-val--p { color: #d88a00; }

.safe-gap { height: 24rpx; }
