/* 排行榜页（rank）—— 暖色天空卡通风（与 app.wxss 全局主题一致） */
.page-rank {
  padding: 20rpx 30rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  color: #3a3a5c;
}

/* ============ 页面标题 ============ */
.rank-title-bar {
  text-align: center;
  margin: 30rpx 0 28rpx;
}

.rank-title-emoji {
  font-size: 76rpx;
  line-height: 1;
  margin-bottom: 10rpx;
}

.rank-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
}

.rank-title-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

/* ============ 榜单标签 ============ */
.tabs {
  display: flex;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 28rpx;
  transition: transform 0.12s;
}

.tab.active {
  background: #ffb703;
  color: #ffffff;
  text-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.1);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.1);
}

/* ============ 我的排名卡（金色高亮） ============ */
.my-rank {
  background: linear-gradient(135deg, #ffd166 0%, #ffb703 100%);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
}

.my-rank-crown {
  font-size: 56rpx;
  line-height: 1;
  margin-right: 20rpx;
}

.my-rank-main {
  display: flex;
  flex-direction: column;
  margin-right: 24rpx;
}

.my-rank-label {
  font-size: 22rpx;
  color: #6b4e00;
  font-weight: 700;
}

.my-rank-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #3b3b5f;
  line-height: 1.2;
}

.my-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  min-width: 0;
}

.my-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.my-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.my-nickname {
  font-size: 24rpx;
  color: #3b3b5f;
  font-weight: 700;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-stars {
  font-size: 22rpx;
  color: #6b4e00;
  font-weight: 700;
}

/* ============ 排行榜列表（条目卡片化） ============ */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: transform 0.12s;
}

.rank-item.me {
  background: #fff7e0;
  border-color: #ffb703;
}

.rank-number {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #8a9bb5;
  background: #eef3fa;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-number.top1 {
  background: #ffd166;
  color: #6b4e00;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-number.top2 {
  background: #c9d6e8;
  color: #4a5568;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-number.top3 {
  background: #eab68c;
  color: #7a4a1d;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.1);
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid #eef3fa;
  box-sizing: border-box;
  flex-shrink: 0;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: #3b3b5f;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-stars {
  font-size: 22rpx;
  color: #5c7f9e;
}

.rank-detail {
  text-align: right;
  flex-shrink: 0;
}

.rank-rankName {
  font-size: 22rpx;
  font-weight: 700;
  color: #b388ff;
  background: rgba(179, 136, 255, 0.14);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.rank-score {
  font-size: 30rpx;
  font-weight: 900;
  color: #3b3b5f;
}

/* ============ 空态 ============ */
.empty-state {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 28rpx;
  padding: 60rpx 30rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.06), 0 14rpx 28rpx rgba(0, 0, 0, 0.06);
}

.empty-text {
  color: #8899aa;
  font-size: 28rpx;
}

/* ============ 分页 ============ */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 36rpx 0 24rpx;
}

.btn-page {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #4cc9f0;
  color: #ffffff;
  border-radius: 28rpx;
  line-height: 1.4;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
  transition: transform 0.12s;
}

.btn-page:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(0, 0, 0, 0.12);
}

.btn-page[disabled] {
  opacity: 0.5;
  background: #c9d6e8;
  color: #ffffff;
}

button.btn-page::after {
  border: none;
}

.page-info {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.85);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

/* ============ 返回按钮 ============ */
.btn-back {
  margin-top: 20rpx;
  width: 320rpx;
  padding: 20rpx 0;
  background: rgba(255, 255, 255, 0.9);
  color: #3a3a5c;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  line-height: 1.4;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.12s;
}

.btn-back:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.08);
}

button.btn-back::after {
  border: none;
}
