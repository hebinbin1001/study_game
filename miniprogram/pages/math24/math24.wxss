/* 算 24 点（B6-4） */
.page-24 {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
.p-head { display: flex; align-items: center; gap: 20rpx; flex: 0 0 auto; }
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }
.p-title { font-size: 40rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 0 rgba(0,0,0,.1); }
.p-grade { margin-left: auto; background: rgba(255,255,255,.85); color: #5c7f9e; font-weight: 800; font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 999rpx; }

.intro { background: #fff; border-radius: 28rpx; padding: 28rpx; text-align: center; margin: 20rpx 0; }
.i-t { font-size: 32rpx; font-weight: 900; color: #3a3a5c; }
.i-s { font-size: 22rpx; color: #8a9bb5; margin-top: 8rpx; line-height: 1.5; }
.levels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.lv {
  background: #fff; border-radius: 24rpx; padding: 22rpx;
  text-align: center; box-shadow: 0 8rpx 0 rgba(0,0,0,.05);
}
.lv.on { outline: 6rpx solid #ffb703; }
.lv-no { font-size: 24rpx; font-weight: 800; color: #3a3a5c; }
.lv-nums { font-size: 40rpx; font-weight: 900; color: #b57900; letter-spacing: 6rpx; margin-top: 8rpx; }

.hud { display: flex; justify-content: center; gap: 18rpx; margin: 20rpx 0; flex: 0 0 auto; }
.hud-chip {
  background: rgba(255,255,255,.92); color: #3a3a5c;
  border-radius: 999rpx; padding: 12rpx 30rpx;
  font-size: 26rpx; font-weight: 800;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.05);
}

/* 数字池：随合成数变化，grid 自适应列 */
.board {
  flex: 1 1 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-content: center;
  align-items: center;
  gap: 24rpx;
  min-height: 0;
}
.num-card {
  width: 200rpx; height: 200rpx;
  position: relative;
  background: #fff;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; font-weight: 900; color: #3a3a5c;
  box-shadow: 0 10rpx 0 rgba(0,0,0,.06);
  box-sizing: border-box;
}
.nc-text { line-height: 1; word-break: break-all; }
.nc-mark {
  position: absolute; top: 6rpx; right: 12rpx;
  font-size: 26rpx; color: #ffb703; font-weight: 900;
}
.num-card.res { background: #fff8e6; color: #b57900; font-size: 48rpx; }
.num-card.sel { outline: 8rpx solid #ffb703; }
.num-card.sel2 { outline: 8rpx solid #7bd389; }
.num-card:active { opacity: .85; }

/* 运算符 */
.ops { flex: 0 0 auto; display: flex; justify-content: center; gap: 20rpx; margin: 10rpx 0 6rpx; }
.op {
  width: 130rpx; height: 110rpx;
  background: #fff; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 900; color: #4cc9f0;
  box-shadow: 0 8rpx 0 rgba(0,0,0,.07);
}
.op:active { transform: translateY(3rpx); background: #e8f7ff; }

/* 工具行：撤销 / 重置 */
.tools { flex: 0 0 auto; display: flex; justify-content: center; gap: 24rpx; margin: 8rpx 0 2rpx; }
.tool {
  background: rgba(255,255,255,.9); color: #5c7f9e;
  border-radius: 999rpx; padding: 12rpx 36rpx;
  font-size: 26rpx; font-weight: 800;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.tool:active { opacity: .8; }
.op-tip { flex: 0 0 auto; text-align: center; font-size: 24rpx; color: #fff; opacity: .95; min-height: 40rpx; }
.goal { flex: 0 0 auto; text-align: center; font-size: 24rpx; color: #fff; font-weight: 800; opacity: .9; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #2e8b57; margin-top: 10rpx; }
.o-title.fail { color: #e62e2e; }
.o-msg { font-size: 26rpx; color: #8a9bb5; margin-top: 10rpx; }
.btn { margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; font-size: 32rpx; font-weight: 900; }
.btn.b1 { background: #ffb703; color: #fff; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn.b2 { background: #eef2f8; color: #5c7f9e; }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
