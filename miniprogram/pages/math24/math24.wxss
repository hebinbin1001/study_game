/* 算 24 点（成熟玩法：构造算式） */
.page-24 {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
/* 头部/HUD 统一到 app.wxss 的 .g-head/.g-title/.g-chip/.hud/.hud-chip（2026-09-12 视觉统一） */
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }

/* 选关 */
.intro { background: #fff; border-radius: 28rpx; padding: 28rpx; text-align: center; margin: 20rpx 0; }
.i-t { font-size: 32rpx; font-weight: 900; color: #3a3a5c; }
.i-s { font-size: 22rpx; color: #8a9bb5; margin-top: 8rpx; line-height: 1.5; }
.levels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.lv {
  background: #fff; border-radius: 24rpx; padding: 22rpx;
  text-align: center; box-shadow: 0 8rpx 0 rgba(0,0,0,.05);
}
.lv.on { outline: 6rpx solid #ffb703; }
.lv-no { font-size: 24rpx; font-weight: 800; color: #3a3a5c; }
.lv-nums { font-size: 40rpx; font-weight: 900; color: #b57900; letter-spacing: 6rpx; margin-top: 8rpx; }

/* HUD 用 app.wxss 的 .hud / .hud-chip */

/* 数字牌 */
.cards { flex: 0 0 auto; display: flex; justify-content: center; gap: 22rpx; margin: 6rpx 0; }
.card {
  width: 160rpx; height: 160rpx;
  border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; font-weight: 900; color: #3a3a5c;
}
.card.used { opacity: .35; box-shadow: none; }

/* 算式显示 */
.expr-box {
  flex: 0 0 auto;
  min-height: 108rpx;
  margin: 18rpx 0 16rpx;
  background: rgba(255,255,255,.95);
  border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 12rpx 24rpx;
  font-size: 44rpx; font-weight: 900; color: #2c3e72;
  letter-spacing: 4rpx;
  word-break: break-all;
  text-align: center;
}

/* 按键 */
.keys {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.key {
  height: 96rpx; line-height: 96rpx;
  background: #fff; border-radius: 20rpx;
  text-align: center;
  font-size: 40rpx; font-weight: 900;
  box-shadow: 0 6rpx 0 rgba(0,0,0,.07);
}
.k-sym { color: #7bd389; }
.k-op { color: #4cc9f0; }
.k-del { color: #ff8f00; }
.k-clr { color: #8a9bb5; font-size: 30rpx; }
.key:active { transform: translateY(3rpx); }

/* 校验 */
.check-btn {
  flex: 0 0 auto;
  margin: 22rpx 0 6rpx;
  height: 96rpx; line-height: 96rpx;
  border-radius: 48rpx;
  background: #ffb703; color: #fff;
  font-size: 34rpx; font-weight: 900; letter-spacing: 6rpx;
  box-shadow: 0 10rpx 0 rgba(0,0,0,.1);
}
.check-btn::after { border: none; }
.op-tip { flex: 0 0 auto; text-align: center; font-size: 24rpx; color: #fff; opacity: .95; margin-top: 8rpx; min-height: 36rpx; }
.goal { flex: 0 0 auto; text-align: center; font-size: 22rpx; color: #fff; font-weight: 700; opacity: .9; }

/* 结算 */
.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #2e8b57; margin-top: 10rpx; }
.o-title.fail { color: #e62e2e; }
.o-msg { font-size: 26rpx; color: #8a9bb5; margin-top: 10rpx; line-height: 1.6; }
.btn { margin-top: 18rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; font-size: 32rpx; font-weight: 900; }
.btn.b1 { background: #ffb703; color: #fff; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn.b2 { background: #eef2f8; color: #5c7f9e; }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
/* ===== 合并式交互（2026-09-12 改版）新增状态 ===== */
/* 选中态：金色环 + 上浮（用 app.wxss 的 .b-sel，原写法只设了 border-color
   却从没声明过 border，所以在真机上一直看不出来） */
.card.b-sel { background: linear-gradient(180deg, #fffdf6 0%, #fff4d9 100%); }
/* 刚合并出来的结果牌：绿色环提示「这是新的牌」（原写法同样只设了 border-color
   而没有 border，真机上只剩一层淡淡的绿底） */
.card.merged {
  background: linear-gradient(180deg, #f4fdf6 0%, #e4f7e9 100%);
  box-shadow: 0 0 0 5rpx #7bd389, 0 6rpx 0 rgba(30, 120, 60, 0.22),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.95);
}
