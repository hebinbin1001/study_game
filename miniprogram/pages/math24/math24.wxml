<!-- 算 24 点（成熟玩法：直接构造算式） -->
<view class="page-24">
  <view class="p-head">
    <button class="back-pill" bindtap="goBack">‹</button>
    <view class="p-title">算 24 点</view>
    <view class="p-grade" bindtap="goLevels">{{playing ? ('第 ' + curLevel + '/' + levelInfo.length + ' 关') : '选关'}}</view>
  </view>

  <!-- 选关 -->
  <block wx:if="{{!playing}}">
    <view class="intro">
      <view class="i-t">🧮 四张牌 + − × ÷ 与括号凑成 24</view>
      <view class="i-s">每张牌各用一次 · 每关固定 4 数，全部有解</view>
    </view>
    <view class="levels">
      <view
        wx:for="{{levelInfo}}"
        wx:key="no"
        class="lv {{curLevel === item.no ? 'on' : ''}}"
        data-no="{{item.no}}"
        bindtap="pickLevel">
        <view class="lv-no">第 {{item.no}} 关</view>
        <view class="lv-nums">{{item.nums.join('  ')}}</view>
      </view>
    </view>
  </block>

  <!-- 对局 -->
  <block wx:else>
    <view class="hud">
      <view class="hud-chip">❤{{lives}}</view>
      <view class="hud-chip">第 {{curLevel}} 关</view>
      <view class="hud-chip">已试 {{tries}}</view>
    </view>

    <!-- 数字牌（点=插入算式） -->
    <view class="cards">
      <view
        wx:for="{{cards}}"
        wx:key="index"
        class="card {{item.used ? 'used' : ''}}"
        data-idx="{{index}}"
        bindtap="tapCard">{{item.num}}</view>
    </view>

    <!-- 算式显示 -->
    <view class="expr-box">{{expr || '点上面的牌开始构造…'}}</view>

    <!-- 按键区 -->
    <view class="keys">
      <view class="key k-sym" data-s="(" bindtap="addSym">(</view>
      <view class="key k-sym" data-s=")" bindtap="addSym">)</view>
      <view class="key k-op" data-s="+" bindtap="addSym">＋</view>
      <view class="key k-op" data-s="-" bindtap="addSym">－</view>
      <view class="key k-op" data-s="*" bindtap="addSym">×</view>
      <view class="key k-op" data-s="/" bindtap="addSym">÷</view>
      <view class="key k-del" bindtap="backspace">⌫</view>
      <view class="key k-clr" bindtap="clearAll">清空</view>
    </view>

    <!-- 校验 -->
    <button class="check-btn" bindtap="check">＝ 校验 24</button>
    <view class="op-tip">{{hint}}</view>
    <view class="goal">四张牌各用一次 · 可加括号 · 结果须恰为 24</view>
  </block>

  <!-- 结算 -->
  <view wx:if="{{over}}" class="over-mask">
    <view class="over-card">
      <view class="o-stars">{{win ? starsText : '💔'}}</view>
      <view class="o-title {{win ? '' : 'fail'}}">{{win ? '凑出 24！' : '本关失败'}}</view>
      <view class="o-msg">{{overMsg}}</view>
      <button wx:if="{{win}}" class="btn b1" bindtap="goNext">下一关 ▶</button>
      <button class="btn b1" bindtap="again">再试本关</button>
      <button class="btn b2" bindtap="goLevels">关卡列表</button>
    </view>
  </view>

  <view class="safe-gap"></view>
</view>
