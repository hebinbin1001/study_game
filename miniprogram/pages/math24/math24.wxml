<!-- 算 24 点（合并式 · 2026-09-12 改版）：
     点两张牌 → 点运算符 → 立即合并成一张结果牌（结果自动选中）→ 最后剩一张等于 24 过关 -->
<view class="page-24">
  <!-- 2026-10-17：删掉页内「返回 + 标题 + 选关胶囊」（原生导航栏已有返回与页面名）。
       「第 N 关 / 选关」信息在对局 HUD 与底部「关卡列表」按钮里都有，不丢功能。 -->

  <!-- 选关 -->
  <block wx:if="{{!playing}}">
    <view class="intro">
      <view class="i-t">🧮 选两张牌，用 + − × ÷ 合并成一个新数</view>
      <view class="i-s">最后只剩一张且等于 24 即过关 · 每关 4 数都有解</view>
    </view>
    <view class="levels">
      <view
        wx:for="{{levelInfo}}"
        wx:key="no"
        class="lv {{curLevel === item.no ? 'on' : ''}}"
        data-no="{{item.no}}"
        bindtap="pickLevel">
        <view class="lv-no">第 {{item.no}} 关</view>
        <view class="lv-nums">{{item.numsText}}</view>
      </view>
    </view>
  </block>

  <!-- 对局 -->
  <block wx:else>
    <view class="hud">
      <view class="hud-chip">🃏 剩 {{tiles.length}} 张</view>
      <view class="hud-chip">第 {{curLevel}} 关</view>
      <view class="hud-chip">已合并 {{steps}} 步</view>
      <warrior-badge size="sm" />
      <game-pause
        inline
        open="{{paused}}"
        showFab="{{playing && !over}}"
        sub="第 {{curLevel}} 关 · {{steps}} 步"
        bind:pause="onGamePause"
        bind:resume="onGameResume"
        bind:restart="onGameRestart"
        bind:quit="onGameQuit" />
    </view>

    <!-- 数字牌（点=选中；已选两张后点运算符即合并） -->
    <view class="cards">
      <view
        wx:for="{{tiles}}"
        wx:key="id"
        class="card b-face b-press {{item.sel ? 'b-sel' : ''}} {{item.justMerged ? 'merged' : ''}}"
        data-idx="{{index}}"
        bindtap="tapTile">
        <!-- 角标：结果牌（绿）与普通选中牌（蓝勾）一眼区分，避免两种高亮混在一起 -->
        <text wx:if="{{item.justMerged}}" class="tile-tag tile-tag--result">结果</text>
        <text wx:elif="{{item.sel}}" class="tile-tag tile-tag--sel">✓</text>
        {{item.text}}
      </view>
    </view>

    <!-- 当前选中预览 -->
    <view class="expr-box">{{selText || hint}}</view>

    <!-- 运算符 -->
    <view class="keys">
      <view
        wx:for="{{ops}}"
        wx:key="key"
        class="key k-op"
        data-key="{{item.key}}"
        bindtap="tapOp">{{item.label}}</view>
    </view>

    <!-- 撤销 / 重来 / 提示 -->
    <view class="keys">
      <view class="key k-del" bindtap="undo">↩ 撤销</view>
      <view class="key k-clr" bindtap="reset">重来</view>
      <view class="key k-clr" bindtap="hint">💡 提示</view>
    </view>

    <!-- 只在「走死路」时提示：正常情况这句话和上面 expr-box 的提示重复，
         白占一行还会把底部规则行挤出屏幕（2026-09-12 布局体检） -->
    <view wx:if="{{deadEnd}}" class="op-tip">⚠️ {{hint}}</view>
    <view class="goal">每张牌各用一次 · 每步只做一次运算（不需要括号）· 结果须恰为 24</view>
  </block>

  <!-- 结算统一走公共组件（2026-10-17） -->
  <settle-pop visible="{{over}}" win="{{win}}" stars-text="{{win ? starsText : ''}}"
    title="{{win ? '凑出 24！' : '本关失败'}}" msg="{{overMsg}}"
    hint="{{hintText}}"
    show-next="{{win}}" next-text="下一关 ▶"
    bind:retry="again" bind:next="goNext">
    <button class="btn btn-ghost" bindtap="goLevels">关卡列表</button>
  </settle-pop>

  <view class="safe-gap"></view>

</view>

