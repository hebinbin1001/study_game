<!-- 算 24 点（合并式 · 2026-09-12 改版）：
     点两张牌 → 点运算符 → 立即合并成一张结果牌（结果自动选中）→ 最后剩一张等于 24 过关 -->
<view class="page-24">
  <view class="g-head">
    <button class="back-pill" bindtap="goBack">‹</button>
    <view class="g-title">算 24 点</view>
    <view class="g-chip" bindtap="goLevels">{{playing ? ('第 ' + curLevel + '/' + levelInfo.length + ' 关') : '选关'}}</view>
  </view>

  <!-- 选关 -->
  <block wx:if="{{!playing}}">
    <view class="intro">
      <view class="i-t">🧮 选两张牌，用 + − × ÷ 合并成一个新数</view>
      <view class="i-s">最后只剩一张且等于 24 即过关 · 每关 4 数都有解</view>
    </view>
    <view class="levels">
      <view
        wx:for="{{levelInfo}}"
        wx:key="no"
        class="lv {{curLevel === item.no ? 'on' : ''}}"
        data-no="{{item.no}}"
        bindtap="pickLevel">
        <view class="lv-no">第 {{item.no}} 关</view>
        <view class="lv-nums">{{item.nums.join('  ')}}</view>
      </view>
    </view>
  </block>

  <!-- 对局 -->
  <block wx:else>
    <view class="hud">
      <view class="hud-chip">🃏 剩 {{tiles.length}} 张</view>
      <view class="hud-chip">第 {{curLevel}} 关</view>
      <view class="hud-chip">已合并 {{steps}} 步</view>
    </view>

    <!-- 数字牌（点=选中；已选两张后点运算符即合并） -->
    <view class="cards">
      <view
        wx:for="{{tiles}}"
        wx:key="id"
        class="card {{item.sel ? 'sel' : ''}} {{item.justMerged ? 'merged' : ''}}"
        data-idx="{{index}}"
        bindtap="tapTile">{{item.text}}</view>
    </view>

    <!-- 当前选中预览 -->
    <view class="expr-box">{{selText || hint}}</view>

    <!-- 运算符 -->
    <view class="keys">
      <view
        wx:for="{{ops}}"
        wx:key="key"
        class="key k-op"
        data-key="{{item.key}}"
        bindtap="tapOp">{{item.label}}</view>
    </view>

    <!-- 撤销 / 重来 / 提示 -->
    <view class="keys">
      <view class="key k-del" bindtap="undo">↩ 撤销</view>
      <view class="key k-clr" bindtap="reset">重来</view>
      <view class="key k-clr" bindtap="hint">💡 提示</view>
    </view>

    <view class="op-tip">{{deadEnd ? '⚠️ ' + hint : hint}}</view>
    <view class="goal">每张牌各用一次 · 每步只做一次运算（不需要括号）· 结果须恰为 24</view>
  </block>

  <!-- 结算 -->
  <view wx:if="{{over}}" class="over-mask">
    <view class="over-card">
      <view class="o-stars">{{win ? starsText : '💔'}}</view>
      <view class="o-title {{win ? '' : 'fail'}}">{{win ? '凑出 24！' : '本关失败'}}</view>
      <view class="o-msg">{{overMsg}}</view>
      <button wx:if="{{win}}" class="btn b1" bindtap="goNext">下一关 ▶</button>
      <button class="btn b1" bindtap="again">再试本关</button>
      <button class="btn b2" bindtap="goLevels">关卡列表</button>
    </view>
  </view>

  <view class="safe-gap"></view>
</view>
