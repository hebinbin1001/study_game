/* 字母拼词工坊样式：晴空蓝 + 字母格子（与成语拼字的暖橙区分开） */
page {
  background: linear-gradient(180deg, #5aa9e6 0%, #a8d8f5 38%, #d8efff 70%, #eef8ff 100%);
  min-height: 100vh;
}
.page-word-build {
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.prompt {
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx 24rpx;
  text-align: center;
  box-shadow: 0 12rpx 0 rgba(35, 70, 110, 0.12), 0 20rpx 40rpx rgba(35, 70, 110, 0.1);
}
.prompt .label { font-size: 24rpx; color: #7a8896; }
.prompt .cn {
  font-size: 54rpx;
  font-weight: 900;
  color: #1d3550;
  margin: 10rpx 0 6rpx;
  line-height: 1.3;
}
.prompt .meta { font-size: 24rpx; color: #6b7a89; }

.slots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
.slot {
  width: 84rpx;
  height: 104rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 4rpx dashed #b8d6f0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 900;
  color: #2f6fd0;
  box-shadow: 0 8rpx 0 rgba(35, 70, 110, 0.08);
}
.slot.filled { border-style: solid; border-color: #9fc9ee; background: #eef7ff; }
.slot.hinted { background: #fff6dd; border-color: #ffd166; color: #b07a00; }
.slots.ok .slot { background: #dcf6e4; border-color: #7bd389; color: #2b7a4b; }
.slots.bad { animation: shake 0.42s ease; }
.slots.bad .slot { background: #ffe2ea; border-color: #ff9fb8; color: #c53862; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20% { transform: translateX(-16rpx); }
  40% { transform: translateX(16rpx); }
  60% { transform: translateX(-10rpx); }
  80% { transform: translateX(10rpx); }
}

.poolWrap {
  background: rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
}
.pool {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}
.tile {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #1d3550;
  font-size: 42rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 0 rgba(35, 70, 110, 0.16);
  transition: transform 0.1s ease, opacity 0.2s ease;
}
.tile:active { transform: translateY(4rpx); }
.tile.used { opacity: 0.25; transform: scale(0.94); }

.foot { display: flex; gap: 16rpx; margin-top: 4rpx; }
.back { display: flex; }
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 800;
  background: #4285F4;
  color: #fff;
  box-shadow: 0 8rpx 0 #2f6fd0;
}
.btn:active { transform: translateY(4rpx); }
.btn.ghost {
  background: #fff;
  color: #4285F4;
  box-shadow: 0 8rpx 0 rgba(35, 70, 110, 0.14);
}
.btn.wide { width: 100%; }
