<!-- 昵称设置页（T17 · UI 重设计）：
     卡通档案卡：头像选择 + 昵称输入 + 保存按钮 + 可爱引导文案
     关联需求：REQ-NICK-1（头像昵称填写能力）、REQ-NICK-2（持久化）、REQ-NICK-3（校验） -->
<view class="page-nickname">
  <!-- 标题 + 吉祥物 -->
  <view class="head-area">
    <view class="head-emoji">🐱</view>
    <view class="page-title-nick">战士档案</view>
    <view class="head-sub">闯关榜单上就叫这个名字啦！</view>
  </view>

  <!-- 档案卡 -->
  <view class="profile-card">
    <!-- 头像选择（REQ-NICK-1：chooseAvatar 按钮，交互保留） -->
    <view class="section">
      <view class="section-title">😄 选择头像</view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-wrap">
          <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-default">👤</view>
          <view class="avatar-pen">✏️</view>
        </view>
        <view class="avatar-tip">{{avatarUploading ? '头像上传中…' : '点击更换头像'}}</view>
      </button>
    </view>

    <!-- 昵称输入（REQ-NICK-1：nickname input 双通道，交互保留） -->
    <view class="section">
      <view class="section-title">✍️ 设置昵称</view>

      <!-- 微信昵称采集引导（2026-09-29）：
           微信从 2022 年起不允许静默读取昵称 —— 用户必须**主动点一次**键盘上方的
           「使用微信昵称」，我们才拿得到。所以这里的视觉引导就是采集率的全部依赖，
           点了之后（onNicknameReview 回调）立刻变绿反馈，让用户知道成功了。 -->
      <view class="wx-guide {{wxNickname ? 'wx-guide--done' : ''}}">
        <view class="wx-guide-ic">{{wxNickname ? '✅' : '💡'}}</view>
        <view class="wx-guide-t">
          <view class="wx-guide-b">{{wxNickname ? '已获取微信昵称' : '顺手点一下「使用微信昵称」'}}</view>
          <view class="wx-guide-s">{{wxNickname ? '只有管理员能看到，不会公开显示' : '点下面输入框 → 键盘上方会冒出「使用微信昵称」→ 点它即可'}}</view>
        </view>
      </view>
      <view wx:if="{{!wxNickname}}" class="wx-guide-arrow">⬇️ 点下面这个输入框试试</view>

      <view class="input-card">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称（2~12字）"
          placeholder-class="input-placeholder"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          bindnicknamereview="onNicknameReview"
          maxlength="12" />
      </view>
      <view class="input-hint">长度 2~12 个字符 · 微信昵称填进来后也可以随时改成自定义昵称</view>
    </view>

  </view>

  <!-- 保存按钮 -->
  <button class="btn btn-primary btn-save" bindtap="onSave">保存 ✨</button>

  <!-- 返回链接 -->
  <view class="back-link" bindtap="goBack">← 返回</view>

  <!-- 退出登录（M5：仅已登录显示） -->
  <view wx:if="{{loggedIn}}" class="back-link logout-link" bindtap="goLogout">退出登录</view>

  <!-- 注销账号（M6-A：双重确认，删除全部数据） -->
  <view wx:if="{{loggedIn}}" class="back-link logout-link" style="color:#ff5a5a;" bindtap="goDeleteAccount">注销账号</view>
</view>
