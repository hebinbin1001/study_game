<!-- 昵称设置页（T17 · UI 重设计）：
     卡通档案卡：头像选择 + 昵称输入 + 保存按钮 + 可爱引导文案
     关联需求：REQ-NICK-1（头像昵称填写能力）、REQ-NICK-2（持久化）、REQ-NICK-3（校验） -->
<page-meta page-style="{{fsStyle}}" />

<view class="page-nickname">
  <!-- 标题 + 吉祥物 -->
  <view class="head-area">
    <view class="head-emoji">🐱</view>
    <view class="page-title-nick">战士档案</view>
    <view class="head-sub">闯关榜单上就叫这个名字啦！</view>
  </view>

  <!-- 档案卡 -->
  <view class="profile-card">
    <!-- 头像选择（REQ-NICK-1：chooseAvatar 按钮，交互保留） -->
    <view class="section">
      <view class="section-title">😄 选择头像</view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-wrap">
          <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-default">👤</view>
          <view class="avatar-pen">✏️</view>
        </view>
        <view class="avatar-tip">{{avatarUploading ? '头像上传中…' : '点击更换头像'}}</view>
      </button>
    </view>

    <!-- 昵称输入（REQ-NICK-1：nickname input 双通道，交互保留） -->
    <view class="section">
      <view class="section-title">✍️ 设置昵称</view>
      <!-- 2026-10-08：微信昵称采集引导整条下线。
           微信不给真实昵称、用户又普遍不会去点键盘上方的「使用微信昵称」，
           采到的其实没什么用（而且它也只是另一个展示名，用户标识始终是 openid）。
           现在注册就发默认昵称（「战士 3F2A」），这里只是「想改就改」的入口。 -->
      <view class="input-card">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称（2~12字）"
          placeholder-class="input-placeholder"
          value="{{nickname}}"
          bindinput="onNicknameInput"
          maxlength="12" />
      </view>
      <view class="input-hint">长度 2~12 个字符 · 不改也没关系，系统已经给了你一个默认昵称</view>
    </view>

  </view>

  <!-- 底部操作区（2026-11-11 重排）：
       保存 / 返回 = 两个同宽胶囊竖排；退出登录 / 注销账号 = 分隔线下的深色文字链接。
       原来「返回」直接套了全局 .btn-back（按钮胶囊）在 view 上，会变成一颗小胶囊飘在保存下面；
       账号链接是白字压在天色最浅的一段上，真机上几乎看不见。 -->
  <view class="actions">
    <button class="btn btn-primary btn-save" bindtap="onSave">保存 ✨</button>
    <button class="btn btn-return" bindtap="goBack">返回</button>

    <block wx:if="{{loggedIn}}">
      <view class="account-sep"></view>
      <!-- 退出登录（M5）与注销账号（M6-A，双重确认）都是不可逆操作：
           放在同一行做文字链接（各 88rpx 热区），比堆两行更省高度、首屏也不会被安全区切掉 -->
      <view class="account-row">
        <view class="account-link" bindtap="goLogout">退出登录</view>
        <view class="account-divider"></view>
        <view class="account-link account-link--danger" bindtap="goDeleteAccount">注销账号</view>
      </view>
    </block>
  </view>
</view>
