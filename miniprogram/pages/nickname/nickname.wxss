/* 昵称设置页样式（T17 · UI 重设计）：
   卡通档案卡：标题吉祥物 + 白色大卡片 + 圆形头像 + 圆角输入框 + 橙色保存按钮
   硬阴影 + :active 按压位移（与 avatar 页样板一致） */

page {
  background: linear-gradient(180deg, #7ec8ff 0%, #b9e3ff 55%, #e4f6ff 100%);
  min-height: 100vh;
  color: #3a3a5c;
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-nickname {
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 标题 + 吉祥物 ===== */
.head-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.head-emoji {
  font-size: 88rpx;
  line-height: 1;
  animation: headBounce 2.4s ease-in-out infinite;
  text-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.12);
}
@keyframes headBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.page-title-nick {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
}
.head-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ffffff;
  opacity: 0.85;
  letter-spacing: 2rpx;
}

/* ===== 档案大卡片 ===== */
.profile-card {
  width: 100%;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.08), 0 14rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

/* ===== 区块 ===== */
.section {
  width: 100%;
}
.section + .section {
  margin-top: 44rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3a3a5c;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ===== 头像选择 ===== */
.avatar-btn {
  width: 100%;
  height: auto;
  background: #f6faff;
  border: 3rpx dashed #bcd8ee;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  margin: 0;
  line-height: normal;
  transition: transform 0.12s;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn:active {
  transform: translateY(4rpx);
  background: #eef6ff;
}
.avatar-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e0ecf7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.06), 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}
.avatar {
  width: 148rpx;
  height: 148rpx;
}
.avatar-default {
  font-size: 76rpx;
}
/* 角标小铅笔，暗示可更换 */
.avatar-pen {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: #ffb703;
  border-radius: 50%;
  box-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.12);
}
.avatar-tip {
  font-size: 26rpx;
  color: #5c7f9e;
  margin-top: 20rpx;
  font-weight: 700;
}

/* ===== 昵称输入（卡通输入卡） ===== */
.input-card {
  width: 100%;
  background: #f6faff;
  border: 3rpx solid #dcebf7;
  border-radius: 28rpx;
  padding: 6rpx 24rpx;
  box-sizing: border-box;
  transition: border-color 0.15s;
}
.nickname-input {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #3a3a5c;
}
.input-placeholder {
  color: #a9bccf;
  font-weight: 400;
}
.input-hint {
  font-size: 24rpx;
  color: #8899aa;
  margin-top: 16rpx;
  padding-left: 8rpx;
}

/* ===== 保存按钮（全局 .btn-primary：480×128 橙色大按钮） ===== */
.btn-save {
  margin-top: 48rpx;
}

/* ===== 返回链接 ===== */
.back-link {
  margin-top: 32rpx;
  margin-bottom: calc(24rpx + env(safe-area-inset-bottom));
  font-size: 30rpx;
  color: #ffffff;
  opacity: 0.9;
  font-weight: 700;
  padding: 16rpx 48rpx;
  transition: opacity 0.12s;
}
.back-link:active {
  opacity: 0.6;
}
