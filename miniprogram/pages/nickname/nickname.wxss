/* 昵称设置页样式（T17 · UI 重设计）：
   卡通档案卡：标题吉祥物 + 白色大卡片 + 圆形头像 + 圆角输入框 + 橙色保存按钮
   硬阴影 + :active 按压位移（与 avatar 页样板一致） */

page {
  background: linear-gradient(180deg, var(--sky-1) 0%, var(--sky-2) 34%, var(--sky-3) 72%);
  min-height: 100vh;
  color: var(--ink);
  font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
}

.page-nickname {
  padding: 40rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 标题 + 吉祥物 ===== */
.head-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.head-emoji {
  font-size: 88rpx;
  line-height: 1;
  animation: headBounce 2.4s ease-in-out infinite;
  text-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.12);
}
@keyframes headBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.page-title-nick {
  margin-top: 16rpx;
  font-size: var(--fs-display);
  font-weight: 900;
  color: var(--white);
  letter-spacing: 8rpx;
  text-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.12);
}
.head-sub {
  margin-top: 12rpx;
  font-size: var(--fs-cap);
  color: var(--white);
  opacity: 0.85;
  letter-spacing: 2rpx;
}

/* ===== 档案大卡片 ===== */
.profile-card {
  width: 100%;
  background: var(--white);
  border-radius: 28rpx;
  padding: 44rpx 36rpx;
  box-shadow: var(--clay-2);
  box-sizing: border-box;
}

/* ===== 区块 ===== */
.section {
  width: 100%;
}
.section + .section {
  margin-top: 44rpx;
}
.section-title {
  font-size: var(--fs-strong);
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* ===== 头像选择 ===== */
.avatar-btn {
  width: 100%;
  height: auto;
  background: #f6faff;
  border: 3rpx dashed #bcd8ee;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0;
  margin: 0;
  line-height: normal;
  transition: transform 0.12s;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn:active {
  transform: translateY(4rpx);
  background: #eef6ff;
}
.avatar-wrap {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e0ecf7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--clay-2);
}
.avatar {
  width: 148rpx;
  height: 148rpx;
}
.avatar-default {
  font-size: 76rpx;
}
/* 角标小铅笔，暗示可更换 */
.avatar-pen {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  background: var(--pri);
  border-radius: 50%;
  box-shadow: var(--clay-1);
}
.avatar-tip {
  font-size: var(--fs-body);
  color: var(--ink-sub);
  margin-top: 20rpx;
  font-weight: 700;
}

/* ===== 昵称输入（卡通输入卡） ===== */
.input-card {
  width: 100%;
  background: #f6faff;
  border: 3rpx solid #dcebf7;
  border-radius: 28rpx;
  padding: 6rpx 24rpx;
  box-sizing: border-box;
  transition: border-color 0.15s;
}
.nickname-input {
  width: 100%;
  height: 96rpx;
  font-size: var(--fs-strong);
  font-weight: 700;
  color: var(--ink);
}
.input-placeholder {
  color: #a9bccf;
  font-weight: 400;
}
.input-hint {
  font-size: var(--fs-cap);
  color: var(--ink-weak);
  margin-top: 16rpx;
  padding-left: 8rpx;
}

/* ===== 微信昵称采集引导（2026-09-29） =====
   微信不允许静默读取昵称，用户必须主动点一次键盘上方的「使用微信昵称」；
   这块引导卡就是采集率的全部依赖 —— 未采集时暖色高亮 + 呼吸箭头，采集到立刻变绿。 */
.wx-guide {
  display: flex;
  align-items: flex-start;
  background: #fff8e6;
  border: 3rpx solid #ffe3a3;
  border-radius: 28rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 18rpx;
}
.wx-guide--done {
  background: #eefaf1;
  border-color: #bfe8cd;
}
.wx-guide-ic {
  font-size: var(--fs-title);
  line-height: 1.1;
  margin-right: 14rpx;
}
.wx-guide-t {
  flex: 1;
  min-width: 0;
}
.wx-guide-b {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--pri-ink);
}
.wx-guide--done .wx-guide-b {
  color: var(--green-ink);
}
.wx-guide-s {
  font-size: var(--fs-cap);
  color: #9a7a3a;
  margin-top: 6rpx;
  line-height: 1.5;
}
.wx-guide--done .wx-guide-s {
  color: #4d8b64;
}
.wx-guide-arrow {
  text-align: center;
  font-size: var(--fs-cap);
  font-weight: 700;
  color: #b58a2a;
  margin-bottom: 12rpx;
  animation: arrowPulse 1.6s ease-in-out infinite;
}
@keyframes arrowPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ===== 底部操作区（2026-11-11 重排）=====
   之前的三个问题：
   ① 「返回」用的是全局 .btn-back（白胶囊 + ‹，宽度只跟文字走），套在 view 上变成一颗
      小胶囊飘在保存按钮下面，跟 480rpx 的主按钮完全不成一套；
   ② 「退出登录 / 注销账号」是白色文字，而这页的天色渐变到下方已经接近最浅的 --sky-3，
      白字压白底等于看不见；
   ③ 两个链接各自 min-height 88 + margin-bottom(含安全区)，竖向间距被撑乱、页面还会多出一截空白。
   现在：保存/返回两个同宽胶囊竖排 → 分隔线 → 账号操作深色文字链接（各 88rpx 热区），
   安全区只在 .actions 底部留一次。 */
.actions {
  width: 480rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 48rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.btn-save {
  margin-top: 0;
}
/* 次要操作：与主按钮同宽的白底胶囊。
   必须用 `.actions .btn-return`（两个类）压过 app.wxss 里 `button.btn { background: var(--pri) }`
   （那是 0,1,1；单个 .btn-return 是 0,1,0 压不住，上一版「返回」就还是橙的）。 */
.actions .btn-return {
  width: 480rpx;
  height: 96rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, .94);
  color: var(--ink-deep);
  font-size: var(--fs-strong);
  letter-spacing: 2rpx;
  box-shadow: var(--clay-card);
}
.account-sep {
  width: 100%;
  height: 2rpx;
  margin: 28rpx 0 0;
  background: rgba(47, 74, 107, .14);
}
/* 账号操作同一行：两枚文字链接 + 中间细竖线，各保留 88rpx 热区 */
.account-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.account-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--ink-deep);
  transition: opacity 0.12s;
}
.account-link:active {
  opacity: 0.55;
}
.account-divider {
  width: 2rpx;
  height: 28rpx;
  background: rgba(47, 74, 107, .18);
}
.account-link--danger {
  font-weight: 800;
  color: var(--danger-ink);
}
