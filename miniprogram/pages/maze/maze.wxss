/* 算术迷宫（数字智力第 11 款）—— 靛蓝石墙主题，与数独（亮蓝）/ 一笔画（青绿）/ 找规律（紫）/ 认钟表（橙）区分 */
page {
  background: linear-gradient(180deg, #3f5b8b 0%, #6d8ab8 30%, #d6e2f2 62%, #f4f8fd 100%);
  min-height: 100vh;
}

.page-maze {
  min-height: 100vh;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hud { display: flex; gap: 16rpx; align-items: stretch; }
.chip {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx 6rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(38, 58, 96, 0.18);
}
.chip .k { font-size: 22rpx; color: #7d8fb0; }
.chip .v { font-size: 30rpx; font-weight: 900; color: #2f4a7a; margin-top: 2rpx; }
.chip .v.hearts { font-size: 24rpx; letter-spacing: 2rpx; }

.bar { height: 12rpx; border-radius: 6rpx; background: #dbe6f6; overflow: hidden; flex: 0 0 auto; }
.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #4caf9a, #7bd6a8);
  transition: width 0.25s ease;
}

.banner {
  flex: 0 0 auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 14rpx 22rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(38, 58, 96, 0.14), 0 16rpx 28rpx rgba(38, 58, 96, 0.1);
}
.banner .main { font-size: 30rpx; font-weight: 900; color: #2f4a7a; }
/* 固定两行高：从提示换成"答对了 + 算式"时不跳动 */
.banner .sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #6f83a6;
  line-height: 1.4;
  min-height: 32rpx;
}
.banner.good { background: #e9fbef; }
.banner.good .main { color: #1b8f4b; }
.banner.good .sub { color: #3f8f63; }
.banner.bad { background: #fff0f0; }
.banner.bad .main { color: #d64545; }
.banner.bad .sub { color: #a85858; }

/* ---------- 棋盘 ---------- */
.board {
  flex: 0 0 auto;
  margin: 0 auto;
  display: grid;
  background: #f7faff;
  border-radius: 22rpx;
  padding: 8rpx;
  box-sizing: content-box;
  box-shadow: 0 10rpx 0 rgba(38, 58, 96, 0.14), 0 18rpx 34rpx rgba(38, 58, 96, 0.12);
}
/* 墙：四边都是 3rpx 实线，通道那条边透明 —— 相邻两格都透明时看起来就是通的 */
.cell {
  position: relative;
  box-sizing: border-box;
  border: 3rpx solid transparent;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cell.wn { border-top-color: #3a4a6b; }
.cell.we { border-right-color: #3a4a6b; }
.cell.ws { border-bottom-color: #3a4a6b; }
.cell.ww { border-left-color: #3a4a6b; }

/* 走过的格子淡淡留痕：既提示"来过"，又不至于把墙盖住 */
.cell.seen { background: #eef3ff; }
.cell.cur {
  background: #fff3d6;
  box-shadow: inset 0 0 0 4rpx #ff9f1c;
  z-index: 2;
}
.cell.cur .ico { font-size: 54rpx; }

.ico { font-size: 46rpx; line-height: 1; }

/* ---------- 答题浮层 ---------- */
.ask-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 100;
  background: rgba(18, 30, 52, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.ask-card {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.28);
}
.ask-title { font-size: 26rpx; color: #7d8fb0; font-weight: 700; }
.ask-expr {
  margin-top: 10rpx;
  font-size: 68rpx;
  font-weight: 900;
  color: #2f4a7a;
  letter-spacing: 2rpx;
}
.ask-opts {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.ask-opt {
  height: 108rpx;
  box-sizing: border-box;
  border: 4rpx solid #eef2fa;
  border-radius: 24rpx;
  background: #f7faff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
  color: #2f4a7a;
}
.ask-opt.ok {
  background: #e9fbef;
  border-color: #3fc26b;
  color: #1b8f4b;
}
.ask-opt.bad {
  background: #fff0f0;
  border-color: #f2635f;
  color: #d64545;
}
.ask-tip {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8ba0c0;
  min-height: 30rpx;
}
.ask-tip.good { color: #1b8f4b; font-weight: 700; }
.ask-tip.bad { color: #d64545; font-weight: 700; }

.foot {
  flex: 0 0 auto;
  text-align: center;
  font-size: 21rpx;
  color: #43587c;
  opacity: 0.9;
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
