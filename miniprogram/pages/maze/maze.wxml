<!-- 算术迷宫（数字智力第 11 款）：6×6 棋盘 + 门 + 支路宝箱，难度只靠关卡序号 -->
<view class="page-maze">

  <!-- 顶部三格：关卡 / 门 / 机会 -->
  <view class="hud">
    <view class="chip"><view class="k">关卡</view><view class="v">{{levelText}}</view></view>
    <view class="chip"><view class="k">门</view><view class="v">{{gateText}}</view></view>
    <view class="chip"><view class="k">机会</view><view class="v hearts">{{hearts}}</view></view>
    <warrior-badge size="sm" />
  </view>

  <view class="bar"><view class="bar-fill" style="width: {{pct}}%;"></view></view>

  <view class="banner {{fb}}">
    <view class="main">{{bannerMain}}</view>
    <view class="sub">{{bannerSub}}</view>
  </view>

  <!-- 棋盘：墙用四边 border 画（有墙=深色，通道=透明），格子宽度在 JS 里按棋盘宽算 -->
  <view class="board" style="width: {{boardW}}rpx; grid-template-columns: repeat({{size}}, {{cellW}}rpx); grid-auto-rows: {{cellW}}rpx;">
    <view
      wx:for="{{cells}}"
      wx:key="index"
      class="cell {{item.kn ? 'wn' : ''}} {{item.ke ? 'we' : ''}} {{item.ks ? 'ws' : ''}} {{item.kw ? 'ww' : ''}} {{item.cls}}"
      data-idx="{{index}}"
      bindtap="tapCell">
      <text class="ico">{{item.ico}}</text>
    </view>
  </view>

  <view class="foot">点相邻格子移动 · 已走 {{stepText}} 步 · 🎁 答对回一次机会</view>

  <!-- 答题浮层：进格才弹，格子上只显示门/宝箱图标（格子约 54px，塞不下算式） -->
  <view class="ask-mask" wx:if="{{ask}}" catchtap="noop">
    <view class="ask-card">
      <view class="ask-title">{{askTitle}}</view>
      <view class="ask-expr">{{askText}} = ?</view>
      <view class="ask-opts">
        <view
          wx:for="{{askOptions}}"
          wx:key="index"
          class="ask-opt {{item.cls}}"
          data-idx="{{index}}"
          bindtap="tapAnswer">{{item.v}}</view>
      </view>
      <view class="ask-tip {{askTipCls}}">{{askTip}}</view>
    </view>
  </view>

  <settle-pop
    visible="{{settle}}" win="{{win}}" starsText="{{starsText}}"
    title="{{overTitle}}" msg="{{overMsg}}" hint="{{overHint}}"
    show-next="{{showNext}}" next-text="下一关 ▶"
    bind:retry="onRetry" bind:next="onNext" />
</view>
