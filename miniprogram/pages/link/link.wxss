/* 词语连连看（B6-5） */
.page-link {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #8fd0ff 0%, #c9ecff 60%, #eaf8ff 100%);
}
/* 头部/HUD 统一到 app.wxss 的 .g-head/.g-title/.g-chip/.hud/.hud-chip（2026-09-12 视觉统一） */
.back-pill {
  width: 80rpx; height: 80rpx; padding: 0;
  background: rgba(255,255,255,.9); border-radius: 50%;
  font-size: 40rpx; color: #3a3a5c; font-weight: 900;
  line-height: 80rpx; box-shadow: 0 6rpx 0 rgba(0,0,0,.06);
}
.back-pill::after { border: none; }

.board {
  /* 棋盘贴着自己的格子，不再被拉伸（否则底槽里会出现一大片空白），
     margin:auto 上下平分剩余空间 → 头部在顶、棋盘居中、提示贴底 */
  flex: 0 0 auto;
  margin: auto 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  align-content: center;
}
.tile {
  aspect-ratio: 1/1;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  padding: 6rpx; box-sizing: border-box;
  color: #3a3a5c;
  font-size: 26rpx; font-weight: 800; text-align: center;
  word-break: break-all;
}
.tile.word { color: #4285F4; font-size: 30rpx; }
/* 词卡选中：金色环（.b-sel）+ 微暖底，和义卡区分得更清楚 */
.tile.word.b-sel { background: linear-gradient(180deg, #fffdf6 0%, #eaf3ff 100%); }
/* 消掉：淡出 + 缩小，别"啪"地消失 */
.tile.gone {
  opacity: 0;
  transform: scale(0.72);
  transition: opacity .28s ease, transform .28s ease;
  pointer-events: none;
}
.tile.err { background: linear-gradient(180deg, #ff9cbc 0%, #ff7ba4 100%); color: #fff; animation: shake .3s; }
@keyframes shake { 25% { transform: translateX(-6rpx); } 75% { transform: translateX(6rpx); } }

.tip { flex: 0 0 auto; text-align: center; font-size: 24rpx; color: #4a6b8a; opacity: 1; margin: 14rpx 0 6rpx; }

.over-mask {
  position: fixed; inset: 0; z-index: 60;
  background: rgba(20,34,56,.55);
  display: flex; align-items: center; justify-content: center;
}
.over-card { width: 600rpx; background: #fff; border-radius: 40rpx; padding: 44rpx 36rpx; text-align: center; }
.o-stars { font-size: 72rpx; color: #ffb703; letter-spacing: 8rpx; }
.o-title { font-size: 44rpx; font-weight: 900; color: #2e8b57; margin-top: 10rpx; }
.o-title.fail { color: #e62e2e; }
.btn { margin-top: 20rpx; width: 100%; height: 92rpx; line-height: 92rpx; border-radius: 46rpx; background: #ffb703; color: #fff; font-size: 32rpx; font-weight: 900; box-shadow: 0 10rpx 0 rgba(0,0,0,.1); }
.btn::after { border: none; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 12rpx); }
