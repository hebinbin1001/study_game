<!-- 词语连连看（B6-5） -->
<view class="page-link">
  <!-- 2026-10-17：删掉页内「返回 + 标题」（原生导航栏已有）。原「换局」胶囊并进 HUD 行，功能不丢。 -->

  <view class="hud">
    <view class="hud-chip">❤{{lives}}</view>
    <view class="hud-chip">配对 {{matched}}/{{pairsTotal}} 对</view>
    <view class="hud-chip" bindtap="newRound">{{gradeLabel}} · 换局</view>
    <!-- 战士徽章：并进 HUD 行（原来 fixed 悬浮会压住棋盘/提示条） -->
    <warrior-badge size="sm" />
  </view>

  <view class="board b-tray b-in">
    <view
      wx:for="{{cards}}"
      wx:key="i"
      class="tile b-face b-press {{item.t === 'w' ? 'word' : ''}} {{item.long ? 'long' : ''}} {{item.sel ? 'b-sel' : ''}} {{item.gone ? 'gone' : ''}} {{item.err ? 'err' : ''}}"
      data-idx="{{index}}"
      bindtap="tapCard">{{item.lab}}</view>
  </view>

  <view class="tip">{{tip}}</view>

  <!-- 结算 -->
  <!-- 结算统一走公共组件（2026-10-17）：原来这页自己画遮罩，星星/按钮与其它玩法不一致 -->
  <settle-pop
    visible="{{over}}"
    win="{{win}}"
    stars-text="{{win ? starsText : ''}}"
    title="{{win ? '全部连上！' : '生命耗尽'}}"
    hint="{{hintText}}"
    show-next="{{showNext && win}}"
    next-text="下一关 ▶"
    bind:retry="newRound"
    bind:next="onNext">
    <button class="btn btn-ghost" bindtap="goBack">返回关卡</button>
  </settle-pop>

  <view class="safe-gap"></view>

  <!-- 暂停 / 音效（统一组件 game-pause）：固定右上角，只在对局中出现 -->
  <game-pause
    open="{{paused}}"
    showFab="{{!over}}"
    bind:pause="onGamePause"
    bind:resume="onGameResume"
    bind:restart="onGameRestart"
    bind:quit="onGameQuit" />
</view>


