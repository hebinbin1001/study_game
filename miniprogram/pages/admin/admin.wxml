<!-- 管理后台：统计概览 + 用户列表（2026-10-08 起不再有「微信名」列 —— 那条采集线下线了） -->
<view class="page-admin">
  <!-- 口令门：未通过校验时只显示输入框 -->
  <view wx:if="{{!ready}}" class="gate">
    <view class="gate-title">🔐 管理后台</view>
    <view class="gate-sub">请输入管理口令（云托管环境变量 ADMIN_PASSCODE 里配置的那个）</view>
    <input
      class="gate-input"
      password="true"
      placeholder="管理口令"
      value="{{passcode}}"
      bindinput="onPasscodeInput" />
    <button class="gate-btn" loading="{{checking}}" bindtap="onEnter">进入</button>
  </view>

  <block wx:else>
    <!-- 统计概览 -->
    <view class="stat-grid">
      <view class="stat"><view class="s-num">{{stats.totalUsers}}</view><view class="s-lab">注册人数</view></view>
      <view class="stat hot"><view class="s-num">{{stats.onlineUsers}}</view><view class="s-lab">在线（{{stats.onlineWindowMin}} 分钟）</view></view>
      <view class="stat"><view class="s-num">{{stats.todayActiveUsers}}</view><view class="s-lab">今日活跃</view></view>
      <view class="stat"><view class="s-num">{{stats.todayNewUsers}}</view><view class="s-lab">今日新增</view></view>
      <view class="stat"><view class="s-num">{{stats.totalScores}}</view><view class="s-lab">累计答题</view></view>
    </view>

    <!-- 段位同步自检（服务端返回的最近一次重算结果；非空 = 失败了） -->
    <view wx:if="{{stats.rankSyncWarn}}" class="me-warn">
      ⚠️ 段位星最近一次同步失败：{{stats.rankSyncWarn}}
      —— 此时用户星星会涨、段位不动，请检查后端日志。
    </view>

    <!-- 段位分布 -->
    <view class="sec-title">我的身份（配 ADMIN_OPENIDS 白名单用）</view>
    <view class="me-card">
      <view class="me-row"><text class="me-k">身份来源</text><text class="me-v">{{adminBy === 'openid' ? 'openid 白名单' : (adminBy === 'passcode' ? '管理口令' : (adminBy === 'wxNickname' ? '微信名白名单' : '-'))}}</text></view>
      <view class="me-row"><text class="me-k">我的 openid</text><text class="me-v me-id">{{myOpenid || myOpenidMasked || '-'}}</text></view>
      <view class="me-btn" bindtap="copyOpenid">复制 openid</view>
    </view>

    <view class="sec-title">段位分布</view>
    <view class="dist">
      <view wx:for="{{stats.rankDistList}}" wx:key="name" class="dist-item">
        <text class="d-name">{{item.name}}</text>
        <text class="d-count">{{item.count}} 人</text>
      </view>
    </view>

    <!-- 玩法热度（2026-09-29 新增）：条形按第一名归一化，一眼看出哪个玩法最受欢迎 -->
    <view class="sec-title">玩法热度（按累计局数）</view>
    <view wx:if="{{stats.gameHeatTop.length}}" class="heat">
      <view wx:for="{{stats.gameHeatTop}}" wx:key="label" class="heat-row">
        <text class="heat-name">{{item.label}}</text>
        <view class="heat-track"><view class="heat-bar" style="width: {{item.pct}}%"></view></view>
        <text class="heat-count">{{item.count}}</text>
      </view>
      <view wx:if="{{stats.gameHeatRestTypes}}" class="heat-rest">
        其余 {{stats.gameHeatRestTypes}} 款玩法合计 {{stats.gameHeatRestGames}} 局
      </view>
    </view>
    <view wx:else class="empty">还没有成绩上报</view>

    <!-- 用户列表 -->
    <view class="sec-title">用户列表</view>
    <!-- 排序：服务端排序（不是端上排），所以翻页后顺序仍然正确 -->
    <view class="sort-row">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-chip {{sort === item.key ? 'sort-chip--on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onSortTap">{{item.label}}</view>
    </view>
    <view class="search">
      <input class="search-input" placeholder="搜昵称 / openid" value="{{q}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
    <view class="list-meta">共 {{total}} 人 · 已加载 {{users.length}}</view>
    <view wx:if="{{loadWarn}}" class="me-warn">⚠️ {{loadWarn}}</view>
    <view wx:for="{{users}}" wx:key="openidMasked" class="urow">
      <image wx:if="{{item.avatarUrl}}" class="u-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="u-avatar u-avatar--default">🙂</view>
      <view class="u-body">
        <view class="u-main">
          <text class="u-nick">{{item.nickname}}</text>
        </view>
        <view class="u-sub">
          <text class="u-chip">{{item.rankName}}</text>
          <text class="u-chip">库 {{item.stars}} · 现算 {{item.starsDeduped}} · 流水 {{item.starsRaw}}</text>
          <text wx:if="{{item.stars !== item.starsDeduped}}" class="u-chip u-chip--bad">同步未生效</text>
          <text class="u-chip">{{item.scoreCount}} 局</text>
        </view>
        <view class="u-meta">{{item.openidMasked}} · 注册 {{item.createdText}} · 最近上报 {{item.lastActiveText}}</view>
      </view>
    </view>
    <view wx:if="{{hasMore}}" class="more" bindtap="onMore">{{loading ? '加载中…' : '加载更多'}}</view>
    <view wx:if="{{!users.length && !loading}}" class="empty">没有匹配的用户</view>
    <view class="list-note">昵称可能是用户自己改的，也可能是注册时系统给的默认名（「战士 XXXX」，取 openid 后 4 位）。用户身份以 openid 为准。</view>

    <button class="btn-back" bindtap="goBack">返回</button>
  </block>
  <view class="safe-gap"></view>
</view>
