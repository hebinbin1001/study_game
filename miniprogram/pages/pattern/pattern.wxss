/* 找规律（数字智力第 9 款）—— 紫罗兰主题，和数独（蓝）/ 一笔画（青绿）区分开 */
page {
  background: linear-gradient(180deg, #7c6cf0 0%, #a99bf7 30%, #d9d2ff 62%, #f5f2ff 100%);
  min-height: 100vh;
}

/* 用 min-height 而不是 height: 100vh —— 内容比一屏高时让它自然长高（可滚动），
   不会把底部选项压出屏幕。 */
.page-pattern {
  min-height: 100vh;
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hud { display: flex; gap: 16rpx; align-items: stretch; }
.chip {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(79, 63, 201, 0.14);
}
.chip .k { font-size: 22rpx; color: #8b83b8; }
.chip .v { font-size: 32rpx; font-weight: 900; color: #4f3fc9; margin-top: 2rpx; }

.bar { height: 12rpx; border-radius: 6rpx; background: #e8e3ff; overflow: hidden; flex: 0 0 auto; }
.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #ffd166, #ff9f1c);
  transition: width 0.25s ease;
}

.banner {
  flex: 0 0 auto;
  background: #fff;
  border-radius: 26rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(79, 63, 201, 0.14), 0 16rpx 30rpx rgba(79, 63, 201, 0.1);
}
.banner .main { font-size: 32rpx; font-weight: 900; color: #4f3fc9; }
/* 副标题固定两行高：从「第 1 题 · 入门 · 等差数列」换成「每次 +3」时不跳动 */
.banner .sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7b74a8;
  line-height: 1.4;
  min-height: 34rpx;
}
.banner.good { background: #e9fbef; }
.banner.good .main { color: #1b8f4b; }
.banner.good .sub { color: #3f8f63; }
.banner.bad { background: #fff0f0; }
.banner.bad .main { color: #d64545; }
.banner.bad .sub { color: #a85858; }

/* 题面区：flex:1 吸收剩余高度，但给 min-height 兜底，避免小屏把珠子压扁 */
.stage {
  flex: 1 1 auto;
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 24rpx 20rpx;
  /* 白色题板：珠子落在卡片上更聚拢，大屏时也不会显得空 */
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 0 rgba(79, 63, 201, 0.10), 0 20rpx 38rpx rgba(79, 63, 201, 0.10);
}
.cells {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}
.cell {
  flex: 0 0 auto;
  box-sizing: border-box;
  /* 珠子放在白色题板上：白底会"消失"，改成浅紫底 + 细描边才有块感 */
  background: #f4f1ff;
  border: 2rpx solid #e2dbff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  color: #3a3560;
  box-shadow: 0 4rpx 0 rgba(79, 63, 201, 0.10);
}
.cell.blank {
  background: #faf8ff;
  border: 4rpx dashed #8b7ef0;
  color: #6b5fd6;
  box-shadow: none;
}
.cell.reveal {
  background: linear-gradient(180deg, #ffe9a8, #ffd166);
  color: #8a5a00;
  box-shadow: 0 6rpx 0 rgba(180, 130, 0, 0.22);
}
.stage-tip { font-size: 22rpx; color: #6b64a0; min-height: 30rpx; }

.opts {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
/* 单个选项 128rpx 高（远大于 88rpx 最小点击区），2×2 占 276rpx，底部不会顶到 tabBar */
.opt {
  height: 128rpx;
  box-sizing: border-box;
  background: #fff;
  border: 4rpx solid #fff;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #3a3560;
  box-shadow: 0 8rpx 0 rgba(79, 63, 201, 0.16);
}
/* 图形题的选项是 emoji，44rpx 偏小，单独放大 */
.opts.emoji .opt { font-size: 60rpx; }

/* 对错态用"浅底 + 粗描边"，不用实心色块：
   图形题的选项是 emoji，深色 emoji 压在绿底上几乎看不见（截图发现的）。 */
.opt.ok {
  background: #e9fbef;
  border-color: #3fc26b;
  color: #1b8f4b;
  box-shadow: 0 8rpx 0 rgba(31, 122, 66, 0.22);
}
.opt.bad {
  background: #fff0f0;
  border-color: #f2635f;
  color: #d64545;
  box-shadow: 0 8rpx 0 rgba(150, 40, 38, 0.2);
}

.foot {
  flex: 0 0 auto;
  text-align: center;
  font-size: 22rpx;
  color: #5b53a0;
  opacity: 0.85;
}

/* 右上角固定暂停按钮让位（components/game-pause）：HUD 右端不压住内容 / 战士徽章 */
