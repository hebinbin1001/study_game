<!-- 找规律（数字智力第 9 款）：30 关 × 每关 10 题，难度只靠关卡序号，不接年级 -->
<view class="page-pattern">

  <!-- 顶部三格信息（沿用统一 HUD 视觉：关卡 / 题号 / 答对） -->
  <view class="hud">
    <view class="chip"><view class="k">关卡</view><view class="v">{{levelText}}</view></view>
    <view class="chip"><view class="k">题号</view><view class="v">{{qText}}</view></view>
    <view class="chip"><view class="k">答对</view><view class="v">{{rightText}}</view></view>
    <warrior-badge size="sm" />
  </view>

  <view class="bar"><view class="bar-fill" style="width: {{pct}}%;"></view></view>

  <!-- 提示条：考前只说「看规律」，答完才公布规则（否则题目没难度） -->
  <view class="banner {{fb}}">
    <view class="main">{{bannerMain}}</view>
    <view class="sub">{{bannerSub}}</view>
  </view>

  <!-- 题面：珠子横排，最后一格是问号；格宽按题目项数算，永远不会溢出屏幕 -->
  <view class="stage">
    <view class="cells">
      <view
        wx:for="{{cells}}"
        wx:key="index"
        class="cell {{item.blank ? 'blank' : ''}} {{item.reveal ? 'reveal' : ''}}"
        style="width: {{cellW}}rpx; height: {{cellW}}rpx; font-size: {{cellFont}}rpx;">{{item.v}}</view>
    </view>
    <view class="stage-tip">{{stageTip}}</view>
  </view>

  <!-- 四个选项（2×2）：点完立即判对错，答完自动下一题 -->
  <view class="opts {{optBig ? 'emoji' : ''}}">
    <view
      wx:for="{{options}}"
      wx:key="index"
      class="opt {{item.cls}}"
      data-idx="{{index}}"
      bindtap="tapOption">{{item.v}}</view>
  </view>

  <view class="foot">点一个答案 · 答完自动进入下一题</view>

  <settle-pop
    visible="{{settle}}" win="{{win}}" starsText="{{starsText}}"
    title="{{overTitle}}" msg="{{overMsg}}" hint="{{overHint}}"
    show-next="{{showNext}}" next-text="下一关 ▶"
    bind:retry="onRetry" bind:next="onNext" />
</view>
