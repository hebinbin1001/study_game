<!-- 首页 Tab（B1 UI 对齐 demo 首页；去宫格 → 大厅化）
     结构：Header / Hero / 游客引导条 / 资产条 / 排行榜行 / 今日目标 / 每日一题 / 继续挑战 / 推荐玩法 -->
<view class="page-home">
  <!-- Header -->
  <view class="head">
    <view class="head-t">⚔️ 词力战士</view>
    <button class="snd-btn" bindtap="toggleSound" hover-class="none">{{soundOn ? '🔊' : '🔇'}}</button>
  </view>

  <!-- Hero 头图（已登录点头像进“我的”） -->
  <view class="hero" bindtap="onProfileTap">
    <view class="hero-av">
      <image wx:if="{{avatarUrl}}" class="hero-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:elif="{{loggedIn}}" class="hero-emoji">😎</view>
      <view wx:else class="hero-emoji">⚔️</view>
    </view>
    <view class="hero-title">词力战士</view>
    <view class="hero-sub">{{loggedIn ? '点击头像进入个人中心' : '玩中学 · 学中记'}}</view>
  </view>

  <!-- 游客引导条（仅游客）：点去登录 → 先弹协议再登录；条下提供协议全文阅读 -->
  <view wx:if="{{!loggedIn}}" class="guestbar" bindtap="onProfileTap">
    <view class="gb-ic">👤</view>
    <view class="gb-t">
      <view class="gb-b">游客模式 · 数据仅存本机</view>
      <view class="gb-s">登录后可同步进度、解锁全部功能</view>
    </view>
    <view class="gb-btn">去登录</view>
  </view>
  <view wx:if="{{!loggedIn}}" class="agree-link" bindtap="goAgreement">登录即代表同意《用户协议与隐私政策》· 点击阅读全文</view>

  <!-- 资产条 -->
  <view class="asset-row">
    <view class="asset-box">
      <view class="a-num">{{totalStars}}</view>
      <view class="a-lab">⭐ 累计星星</view>
    </view>
    <view class="asset-box">
      <view class="a-num a-num--name">{{loggedIn ? (rankName || '青铜') : '游客'}}</view>
      <view class="a-lab">🎖 段位</view>
    </view>
    <view class="asset-box">
      <view class="a-num">{{streakDays}} 天</view>
      <view class="a-lab">🔥 连续</view>
    </view>
  </view>

  <!-- 排行榜行 -->
  <view class="link" bindtap="goRank">
    <view class="li">🏆</view>
    <view class="lt">
      <view class="l-b">排行榜</view>
      <view class="l-s">
        <block wx:if="{{loggedIn}}">{{myRank > 0 ? ('我的排名 第 ' + myRank + ' 名') : '全服榜单 · 登录即上榜'}}</block>
        <block wx:else>全服榜单 · 登录后上榜</block>
      </view>
    </view>
    <view class="link-badge">TOP 100</view>
    <view class="ar">›</view>
  </view>

  <!-- 今日目标 / 学习进度 -->
  <view class="goal-card">
    <view class="goal-head">
      <view class="gt">🎯 今日目标</view>
      <view class="gsub">{{loggedIn ? ('已答 ' + todayQ + ' 题' + (todayQ ? ' · 正确 ' + todayRate + '%' : '')) : '登录后查看'}}</view>
    </view>
    <view class="goal-track">
      <view class="goal-fill" style="width: {{todayQ >= 10 ? 100 : (todayQ * 10)}}%;"></view>
    </view>
    <view class="goal-foot">{{dailyDone ? '每日一题已完成 · 今日已签 ✓' : '完成每日一题即签到 · 目标 10 题'}}</view>
  </view>

  <!-- 每日一题 · 签到 -->
  <view class="daily" bindtap="goDaily">
    <view class="di">📌</view>
    <view class="dt">
      <view class="d-b">每日一题</view>
      <view class="d-s">{{dailyDone ? '今日已签 ✓ · 连续 ' + streakDays + ' 天' : '今日未答 · 答完即签到'}}</view>
    </view>
    <view class="ar ar-green">{{dailyDone ? '✓' : '›'}}</view>
  </view>

  <!-- 继续挑战（一期：显示真实进度，点击直达该关对局；右上角「换关卡」进关卡页） -->
  <view class="cta">
    <view class="ci">⚔️</view>
    <view class="ct" bindtap="goContinue">
      <view class="c-b">继续挑战</view>
      <view class="c-s">{{continueHint}}</view>
    </view>
    <view wx:if="{{continueStars > 0}}" class="c-stars">★{{continueStars}}</view>
    <view class="c-switch" catchtap="goLevel">换关卡 ›</view>
  </view>

  <!-- 推荐玩法 -->
  <view class="sec">🔥 推荐玩法</view>
  <view class="rec">
    <view class="game" bindtap="goShoot">
      <view class="ic">🔫</view>
      <view class="g-b">字母射击</view>
      <view class="g-s">挖空补词 · 打跑怪兽</view>
    </view>
    <view class="game" bindtap="goMatch">
      <view class="ic">🃏</view>
      <view class="g-b">词义消消乐</view>
      <view class="g-s">词↔义配对消除</view>
    </view>
  </view>

  <view class="safe-gap"></view>
</view>
