/* 首页 Tab —— UI token 对齐 demo；O1 全机型自适应（rpx 宽自适应 + 长内容滚动 + 安全区） */
.page-home {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 16rpx 32rpx 0;
  background: #F5F7FB;
}

/* Header */
.head {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.head-t { flex: 1; font-size: 40rpx; font-weight: 900; color: #333A45; }
.snd-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  border: none;
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  font-size: 36rpx;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
}
.snd-btn::after { border: none; }

/* Hero */
.hero {
  margin-top: 16rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(160deg, #4A90E2, #7BB8F5);
  border-radius: 40rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
}
.hero-av {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: #fff;
  border: 8rpx solid rgba(255, 255, 255, .72);
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .12);
  overflow: hidden;
  box-sizing: border-box;
}
.hero-img { width: 100%; height: 100%; }
.hero-emoji { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; font-size: 72rpx; }
.hero-title { font-size: 52rpx; font-weight: 900; margin-top: 20rpx; letter-spacing: 4rpx; }
.hero-sub { font-size: 26rpx; opacity: .92; margin-top: 6rpx; }

/* 游客引导条 */
.guestbar {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFF6E6, #FFF0D6);
  border: 2rpx solid #FFE3B3;
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
}
.gb-ic { font-size: 40rpx; }
.gb-t { flex: 1; min-width: 0; }
.gb-b { font-size: 28rpx; font-weight: 800; color: #A66A00; }
.gb-s { font-size: 22rpx; color: #C08B4A; margin-top: 2rpx; }
.gb-btn {
  background: #FF9800;
  color: #fff;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  flex: 0 0 auto;
}
.agree-link {
  text-align: center;
  font-size: 20rpx;
  color: #9aa7bd;
  padding: 12rpx 0 2rpx;
}
.agree-link:active { opacity: .7; }

/* 资产条 */
.asset-row { display: flex; gap: 20rpx; margin-top: 24rpx; }
.asset-box {
  flex: 1;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 22rpx 8rpx;
  text-align: center;
  min-width: 0;
}
.a-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #333A45;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.a-num--name { font-size: 32rpx; }
.a-lab { font-size: 20rpx; color: #8A94A6; margin-top: 6rpx; }

/* 通用链接行（排行/列表） */
.link {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 24rpx 28rpx;
}
.link:active { opacity: .8; }
.li {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: #EEF3FD;
  flex: 0 0 auto;
}
.lt { flex: 1; min-width: 0; }
.l-b { font-size: 30rpx; font-weight: 800; color: #333A45; }
.l-s { font-size: 22rpx; color: #8A94A6; margin-top: 4rpx; }
.link-badge {
  background: #EAF5FF;
  color: #4285F4;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  font-weight: 800;
  flex: 0 0 auto;
}
.ar { color: #C3CCDA; font-size: 36rpx; font-weight: 700; flex: 0 0 auto; }
.ar-green { color: #34A853; }

/* 今日目标卡 */
.goal-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 26rpx 28rpx;
}
.goal-head { display: flex; align-items: center; }
.gt { font-size: 28rpx; font-weight: 800; color: #333A45; }
.gsub { flex: 1; font-size: 22rpx; color: #8A94A6; text-align: right; }
.goal-track {
  height: 18rpx;
  border-radius: 12rpx;
  background: #EFF3FA;
  margin-top: 20rpx;
  overflow: hidden;
}
.goal-fill {
  height: 100%;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #34A853, #7BC96F);
  min-width: 6rpx;
  transition: width .3s;
}
.goal-foot { font-size: 22rpx; color: #8A94A6; margin-top: 14rpx; }

/* 每日一题 */
.daily {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.daily:active { opacity: .8; }
.di { font-size: 44rpx; flex: 0 0 auto; }
.dt { flex: 1; min-width: 0; }
.d-b { font-size: 28rpx; font-weight: 800; color: #333A45; }
.d-s { font-size: 22rpx; color: #8A94A6; margin-top: 4rpx; }

/* 继续挑战大卡 */
.cta {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #4285F4, #6AA6F5);
  border-radius: 36rpx;
  box-shadow: 0 12rpx 28rpx rgba(66, 133, 244, .28);
  color: #fff;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cta:active { opacity: .9; }
.ci {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex: 0 0 auto;
}
.ct { flex: 1; min-width: 0; }
.c-b { font-size: 34rpx; font-weight: 800; }
.c-s {
  font-size: 24rpx;
  opacity: .92;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cta .c-stars {
  flex: 0 0 auto;
  color: #ffe08a;
  font-size: 28rpx;
  font-weight: 900;
}
.cta .c-switch {
  flex: 0 0 auto;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  opacity: .92;
  border: 2rpx solid rgba(255, 255, 255, .6);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.cta .ar { color: #fff; font-size: 44rpx; font-weight: 800; opacity: .9; }

/* 推荐玩法 */
.sec { margin: 36rpx 4rpx 20rpx; font-size: 30rpx; font-weight: 800; color: #333A45; }
.rec { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.game {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(30, 60, 120, .08);
  padding: 30rpx 24rpx;
}
.game:active { opacity: .8; }
.ic { font-size: 68rpx; }
.g-b { font-size: 30rpx; font-weight: 800; color: #333A45; margin-top: 12rpx; }
.g-s { font-size: 22rpx; color: #8A94A6; line-height: 1.45; margin-top: 6rpx; }

.safe-gap { height: calc(env(safe-area-inset-bottom) + 48rpx); }
